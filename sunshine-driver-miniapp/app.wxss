page {
  background:
    radial-gradient(circle at top right, rgba(255, 177, 74, 0.18), transparent 32%),
    linear-gradient(180deg, #fff7ef 0%, #f7f8fc 34%, #f7f8fc 100%);
  color: #1f2432;
  font-size: 28rpx;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
button,
input,
textarea,
map,
scroll-view {
  box-sizing: border-box;
}

input {
  min-height: 76rpx;
}

.driver-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f7f8fc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  font-size: 28rpx;
  line-height: 76rpx;
  color: #1f2432;
}

.driver-input::placeholder {
  color: #98a2b3;
}

.page-shell {
  min-height: 100vh;
}

.page-content {
  padding: 24rpx 24rpx 40rpx;
}

.hero-card,
.panel-card,
.glass-card {
  background: #ffffff;
  border-radius: 30rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(31, 36, 50, 0.08);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2432;
}

.section-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7385;
}

.primary-button,
.ghost-button {
  border: none;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  padding: 24rpx 28rpx;
}

.primary-button::after,
.ghost-button::after {
  border: none;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00, #ff9a31);
}

.ghost-button {
  color: #ff7a00;
  background: #fff1df;
}

.button-hover,
.tap-scale:active {
  transform: scale(0.98);
  opacity: 0.96;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pill {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ff7a00;
  background: #fff1df;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.waiting {
  color: #c77700;
  background: rgba(255, 176, 32, 0.14);
}

.status-tag.success {
  color: #13885e;
  background: rgba(27, 169, 122, 0.14);
}

.status-tag.processing {
  color: #2c63ff;
  background: rgba(44, 99, 255, 0.12);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.metric-item {
  padding: 22rpx 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 246, 236, 0.92));
}

.metric-value {
  font-size: 32rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7385;
}

.list-gap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b7385;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.08);
}

.chip-active {
  color: #ff7a00;
  background: #fff1df;
  border-color: rgba(255, 122, 0, 0.2);
}

.floating-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 30;
}
