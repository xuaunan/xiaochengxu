.wallet-page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 48% 0%, rgba(255, 184, 94, 0.34) 0%, rgba(255, 218, 169, 0.2) 30%, rgba(255, 218, 169, 0) 54%),
    linear-gradient(180deg, #ffeedb 0%, #fff4e9 24%, #f3f6fc 62%, #edf2fa 100%);
}

.wallet-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 12rpx 18rpx 32rpx;
  padding-top: 12rpx;
}

.wallet-hero {
  position: relative;
  min-height: 174rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 135, 24, 0.2);
  background:
    radial-gradient(circle at 91% 22%, rgba(255, 160, 48, 0.24) 0, rgba(255, 160, 48, 0) 160rpx),
    radial-gradient(circle at 74% 100%, rgba(255, 203, 132, 0.3) 0, rgba(255, 203, 132, 0) 180rpx),
    linear-gradient(105deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 250, 244, 0.98) 48%, rgba(255, 231, 198, 0.74) 100%),
    #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(210, 104, 18, 0.075);
}

.wallet-hero::before {
  content: "";
  position: absolute;
  inset: 2rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  pointer-events: none;
}

.wallet-hero::after {
  content: "";
  position: absolute;
  right: 18rpx;
  bottom: -38rpx;
  width: 210rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 144, 31, 0.08);
  filter: blur(2rpx);
  pointer-events: none;
}

.wallet-hero__art {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 1;
  pointer-events: none;
}

.wallet-hero__head,
.wallet-title-row,
.detail-link,
.bill-head,
.bill-title-wrap,
.bill-row,
.bill-finished,
.withdraw-panel__head,
.withdraw-panel__title-wrap,
.withdraw-record {
  display: flex;
  align-items: center;
}

.wallet-hero__head,
.bill-head,
.withdraw-panel__head {
  position: relative;
  z-index: 2;
  justify-content: space-between;
  gap: 18rpx;
}

.wallet-hero__head {
  width: 100%;
}

.wallet-title-row {
  min-width: 0;
  gap: 12rpx;
}

.wallet-title-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 21rpx;
  background:
    radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.48) 0, rgba(255, 255, 255, 0) 22rpx),
    linear-gradient(145deg, #ffaf45 0%, #ff741e 100%);
  box-shadow:
    inset 0 0 0 6rpx rgba(255, 255, 255, 0.72),
    0 9rpx 18rpx rgba(255, 111, 0, 0.14);
}

.wallet-title-icon::before {
  content: "";
  position: absolute;
  left: 19rpx;
  top: 21rpx;
  width: 28rpx;
  height: 22rpx;
  border-radius: 10rpx;
  border: 3rpx solid #ffffff;
  background: rgba(255, 255, 255, 0.18);
}

.wallet-title-icon::after {
  content: "";
  position: absolute;
  right: 15rpx;
  top: 29rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffffff;
}

.wallet-title-icon__line {
  position: absolute;
  left: 24rpx;
  top: 18rpx;
  width: 20rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.wallet-title-icon-img {
  display: block;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.wallet-title,
.bill-title,
.withdraw-panel__title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.18;
}

.eye-icon {
  position: relative;
  width: 40rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.78;
}

.eye-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 31rpx;
  height: 18rpx;
  border: 3rpx solid #6b7280;
  border-radius: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.eye-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #6b7280;
  transform: translate(-50%, -50%);
}

.detail-link {
  flex-shrink: 0;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 122, 0, 0.22);
  font-size: 22rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 14rpx rgba(255, 122, 0, 0.08);
}

.link-arrow,
.bill-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.income-panel {
  position: relative;
  margin: 0 8rpx;
}

.income-grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 0;
}

.income-card {
  position: relative;
  min-height: 142rpx;
  overflow: hidden;
  padding: 17rpx 16rpx 14rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86),
    0 10rpx 20rpx rgba(31, 36, 50, 0.045);
}

.income-card::after {
  content: "";
  position: absolute;
  right: -22rpx;
  bottom: -28rpx;
  width: 92rpx;
  height: 82rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
  pointer-events: none;
}

.income-card--today {
  border-color: rgba(255, 122, 0, 0.18);
  background: linear-gradient(135deg, #fffaf5 0%, #fff2e1 100%);
}

.income-card--month {
  border-color: rgba(47, 114, 219, 0.13);
  background: linear-gradient(135deg, #f9fcff 0%, #ecf4ff 100%);
}

.income-card--cash {
  border-color: rgba(19, 136, 94, 0.13);
  background: linear-gradient(135deg, #f7fffb 0%, #e8f9f2 100%);
}

.income-icon {
  position: relative;
  z-index: 2;
  width: 44rpx;
  height: 44rpx;
  border-radius: 18rpx;
  box-shadow:
    inset 0 0 0 5rpx rgba(255, 255, 255, 0.55),
    0 8rpx 16rpx rgba(31, 36, 50, 0.08);
}

.income-icon--today {
  background:
    radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.62) 0, rgba(255, 255, 255, 0) 18rpx),
    linear-gradient(145deg, #ffb15a 0%, #ff7a1f 100%);
}

.income-icon--month,
.income-icon--cash {
  background:
    radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.62) 0, rgba(255, 255, 255, 0) 18rpx),
    linear-gradient(145deg, #ffb15a 0%, #ff7a1f 100%);
}

.income-icon--today::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 20rpx;
  height: 15rpx;
  border-radius: 8rpx;
  border: 3rpx solid #ffffff;
  box-sizing: border-box;
}

.income-icon--today::after {
  content: "";
  position: absolute;
  right: 10rpx;
  top: 19rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #ffffff;
}

.income-icon--month::before {
  content: "";
  position: absolute;
  left: 12rpx;
  bottom: 11rpx;
  width: 4rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow:
    8rpx -6rpx 0 #ffffff,
    16rpx -12rpx 0 #ffffff;
}

.income-icon--month::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 12rpx;
  width: 24rpx;
  height: 20rpx;
  border-radius: 8rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.68);
  box-sizing: border-box;
}

.income-icon--cash::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 15rpx;
  width: 22rpx;
  height: 15rpx;
  border-radius: 9rpx;
  border: 3rpx solid #ffffff;
  box-sizing: border-box;
}

.income-icon--cash::after {
  content: "";
  position: absolute;
  left: 19rpx;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 8rpx 0 0 rgba(255, 255, 255, 0.72);
}

.income-icon-img {
  position: relative;
  z-index: 2;
  display: block;
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
}

.income-value {
  position: relative;
  z-index: 2;
  margin-top: 11rpx;
  overflow: hidden;
  color: #ff6f00;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.income-card--month .income-value {
  color: #2d63d8;
}

.income-card--cash .income-value {
  color: #13885e;
}

.income-label {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 5rpx;
  margin-top: 9rpx;
  color: #667085;
  font-size: 19rpx;
  font-weight: 400;
  line-height: 1.22;
  white-space: nowrap;
}

.info-dot {
  display: inline-flex;
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #8b94a7;
  border: 2rpx solid #a5adbd;
  font-size: 13rpx;
  line-height: 1;
  box-sizing: border-box;
}

.withdraw-button {
  position: relative;
  width: 340rpx;
  min-height: 66rpx;
  margin: 20rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9326 100%);
  box-shadow: 0 12rpx 26rpx rgba(255, 122, 0, 0.24);
  font-size: 24rpx;
  font-weight: 650;
}

.withdraw-button::after {
  border: none;
}

.bill-panel,
.withdraw-panel {
  margin-left: 8rpx;
  margin-right: 8rpx;
  padding: 24rpx 34rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.062);
}

.bill-panel {
  overflow: hidden;
}

.bill-title-wrap,
.withdraw-panel__title-wrap {
  gap: 14rpx;
  min-width: 0;
}

.bill-icon,
.withdraw-panel__icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 19rpx;
  background:
    radial-gradient(circle at 36% 28%, rgba(255, 255, 255, 0.52) 0, rgba(255, 255, 255, 0) 18rpx),
    linear-gradient(145deg, #ffb24f 0%, #ff7a00 100%);
  box-shadow: 0 8rpx 16rpx rgba(255, 122, 0, 0.12);
}

.bill-icon::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 13rpx;
  width: 20rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 0 #ffffff;
}

.bill-icon::after {
  content: "";
  position: absolute;
  right: 11rpx;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffffff;
}

.withdraw-panel__icon::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 15rpx;
  width: 22rpx;
  height: 16rpx;
  border-radius: 6rpx;
  border: 3rpx solid #ffffff;
}

.withdraw-panel__icon::after {
  content: "";
  position: absolute;
  right: 10rpx;
  top: 20rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #ffffff;
}

.section-icon-img {
  display: block;
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
}

.bill-summary {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  margin-top: 15rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #667085;
  background: #fff8ef;
  font-size: 21rpx;
  font-weight: 400;
}

.bill-summary text {
  color: #ff6f00;
}

.month-picker {
  display: flex;
  min-width: 166rpx;
  height: 50rpx;
  padding: 0 16rpx;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff7ed;
  border: 1rpx solid rgba(255, 122, 0, 0.16);
  font-size: 21rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.month-picker text {
  overflow: hidden;
  max-width: 168rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.month-picker__arrow {
  width: 11rpx;
  height: 11rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: translateY(-3rpx) rotate(45deg);
}

.bill-list {
  margin-top: 18rpx;
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.bill-row {
  min-height: 102rpx;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
}

.bill-car-icon {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 34% 26%, rgba(255, 255, 255, 0.52) 0, rgba(255, 255, 255, 0) 19rpx),
    linear-gradient(145deg, #ffb15a 0%, #ff7a1f 100%);
  box-shadow:
    inset 0 0 0 5rpx rgba(255, 255, 255, 0.48),
    0 8rpx 16rpx rgba(255, 122, 0, 0.12);
}

.bill-car-icon::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 22rpx;
  width: 31rpx;
  height: 15rpx;
  border-radius: 8rpx 10rpx 5rpx 5rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}

.bill-car-icon::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 35rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow:
    18rpx 0 0 currentColor,
    9rpx -20rpx 0 -1rpx currentColor;
}

.bill-service-icon {
  display: block;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
}

.bill-copy {
  flex: 1;
  min-width: 0;
}

.bill-name {
  overflow: hidden;
  color: #172033;
  font-size: 22rpx;
  font-weight: 550;
  line-height: 1.38;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-time {
  margin-top: 8rpx;
  color: #7a8396;
  font-size: 20rpx;
  line-height: 1.24;
}

.bill-amount {
  flex-shrink: 0;
  color: #13885e;
  font-size: 24rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.bill-arrow {
  flex-shrink: 0;
  color: rgba(107, 114, 128, 0.42);
}

.bill-finished {
  justify-content: center;
  gap: 10rpx;
  padding-top: 18rpx;
  color: #7a8396;
  font-size: 22rpx;
}

.finished-check {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
}

.finished-check::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 4rpx;
  width: 7rpx;
  height: 12rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(42deg);
}

.wallet-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 18rpx 18rpx;
  text-align: center;
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.wallet-empty--compact {
  padding: 24rpx 18rpx 6rpx;
  border-top: none;
}

.wallet-empty__icon {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  border-radius: 21rpx;
  background: #fff4e8;
  border: 1rpx solid rgba(255, 122, 0, 0.18);
  box-shadow: 0 8rpx 16rpx rgba(255, 122, 0, 0.08);
}

.wallet-empty__icon::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 17rpx;
  width: 22rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ff8a16;
  box-shadow: 0 10rpx 0 rgba(255, 138, 22, 0.5);
}

.wallet-empty__icon-img {
  display: block;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
}

.wallet-empty__title {
  margin-top: 12rpx;
  color: #172033;
  font-size: 23rpx;
  font-weight: 650;
}

.wallet-empty__desc {
  margin-top: 8rpx;
  color: #7a8396;
  font-size: 20rpx;
  line-height: 1.45;
}

.wallet-state-card {
  padding: 34rpx 20rpx 22rpx;
  text-align: center;
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.wallet-state-title {
  color: #172033;
  font-size: 24rpx;
  font-weight: 650;
}

.wallet-state-desc {
  margin-top: 10rpx;
  color: #7a8396;
  font-size: 20rpx;
  line-height: 1.45;
}

.wallet-state-button {
  min-width: 186rpx;
  height: 54rpx;
  min-height: 54rpx;
  margin-top: 20rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.withdraw-panel__action {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff7ed;
  border: 1rpx solid rgba(255, 122, 0, 0.16);
  font-size: 20rpx;
  font-weight: 500;
}

.withdraw-record-list {
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.withdraw-record {
  gap: 16rpx;
  padding: 17rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
}

.withdraw-record:last-child {
  border-bottom: none;
}

.withdraw-record__main {
  flex: 1;
  min-width: 0;
}

.withdraw-record__amount {
  color: #172033;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.withdraw-record__meta,
.withdraw-record__time {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a8396;
  font-size: 20rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.withdraw-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #b45309;
  background: #fff7ed;
  font-size: 20rpx;
  line-height: 1;
}

.withdraw-status--approved {
  color: #13885e;
  background: #e9f8f1;
}

.withdraw-status--rejected {
  color: #d14343;
  background: #fff1f2;
}

.pressable-hover,
.tap-scale:active,
.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
