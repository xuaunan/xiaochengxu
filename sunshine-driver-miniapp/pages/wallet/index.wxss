.wallet-page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fff5eb 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.wallet-content {
  padding: 24rpx 24rpx 32rpx;
}

.wallet-hero {
  position: relative;
  overflow: hidden;
  padding: 26rpx 24rpx 28rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(255, 188, 95, 0.26), transparent 38%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 250, 244, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 46rpx rgba(135, 83, 39, 0.09);
}

.wallet-hero__head,
.wallet-title-row,
.detail-link,
.bill-head,
.bill-title-wrap,
.bill-row,
.bill-finished {
  display: flex;
  align-items: center;
}

.wallet-hero__head,
.bill-head {
  justify-content: space-between;
  gap: 20rpx;
}

.wallet-title-row {
  gap: 14rpx;
}

.wallet-title,
.bill-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.eye-icon {
  position: relative;
  width: 42rpx;
  height: 28rpx;
}

.eye-icon::before {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 4rpx;
  width: 34rpx;
  height: 20rpx;
  border: 4rpx solid #6b7280;
  border-radius: 50%;
}

.eye-icon::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #6b7280;
}

.detail-link {
  gap: 8rpx;
  color: #8d8490;
  font-size: 23rpx;
  font-weight: 500;
}

.link-arrow,
.bill-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid rgba(107, 114, 128, 0.45);
  border-right: 4rpx solid rgba(107, 114, 128, 0.45);
  transform: rotate(45deg);
}

.income-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.income-card {
  position: relative;
  min-height: 126rpx;
  overflow: hidden;
  padding: 20rpx 14rpx 14rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
}

.income-card--today {
  background: linear-gradient(135deg, #fff8ef 0%, #fff1df 100%);
  border-color: rgba(255, 122, 0, 0.18);
}

.income-card--month {
  background: linear-gradient(135deg, #f7fbff 0%, #eaf2ff 100%);
  border-color: rgba(47, 114, 219, 0.13);
}

.income-card--cash {
  background: linear-gradient(135deg, #f3fffa 0%, #e6f8f1 100%);
  border-color: rgba(19, 136, 94, 0.13);
}

.income-value {
  position: relative;
  z-index: 2;
  color: #ff6f00;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.1;
  white-space: nowrap;
}

.income-card--month .income-value {
  color: #2d63d8;
}

.income-card--cash .income-value {
  color: #13885e;
}

.income-label {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 500;
}

.info-dot {
  display: inline-flex;
  width: 18rpx;
  height: 18rpx;
  margin-left: 5rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #8b94a7;
  border: 2rpx solid #a5adbd;
  font-size: 14rpx;
  line-height: 1;
}

.income-watermark {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  width: 70rpx;
  height: 58rpx;
  opacity: 0.15;
}

.income-watermark--wallet::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 16rpx;
  width: 50rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: #ff6f00;
}

.income-watermark--chart::before {
  content: "";
  position: absolute;
  left: 8rpx;
  bottom: 6rpx;
  width: 12rpx;
  height: 30rpx;
  border-radius: 5rpx;
  background: #2d63d8;
  box-shadow: 18rpx -12rpx 0 #2d63d8, 36rpx -24rpx 0 #2d63d8;
}

.income-watermark--card::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 14rpx;
  width: 52rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #13885e;
}

.withdraw-button {
  width: 380rpx;
  min-height: 72rpx;
  margin: 26rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 18rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9326 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.24);
  font-size: 28rpx;
  font-weight: 700;
}

.withdraw-button::after {
  border: none;
}

.bill-panel {
  margin-top: 24rpx;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.04);
  box-shadow: 0 18rpx 44rpx rgba(24, 34, 56, 0.065);
}

.bill-title-wrap {
  gap: 16rpx;
}

.bill-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #ffac4b 0%, #ff7a00 100%);
}

.bill-icon::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 12rpx;
  width: 20rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 9rpx 0 #ffffff;
}

.bill-icon::after {
  content: "";
  position: absolute;
  right: 7rpx;
  bottom: 7rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #ffffff;
}

.bill-summary {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #667085;
  background: #fff8ef;
  font-size: 22rpx;
  font-weight: 500;
}

.bill-summary text {
  color: #ff6f00;
}

.bill-list {
  margin-top: 18rpx;
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.bill-row {
  min-height: 92rpx;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
}

.bill-car-icon {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ff6f00;
  background: #fff4e8;
}

.bill-car-icon::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 23rpx;
  width: 34rpx;
  height: 18rpx;
  border-radius: 9rpx 10rpx 5rpx 5rpx;
  border: 4rpx solid currentColor;
}

.bill-car-icon::after {
  content: "";
  position: absolute;
  left: 18rpx;
  bottom: 12rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 17rpx 0 0 currentColor;
}

.bill-copy {
  flex: 1;
  min-width: 0;
}

.bill-name {
  overflow: hidden;
  color: #172033;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-time {
  margin-top: 6rpx;
  color: #7a8396;
  font-size: 22rpx;
}

.bill-amount {
  flex-shrink: 0;
  color: #13885e;
  font-size: 26rpx;
  font-weight: 700;
}

.bill-arrow {
  flex-shrink: 0;
}

.bill-finished {
  justify-content: center;
  gap: 12rpx;
  padding-top: 22rpx;
  color: #7a8396;
  font-size: 23rpx;
}

.finished-check {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
}

.finished-check::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 7rpx;
  height: 13rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(42deg);
}

.pressable-hover,
.tap-scale:active,
.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
