.wallet-page {
  background:
    linear-gradient(180deg, rgba(255, 247, 237, 0.92) 0%, rgba(247, 248, 252, 0.98) 34%, #f7f8fc 100%);
}

.wallet-content {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 28rpx;
}

.wallet-hero {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  background:
    linear-gradient(145deg, #ffffff 0%, #fff8f0 58%, #f3fbf8 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 20rpx 48rpx rgba(126, 93, 58, 0.12);
}

.wallet-hero::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 210rpx;
  height: 150rpx;
  background: linear-gradient(135deg, rgba(255, 122, 0, 0.14), rgba(19, 136, 94, 0.08));
  border-bottom-left-radius: 110rpx;
}

.wallet-title {
  position: relative;
  z-index: 1;
  color: #202532;
}

.wallet-metric-grid {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
}

.wallet-metric {
  border: 1rpx solid rgba(31, 36, 50, 0.04);
  box-shadow: 0 10rpx 22rpx rgba(31, 36, 50, 0.05);
}

.wallet-metric--today {
  background: linear-gradient(180deg, #fffaf4, #fff0df);
}

.wallet-metric--month {
  background: linear-gradient(180deg, #f8fbff, #edf4ff);
}

.wallet-metric--cash {
  background: linear-gradient(180deg, #f7fffb, #eaf8f1);
}

.wallet-metric .metric-value {
  color: #202532;
  font-size: 34rpx;
  letter-spacing: 0;
}

.wallet-metric--cash .metric-value,
.wallet-bill-amount {
  color: #13885e;
}

.wallet-metric .metric-label {
  color: #7a8396;
}

.wallet-withdraw {
  align-self: center;
  width: 340rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9a31 100%);
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 0, 0.22);
}

.wallet-panel {
  padding: 28rpx 24rpx 12rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 42rpx rgba(31, 36, 50, 0.07);
}

.wallet-panel-head {
  gap: 16rpx;
}

.wallet-summary {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #7a8396;
  background: #f5f7fb;
  font-size: 22rpx;
}

.wallet-list {
  margin-top: 14rpx;
}

.wallet-bill {
  min-height: 94rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
  gap: 18rpx;
}

.wallet-bill:last-child {
  border-bottom: none;
}

.wallet-bill-main {
  min-width: 0;
  flex: 1;
}

.wallet-bill-title {
  overflow: hidden;
  color: #252b3a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wallet-bill .section-subtitle {
  margin-top: 6rpx;
  color: #8891a3;
}

.wallet-bill-amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
}


