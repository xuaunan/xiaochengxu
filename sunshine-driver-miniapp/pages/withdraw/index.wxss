.withdraw-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 184, 98, 0.24), transparent 30%),
    radial-gradient(circle at 0% 18%, rgba(19, 136, 94, 0.08), transparent 28%),
    linear-gradient(180deg, #fff5e9 0%, #f7f8fc 34%, #f4f6fb 100%);
}

.withdraw-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 36rpx 0;
}

.has-bottom-action {
  padding-bottom: 116rpx;
}

.withdraw-hero,
.withdraw-card,
.withdraw-balance-card,
.withdraw-record-card {
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.055);
}

.withdraw-hero {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 26rpx;
  border-color: rgba(255, 122, 0, 0.18);
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 248, 239, 0.96) 56%, rgba(255, 226, 190, 0.68) 100%),
    #ffffff;
}

.withdraw-hero__icon {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9d32 0%, #ff6f00 100%);
  box-sizing: border-box;
}

.withdraw-hero__icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 25rpx;
  border-radius: 8rpx;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

.withdraw-hero__icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: -7rpx 7rpx 0 -2rpx #ff7a00, 7rpx 7rpx 0 -2rpx #ff7a00;
  transform: translate(-50%, -52%);
}

.withdraw-hero__copy {
  flex: 1;
  min-width: 0;
}

.withdraw-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.18;
}

.withdraw-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.45;
}

.withdraw-balance-card {
  padding: 24rpx 26rpx;
  border-color: rgba(19, 136, 94, 0.13);
  background:
    radial-gradient(circle at 100% 0%, rgba(27, 169, 122, 0.11), transparent 44%),
    linear-gradient(135deg, #f4fffa 0%, #ffffff 100%);
}

.withdraw-balance-card__label {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.2;
}

.withdraw-balance-card__amount {
  margin-top: 10rpx;
  color: #13885e;
  font-size: 38rpx;
  font-weight: 550;
  line-height: 1.08;
}

.withdraw-balance-card__desc {
  margin-top: 10rpx;
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.45;
}

.withdraw-card {
  position: relative;
  overflow: hidden;
  padding: 0 26rpx;
}

.withdraw-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #1ba97a, #34d399);
  opacity: 0.68;
}

.withdraw-field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.withdraw-field:last-child {
  border-bottom: none;
}

.withdraw-field__label {
  color: #172033;
  font-size: 23rpx;
  font-weight: 500;
}

.withdraw-input {
  width: 100%;
  height: 64rpx;
  min-height: 64rpx;
  margin-top: 10rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 15rpx;
  background: #f6f8fc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  color: #172033;
  font-size: 24rpx;
  line-height: 64rpx;
}

.withdraw-floating-bar {
  padding-top: 14rpx;
}

.withdraw-record-card {
  padding: 24rpx 26rpx;
}

.withdraw-record-card__head,
.withdraw-record {
  display: flex;
  align-items: center;
}

.withdraw-record-card__head {
  justify-content: space-between;
  gap: 18rpx;
}

.withdraw-record-card__title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
}

.withdraw-record-card__count {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #667085;
  background: #f6f7fb;
  font-size: 20rpx;
  line-height: 1;
}

.withdraw-record-list {
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.withdraw-record {
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
}

.withdraw-record:last-child {
  border-bottom: none;
}

.withdraw-record__main {
  flex: 1;
  min-width: 0;
}

.withdraw-record__amount {
  color: #172033;
  font-size: 25rpx;
  font-weight: 500;
}

.withdraw-record__meta,
.withdraw-record__time,
.withdraw-record__reason {
  margin-top: 6rpx;
  color: #7a8396;
  font-size: 20rpx;
  line-height: 1.35;
}

.withdraw-record__reason {
  color: #d14343;
}

.withdraw-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #b45309;
  background: #fff7ed;
  font-size: 20rpx;
  line-height: 1;
}

.withdraw-status--approved {
  color: #13885e;
  background: #e9f8f1;
}

.withdraw-status--rejected {
  color: #d14343;
  background: #fff1f2;
}

.withdraw-empty {
  padding: 28rpx 12rpx 8rpx;
  text-align: center;
}

.withdraw-empty__title {
  color: #172033;
  font-size: 23rpx;
  font-weight: 500;
}

.withdraw-empty__desc {
  margin-top: 8rpx;
  color: #7a8396;
  font-size: 20rpx;
  line-height: 1.45;
}

.withdraw-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.2;
  box-sizing: border-box;
}
