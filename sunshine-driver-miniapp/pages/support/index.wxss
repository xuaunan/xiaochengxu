.support-shell {
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 86% 4%, rgba(255, 184, 98, 0.22), transparent 30%),
    linear-gradient(180deg, #fff5e9 0%, #f7f8fc 34%, #f4f6fb 100%);
}

.support-shell.safe-bottom {
  padding-bottom: 0;
}

.support-page {
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 18rpx 26rpx 260rpx;
  box-sizing: border-box;
}

.support-hero,
.support-data-note {
  display: none;
}

.support-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
}

.support-hero::after {
  content: "";
  position: absolute;
  right: -44rpx;
  bottom: -58rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(22, 163, 74, 0.08);
}

.support-hero__copy {
  min-width: 0;
}

.support-kicker {
  display: inline-flex;
  margin-bottom: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  color: #15803d;
  background: #dcfce7;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
}

.support-title {
  color: #172033;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 550;
}

.support-desc {
  margin-top: 8rpx;
  color: #747e91;
  font-size: 21rpx;
  line-height: 1.4;
}

.support-status {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff1df;
  font-size: 21rpx;
  font-weight: 500;
}

.support-data-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(47, 114, 219, 0.14);
  border-radius: 20rpx;
  background: linear-gradient(180deg, #eff6ff, #f8fbff);
}

.support-data-note__label {
  flex-shrink: 0;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  color: #2563eb;
  background: #dbeafe;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
}

.support-data-note__text {
  min-width: 0;
  color: #334155;
  font-size: 22rpx;
  line-height: 1.45;
}

.support-page > .support-hero,
.support-page > .support-data-note {
  display: none;
}

.support-quick {
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  padding: 0 0 2rpx;
  white-space: nowrap;
}

.support-quick__item {
  flex-shrink: 0;
  padding: 11rpx 18rpx;
  border-radius: 999rpx;
  color: #5f6f86;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 500;
}

.support-messages {
  flex: 1;
  min-height: 0;
  padding: 34rpx 20rpx 0;
  border-radius: 32rpx;
  background:
    linear-gradient(180deg, rgba(255, 253, 250, 0.9), rgba(248, 250, 252, 0.96)),
    rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(220, 229, 241, 0.95);
  box-sizing: border-box;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.support-message {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.support-message--self {
  justify-content: flex-end;
}

.support-message--admin,
.support-message--ai {
  justify-content: flex-start;
}

.support-avatar {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  background: #ffffff;
  border: 1rpx solid rgba(218, 226, 238, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.08);
}

.support-avatar__image {
  display: block;
  width: 100%;
  height: 100%;
}

.support-avatar--service {
  color: #ff7a00;
  background: #ffffff;
  border-color: rgba(255, 122, 0, 0.18);
}

.support-avatar--self {
  color: #ff7a00;
  background: #ffffff;
  border-color: rgba(255, 122, 0, 0.2);
}

.support-message--self .support-avatar {
  order: 2;
}

.support-bubble {
  max-width: 540rpx;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(218, 226, 238, 0.96);
  box-shadow: 0 16rpx 32rpx rgba(24, 34, 56, 0.07);
}

.support-message--self .support-bubble {
  order: 1;
  max-width: 420rpx;
  color: #293244;
  background: linear-gradient(135deg, #fff7ec, #fff0dd);
  border-color: rgba(255, 122, 0, 0.34);
  box-shadow: 0 18rpx 36rpx rgba(255, 122, 0, 0.12);
}

.support-message--ai .support-bubble {
  max-width: 560rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border-color: rgba(218, 226, 238, 0.96);
}

.support-message--typing .support-bubble {
  color: #3a6d54;
  background: #f3fff8;
  border-color: rgba(86, 205, 132, 0.34);
  animation: support-typing-pulse 1.2s ease-in-out infinite;
}

.support-bubble__head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 14rpx;
}

.support-bubble__name {
  color: #506178;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 700;
}

.support-bubble__meta {
  color: #8a98ad;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
}

.support-message--self .support-bubble__name {
  color: #80511d;
}

.support-message--self .support-bubble__meta {
  color: #a77942;
}

.support-message--self .support-bubble__head {
  margin-bottom: 12rpx;
}

.support-bubble__tag {
  display: inline-flex;
  margin-bottom: 8rpx;
  padding: 3rpx 8rpx;
  border-radius: 8rpx;
  color: #15803d;
  background: #dcfce7;
  font-size: 19rpx;
  font-weight: 500;
}

.support-bubble__text {
  font-size: 23rpx;
  line-height: 1.64;
  font-weight: 400;
  white-space: pre-wrap;
  word-break: break-word;
}

.support-message--ai .support-bubble__text,
.support-message--admin .support-bubble__text {
  color: #334155;
  line-height: 1.72;
}

.support-scroll-spacer {
  height: 250rpx;
}

.support-bubble__time {
  margin-top: 8rpx;
  color: #9aa2b3;
  font-size: 19rpx;
}

.support-message--self .support-bubble__time {
  color: rgba(255, 255, 255, 0.78);
}

.support-empty {
  padding-top: 170rpx;
  text-align: center;
}

.support-empty__title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 500;
}

.support-empty__desc {
  margin-top: 8rpx;
  color: #8c96a8;
  font-size: 22rpx;
  line-height: 1.5;
}

.support-input-panel {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.support-composer {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(env(safe-area-inset-bottom) + 14rpx);
  z-index: 30;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 18rpx 18rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.18);
  background: rgba(255, 252, 248, 0.98);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.1);
}

.support-quick-title {
  color: #8a520e;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 700;
}

.support-input {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 160rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  color: #172033;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(196, 211, 232, 0.9);
  font-size: 24rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.support-send {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 104rpx;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffad67, #ff7a00);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.support-send--disabled {
  opacity: 0.72;
}

@keyframes support-typing-pulse {
  0%,
  100% {
    box-shadow: 0 8rpx 18rpx rgba(24, 34, 56, 0.045);
  }

  50% {
    box-shadow: 0 10rpx 24rpx rgba(34, 197, 94, 0.14);
  }
}
