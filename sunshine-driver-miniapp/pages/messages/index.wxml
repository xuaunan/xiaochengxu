<view class="page-shell driver-message-shell safe-bottom">
  <view class="page-content driver-message-page page-enter">
    <view class="driver-message-header">
      <view>
        <view class="driver-message-title">消息通知</view>
        <view class="driver-message-subtitle">订单通知、平台提醒与审核结果</view>
      </view>
      <view class="driver-message-count">{{list.length}} 条</view>
    </view>

    <view wx:if="{{list.length === 0}}" class="driver-message-empty">
      <view class="driver-message-empty__mark"></view>
      <view class="driver-message-empty__title">暂无消息</view>
      <view class="driver-message-empty__desc">订单通知、平台提醒和取消消息会显示在这里。</view>
    </view>

    <view class="driver-message-list" wx:if="{{list.length > 0}}">
      <view class="driver-message-card tap-scale" wx:for="{{list}}" wx:key="id">
        <view class="driver-message-card__head">
          <view class="driver-message-card__badge"></view>
          <view class="driver-message-card__title">{{item.title}}</view>
          <view class="driver-message-card__dot" wx:if="{{item.unread}}"></view>
          <view class="driver-message-card__tag">{{item.type || 'notice'}}</view>
        </view>
        <view class="driver-message-card__content">{{item.content}}</view>
        <view class="driver-message-card__time">{{item.time}}</view>
      </view>
    </view>
  </view>
</view>
