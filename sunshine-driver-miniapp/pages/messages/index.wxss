.message-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 32%, #f5f7fb 100%);
}

.message-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 20rpx;
}

.message-hero {
  position: relative;
  min-height: 138rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 250, 244, 0.96) 58%, rgba(255, 233, 209, 0.66) 100%),
    #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.08);
}

.message-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.message-hero__title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.15;
}

.message-hero__desc {
  margin-top: 12rpx;
  color: #5f6676;
  font-size: 24rpx;
  line-height: 1.35;
}

.message-bell {
  position: absolute;
  right: 202rpx;
  top: 30rpx;
  width: 104rpx;
  height: 98rpx;
  transform: rotate(-12deg);
  opacity: 0.96;
}

.message-bell__body {
  position: absolute;
  left: 22rpx;
  top: 16rpx;
  width: 76rpx;
  height: 78rpx;
  border-radius: 42rpx 42rpx 24rpx 24rpx;
  background: linear-gradient(145deg, #ffd9b5 0%, #ff8a16 100%);
  box-shadow: 0 16rpx 28rpx rgba(255, 122, 0, 0.16);
}

.message-bell__body::before {
  content: "";
  position: absolute;
  left: 28rpx;
  top: -12rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #ff9b32;
}

.message-bell__body::after {
  content: "";
  position: absolute;
  left: -12rpx;
  right: -12rpx;
  bottom: -7rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffc796 0%, #ff7900 100%);
}

.message-bell__clapper {
  position: absolute;
  left: 54rpx;
  bottom: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.message-count {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  min-width: 96rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 250, 244, 0.8);
  border: 2rpx solid rgba(255, 122, 0, 0.18);
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.message-card {
  position: relative;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 58rpx 22rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.065);
}

.message-icon {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ff7900;
  background: #fff1df;
}

.message-icon--cancel::before,
.message-icon--cancel::after {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 25rpx;
  width: 21rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.message-icon--cancel::before {
  transform: rotate(45deg);
}

.message-icon--cancel::after {
  transform: rotate(-45deg);
}

.message-icon--order::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 12rpx;
  width: 23rpx;
  height: 30rpx;
  border-radius: 7rpx;
  background: currentColor;
}

.message-icon--order::after {
  content: "";
  position: absolute;
  left: 23rpx;
  top: 21rpx;
  width: 11rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 0 #ffffff;
}

.message-icon--paid::before,
.message-icon--finish::before {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 12rpx;
  width: 18rpx;
  height: 28rpx;
  border-right: 6rpx solid currentColor;
  border-bottom: 6rpx solid currentColor;
  transform: rotate(42deg);
}

.message-icon--finish::before {
  left: 18rpx;
  top: 13rpx;
  width: 16rpx;
  height: 25rpx;
}

.message-icon--start::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 16rpx;
  border-left: 20rpx solid currentColor;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
}

.message-icon--car::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 23rpx;
  width: 32rpx;
  height: 17rpx;
  border-radius: 10rpx 12rpx 6rpx 6rpx;
  border: 4rpx solid currentColor;
}

.message-icon--car::after {
  content: "";
  position: absolute;
  left: 18rpx;
  bottom: 12rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 16rpx 0 0 currentColor, 6rpx -21rpx 0 -1rpx currentColor;
}

.message-icon--driver::before,
.message-icon--driver::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.message-icon--driver::before {
  left: 20rpx;
  top: 12rpx;
  width: 15rpx;
  height: 15rpx;
}

.message-icon--driver::after {
  left: 14rpx;
  bottom: 12rpx;
  width: 27rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
}

.message-icon--notice::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 14rpx;
  width: 25rpx;
  height: 25rpx;
  border-radius: 50%;
  border: 5rpx solid currentColor;
}

.message-icon--notice::after {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 24rpx;
  width: 5rpx;
  height: 13rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.message-card__main {
  flex: 1;
  min-width: 0;
}

.message-card__title {
  color: #111827;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-card__content {
  margin-top: 10rpx;
  color: #222733;
  font-size: 23rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-card__time {
  margin-top: 10rpx;
  color: #8b94a7;
  font-size: 22rpx;
}

.message-card__dot {
  position: absolute;
  left: 62rpx;
  top: 22rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff5b57;
  box-shadow: 0 0 0 5rpx #ffffff;
}

.message-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid rgba(31, 36, 50, 0.46);
  border-right: 4rpx solid rgba(31, 36, 50, 0.46);
  transform: translateY(-50%) rotate(45deg);
}

.message-empty {
  min-height: 300rpx;
  padding: 60rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.065);
  text-align: center;
  color: #8a94a8;
}

.message-empty__mark {
  margin: 0 auto 20rpx;
}

.message-empty__title {
  color: #1f2432;
  font-size: 27rpx;
  font-weight: 700;
}

.message-empty__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
