.driver-message-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.driver-message-hero {
  background:
    linear-gradient(135deg, rgba(255, 244, 232, 0.98) 0%, rgba(255, 255, 255, 0.98) 58%),
    #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.055);
}

.driver-message-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.driver-message-count {
  flex-shrink: 0;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.message-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 50, 0.05);
}

.message-card__main {
  flex: 1;
  min-width: 0;
}

.message-card__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.message-card__title {
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1f2432;
}

.message-card__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.message-card__content {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #6f7b90;
}

.message-card__time {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a0a8b8;
}

.message-card__tag {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #ff7a00;
  background: #fff2de;
}

.message-empty {
  padding: 64rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 50, 0.05);
  text-align: center;
  color: #8a94a8;
}

.message-empty__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.message-empty__desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.55;
}


