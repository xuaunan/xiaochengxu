.driver-message-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 32%, #f5f7fb 100%);
}

.driver-message-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 24rpx;
}

.driver-message-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 8rpx 2rpx;
}

.driver-message-title {
  color: #172033;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.15;
}

.driver-message-subtitle {
  margin-top: 8rpx;
  color: #8a94a8;
  font-size: 23rpx;
}

.driver-message-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.driver-message-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.driver-message-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
}

.driver-message-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 180rpx;
  height: 90rpx;
  background: radial-gradient(circle at 0 0, rgba(255, 122, 0, 0.08), transparent 70%);
}

.driver-message-card__head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.driver-message-card__badge {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow: 0 0 0 8rpx rgba(255, 122, 0, 0.08);
}

.driver-message-card__title {
  flex: 1;
  min-width: 0;
  color: #1f2432;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-message-card__dot {
  width: 11rpx;
  height: 11rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #ff5b57;
}

.driver-message-card__tag {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: #fff2de;
  font-size: 20rpx;
  font-weight: 800;
}

.driver-message-card__content {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: #6f7b90;
  font-size: 24rpx;
  line-height: 1.55;
}

.driver-message-card__time {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: #a0a8b8;
  font-size: 21rpx;
}

.driver-message-empty {
  min-height: 360rpx;
  padding: 78rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
  text-align: center;
  color: #8a94a8;
}

.driver-message-empty__mark {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  margin: 0 auto 20rpx;
  border-radius: 22rpx;
  color: #ff7a00;
  background: #fff1df;
}

.driver-message-empty__mark::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 18rpx;
  width: 36rpx;
  height: 25rpx;
  border-radius: 8rpx;
  background: currentColor;
}

.driver-message-empty__mark::after {
  content: "";
  position: absolute;
  left: 23rpx;
  top: 29rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 9rpx 0 0 #ffffff, 18rpx 0 0 #ffffff;
}

.driver-message-empty__title {
  color: #1f2432;
  font-size: 30rpx;
  font-weight: 900;
}

.driver-message-empty__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
