.message-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 190, 107, 0.24), transparent 30%),
    radial-gradient(circle at 0% 18%, rgba(47, 114, 219, 0.08), transparent 28%),
    linear-gradient(180deg, #fff5e9 0%, #f7f8fc 34%, #f4f6fb 100%);
}

.message-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 18rpx 36rpx 44rpx;
}

.message-hero {
  position: relative;
  min-height: 106rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 250, 244, 0.96) 58%, rgba(255, 233, 209, 0.66) 100%),
    #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(210, 104, 18, 0.07);
}

.message-hero::after {
  content: "";
  position: absolute;
  right: -34rpx;
  bottom: -48rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 122, 0, 0.08);
}

.message-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.message-hero__title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.15;
}

.message-hero__desc {
  margin-top: 8rpx;
  color: #5f6676;
  font-size: 21rpx;
  line-height: 1.35;
}

.message-bell {
  position: absolute;
  right: 128rpx;
  top: 30rpx;
  width: 54rpx;
  height: 52rpx;
  transform: rotate(-12deg);
  opacity: 0.48;
}

.message-bell__body {
  position: absolute;
  left: 11rpx;
  top: 9rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 26rpx 26rpx 14rpx 14rpx;
  background: linear-gradient(145deg, #ffd9b5 0%, #ff8a16 100%);
  box-shadow: 0 16rpx 28rpx rgba(255, 122, 0, 0.16);
}

.message-bell__body::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: -7rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff9b32;
}

.message-bell__body::after {
  content: "";
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  bottom: -4rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffc796 0%, #ff7900 100%);
}

.message-bell__clapper {
  position: absolute;
  left: 28rpx;
  bottom: 5rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.message-count {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  min-width: 82rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 250, 244, 0.8);
  border: 2rpx solid rgba(255, 122, 0, 0.18);
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.message-card {
  position: relative;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 18rpx 50rpx 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
}

.message-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 5rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.42);
}

.message-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ff7900;
  background: linear-gradient(180deg, #fff4e7, #ffe8d1);
  box-sizing: border-box;
}

.message-icon--paid,
.message-icon--finish {
  color: #18a76f;
  background: linear-gradient(180deg, #eafff5, #d8f7e8);
}

.message-icon--start,
.message-icon--car,
.message-icon--driver {
  color: #2f72db;
  background: linear-gradient(180deg, #edf5ff, #ddeaff);
}

.message-icon--cancel::before,
.message-icon--cancel::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.message-icon--cancel::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.message-icon--cancel::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.message-icon--order::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 29rpx;
  border-radius: 7rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.message-icon--order::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 11rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 0 #ffffff;
  transform: translate(-50%, -106%);
}

.message-icon--paid::before,
.message-icon--finish::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 15rpx;
  height: 26rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-35%, -58%) rotate(42deg);
  transform-origin: center;
}

.message-icon--finish::before {
  width: 14rpx;
  height: 24rpx;
}

.message-icon--start::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  border-left: 18rpx solid currentColor;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  transform: translate(-34%, -50%);
}

.message-icon--car::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 31rpx;
  height: 17rpx;
  border-radius: 10rpx 12rpx 6rpx 6rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -12%);
}

.message-icon--car::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 15rpx 0 0 currentColor, 6rpx -20rpx 0 -1rpx currentColor;
  transform: translate(-168%, 74%);
}

.message-icon--driver::before,
.message-icon--driver::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.message-icon--driver::before {
  left: 50%;
  top: 50%;
  width: 15rpx;
  height: 15rpx;
  transform: translate(-50%, -86%);
}

.message-icon--driver::after {
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
  transform: translate(-50%, 16%);
}

.message-icon--notice::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 25rpx;
  height: 25rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.message-icon--notice::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 4rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -22%);
}

.message-card__main {
  flex: 1;
  min-width: 0;
}

.message-card__title {
  color: #111827;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-card__content {
  margin-top: 7rpx;
  color: #222733;
  font-size: 21rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-card__time {
  margin-top: 7rpx;
  color: #8b94a7;
  font-size: 20rpx;
}

.message-card__dot {
  position: absolute;
  left: 58rpx;
  top: 20rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff5b57;
  box-shadow: 0 0 0 5rpx #ffffff;
}

.message-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid rgba(31, 36, 50, 0.46);
  border-right: 4rpx solid rgba(31, 36, 50, 0.46);
  transform: translateY(-50%) rotate(45deg);
}

.message-empty {
  min-height: 240rpx;
  padding: 42rpx 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
  text-align: center;
  color: #8a94a8;
}

.message-empty__mark {
  margin: 0 auto 20rpx;
}

.message-empty__title {
  color: #1f2432;
  font-size: 24rpx;
  font-weight: 500;
}

.message-empty__desc {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.55;
}

.pressable-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
