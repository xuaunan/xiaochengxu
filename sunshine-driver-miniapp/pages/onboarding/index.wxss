.vehicle-field-icon--card::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.vehicle-field-icon--card::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 13rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 7rpx 0 currentColor;
  transform: translate(-12%, -95%);
}

.vehicle-field-icon--plate::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.vehicle-field-icon--plate::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.vehicle-field-icon--brand::before,
.vehicle-field-icon--car::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 15rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx 8rpx 5rpx 5rpx;
  box-sizing: border-box;
  transform: translate(-50%, -14%);
}

.vehicle-field-icon--brand::after,
.vehicle-field-icon--car::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 13rpx 0 0 currentColor, 5rpx -15rpx 0 -1rpx currentColor;
  transform: translate(-160%, 92%);
}

.vehicle-field-icon--color::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
