.onboarding-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 86% 4%, rgba(255, 184, 98, 0.24), transparent 30%),
    radial-gradient(circle at 0% 18%, rgba(47, 114, 219, 0.08), transparent 28%),
    linear-gradient(180deg, #fff5e9 0%, #f7f8fc 34%, #f4f6fb 100%);
}

.driver-landing {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 22rpx 34rpx calc(env(safe-area-inset-bottom) + 34rpx);
}

.auth-hero {
  position: relative;
  min-height: 222rpx;
  overflow: hidden;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 86% 22%, rgba(255, 186, 108, 0.22), transparent 28%),
    linear-gradient(126deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 248, 239, 0.96) 56%, rgba(255, 225, 188, 0.82) 100%),
    #ffffff;
  border: 1rpx solid rgba(255, 151, 55, 0.2);
  box-shadow: 0 16rpx 38rpx rgba(211, 111, 21, 0.1);
}

.auth-hero::after {
  content: "";
  position: absolute;
  left: 270rpx;
  right: -86rpx;
  bottom: 50rpx;
  height: 72rpx;
  border-top: 8rpx solid rgba(255, 255, 255, 0.92);
  transform: rotate(-8deg);
}

.auth-copy {
  position: relative;
  z-index: 2;
  width: 420rpx;
}

.auth-kicker {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #b45605;
  background: rgba(255, 122, 0, 0.1);
  font-size: 20rpx;
  font-weight: 550;
}

.auth-title {
  margin-top: 16rpx;
  color: #172033;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.16;
}

.auth-desc {
  width: 390rpx;
  margin-top: 12rpx;
  color: #5a6577;
  font-size: 21rpx;
  line-height: 1.5;
}

.auth-flow {
  display: flex;
  align-items: center;
  width: 390rpx;
  margin-top: 20rpx;
}

.auth-flow__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.auth-flow__item--active {
  color: #ff6f00;
}

.auth-flow__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #c6ced9;
  font-size: 18rpx;
  font-weight: 600;
}

.auth-flow__item--active .auth-flow__dot {
  background: linear-gradient(135deg, #ff8a18 0%, #ff6f00 100%);
}

.auth-flow__line {
  flex: 1;
  height: 2rpx;
  margin: 0 10rpx;
  background: rgba(102, 112, 133, 0.18);
}

.auth-vehicle {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 2;
  width: 196rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  box-shadow: 0 18rpx 36rpx rgba(184, 91, 11, 0.13);
}

.auth-vehicle__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.auth-vehicle__mark {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ff9d32 0%, #ff6f00 100%);
}

.auth-vehicle__mark::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 13rpx;
  height: 24rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: translate(-28%, -56%) rotate(42deg);
}

.auth-vehicle__lines {
  flex: 1;
}

.auth-vehicle__lines view {
  height: 10rpx;
  border-radius: 999rpx;
  background: #eef1f6;
}

.auth-vehicle__lines view + view {
  width: 68rpx;
  margin-top: 10rpx;
}

.auth-vehicle__plate {
  margin-top: 20rpx;
  color: #172033;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
}

.auth-vehicle__status {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #8a5a12;
  background: rgba(255, 176, 32, 0.15);
  font-size: 19rpx;
  font-weight: 550;
}

.login-card {
  position: relative;
  z-index: 4;
  padding: 26rpx 28rpx 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 16rpx 38rpx rgba(24, 34, 56, 0.07);
}

.login-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.login-eyebrow {
  color: #ff6f00;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
}

.login-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.25;
}

.login-badge {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #4f5a6d;
  background: #f4f6fa;
  font-size: 20rpx;
  font-weight: 500;
}

.login-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.5;
}

.mode-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  height: 60rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #f1f4f8;
  border: 1rpx solid rgba(31, 36, 50, 0.07);
  padding: 4rpx;
}

.mode-item {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #172033;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.mode-item--active {
  color: #ff6f00;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 0, 0.1);
  font-weight: 500;
}

.input-wrap {
  position: relative;
  min-height: 70rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  border-radius: 18rpx;
  background: #fbfcff;
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
}

.driver-input,
.vehicle-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  min-height: 68rpx;
  padding: 0 24rpx 0 0;
  color: #172033;
  background: transparent;
  border: none;
  font-size: 23rpx;
  line-height: 68rpx;
}

.input-icon {
  position: relative;
  width: 74rpx;
  height: 70rpx;
  flex-shrink: 0;
  color: #7b8494;
  box-sizing: border-box;
}

.input-icon--phone::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 17rpx;
  height: 32rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.input-icon--lock::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: currentColor;
  transform: translate(-50%, 6%);
}

.input-icon--lock::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 17rpx;
  height: 19rpx;
  border-radius: 11rpx 11rpx 2rpx 2rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  box-sizing: border-box;
  transform: translate(-50%, -72%);
}

.input-icon--user::before,
.input-icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.input-icon--user::before {
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  transform: translate(-50%, -78%);
}

.input-icon--user::after {
  left: 50%;
  top: 50%;
  width: 31rpx;
  height: 18rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
  transform: translate(-50%, 14%);
}

.input-clear {
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #a4acb8;
  font-size: 28rpx;
  font-weight: 600;
}

.input-eye {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  color: #6b7280;
}

.input-eye::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.input-eye::after {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 8rpx;
  width: 5rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(-45deg);
}

.input-eye--open::after {
  display: none;
}

.forgot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.forgot {
  color: #667085;
  font-size: 22rpx;
}

.driver-login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  min-height: 74rpx;
  margin: 26rpx auto 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9d32 100%);
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 0, 0.22);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
  box-sizing: border-box;
}

.driver-login-button::after {
  border: none;
}

.login-note {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 15rpx 18rpx;
  border-radius: 18rpx;
  color: #7a8396;
  background: #f8fafc;
  font-size: 21rpx;
  line-height: 1.35;
}

.login-note__line {
  display: none;
}

.login-note__icon {
  position: relative;
  width: 28rpx;
  height: 30rpx;
  border-radius: 10rpx 10rpx 15rpx 15rpx;
  border: 3rpx solid #ff7a00;
}

.login-note__icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 14rpx;
  border-right: 3rpx solid #ff7a00;
  border-bottom: 3rpx solid #ff7a00;
  box-sizing: border-box;
  transform: translate(-22%, -54%) rotate(42deg);
  transform-origin: center;
}

.driver-guide {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
}

.driver-guide__title {
  color: #172033;
  font-size: 24rpx;
  font-weight: 500;
}

.driver-guide__row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 12rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.48;
}

.driver-guide__dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #ff8a18;
  flex-shrink: 0;
}

.vehicle-page {
  padding: 22rpx 36rpx 154rpx;
}

.vehicle-card,
.vehicle-form {
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.052);
}

.vehicle-form {
  margin-top: 18rpx;
}

.row-between {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 550;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.6;
}

.status-chip {
  flex-shrink: 0;
  min-width: 88rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 500;
}

.status-chip.pending {
  color: #c77614;
  background: rgba(255, 153, 0, 0.16);
}

.status-chip.success {
  color: #1d8f56;
  background: rgba(34, 197, 94, 0.16);
}

.status-chip.danger {
  color: #d14343;
  background: rgba(239, 68, 68, 0.16);
}

.status-chip.neutral,
.status-chip.disabled {
  color: #66788a;
  background: rgba(148, 163, 184, 0.18);
}

.summary-card {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 17rpx;
  background: #fff8f0;
  border: 1rpx solid rgba(255, 122, 0, 0.14);
}

.summary-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.summary-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 500;
}

.summary-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
}

.summary-right {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: #fff1df;
  font-size: 20rpx;
  font-weight: 500;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.summary-item {
  padding: 12rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.summary-label {
  color: #667085;
  font-size: 19rpx;
}

.summary-value {
  margin-top: 8rpx;
  color: #172033;
  font-size: 21rpx;
  font-weight: 500;
}

.empty-vehicle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0 10rpx;
  text-align: center;
}

.empty-vehicle-image {
  width: 220rpx;
  height: 180rpx;
}

.empty-vehicle-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 500;
}

.empty-vehicle-desc {
  color: #667085;
  font-size: 21rpx;
  line-height: 1.55;
}

.lock-card {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8f0;
  border: 1rpx dashed rgba(255, 122, 0, 0.26);
}

.lock-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 600;
}

.lock-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.7;
}

.vehicle-input {
  width: 100%;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 15rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  box-sizing: border-box;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.upload-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.upload-title {
  color: #172033;
  font-size: 22rpx;
  font-weight: 550;
}

.upload-preview,
.upload-placeholder {
  width: 100%;
  height: 176rpx;
  border-radius: 16rpx;
}

.upload-preview {
  background: #ffffff;
}

.upload-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  color: #98a2b3;
  background: #ffffff;
  border: 1rpx dashed rgba(152, 162, 179, 0.5);
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
}

.floating-actions {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  z-index: 30;
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 12rpx;
}

.vehicle-reference-page {
  padding: 22rpx 36rpx 142rpx;
}

.vehicle-reference-card {
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background:
    linear-gradient(125deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 248, 239, 0.96) 56%, rgba(255, 236, 214, 0.68) 100%),
    #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(24, 34, 56, 0.06);
}

.vehicle-reference-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.vehicle-reference-copy {
  flex: 1;
  min-width: 0;
}

.vehicle-reference-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.12;
}

.vehicle-reference-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.55;
}

.vehicle-summary-box {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, rgba(255, 250, 244, 0.98) 0%, rgba(255, 244, 232, 0.78) 100%),
    #fff8f0;
  border: 1rpx solid rgba(255, 122, 0, 0.16);
}

.vehicle-summary-box .summary-title,
.vehicle-summary-box .summary-subtitle {
  font-weight: 700;
}

.summary-grid--reference {
  gap: 12rpx;
}

.summary-grid--reference .summary-item {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
}

.summary-icon,
.vehicle-field-icon {
  position: relative;
  flex-shrink: 0;
  color: #ff6f00;
  box-sizing: border-box;
}

.summary-icon {
  width: 42rpx;
  height: 42rpx;
}

.summary-icon--seat::before,
.vehicle-field-icon--seat::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx 5rpx 10rpx 10rpx;
  box-sizing: border-box;
  transform: translate(-50%, -33%);
}

.summary-icon--seat::after,
.vehicle-field-icon--seat::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 22rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  border-radius: 0 0 0 7rpx;
  box-sizing: border-box;
  transform: translate(-82%, -62%);
}

.summary-icon--shield::before,
.vehicle-field-icon--shield::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
  border-radius: 9rpx 9rpx 14rpx 14rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.summary-icon--shield::after,
.vehicle-field-icon--shield::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 14rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-22%, -48%) rotate(42deg);
  transform-origin: center;
}

.summary-icon--calendar::before,
.vehicle-field-icon--calendar::before,
.calendar-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.summary-icon--calendar::after,
.vehicle-field-icon--calendar::after,
.calendar-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 7rpx 0 currentColor;
  transform: translate(-50%, -8%);
}

.permission-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(255, 122, 0, 0.14);
}

.permission-icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border-radius: 15rpx;
  background: linear-gradient(135deg, #ff9d32 0%, #ff6f00 100%);
}

.permission-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 22rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
