.onboarding-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 42%, #f5f7fb 100%);
}

.driver-landing {
  min-height: 100vh;
  padding: 34rpx 30rpx calc(env(safe-area-inset-bottom) + 38rpx);
}

.driver-hero {
  position: relative;
  height: 338rpx;
  overflow: hidden;
  border-radius: 34rpx 34rpx 0 0;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.74) 0%, rgba(255, 245, 230, 0.82) 100%),
    #fff4e7;
}

.brand-block {
  position: absolute;
  left: 56rpx;
  top: 86rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.brand-shield {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx 18rpx 26rpx 26rpx;
  background: linear-gradient(135deg, #ff8b18 0%, #ff6f00 100%);
}

.brand-shield::after {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 14rpx;
  width: 15rpx;
  height: 28rpx;
  border-right: 8rpx solid #ffffff;
  border-bottom: 8rpx solid #ffffff;
  transform: rotate(42deg);
}

.brand-title {
  color: #ff6f00;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: 3rpx;
}

.brand-subtitle {
  margin-top: 18rpx;
  color: #3a312d;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 16rpx;
}

.hero-city,
.hero-road,
.hero-car,
.hero-sun {
  pointer-events: none;
}

.hero-city {
  position: absolute;
  right: 18rpx;
  bottom: 68rpx;
  width: 360rpx;
  height: 190rpx;
  opacity: 0.28;
}

.hero-building {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: #ff9b3d;
}

.hero-building--1 {
  left: 20rpx;
  height: 82rpx;
}

.hero-building--2 {
  left: 100rpx;
  height: 132rpx;
}

.hero-building--3 {
  left: 184rpx;
  height: 102rpx;
}

.hero-building--4 {
  left: 276rpx;
  height: 166rpx;
}

.hero-sun {
  position: absolute;
  right: 246rpx;
  top: 68rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffe7a8, #ffba4a);
  opacity: 0.8;
}

.hero-road {
  position: absolute;
  left: 160rpx;
  right: -80rpx;
  bottom: 24rpx;
  height: 108rpx;
  border-top: 8rpx solid rgba(255, 255, 255, 0.9);
  transform: rotate(-8deg);
}

.hero-road::after {
  content: "";
  position: absolute;
  right: 110rpx;
  top: 34rpx;
  width: 250rpx;
  border-top: 5rpx dashed rgba(255, 255, 255, 0.94);
}

.hero-car {
  position: absolute;
  right: 74rpx;
  bottom: 52rpx;
  width: 224rpx;
  height: 120rpx;
  z-index: 3;
  filter: drop-shadow(0 16rpx 22rpx rgba(151, 78, 15, 0.2));
}

.hero-car__body {
  position: absolute;
  left: 10rpx;
  bottom: 26rpx;
  width: 200rpx;
  height: 70rpx;
  border-radius: 30rpx 40rpx 22rpx 22rpx;
  background: linear-gradient(180deg, #ffb03f 0%, #ff7a00 82%);
  border: 3rpx solid rgba(119, 65, 13, 0.18);
}

.hero-car__top {
  position: absolute;
  left: 76rpx;
  top: 22rpx;
  width: 82rpx;
  height: 54rpx;
  border-radius: 34rpx 34rpx 8rpx 8rpx;
  background: linear-gradient(180deg, #fff5e7 0%, #ff9d32 76%);
  border: 3rpx solid rgba(119, 65, 13, 0.14);
}

.hero-car__sign {
  position: absolute;
  left: 102rpx;
  top: 4rpx;
  padding: 5rpx 12rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  color: #ffffff;
  background: #ff7a00;
  font-size: 16rpx;
  font-weight: 900;
}

.hero-car__wheel {
  position: absolute;
  bottom: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #2e3035;
  box-shadow: inset 0 0 0 11rpx #ffffff, inset 0 0 0 16rpx #88909c;
}

.hero-car__wheel--left {
  left: 44rpx;
}

.hero-car__wheel--right {
  right: 40rpx;
}

.login-card {
  position: relative;
  z-index: 4;
  margin-top: -8rpx;
  padding: 38rpx 36rpx 36rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 22rpx 50rpx rgba(24, 34, 56, 0.08);
}

.login-title {
  color: #172033;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.2;
}

.login-desc {
  margin-top: 20rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.default-account {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 28rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff8ef 0%, #fff1df 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.24);
}

.default-icon {
  position: relative;
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
  border-radius: 18rpx 18rpx 28rpx 28rpx;
  background: linear-gradient(135deg, #ffac4b 0%, #ff7a00 100%);
  box-shadow: 0 12rpx 22rpx rgba(255, 122, 0, 0.18);
}

.default-icon::before,
.default-icon::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: #ffffff;
}

.default-icon::before {
  left: 26rpx;
  top: 16rpx;
  width: 18rpx;
  height: 18rpx;
}

.default-icon::after {
  left: 18rpx;
  bottom: 14rpx;
  width: 34rpx;
  height: 20rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
}

.default-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.default-line {
  margin-top: 8rpx;
  color: #566176;
  font-size: 25rpx;
  line-height: 1.25;
}

.mode-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  height: 72rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid rgba(31, 36, 50, 0.08);
  overflow: hidden;
}

.mode-item {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #172033;
  font-size: 29rpx;
  font-weight: 900;
}

.mode-item--active {
  color: #ff6f00;
  background: #fff4e8;
  border: 2rpx solid rgba(255, 122, 0, 0.46);
  border-radius: 999rpx;
}

.input-wrap {
  position: relative;
  min-height: 78rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  border-radius: 18rpx;
  background: #ffffff;
  border: 2rpx solid rgba(31, 36, 50, 0.09);
}

.driver-input,
.vehicle-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  min-height: 78rpx;
  padding: 0 20rpx 0 0;
  color: #172033;
  background: transparent;
  border: none;
  font-size: 31rpx;
  line-height: 78rpx;
}

.input-icon {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  flex-shrink: 0;
  color: #6b7280;
}

.input-icon--phone::before {
  content: "";
  position: absolute;
  left: 30rpx;
  top: 20rpx;
  width: 19rpx;
  height: 36rpx;
  border: 5rpx solid currentColor;
  border-radius: 6rpx;
}

.input-icon--lock::before {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 36rpx;
  width: 28rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: currentColor;
}

.input-icon--lock::after {
  content: "";
  position: absolute;
  left: 31rpx;
  top: 20rpx;
  width: 18rpx;
  height: 20rpx;
  border-radius: 11rpx 11rpx 2rpx 2rpx;
  border: 5rpx solid currentColor;
  border-bottom: none;
}

.input-icon--user::before,
.input-icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.input-icon--user::before {
  left: 30rpx;
  top: 20rpx;
  width: 18rpx;
  height: 18rpx;
}

.input-icon--user::after {
  left: 22rpx;
  bottom: 18rpx;
  width: 34rpx;
  height: 20rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
}

.input-clear {
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #8c929d;
  font-size: 28rpx;
  font-weight: 900;
}

.input-eye {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  color: #6b7280;
}

.input-eye::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 17rpx;
  width: 34rpx;
  height: 22rpx;
  border: 5rpx solid currentColor;
  border-radius: 50%;
}

.input-eye::after {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 8rpx;
  width: 5rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(-45deg);
}

.input-eye--open::after {
  display: none;
}

.forgot-row {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.forgot {
  color: #667085;
  font-size: 25rpx;
}

.driver-login-button {
  width: 100%;
  min-height: 94rpx;
  margin-top: 32rpx;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9d32 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.25);
  font-size: 32rpx;
  font-weight: 900;
}

.driver-login-button::after {
  border: none;
}

.login-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 34rpx;
  color: #7a8396;
  font-size: 23rpx;
}

.login-note__line {
  flex: 1;
  height: 1rpx;
  background: rgba(31, 36, 50, 0.12);
}

.login-note__icon {
  position: relative;
  width: 28rpx;
  height: 30rpx;
  border-radius: 10rpx 10rpx 15rpx 15rpx;
  border: 3rpx solid #ff7a00;
}

.login-note__icon::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 5rpx;
  width: 7rpx;
  height: 14rpx;
  border-right: 4rpx solid #ff7a00;
  border-bottom: 4rpx solid #ff7a00;
  transform: rotate(42deg);
}

.vehicle-page {
  padding: 28rpx 24rpx 180rpx;
}

.vehicle-card,
.vehicle-form {
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 16rpx 38rpx rgba(24, 34, 56, 0.06);
}

.vehicle-form {
  margin-top: 22rpx;
}

.row-between {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 35rpx;
  font-weight: 900;
}

.section-subtitle {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.status-chip {
  flex-shrink: 0;
  min-width: 120rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
}

.status-chip.pending {
  color: #c77614;
  background: rgba(255, 153, 0, 0.16);
}

.status-chip.success {
  color: #1d8f56;
  background: rgba(34, 197, 94, 0.16);
}

.status-chip.danger {
  color: #d14343;
  background: rgba(239, 68, 68, 0.16);
}

.status-chip.neutral,
.status-chip.disabled {
  color: #66788a;
  background: rgba(148, 163, 184, 0.18);
}

.summary-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff8f0;
  border: 1rpx solid rgba(255, 122, 0, 0.14);
}

.summary-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.summary-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
}

.summary-subtitle {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
}

.summary-right {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: #fff1df;
  font-size: 24rpx;
  font-weight: 900;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.summary-item {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.summary-label {
  color: #667085;
  font-size: 22rpx;
}

.summary-value {
  margin-top: 8rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.empty-vehicle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0 10rpx;
  text-align: center;
}

.empty-vehicle-image {
  width: 220rpx;
  height: 180rpx;
}

.empty-vehicle-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-vehicle-desc {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.7;
}

.lock-card {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8f0;
  border: 1rpx dashed rgba(255, 122, 0, 0.26);
}

.lock-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.lock-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.7;
}

.vehicle-input {
  width: 100%;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  box-sizing: border-box;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.upload-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.upload-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.upload-preview,
.upload-placeholder {
  width: 100%;
  height: 220rpx;
  border-radius: 22rpx;
}

.upload-preview {
  background: #ffffff;
}

.upload-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  color: #98a2b3;
  background: #ffffff;
  border: 1rpx dashed rgba(152, 162, 179, 0.5);
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
}

.floating-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 30;
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 16rpx;
}

.pressable-hover,
.tap-scale:active,
.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
