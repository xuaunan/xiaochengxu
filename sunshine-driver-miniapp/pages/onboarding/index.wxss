.driver-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f7f8fc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  font-size: 28rpx;
  line-height: 76rpx;
  color: #1f2432;
}

.page-content {
  padding-bottom: calc(env(safe-area-inset-bottom) + 176rpx);
}

.tip-board {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff1df, #fff7ef);
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.tip-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7385;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.status-chip.pending {
  color: #c77614;
  background: rgba(255, 153, 0, 0.16);
}

.status-chip.success {
  color: #1d8f56;
  background: rgba(34, 197, 94, 0.16);
}

.status-chip.danger {
  color: #d14343;
  background: rgba(239, 68, 68, 0.16);
}

.status-chip.neutral,
.status-chip.disabled {
  color: #66788a;
  background: rgba(148, 163, 184, 0.18);
}

.summary-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(255, 247, 239, 0.9), rgba(255, 255, 255, 1));
}

.summary-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.summary-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2432;
}

.summary-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7385;
}

.summary-right {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff7a00;
  background: #fff1df;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.summary-item {
  padding: 18rpx;
  border-radius: 22rpx;
  background: #ffffff;
}

.summary-label {
  font-size: 22rpx;
  color: #6b7385;
}

.summary-value {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2432;
}

.empty-vehicle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0 8rpx;
  text-align: center;
}

.empty-vehicle-image {
  width: 220rpx;
  height: 180rpx;
}

.empty-vehicle-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
}

.empty-vehicle-desc {
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7385;
}

.lock-card {
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8f0;
  border: 1rpx dashed rgba(255, 122, 0, 0.26);
}

.lock-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.lock-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7385;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.upload-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f7f8fc;
}

.upload-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2432;
}

.upload-preview,
.upload-placeholder {
  width: 100%;
  height: 220rpx;
  border-radius: 22rpx;
}

.upload-preview {
  background: #ffffff;
}

.upload-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: #98a2b3;
  background: #ffffff;
  border: 1rpx dashed rgba(152, 162, 179, 0.5);
}

.floating-actions {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 16rpx;
}
