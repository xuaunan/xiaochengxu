.driver-settings {
  margin-top: 18rpx;
}

.driver-settings-hero {
  background:
    linear-gradient(135deg, rgba(255, 244, 232, 0.98) 0%, rgba(255, 255, 255, 0.98) 58%),
    #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.055);
}

.setting-row {
  gap: 24rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.setting-row > view:first-child {
  flex: 1;
  min-width: 0;
}

.driver-settings .panel-card {
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.voice-style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.track-mode-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.track-mode-chip {
  min-width: 0;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 2rpx solid transparent;
}

.track-mode-chip--active {
  background: rgba(255, 122, 0, 0.12);
  border-color: rgba(255, 122, 0, 0.34);
}

.track-mode-chip__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.track-mode-chip__desc {
  margin-top: 10rpx;
  color: #7a8396;
  font-size: 22rpx;
  line-height: 1.35;
}

.voice-style-chip {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #556074;
  font-size: 24rpx;
  line-height: 1;
}

.voice-style-chip--active {
  background: rgba(255, 122, 0, 0.14);
  color: #ff7a00;
  font-weight: 600;
}

.voice-style-current {
  margin-top: 22rpx;
  color: #7a8396;
  font-size: 24rpx;
}

.voice-preview-btn {
  min-width: 112rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9d2f 0%, #ff7a00 100%);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}


