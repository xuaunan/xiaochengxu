.driver-settings-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.driver-settings-page {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 14rpx;
}

.driver-settings-hero {
  position: relative;
  min-height: 104rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.22);
  background:
    linear-gradient(112deg, rgba(255, 250, 244, 0.98) 0%, rgba(255, 247, 238, 0.92) 56%, rgba(255, 226, 190, 0.54) 100%),
    #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(210, 104, 18, 0.08);
}

.settings-hero__icon {
  position: relative;
  z-index: 2;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 17rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9d32 0%, #ff6f00 100%);
  box-shadow: 0 10rpx 20rpx rgba(255, 111, 0, 0.16);
  box-sizing: border-box;
}

.settings-hero__icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.settings-hero__icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 4rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: translate(-50%, -50%) rotate(45deg);
}

.settings-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.settings-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.18;
}

.settings-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.35;
}

.settings-hero__badge {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 122, 0, 0.38);
  font-size: 20rpx;
  font-weight: 500;
}

.settings-city {
  position: absolute;
  right: 72rpx;
  bottom: 16rpx;
  width: 190rpx;
  height: 92rpx;
  opacity: 0.18;
}

.settings-building {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.settings-building--1 {
  left: 18rpx;
  height: 58rpx;
}

.settings-building--2 {
  left: 72rpx;
  height: 86rpx;
}

.settings-building--3 {
  left: 130rpx;
  height: 64rpx;
}

.settings-section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.settings-section-title {
  position: relative;
  padding-left: 14rpx;
  color: #172033;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.25;
}

.settings-section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 5rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.settings-card,
.settings-panel,
.settings-preview-card {
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.055);
}

.settings-card {
  overflow: hidden;
  padding: 0 18rpx;
}

.setting-row,
.settings-preview-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.setting-row {
  min-height: 82rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  border-radius: 13rpx;
  color: #ff6f00;
  background: #fff1df;
  box-sizing: border-box;
}

.setting-icon--listen::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.setting-icon--listen::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 21rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-16%, -50%);
}

.setting-icon--auto::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 27rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.setting-icon--auto::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 26rpx 0 currentColor, 13rpx 13rpx 0 -1rpx currentColor, -13rpx 13rpx 0 -1rpx currentColor;
  transform: translate(-50%, -128%);
}

.setting-icon--voice,
.setting-icon--preview {
  color: #2f72db;
  background: #edf5ff;
}

.setting-icon--voice::before,
.setting-icon--preview::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
  background: currentColor;
  transform: translate(-58%, -14%);
}

.setting-icon--voice::after,
.setting-icon--preview::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 28rpx;
  border-radius: 50%;
  border-right: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-10%, -50%);
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-title {
  color: #172033;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.18;
}

.setting-desc,
.panel-desc {
  color: #737d90;
  font-size: 20rpx;
  line-height: 1.45;
}

.setting-desc {
  margin-top: 5rpx;
}

.settings-panel {
  padding: 18rpx;
}

.track-mode-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.track-mode-chip {
  min-width: 0;
  display: flex;
  gap: 10rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: #fbfcfe;
  border: 2rpx solid rgba(31, 36, 50, 0.06);
}

.track-mode-chip--active {
  background: #fff3e7;
  border-color: rgba(255, 122, 0, 0.38);
}

.track-mode-radio {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 3rpx solid rgba(139, 148, 167, 0.34);
  background: #ffffff;
}

.track-mode-chip--active .track-mode-radio {
  border-color: #ff7a00;
}

.track-mode-chip--active .track-mode-radio::after {
  content: "";
  position: absolute;
  inset: 6rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.track-mode-copy {
  min-width: 0;
}

.track-mode-chip__title {
  color: #172033;
  font-size: 23rpx;
  font-weight: 600;
}

.track-mode-chip__desc {
  margin-top: 6rpx;
  color: #7a8396;
  font-size: 20rpx;
  line-height: 1.35;
}

.voice-style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.voice-style-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #fbfcfe;
  border: 2rpx solid rgba(31, 36, 50, 0.06);
  color: #556074;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1;
}

.voice-style-chip--active {
  color: #ff6f00;
  background: #fff3e7;
  border-color: rgba(255, 122, 0, 0.36);
}

.settings-current {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  color: #ff6f00;
  background: #fff7ef;
  font-size: 21rpx;
  font-weight: 500;
}

.settings-preview-card {
  min-height: 84rpx;
  padding: 16rpx 18rpx;
}

.voice-preview-btn {
  min-width: 96rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9d2f 0%, #ff7a00 100%);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.18);
}

.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
