.driver-settings-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.driver-settings-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 24rpx;
}

.driver-settings-hero {
  position: relative;
  min-height: 142rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.22);
  background:
    linear-gradient(112deg, rgba(255, 250, 244, 0.98) 0%, rgba(255, 247, 238, 0.92) 56%, rgba(255, 226, 190, 0.54) 100%),
    #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.09);
}

.settings-hero__icon {
  position: relative;
  z-index: 2;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9d32 0%, #ff6f00 100%);
  box-shadow: 0 14rpx 26rpx rgba(255, 111, 0, 0.18);
}

.settings-hero__icon::before {
  content: "";
  position: absolute;
  left: 21rpx;
  top: 21rpx;
  width: 42rpx;
  height: 42rpx;
  border: 8rpx solid #ffffff;
  border-radius: 50%;
}

.settings-hero__icon::after {
  content: "";
  position: absolute;
  left: 37rpx;
  top: 9rpx;
  width: 9rpx;
  height: 66rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: rotate(45deg);
}

.settings-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.settings-title {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.settings-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
}

.settings-hero__badge {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 122, 0, 0.38);
  font-size: 24rpx;
  font-weight: 900;
}

.settings-city {
  position: absolute;
  right: 72rpx;
  bottom: 16rpx;
  width: 190rpx;
  height: 92rpx;
  opacity: 0.18;
}

.settings-building {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.settings-building--1 {
  left: 18rpx;
  height: 58rpx;
}

.settings-building--2 {
  left: 72rpx;
  height: 86rpx;
}

.settings-building--3 {
  left: 130rpx;
  height: 64rpx;
}

.settings-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.settings-section-title {
  position: relative;
  padding-left: 18rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.settings-section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 5rpx;
  width: 7rpx;
  height: 31rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.settings-card,
.settings-panel,
.settings-preview-card {
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 16rpx 38rpx rgba(24, 34, 56, 0.06);
}

.settings-card {
  overflow: hidden;
  padding: 0 26rpx;
}

.setting-row,
.settings-preview-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.setting-row {
  min-height: 124rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-icon {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  border-radius: 19rpx;
  color: #ff6f00;
  background: #fff1df;
}

.setting-icon--listen::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 15rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 6rpx solid currentColor;
}

.setting-icon--listen::after {
  content: "";
  position: absolute;
  left: 28rpx;
  top: 25rpx;
  width: 22rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.setting-icon--auto::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 30rpx;
  height: 30rpx;
  border: 6rpx solid currentColor;
  border-radius: 50%;
}

.setting-icon--auto::after {
  content: "";
  position: absolute;
  left: 27rpx;
  top: 4rpx;
  width: 8rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 36rpx 0 currentColor, 18rpx 18rpx 0 -1rpx currentColor, -18rpx 18rpx 0 -1rpx currentColor;
}

.setting-icon--voice,
.setting-icon--preview {
  color: #2f72db;
  background: #edf5ff;
}

.setting-icon--voice::before,
.setting-icon--preview::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 23rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
  background: currentColor;
}

.setting-icon--voice::after,
.setting-icon--preview::after {
  content: "";
  position: absolute;
  left: 34rpx;
  top: 18rpx;
  width: 16rpx;
  height: 28rpx;
  border-radius: 50%;
  border-right: 5rpx solid currentColor;
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.18;
}

.setting-desc,
.panel-desc {
  color: #737d90;
  font-size: 23rpx;
  line-height: 1.45;
}

.setting-desc {
  margin-top: 9rpx;
}

.settings-panel {
  padding: 26rpx;
}

.track-mode-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.track-mode-chip {
  min-width: 0;
  display: flex;
  gap: 14rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fbfcfe;
  border: 2rpx solid rgba(31, 36, 50, 0.06);
}

.track-mode-chip--active {
  background: #fff3e7;
  border-color: rgba(255, 122, 0, 0.38);
}

.track-mode-radio {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 3rpx solid rgba(139, 148, 167, 0.34);
  background: #ffffff;
}

.track-mode-chip--active .track-mode-radio {
  border-color: #ff7a00;
}

.track-mode-chip--active .track-mode-radio::after {
  content: "";
  position: absolute;
  inset: 6rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.track-mode-copy {
  min-width: 0;
}

.track-mode-chip__title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.track-mode-chip__desc {
  margin-top: 10rpx;
  color: #7a8396;
  font-size: 22rpx;
  line-height: 1.35;
}

.voice-style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.voice-style-chip {
  padding: 17rpx 24rpx;
  border-radius: 999rpx;
  background: #fbfcfe;
  border: 2rpx solid rgba(31, 36, 50, 0.06);
  color: #556074;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.voice-style-chip--active {
  color: #ff6f00;
  background: #fff3e7;
  border-color: rgba(255, 122, 0, 0.36);
}

.settings-current {
  margin-top: 22rpx;
  padding: 15rpx 18rpx;
  border-radius: 18rpx;
  color: #ff6f00;
  background: #fff7ef;
  font-size: 24rpx;
  font-weight: 800;
}

.settings-preview-card {
  min-height: 118rpx;
  padding: 24rpx 26rpx;
}

.voice-preview-btn {
  min-width: 112rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9d2f 0%, #ff7a00 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 0, 0.2);
}

.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
