.mini-popup {
  position: fixed;
  top: 150rpx;
  left: 50%;
  z-index: 40;
  width: 520rpx;
  max-width: calc(100vw - 72rpx);
  transform: translateX(-50%);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(31, 36, 50, 0.9);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 50, 0.18);
}

.mini-popup--voice {
  background: rgba(255, 122, 0, 0.94);
}

.mini-popup__title {
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}

.mini-popup__content {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.45;
  opacity: 0.92;
}

.trip-hero {
  padding: 28rpx;
}

.trip-hero__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.trip-route {
  line-height: 1.4;
}

.trip-order-no {
  margin-top: 10rpx;
}

.trip-detail-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.trip-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.trip-metric-card {
  padding: 22rpx 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff8f1 0%, #ffffff 100%);
}

.trip-metric-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2432;
}

.trip-metric-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a8;
}

.timeline {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 8rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 10%;
  right: 10%;
  top: 20rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(255, 154, 49, 0.75), rgba(255, 154, 49, 0.42) 70%, rgba(203, 213, 225, 0.75));
}

.timeline-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.4);
  border: 8rpx solid #ffffff;
  box-sizing: content-box;
}

.timeline-dot.done {
  background: #ff9a31;
}

.timeline-dot.active {
  box-shadow: 0 0 0 10rpx rgba(255, 122, 0, 0.14);
}

.timeline-label {
  font-size: 22rpx;
  color: #94a0b5;
  text-align: center;
}

.timeline-label.done {
  color: #1f2432;
  font-weight: 700;
}


