<view class="page-shell trip-detail-shell safe-bottom" wx:if="{{trip}}">
  <view wx:if="{{noticePopup.visible}}" class="mini-popup mini-popup--{{noticePopup.type}}">
    <view class="mini-popup__title">{{noticePopup.title}}</view>
    <view class="mini-popup__content">{{noticePopup.content}}</view>
  </view>

  <view class="page-content trip-detail-page has-floating-action">
    <view class="trip-hero page-enter">
      <view class="trip-hero__head">
        <view class="trip-hero__copy">
          <view class="trip-route">{{trip.startName}} -> {{trip.endName}}</view>
          <view class="trip-order-no">订单号 {{trip.orderNo}} ｜ {{trip.passengerText}}</view>
          <view class="trip-detail-tags">
            <view class="status-tag {{trip.serviceTypeClassName}}">{{trip.serviceTypeLabel}}</view>
            <view class="pill trip-fare">{{trip.fareText}}</view>
          </view>
        </view>
        <view class="status-tag {{trip.statusTagType}} trip-status">{{trip.statusText}}</view>
      </view>

      <view class="trip-city">
        <view class="trip-building trip-building--1"></view>
        <view class="trip-building trip-building--2"></view>
        <view class="trip-building trip-building--3"></view>
        <view class="trip-building trip-building--4"></view>
      </view>
      <view class="trip-road"></view>
      <view class="trip-taxi">
        <view class="trip-taxi__body"></view>
        <view class="trip-taxi__top"></view>
        <view class="trip-taxi__wheel trip-taxi__wheel--left"></view>
        <view class="trip-taxi__wheel trip-taxi__wheel--right"></view>
      </view>

      <view class="trip-metrics">
        <view class="trip-metric-card">
          <view class="trip-metric-icon trip-metric-icon--route"></view>
          <view>
            <view class="trip-metric-value">{{trip.distanceText}}</view>
            <view class="trip-metric-label">已行驶里程</view>
          </view>
        </view>
        <view class="trip-metric-card">
          <view class="trip-metric-icon trip-metric-icon--clock"></view>
          <view>
            <view class="trip-metric-value">{{trip.durationText}}</view>
            <view class="trip-metric-label">已行驶时长</view>
          </view>
        </view>
        <view class="trip-metric-card">
          <view class="trip-metric-icon trip-metric-icon--progress"></view>
          <view>
            <view class="trip-metric-value">{{trip.percentText}}</view>
            <view class="trip-metric-label">当前进度</view>
          </view>
        </view>
      </view>
    </view>

    <view class="trip-panel intl-trip-panel" wx:if="{{trip.internationalMeta}}">
      <view class="panel-title-row">
        <view class="panel-title-icon panel-title-icon--flow"></view>
        <view class="panel-title">国际行程资料</view>
      </view>
      <view class="intl-trip-head">
        <view class="intl-trip-code">{{trip.internationalMeta.routeCode}}</view>
        <view class="intl-trip-sync">{{trip.internationalMeta.syncStatusText}}</view>
      </view>
      <view class="intl-trip-grid">
        <view>
          <text>预约</text>
          <view>{{trip.internationalMeta.appointmentTimeText}}</view>
        </view>
        <view>
          <text>航班/编号</text>
          <view>{{trip.internationalMeta.flightNo || '待补充'}}</view>
        </view>
        <view>
          <text>接机牌</text>
          <view>{{trip.internationalMeta.pickupSign}}</view>
        </view>
        <view>
          <text>人数行李</text>
          <view>{{trip.internationalMeta.passengerCountText}} · {{trip.internationalMeta.luggageCountText}}</view>
        </view>
      </view>
      <view class="intl-trip-note">{{trip.internationalMeta.documentsText}}</view>
      <view class="intl-trip-note intl-trip-note--service">{{trip.internationalMeta.serviceItemsText}}</view>
    </view>

    <view class="trip-panel flow-panel" wx:if="{{trip.showServiceFlow}}">
      <view class="panel-title-row">
        <view class="panel-title-icon panel-title-icon--flow"></view>
        <view class="panel-title">服务流程</view>
      </view>
      <view class="timeline">
        <view class="timeline-item" wx:for="{{trip.timeline}}" wx:key="key">
          <view class="timeline-dot {{item.done ? 'done' : ''}} {{item.active ? 'active' : ''}}"></view>
          <view class="timeline-line" wx:if="{{index !== trip.timeline.length - 1}}"></view>
          <view class="timeline-label {{item.done ? 'done' : ''}} {{item.active ? 'active' : ''}}">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="trip-panel drive-panel drive-panel--{{trip.driveStatus.state}}">
      <view class="drive-head">
        <view class="panel-title-row">
          <view class="panel-title-icon panel-title-icon--car"></view>
          <view class="panel-title">{{trip.driveStatus.sectionTitle}}</view>
        </view>
        <view class="drive-badge">{{trip.driveStatus.badge}}</view>
      </view>

      <block wx:if="{{trip.driveStatus.visualType === 'dispatch'}}">
        <view class="status-stage status-stage--dispatch">
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{trip.driveStatus.subtitle}}</view>
            <view class="drive-description">{{trip.driveStatus.description}}</view>
          </view>
          <view class="dispatch-board">
            <view class="dispatch-board__row dispatch-board__row--active">
              <text>订单确认</text>
              <text>待处理</text>
            </view>
            <view class="dispatch-board__row">
              <text>接驾准备</text>
              <text>未开始</text>
            </view>
            <view class="dispatch-board__row">
              <text>服务状态</text>
              <text>同步中</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:elif="{{trip.driveStatus.visualType === 'approach'}}">
        <view class="status-stage status-stage--approach">
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{trip.driveStatus.subtitle}}</view>
            <view class="drive-description">{{trip.driveStatus.description}}</view>
          </view>
          <view class="arrival-board">
            <view class="arrival-node arrival-node--driver">司机</view>
            <view class="arrival-path">
              <view class="arrival-car"></view>
            </view>
            <view class="arrival-node arrival-node--pickup">上车点</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{trip.driveStatus.visualType === 'trip'}}">
        <view class="status-stage status-stage--trip">
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{trip.driveStatus.subtitle}}</view>
            <view class="drive-description">{{trip.driveStatus.description}}</view>
          </view>
          <view class="nav-board">
            <view class="nav-board__top">
              <text>{{trip.driveStatus.visualTitle}}</text>
              <text>{{trip.driveStatus.progress}}%</text>
            </view>
            <view class="nav-board__bar">
              <view class="nav-board__fill" style="width: {{trip.driveStatus.progress}}%;"></view>
            </view>
            <view class="nav-board__hint">{{trip.driveStatus.visualHint}}</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{trip.driveStatus.visualType === 'finished'}}">
        <view class="status-stage status-stage--finished">
          <view class="result-mark result-mark--done">✓</view>
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{trip.driveStatus.visualTitle}}</view>
            <view class="drive-description">{{trip.driveStatus.visualHint}}</view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="status-stage status-stage--cancelled">
          <view class="result-mark result-mark--closed">×</view>
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{trip.driveStatus.visualTitle}}</view>
            <view class="drive-description">{{trip.driveStatus.description}}</view>
          </view>
        </view>
      </block>

      <view class="drive-facts">
        <view class="drive-fact drive-fact--{{item.tone || 'normal'}}" wx:for="{{trip.driveStatus.facts}}" wx:key="label">
          <view class="drive-fact__label">{{item.label}}</view>
          <view class="drive-fact__value">{{item.value}}</view>
        </view>
      </view>
    </view>

  </view>

  <view class="floating-bar trip-floating-bar">
    <button class="primary-button trip-action-button" hover-class="button-hover" bindtap="updateStatus" disabled="{{trip.orderStatus === 'FINISHED' || trip.orderStatus === 'CANCELLED'}}">
      {{actionText}}
    </button>
  </view>
</view>
