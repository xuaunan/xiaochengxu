<view class="page-shell" wx:if="{{trip}}">
  <view wx:if="{{noticePopup.visible}}" class="mini-popup mini-popup--{{noticePopup.type}}">
    <view class="mini-popup__title">{{noticePopup.title}}</view>
    <view class="mini-popup__content">{{noticePopup.content}}</view>
  </view>

  <view class="page-content list-gap">
    <view class="hero-card trip-hero page-enter">
      <view class="trip-hero__top">
        <view>
          <view class="section-title trip-route">{{trip.startName}} -> {{trip.endName}}</view>
          <view class="section-subtitle trip-order-no">订单号 {{trip.orderNo}} | {{trip.passengerText}}</view>
        </view>
        <view class="status-tag {{trip.statusTagType}}">{{trip.statusText}}</view>
      </view>

      <view class="trip-detail-tags">
        <view class="status-tag {{trip.serviceTypeClassName}}">{{trip.serviceTypeLabel}}</view>
        <view class="pill">{{trip.fareText}}</view>
      </view>

      <view class="trip-metrics">
        <view class="trip-metric-card">
          <view class="trip-metric-value">{{trip.distanceText}}</view>
          <view class="trip-metric-label">已行驶里程</view>
        </view>
        <view class="trip-metric-card">
          <view class="trip-metric-value">{{trip.durationText}}</view>
          <view class="trip-metric-label">已行驶时长</view>
        </view>
        <view class="trip-metric-card">
          <view class="trip-metric-value">{{trip.percentText}}</view>
          <view class="trip-metric-label">当前进度</view>
        </view>
      </view>
    </view>

    <view class="panel-card trip-panel">
      <view class="section-title">服务流程</view>
      <view class="timeline">
        <view class="timeline-item" wx:for="{{trip.timeline}}" wx:key="key">
          <view class="timeline-dot {{item.done ? 'done' : ''}} {{item.active ? 'active' : ''}}"></view>
          <view class="timeline-label {{item.done ? 'done' : ''}}">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="panel-card trip-panel">
      <view class="section-title">行驶状态</view>
      <view class="section-subtitle">{{trip.trafficText}}</view>
    </view>

    <view class="panel-card trip-panel">
      <view class="section-title">司机操作</view>
      <view class="section-subtitle">推进状态后会同步刷新司机端、乘客端和后台。</view>
    </view>
  </view>

  <view class="floating-bar">
    <button class="primary-button" hover-class="button-hover" bindtap="updateStatus" disabled="{{trip.orderStatus === 'FINISHED' || trip.orderStatus === 'CANCELLED'}}">
      {{actionText}}
    </button>
  </view>
</view>
