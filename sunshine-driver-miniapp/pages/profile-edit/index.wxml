<view class="page-shell profile-edit-shell safe-bottom">
  <view class="profile-edit-page has-bottom-action">
    <view class="edit-hero page-enter">
      <view class="edit-hero__copy">
        <view class="edit-title">{{copy.title}}</view>
        <view class="edit-subtitle">{{phoneText}}</view>
      </view>
      <image class="driver-avatar" src="/images/avatar-driver-main.svg" mode="aspectFill"></image>
      <view class="edit-city">
        <view class="edit-building edit-building--1"></view>
        <view class="edit-building edit-building--2"></view>
        <view class="edit-building edit-building--3"></view>
      </view>
    </view>

    <view class="form-section">
      <view class="form-section-title">{{copy.archive}}</view>
      <view class="form-item">
        <view class="form-icon form-icon--user"></view>
        <view class="form-label">{{copy.nickname}}</view>
        <input class="form-input" maxlength="20" data-key="nickname" value="{{form.nickname}}" bindinput="updateField" placeholder="{{copy.nicknamePlaceholder}}"></input>
      </view>
      <view class="form-item">
        <view class="form-icon form-icon--city"></view>
        <view class="form-label">{{copy.cityCode}}</view>
        <input class="form-input" data-key="cityCode" value="{{form.cityCode}}" bindinput="updateField" placeholder="310100"></input>
      </view>
      <view class="form-item">
        <view class="form-icon form-icon--license"></view>
        <view class="form-label">{{copy.licenseNo}}</view>
        <input class="form-input" data-key="licenseNo" value="{{form.licenseNo}}" bindinput="updateField" placeholder="{{copy.licensePlaceholder}}"></input>
      </view>
    </view>

    <view class="form-section">
      <view class="form-section-title">{{copy.contact}}</view>
      <view class="form-item">
        <view class="form-icon form-icon--contact"></view>
        <view class="form-label">{{copy.emergencyContact}}</view>
        <input class="form-input" maxlength="20" data-key="emergencyContact" value="{{form.emergencyContact}}" bindinput="updateField" placeholder="{{copy.optional}}"></input>
      </view>
      <view class="form-item">
        <view class="form-icon form-icon--phone"></view>
        <view class="form-label">{{copy.emergencyPhone}}</view>
        <input class="form-input" type="number" maxlength="16" data-key="emergencyPhone" value="{{form.emergencyPhone}}" bindinput="updateField" placeholder="8-16位纯数字"></input>
      </view>
    </view>

    <view class="form-section readonly-card">
      <view class="form-section-title">{{copy.readonly}}</view>
      <view class="readonly-row">
        <text>{{copy.vehicle}}</text>
        <text>{{vehicleText}}</text>
      </view>
      <view class="readonly-row">
        <text>{{copy.model}}</text>
        <text>{{modelText}}</text>
      </view>
    </view>
  </view>

  <view class="floating-bar edit-floating-bar">
    <button class="primary-action" disabled="{{saving}}" bindtap="submitForm">{{copy.save}}</button>
  </view>
</view>
