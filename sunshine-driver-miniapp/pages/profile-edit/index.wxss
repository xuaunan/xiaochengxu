.profile-edit-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.profile-edit-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 24rpx 24rpx 34rpx;
}

.has-bottom-action {
  padding-bottom: 146rpx;
}

.edit-hero {
  position: relative;
  overflow: hidden;
  min-height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.22);
  background:
    linear-gradient(112deg, rgba(255, 250, 244, 0.98) 0%, rgba(255, 247, 238, 0.92) 56%, rgba(255, 226, 190, 0.54) 100%),
    #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.09);
}

.edit-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.edit-title {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.edit-subtitle {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.35;
}

.driver-avatar {
  position: relative;
  z-index: 2;
  flex: 0 0 118rpx;
  width: 118rpx;
  height: 118rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(255, 122, 0, 0.11);
}

.edit-city {
  position: absolute;
  right: 108rpx;
  bottom: 18rpx;
  width: 170rpx;
  height: 90rpx;
  opacity: 0.16;
}

.edit-building {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.edit-building--1 {
  left: 16rpx;
  height: 54rpx;
}

.edit-building--2 {
  left: 68rpx;
  height: 82rpx;
}

.edit-building--3 {
  left: 124rpx;
  height: 62rpx;
}

.form-section {
  overflow: hidden;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 16rpx 38rpx rgba(24, 34, 56, 0.06);
}

.form-section-title {
  position: relative;
  padding: 26rpx 0 18rpx 18rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
}

.form-section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 30rpx;
  width: 7rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.form-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 110rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.86);
}

.form-item:last-child {
  border-bottom: none;
}

.form-icon {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  border-radius: 17rpx;
  color: #ff6f00;
  background: #fff1df;
}

.form-icon--user::before,
.form-icon--contact::before {
  content: "";
  position: absolute;
  left: 19rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
}

.form-icon--user::after,
.form-icon--contact::after {
  content: "";
  position: absolute;
  left: 13rpx;
  bottom: 11rpx;
  width: 28rpx;
  height: 17rpx;
  border-radius: 16rpx 16rpx 7rpx 7rpx;
  background: currentColor;
}

.form-icon--city::before {
  content: "";
  position: absolute;
  left: 13rpx;
  bottom: 12rpx;
  width: 10rpx;
  height: 24rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: currentColor;
  box-shadow: 14rpx -8rpx 0 0 currentColor, 28rpx 3rpx 0 -1rpx currentColor;
}

.form-icon--license::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 16rpx;
  width: 34rpx;
  height: 22rpx;
  border-radius: 6rpx;
  border: 4rpx solid currentColor;
}

.form-icon--license::after {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 25rpx;
  width: 20rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.form-icon--phone::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 10rpx;
  width: 18rpx;
  height: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.form-label {
  width: 176rpx;
  flex: 0 0 176rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  color: #172033;
  font-size: 28rpx;
  line-height: 80rpx;
  text-align: right;
}

.readonly-card {
  padding-bottom: 16rpx;
}

.readonly-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 76rpx;
  color: #64748b;
  font-size: 26rpx;
}

.readonly-row text:last-child {
  color: #172033;
  font-weight: 900;
  text-align: right;
}

.edit-floating-bar {
  padding-top: 20rpx;
}

.primary-action {
  width: 100%;
  min-height: 96rpx;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7300 0%, #ff8f22 100%);
  box-shadow: 0 16rpx 28rpx rgba(255, 111, 0, 0.24);
  font-size: 31rpx;
  font-weight: 900;
}

.primary-action::after {
  border: none;
}

.primary-action[disabled] {
  opacity: 0.72;
}
