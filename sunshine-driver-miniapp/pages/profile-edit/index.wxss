.profile-edit-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.profile-edit-page {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 16rpx 20rpx 28rpx;
}

.has-bottom-action {
  padding-bottom: 118rpx;
}

.edit-hero {
  position: relative;
  overflow: hidden;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.22);
  background:
    linear-gradient(112deg, rgba(255, 250, 244, 0.98) 0%, rgba(255, 247, 238, 0.92) 56%, rgba(255, 226, 190, 0.54) 100%),
    #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(210, 104, 18, 0.08);
}

.edit-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.edit-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.18;
}

.edit-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.35;
}

.driver-avatar {
  position: relative;
  z-index: 2;
  flex: 0 0 86rpx;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(255, 122, 0, 0.1);
}

.edit-city {
  position: absolute;
  right: 108rpx;
  bottom: 18rpx;
  width: 170rpx;
  height: 90rpx;
  opacity: 0.16;
}

.edit-building {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.edit-building--1 {
  left: 16rpx;
  height: 54rpx;
}

.edit-building--2 {
  left: 68rpx;
  height: 82rpx;
}

.edit-building--3 {
  left: 124rpx;
  height: 62rpx;
}

.form-section {
  overflow: hidden;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.055);
}

.form-section-title {
  position: relative;
  padding: 18rpx 0 12rpx 14rpx;
  color: #172033;
  font-size: 25rpx;
  font-weight: 600;
}

.form-section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22rpx;
  width: 5rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.form-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 82rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.86);
}

.form-item:last-child {
  border-bottom: none;
}

.form-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  border-radius: 13rpx;
  color: #ff6f00;
  background: #fff1df;
  box-sizing: border-box;
}

.form-icon--user::before,
.form-icon--contact::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, -86%);
}

.form-icon--user::after,
.form-icon--contact::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 15rpx;
  border-radius: 16rpx 16rpx 7rpx 7rpx;
  background: currentColor;
  transform: translate(-50%, 12%);
}

.form-icon--city::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 23rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: currentColor;
  box-shadow: 11rpx -7rpx 0 0 currentColor, 22rpx 3rpx 0 -1rpx currentColor;
  transform: translate(-148%, -28%);
}

.form-icon--license::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 20rpx;
  border-radius: 6rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.form-icon--license::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 15rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.form-icon--phone::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 15rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.form-label {
  width: 138rpx;
  flex: 0 0 138rpx;
  color: #172033;
  font-size: 23rpx;
  font-weight: 500;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  min-height: 62rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  color: #172033;
  font-size: 24rpx;
  line-height: 62rpx;
  text-align: right;
}

.readonly-card {
  padding-bottom: 10rpx;
}

.readonly-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 60rpx;
  color: #64748b;
  font-size: 22rpx;
}

.readonly-row text:last-child {
  color: #172033;
  font-weight: 600;
  text-align: right;
}

.edit-floating-bar {
  padding-top: 14rpx;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 76rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7300 0%, #ff8f22 100%);
  box-shadow: 0 10rpx 20rpx rgba(255, 111, 0, 0.22);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  box-sizing: border-box;
}

.primary-action::after {
  border: none;
}

.primary-action[disabled] {
  opacity: 0.72;
}
