<view class="page-shell">
  <view class="page-content">
    <view class="chip-row">
      <view class="chip {{active === item.key ? 'chip-active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseTab">{{item.label}}</view>
    </view>
    <view class="list-gap" style="margin-top: 24rpx;">
      <view class="panel-card tap-scale" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
        <view class="row-between">
          <view class="section-title order-route">{{item.startName}} → {{item.endName}}</view>
          <view class="status-tag {{item.status === 'completed' ? 'success' : item.status === 'processing' ? 'processing' : 'waiting'}}">{{item.statusText}}</view>
        </view>
        <view class="order-extra">
          <view class="status-tag {{item.serviceTypeClassName}}">{{item.serviceTypeLabel}}</view>
          <view class="section-subtitle">{{item.passengerName}} · {{item.createdAt}}</view>
        </view>
        <view class="section-subtitle">{{item.seatHint}}</view>
        <view class="section-subtitle">{{item.fareText}}</view>
      </view>
    </view>
  </view>
</view>
