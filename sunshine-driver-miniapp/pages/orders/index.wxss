.driver-orders-hero {
  background:
    linear-gradient(135deg, rgba(255, 244, 232, 0.98) 0%, rgba(255, 255, 255, 0.98) 58%),
    #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.055);
}

.driver-orders-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.driver-orders-count {
  flex-shrink: 0;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.driver-order-tabs {
  margin-top: 22rpx;
}

.driver-order-tabs .chip {
  background: #f8fafc;
  box-shadow: none;
}

.driver-order-tabs .chip-active {
  background: rgba(255, 122, 0, 0.1);
}

.driver-order-list {
  margin-top: 24rpx;
}

.driver-order-card {
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.order-route {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.order-extra {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}


