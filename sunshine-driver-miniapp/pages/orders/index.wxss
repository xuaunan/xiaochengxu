.driver-orders-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.driver-orders-page {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 16rpx;
}

.driver-orders-hero {
  position: relative;
  min-height: 108rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.26);
  background:
    linear-gradient(110deg, rgba(255, 250, 244, 0.98) 0%, rgba(255, 247, 238, 0.92) 52%, rgba(255, 226, 190, 0.52) 100%),
    #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(210, 104, 18, 0.08);
}

.driver-orders-hero__icon {
  position: relative;
  z-index: 2;
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ff9d32 0%, #ff6f00 100%);
  box-shadow: inset 0 0 0 10rpx rgba(255, 255, 255, 0.7), 0 14rpx 26rpx rgba(255, 111, 0, 0.18);
}

.driver-orders-hero__icon::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 22rpx;
  width: 38rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.driver-orders-hero__icon::after {
  content: "";
  position: absolute;
  left: 30rpx;
  top: 16rpx;
  width: 10rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 18rpx 0 0 #ff7a00;
}

.driver-orders-hero__icon-line {
  position: absolute;
  left: 32rpx;
  top: 38rpx;
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 0 12rpx 0 #ff7a00;
  z-index: 2;
}

.driver-orders-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.driver-orders-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 550;
  line-height: 1.15;
}

.driver-orders-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
  font-weight: 400;
}

.driver-orders-count {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  min-width: 72rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 122, 0, 0.42);
  text-align: center;
  font-size: 21rpx;
  font-weight: 550;
}

.driver-orders-city,
.driver-orders-road,
.driver-orders-taxi {
  pointer-events: none;
}

.driver-orders-city {
  position: absolute;
  right: 84rpx;
  bottom: 20rpx;
  width: 230rpx;
  height: 112rpx;
  opacity: 0.2;
}

.driver-orders-building {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.driver-orders-building--1 {
  left: 14rpx;
  height: 58rpx;
}

.driver-orders-building--2 {
  left: 62rpx;
  height: 92rpx;
}

.driver-orders-building--3 {
  left: 116rpx;
  height: 76rpx;
}

.driver-orders-building--4 {
  left: 168rpx;
  height: 50rpx;
}

.driver-orders-road {
  position: absolute;
  right: -28rpx;
  bottom: 18rpx;
  width: 320rpx;
  height: 70rpx;
  border-top: 7rpx solid rgba(255, 255, 255, 0.84);
  transform: rotate(-12deg);
}

.driver-orders-road::after {
  content: "";
  position: absolute;
  right: 22rpx;
  top: 21rpx;
  width: 170rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.92);
}

.driver-orders-taxi {
  position: absolute;
  right: 122rpx;
  bottom: 36rpx;
  width: 82rpx;
  height: 44rpx;
  transform: rotate(-5deg);
}

.driver-orders-taxi__body,
.driver-orders-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa33d 0%, #ff7a00 100%);
  border: 2rpx solid rgba(134, 68, 0, 0.16);
}

.driver-orders-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 74rpx;
  height: 30rpx;
  border-radius: 13rpx 16rpx 9rpx 9rpx;
}

.driver-orders-taxi__top {
  left: 28rpx;
  bottom: 30rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.driver-orders-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #1f2432;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.driver-orders-taxi__wheel--left {
  left: 16rpx;
}

.driver-orders-taxi__wheel--right {
  right: 14rpx;
}

.driver-filter-card {
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.055);
}

.driver-tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.driver-tabs-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 4rpx;
}

.driver-filter-divider {
  height: 1rpx;
  margin: 16rpx 6rpx;
  background: rgba(31, 36, 50, 0.08);
}

.driver-filter-chip {
  min-width: 94rpx;
  height: 44rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #667085;
  background: #fbfcfe;
  border: 2rpx solid rgba(31, 36, 50, 0.08);
  font-size: 21rpx;
  font-weight: 500;
  transition: transform 0.18s ease, color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.driver-filter-chip--type {
  min-width: 104rpx;
  height: 48rpx;
}

.driver-filter-chip--active {
  color: #ff6f00;
  background: #fff3e7;
  border-color: rgba(255, 122, 0, 0.52);
}

.driver-order-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 28rpx;
}

.driver-order-card {
  position: relative;
  overflow: hidden;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.058);
}

.driver-order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 210rpx;
  height: 90rpx;
  background: radial-gradient(circle at 0% 0%, rgba(255, 122, 0, 0.09), transparent 70%);
}

.driver-order-card__top,
.driver-order-card__bottom,
.driver-order-type,
.driver-order-meta__item {
  display: flex;
  align-items: center;
}

.driver-order-card__top,
.driver-order-card__bottom {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 18rpx;
}

.driver-order-type {
  gap: 12rpx;
  min-width: 0;
}

.driver-order-type__icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  color: #ff6f00;
  background: #fff1df;
  box-sizing: border-box;
}

.driver-order-type__icon--taxi::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 15rpx;
  border-radius: 8rpx 9rpx 5rpx 5rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -12%);
}

.driver-order-type__icon--taxi::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 13rpx 0 0 currentColor, 5rpx -17rpx 0 -1rpx currentColor;
  transform: translate(-160%, 78%);
}

.driver-order-type__icon--carpool::before,
.driver-order-type__icon--carpool::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.driver-order-type__icon--carpool::before {
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  box-shadow: 15rpx 0 0 currentColor;
  transform: translate(-126%, -120%);
}

.driver-order-type__icon--carpool::after {
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 12rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  box-shadow: 17rpx 0 0 currentColor;
  transform: translate(-112%, 18%);
}

.driver-order-type__icon--international::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(-28deg);
}

.driver-order-type__icon--international::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(-28deg);
}

.driver-order-type__text {
  color: #ff6f00;
  font-size: 23rpx;
  font-weight: 550;
}

.driver-order-status {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff1df;
  font-size: 21rpx;
  font-weight: 500;
}

.driver-order-status--completed {
  color: #12845c;
  background: #e8f8ef;
}

.driver-order-status--processing {
  color: #2f72db;
  background: #edf5ff;
}

.driver-order-status--waiting {
  color: #d88300;
  background: #fff4df;
}

.driver-order-status--cancelled {
  color: #df3d38;
  background: #ffeded;
}

.driver-order-route {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: #111827;
  font-size: 23rpx;
  font-weight: 550;
  line-height: 1.45;
}

.driver-order-intl {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f3f7fb;
  border: 1rpx solid rgba(29, 78, 137, 0.08);
}

.driver-order-intl__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.driver-order-intl__head text,
.driver-order-intl__head view {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 36rpx;
}

.driver-order-intl__head text {
  color: #ffffff;
  background: #1d4e89;
}

.driver-order-intl__head view {
  color: #12845c;
  background: #e8f8ef;
}

.driver-order-intl__brief,
.driver-order-intl__docs {
  color: #344054;
  font-size: 21rpx;
  line-height: 1.45;
}

.driver-order-intl__docs {
  color: #1d4e89;
}

.driver-order-card__bottom {
  margin-top: 14rpx;
}

.driver-order-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9rpx 14rpx;
  color: #7a8396;
  font-size: 21rpx;
}

.driver-order-meta__item {
  min-width: 0;
  gap: 12rpx;
  max-width: 100%;
}

.driver-order-meta__item text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-order-meta__icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  color: #8b94a7;
  box-sizing: border-box;
}

.driver-order-meta__icon--user::before,
.driver-order-meta__icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.driver-order-meta__icon--user::before {
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  transform: translate(-50%, -80%);
}

.driver-order-meta__icon--user::after {
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 11rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  transform: translate(-50%, 14%);
}

.driver-order-meta__icon--time {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.driver-order-meta__icon--time::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -76%);
}

.driver-order-meta__icon--time::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(0, -50%);
}

.driver-order-meta__icon--seat::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 7rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.driver-order-price {
  flex-shrink: 0;
  color: #ff6f00;
  font-size: 27rpx;
  font-weight: 550;
  line-height: 1;
}

.driver-empty-card {
  min-height: 220rpx;
  padding: 30rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.058);
  text-align: center;
}

.driver-empty-icon {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  color: #ff6f00;
  background: #fff1df;
  box-sizing: border-box;
}

.driver-empty-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 46rpx;
  height: 26rpx;
  border-radius: 12rpx 14rpx 7rpx 7rpx;
  border: 4rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -10%);
}

.driver-empty-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 24rpx 0 0 currentColor, 10rpx -30rpx 0 -2rpx currentColor;
  transform: translate(-176%, 92%);
}

.driver-empty-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 550;
}

.driver-empty-desc {
  margin-top: 8rpx;
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.5;
}

.pressable-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
