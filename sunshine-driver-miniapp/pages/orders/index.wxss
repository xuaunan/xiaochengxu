.orders-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.orders-page {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 12rpx 18rpx 32rpx;
  padding-top: 12rpx;
}

.orders-hero {
  position: relative;
  min-height: 174rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 135, 24, 0.2);
  background:
    radial-gradient(circle at 91% 22%, rgba(255, 160, 48, 0.24) 0, rgba(255, 160, 48, 0) 160rpx),
    radial-gradient(circle at 74% 100%, rgba(255, 203, 132, 0.3) 0, rgba(255, 203, 132, 0) 180rpx),
    linear-gradient(105deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 250, 244, 0.98) 48%, rgba(255, 231, 198, 0.74) 100%),
    #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(210, 104, 18, 0.075);
}

.orders-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
}

.orders-hero::before {
  content: "";
  position: absolute;
  inset: 2rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  pointer-events: none;
}

.orders-hero::after {
  content: "";
  position: absolute;
  right: 18rpx;
  bottom: -38rpx;
  width: 210rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 144, 31, 0.08);
  filter: blur(2rpx);
  pointer-events: none;
}

.orders-hero__icon {
  position: relative;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background:
    radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.45) 0, rgba(255, 255, 255, 0) 26rpx),
    linear-gradient(145deg, #ffaf45 0%, #ff741e 100%);
  box-shadow:
    inset 0 0 0 7rpx rgba(255, 255, 255, 0.7),
    0 10rpx 20rpx rgba(255, 111, 0, 0.16);
}

.orders-hero__icon::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 20rpx;
  width: 34rpx;
  height: 38rpx;
  border-radius: 9rpx;
  background:
    linear-gradient(135deg, transparent 0 10rpx, rgba(255, 229, 205, 0.95) 10rpx 16rpx, #ffffff 16rpx),
    #ffffff;
  box-shadow: 0 3rpx 8rpx rgba(152, 74, 0, 0.12);
}

.orders-hero__icon::after {
  content: "";
  position: absolute;
  left: 29rpx;
  top: 15rpx;
  width: 7rpx;
  height: 13rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 15rpx 0 0 #ff7a00;
}

.orders-hero__icon-line {
  position: absolute;
  left: 29rpx;
  top: 34rpx;
  width: 21rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow:
    0 9rpx 0 #ff7a00,
    0 18rpx 0 rgba(255, 122, 0, 0.72);
  z-index: 2;
}

.orders-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.orders-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.15;
}

.orders-desc {
  margin-top: 7rpx;
  color: #667085;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.28;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.orders-hero__count {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  min-width: 72rpx;
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 122, 0, 0.34);
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(255, 122, 0, 0.08);
}

.orders-city,
.orders-road,
.orders-taxi {
  pointer-events: none;
  display: none;
}

.orders-city {
  position: absolute;
  right: 86rpx;
  bottom: 17rpx;
  width: 236rpx;
  height: 116rpx;
  opacity: 0.32;
}

.orders-building {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.34) 0 7rpx, transparent 7rpx 17rpx, rgba(255, 255, 255, 0.28) 17rpx 24rpx, transparent 24rpx),
    linear-gradient(180deg, rgba(255, 181, 88, 0.74), rgba(255, 141, 26, 0.24));
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.orders-building--1 {
  left: 14rpx;
  height: 58rpx;
}

.orders-building--2 {
  left: 62rpx;
  height: 92rpx;
}

.orders-building--3 {
  left: 116rpx;
  height: 76rpx;
}

.orders-building--4 {
  left: 168rpx;
  height: 50rpx;
}

.orders-road {
  position: absolute;
  right: -18rpx;
  bottom: 19rpx;
  width: 330rpx;
  height: 72rpx;
  border-top: 8rpx solid rgba(255, 255, 255, 0.94);
  transform: rotate(-12deg);
  filter: drop-shadow(0 5rpx 6rpx rgba(255, 143, 30, 0.08));
}

.orders-road::after {
  content: "";
  position: absolute;
  right: 22rpx;
  top: 21rpx;
  width: 170rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.92);
}

.orders-taxi {
  position: absolute;
  right: 126rpx;
  bottom: 39rpx;
  width: 92rpx;
  height: 48rpx;
  transform: rotate(-5deg);
}

.orders-taxi__body,
.orders-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffb24f 0%, #ff7a00 100%);
  border: 2rpx solid rgba(134, 68, 0, 0.16);
}

.orders-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 84rpx;
  height: 32rpx;
  border-radius: 13rpx 16rpx 9rpx 9rpx;
  box-shadow: 0 7rpx 12rpx rgba(255, 122, 0, 0.16);
}

.orders-taxi__body::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 8rpx;
  width: 16rpx;
  height: 9rpx;
  border-radius: 5rpx 2rpx 2rpx 5rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 38rpx 0 0 rgba(255, 255, 255, 0.62);
}

.orders-taxi__body::after {
  content: "";
  position: absolute;
  right: 4rpx;
  top: 15rpx;
  width: 5rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #fff7df;
}

.orders-taxi__top {
  left: 32rpx;
  bottom: 32rpx;
  width: 31rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #ffb34e 0%, #ff8b17 100%);
}

.orders-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #1f2432;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.orders-taxi__wheel--left {
  left: 16rpx;
}

.orders-taxi__wheel--right {
  right: 14rpx;
}

.filter-card {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 9rpx 22rpx rgba(24, 34, 56, 0.04);
}

.tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.tabs-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 4rpx;
}

.filter-divider {
  height: 1rpx;
  margin: 13rpx 6rpx;
  background: rgba(31, 36, 50, 0.08);
}

.filter-chip {
  min-width: 92rpx;
  height: 46rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border-radius: 999rpx;
  color: #667085;
  background: #fbfcfe;
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  font-size: 22rpx;
  font-weight: 400;
  transition: transform 0.18s ease, color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.filter-chip--type {
  min-width: 108rpx;
  height: 46rpx;
}

.filter-chip--active {
  color: #ff6f00;
  background: #fff3e7;
  border-color: rgba(255, 122, 0, 0.52);
}

.filter-chip__icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 0 12rpx;
  padding-bottom: 28rpx;
}

.order-card {
  position: relative;
  overflow: hidden;
  padding: 15rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 7rpx 18rpx rgba(24, 34, 56, 0.035);
}

.order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 210rpx;
  height: 90rpx;
  background: radial-gradient(circle at 0% 0%, rgba(255, 122, 0, 0.09), transparent 70%);
}

.order-card__top,
.order-card__bottom,
.order-type,
.order-meta__item {
  display: flex;
  align-items: center;
}

.order-card__top,
.order-card__bottom {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 14rpx;
}

.order-type {
  gap: 14rpx;
  min-width: 0;
}

.order-type__icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.order-type__text {
  color: #ff6f00;
  font-size: 22rpx;
  font-weight: 550;
}

.order-status {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff1df;
  font-size: 21rpx;
  font-weight: 500;
}

.order-status--success {
  color: #12845c;
  background: #e8f8ef;
}

.order-status--danger {
  color: #df3d38;
  background: #ffeded;
}

.order-status--processing {
  color: #2f72db;
  background: #edf5ff;
}

.order-status--waiting {
  color: #d88300;
  background: #fff4df;
}

.order-route {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: #111827;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.45;
}

.order-card__bottom {
  margin-top: 12rpx;
}

.order-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 14rpx;
  color: #7a8396;
  font-size: 20rpx;
}

.order-meta__item {
  min-width: 0;
  gap: 9rpx;
  max-width: 100%;
}

.order-meta__item text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta__icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  color: #8b94a7;
  box-sizing: border-box;
}

.order-meta__icon--time {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.order-meta__icon--time::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -76%);
}

.order-meta__icon--time::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(0, -50%);
}

.order-meta__icon--no::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 22rpx;
  border-radius: 5rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.order-meta__icon--no::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 6rpx 0 currentColor;
  transform: translate(-50%, -120%);
}

.order-price {
  flex-shrink: 0;
  color: #ff6f00;
  font-size: 27rpx;
  font-weight: 550;
  line-height: 1;
}

.empty-panel {
  padding: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 8rpx 18rpx rgba(24, 34, 56, 0.035);
}

.empty-panel .empty-box {
  min-height: 330rpx;
  padding: 38rpx 32rpx 42rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.88);
}

.empty-panel .empty-image {
  width: 154rpx;
  height: 116rpx;
}

.empty-panel .empty-title {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.32;
  font-weight: 500;
}

.empty-panel .empty-desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.45;
}

.empty-panel .empty-button {
  width: 210rpx;
  height: 54rpx;
  min-height: 54rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.08);
}

.order-state-card {
  min-height: 260rpx;
  padding: 44rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 8rpx 18rpx rgba(24, 34, 56, 0.035);
  text-align: center;
}

.order-state-title {
  color: #111827;
  font-size: 25rpx;
  font-weight: 550;
}

.order-state-desc {
  margin-top: 10rpx;
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.5;
}

.order-state-button {
  min-width: 200rpx;
  height: 56rpx;
  min-height: 56rpx;
  margin-top: 22rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.pressable-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
