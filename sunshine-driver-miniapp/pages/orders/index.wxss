.driver-orders-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.driver-orders-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 20rpx;
}

.driver-orders-hero {
  position: relative;
  min-height: 128rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.26);
  background:
    linear-gradient(110deg, rgba(255, 250, 244, 0.98) 0%, rgba(255, 247, 238, 0.92) 52%, rgba(255, 226, 190, 0.52) 100%),
    #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.09);
}

.driver-orders-hero__icon {
  position: relative;
  z-index: 2;
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ff9d32 0%, #ff6f00 100%);
  box-shadow: inset 0 0 0 10rpx rgba(255, 255, 255, 0.7), 0 14rpx 26rpx rgba(255, 111, 0, 0.18);
}

.driver-orders-hero__icon::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 22rpx;
  width: 38rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.driver-orders-hero__icon::after {
  content: "";
  position: absolute;
  left: 30rpx;
  top: 16rpx;
  width: 10rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 18rpx 0 0 #ff7a00;
}

.driver-orders-hero__icon-line {
  position: absolute;
  left: 32rpx;
  top: 38rpx;
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 0 12rpx 0 #ff7a00;
  z-index: 2;
}

.driver-orders-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.driver-orders-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.15;
}

.driver-orders-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  font-weight: 500;
}

.driver-orders-count {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  min-width: 82rpx;
  padding: 10rpx 17rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 122, 0, 0.42);
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.driver-orders-city,
.driver-orders-road,
.driver-orders-taxi {
  pointer-events: none;
}

.driver-orders-city {
  position: absolute;
  right: 84rpx;
  bottom: 20rpx;
  width: 230rpx;
  height: 112rpx;
  opacity: 0.2;
}

.driver-orders-building {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.driver-orders-building--1 {
  left: 14rpx;
  height: 58rpx;
}

.driver-orders-building--2 {
  left: 62rpx;
  height: 92rpx;
}

.driver-orders-building--3 {
  left: 116rpx;
  height: 76rpx;
}

.driver-orders-building--4 {
  left: 168rpx;
  height: 50rpx;
}

.driver-orders-road {
  position: absolute;
  right: -28rpx;
  bottom: 18rpx;
  width: 320rpx;
  height: 70rpx;
  border-top: 7rpx solid rgba(255, 255, 255, 0.84);
  transform: rotate(-12deg);
}

.driver-orders-road::after {
  content: "";
  position: absolute;
  right: 22rpx;
  top: 21rpx;
  width: 170rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.92);
}

.driver-orders-taxi {
  position: absolute;
  right: 122rpx;
  bottom: 36rpx;
  width: 82rpx;
  height: 44rpx;
  transform: rotate(-5deg);
}

.driver-orders-taxi__body,
.driver-orders-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa33d 0%, #ff7a00 100%);
  border: 2rpx solid rgba(134, 68, 0, 0.16);
}

.driver-orders-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 74rpx;
  height: 30rpx;
  border-radius: 13rpx 16rpx 9rpx 9rpx;
}

.driver-orders-taxi__top {
  left: 28rpx;
  bottom: 30rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.driver-orders-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #1f2432;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.driver-orders-taxi__wheel--left {
  left: 16rpx;
}

.driver-orders-taxi__wheel--right {
  right: 14rpx;
}

.driver-filter-card {
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 16rpx 36rpx rgba(24, 34, 56, 0.06);
}

.driver-tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.driver-tabs-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 4rpx;
}

.driver-filter-chip {
  min-width: 104rpx;
  height: 52rpx;
  padding: 0 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #667085;
  background: #fbfcfe;
  border: 2rpx solid rgba(31, 36, 50, 0.08);
  font-size: 24rpx;
  font-weight: 600;
  transition: transform 0.18s ease, color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.driver-filter-chip--active {
  color: #ff6f00;
  background: #fff3e7;
  border-color: rgba(255, 122, 0, 0.52);
}

.driver-order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 28rpx;
}

.driver-order-card {
  position: relative;
  overflow: hidden;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.065);
}

.driver-order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 210rpx;
  height: 90rpx;
  background: radial-gradient(circle at 0% 0%, rgba(255, 122, 0, 0.09), transparent 70%);
}

.driver-order-card__top,
.driver-order-card__bottom,
.driver-order-type,
.driver-order-meta__item {
  display: flex;
  align-items: center;
}

.driver-order-card__top,
.driver-order-card__bottom {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 18rpx;
}

.driver-order-type {
  gap: 12rpx;
  min-width: 0;
}

.driver-order-type__icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  color: #ff6f00;
  background: #fff1df;
}

.driver-order-type__icon::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 17rpx;
  width: 28rpx;
  height: 15rpx;
  border-radius: 8rpx 9rpx 5rpx 5rpx;
  border: 3rpx solid currentColor;
}

.driver-order-type__icon::after {
  content: "";
  position: absolute;
  left: 14rpx;
  bottom: 9rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 14rpx 0 0 currentColor, 5rpx -18rpx 0 -1rpx currentColor;
}

.driver-order-type__text {
  color: #ff6f00;
  font-size: 25rpx;
  font-weight: 700;
}

.driver-order-status {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff1df;
  font-size: 23rpx;
  font-weight: 700;
}

.driver-order-status--completed {
  color: #12845c;
  background: #e8f8ef;
}

.driver-order-status--processing {
  color: #2f72db;
  background: #edf5ff;
}

.driver-order-status--waiting {
  color: #d88300;
  background: #fff4df;
}

.driver-order-status--cancelled {
  color: #df3d38;
  background: #ffeded;
}

.driver-order-route {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.driver-order-card__bottom {
  margin-top: 18rpx;
}

.driver-order-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 16rpx;
  color: #7a8396;
  font-size: 23rpx;
}

.driver-order-meta__item {
  min-width: 0;
  gap: 9rpx;
  max-width: 100%;
}

.driver-order-meta__item text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-order-meta__icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  color: #8b94a7;
}

.driver-order-meta__icon--user::before,
.driver-order-meta__icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.driver-order-meta__icon--user::before {
  left: 8rpx;
  top: 3rpx;
  width: 10rpx;
  height: 10rpx;
}

.driver-order-meta__icon--user::after {
  left: 4rpx;
  bottom: 3rpx;
  width: 18rpx;
  height: 11rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.driver-order-meta__icon--time {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.driver-order-meta__icon--time::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 3rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.driver-order-meta__icon--time::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 11rpx;
  width: 8rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.driver-order-meta__icon--seat::before {
  content: "";
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 7rpx;
  border: 3rpx solid currentColor;
}

.driver-order-price {
  flex-shrink: 0;
  color: #ff6f00;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.driver-empty-card {
  min-height: 280rpx;
  padding: 42rpx 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.065);
  text-align: center;
}

.driver-empty-icon {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  color: #ff6f00;
  background: #fff1df;
}

.driver-empty-icon::before {
  content: "";
  position: absolute;
  left: 23rpx;
  top: 31rpx;
  width: 46rpx;
  height: 26rpx;
  border-radius: 12rpx 14rpx 7rpx 7rpx;
  border: 6rpx solid currentColor;
}

.driver-empty-icon::after {
  content: "";
  position: absolute;
  left: 31rpx;
  bottom: 27rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 24rpx 0 0 currentColor;
}

.driver-empty-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.driver-empty-desc {
  margin-top: 12rpx;
  color: #7a8396;
  font-size: 25rpx;
  line-height: 1.5;
}

.pressable-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
