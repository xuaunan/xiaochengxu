.dashboard-page {
  position: relative;
  min-height: 100vh;
  background:
    linear-gradient(180deg, rgba(8, 16, 32, 0.08) 0%, rgba(8, 16, 32, 0) 20%),
    linear-gradient(180deg, #eef3f8 0%, #f6f8fc 100%);
}

.dashboard-map {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 56vh;
}

.mini-popup {
  position: fixed;
  top: 150rpx;
  left: 50%;
  z-index: 40;
  width: 520rpx;
  max-width: calc(100vw - 72rpx);
  transform: translateX(-50%);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(31, 36, 50, 0.9);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 50, 0.18);
}

.mini-popup--voice {
  background: rgba(255, 122, 0, 0.94);
}

.mini-popup__title {
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}

.mini-popup__content {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.45;
  opacity: 0.92;
}

.dashboard-map-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 56vh;
  background:
    linear-gradient(180deg, rgba(15, 23, 42, 0.18) 0%, rgba(15, 23, 42, 0.06) 22%, rgba(15, 23, 42, 0) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0) 66%, rgba(246, 248, 252, 0.96) 100%);
  pointer-events: none;
  z-index: 2;
}

.dashboard-overlay {
  position: relative;
  left: 0;
  right: 0;
  top: 0;
  z-index: 10;
}

.dashboard-nav-wrap {
  padding-top: 4rpx;
}

.dashboard-top {
  margin: 18rpx 24rpx 0;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 249, 243, 0.93));
  transition: background 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
}

.dashboard-top.is-online {
  box-shadow: 0 20rpx 44rpx rgba(255, 122, 0, 0.14);
}

.dashboard-top.is-busy {
  box-shadow: 0 20rpx 44rpx rgba(107, 114, 128, 0.18);
}

.dashboard-top.is-offline {
  box-shadow: 0 18rpx 40rpx rgba(31, 36, 50, 0.12);
}

.dashboard-top-head {
  align-items: flex-start;
  gap: 20rpx;
}

.dashboard-status-copy {
  flex: 1;
  min-width: 0;
}

.status-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #172033;
}

.status-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6f7b90;
  transition: color 0.3s ease;
}

.dashboard-top.is-online .status-desc {
  color: #616d84;
}

.dashboard-metric-grid {
  margin-top: 22rpx;
  gap: 18rpx;
}

.dashboard-metric-card {
  min-height: 146rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.metric-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  min-height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.metric-badge-success {
  color: #ffffff;
  background: linear-gradient(135deg, #1ca565, #34c97d);
}

.metric-badge-pending {
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a28, #ffb44f);
}

.metric-badge-danger {
  color: #ffffff;
  background: linear-gradient(135deg, #ef5b5b, #ff7a7a);
}

.metric-badge-neutral,
.metric-badge-disabled {
  color: #607086;
  background: rgba(148, 163, 184, 0.18);
}

.driver-notice-ticker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: calc(50vh - 62rpx);
  z-index: 13;
  height: 52rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 122, 0, 0.16);
  border-bottom: 0;
  border-radius: 28rpx 28rpx 0 0;
  background: linear-gradient(90deg, rgba(255, 247, 238, 0.98), rgba(255, 255, 255, 0.96));
  box-shadow: 0 -10rpx 24rpx rgba(255, 122, 0, 0.08);
}

.driver-notice-ticker__label {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.12);
  color: #ff7a00;
  font-size: 20rpx;
  font-weight: 700;
}

.driver-notice-ticker__track {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.driver-notice-ticker__text {
  display: inline-block;
  padding-left: 100%;
  color: #566277;
  font-size: 22rpx;
  line-height: 52rpx;
  white-space: nowrap;
  animation: driver-notice-marquee 18s linear infinite;
}

.dashboard-bottom {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: calc(50vh - 10rpx);
  bottom: 20rpx;
  z-index: 12;
  display: flex;
  flex-direction: column;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  overflow: hidden;
}

@keyframes driver-notice-marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-100%);
  }
}

.listen-button {
  border: none;
  border-radius: 999rpx;
  min-width: 184rpx;
  min-height: 88rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.11);
  border: 1rpx solid rgba(255, 122, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  line-height: 1.2;
  white-space: nowrap;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.08);
  transition: transform 0.2s ease, opacity 0.2s ease, background 0.3s ease, box-shadow 0.3s ease;
}

.listen-button::after {
  border: none;
}

.listen-button.is-online {
  background: rgba(255, 122, 0, 0.12);
  color: #ff7a00;
}

.listen-button.is-offline {
  background: rgba(255, 122, 0, 0.1);
  color: #ff7a00;
}

.listen-button.is-busy,
.listen-button.disabled {
  background: rgba(148, 163, 184, 0.12);
  border-color: rgba(148, 163, 184, 0.14);
  color: #98a2b3;
  box-shadow: none;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  transition: background 0.3s ease, color 0.3s ease;
}

.status-chip.success {
  color: #ffffff;
  background: linear-gradient(135deg, #17a05e, #33c776);
}

.status-chip.danger {
  color: #ffffff;
  background: linear-gradient(135deg, #ef5f5f, #ff7c7c);
}

.status-chip.neutral,
.status-chip.disabled {
  color: #66788a;
  background: rgba(148, 163, 184, 0.18);
}

.status-chip.pending {
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a28, #ffb44f);
}

.dashboard-bottom-head {
  align-items: flex-start;
  gap: 16rpx;
}

.dashboard-bottom-copy {
  flex: 1;
  min-width: 0;
}

.board-title {
  font-size: 36rpx;
}

.board-desc {
  margin-top: 8rpx;
}

.dashboard-bottom-body {
  flex: 1;
  min-height: 0;
  margin-top: 22rpx;
  overflow: hidden;
}

.dashboard-scroll {
  width: 100%;
  height: 100%;
}

.dashboard-scroll-content {
  min-height: 100%;
  padding: 4rpx 10rpx 16rpx 2rpx;
}

.current-trip-card {
  margin: 4rpx 0 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff7ef 0%, #fff1e1 100%);
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 0, 0.08);
}

.current-trip-card__head,
.current-trip-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.current-trip-card__eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  color: #ff8a12;
}

.current-trip-card__title {
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 800;
  color: #1f2432;
}

.current-trip-card__foot {
  margin-top: 18rpx;
}

.current-trip-card__price {
  font-size: 30rpx;
  font-weight: 800;
  color: #ff7a00;
}

.current-trip-card__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  font-size: 24rpx;
  font-weight: 700;
  color: #ff7a00;
  white-space: nowrap;
}

.order-list {
  width: 100%;
  gap: 18rpx;
  padding: 2rpx 2rpx 24rpx 0;
}

.order-card {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  background: linear-gradient(180deg, rgba(255, 248, 241, 0.98), #ffffff);
  box-shadow: 0 10rpx 24rpx rgba(31, 36, 50, 0.06);
  transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.3s ease;
}

.order-card-head {
  width: 100%;
}

.order-card-top {
  align-items: flex-start;
  gap: 16rpx;
}

.order-card-top .status-tag {
  flex: 0 0 auto;
  min-width: 108rpx;
  min-height: 46rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  word-break: keep-all;
  font-size: 21rpx;
  line-height: 46rpx;
}

.order-card-meta {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  max-width: 100%;
  margin-top: 10rpx;
}

.order-card-new {
  animation: order-enter 0.45s ease both, order-highlight 2s ease 0.2s 1;
}

.order-title {
  font-size: 28rpx;
  line-height: 1.38;
  color: #1f2432;
  word-break: break-word;
}

.order-passenger {
  flex: 1 1 240rpx;
  min-width: 0;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #8a94a8;
  word-break: break-word;
}

.order-seat-hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #6f7b90;
}

.order-intl-mini {
  display: grid;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #f3f7fb;
  border: 1rpx solid rgba(29, 78, 137, 0.08);
}

.order-intl-mini > view:first-child {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.order-intl-mini text {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #1d4e89;
  background: #eaf2fb;
  font-size: 20rpx;
  line-height: 34rpx;
}

.order-intl-mini > view:last-child {
  color: #344054;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-word;
}

.order-price {
  flex: 0 1 auto;
  max-width: 100%;
  margin-left: auto;
  font-size: 28rpx;
  font-weight: 700;
  color: #ff7a00;
  line-height: 1.35;
  text-align: right;
  white-space: nowrap;
}

.order-actions {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  margin-top: 18rpx;
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.order-button {
  width: 100%;
  min-width: 0;
  min-height: 80rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 18rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: none;
  transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.order-actions .order-button {
  flex: 1 1 0;
  width: 0;
  margin: 0;
}

.ghost-button.order-button {
  background: rgba(255, 122, 0, 0.1);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  color: #ff7a00;
}

.primary-button.order-button {
  background: rgba(255, 122, 0, 0.13);
  border: 1rpx solid rgba(255, 122, 0, 0.16);
  color: #ff7a00;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.08);
}

.dashboard-scroll::-webkit-scrollbar {
  width: 8rpx;
}

.dashboard-scroll::-webkit-scrollbar-thumb {
  background: rgba(31, 36, 50, 0.18);
  border-radius: 999rpx;
}

.dashboard-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.empty-board,
.busy-board,
.lock-mask {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 100%;
  padding: 24rpx 8rpx 12rpx;
  text-align: center;
}

.empty-board-image {
  width: 204rpx;
  height: 164rpx;
}

.busy-board {
  min-height: 100%;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(243, 244, 246, 0.98), rgba(255, 255, 255, 0.98));
}

.busy-board__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
}

.busy-board__desc {
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7385;
}

.empty-board-title,
.lock-mask-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
}

.empty-board-desc,
.lock-mask-desc,
.lock-mask-tip {
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7385;
}

.lock-mask {
  padding: 32rpx 18rpx 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 248, 240, 0.98), rgba(255, 255, 255, 0.98));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
}

@keyframes order-enter {
  from {
    opacity: 0;
    transform: translateX(54rpx);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes order-highlight {
  0%,
  100% {
    box-shadow: 0 14rpx 32rpx rgba(31, 36, 50, 0.08);
    border-color: rgba(255, 122, 0, 0.1);
  }

  25%,
  75% {
    box-shadow: 0 18rpx 40rpx rgba(255, 122, 0, 0.22);
    border-color: rgba(255, 122, 0, 0.28);
  }
}

@media (max-height: 700px) {
  .dashboard-map,
  .dashboard-map-mask {
    height: 52vh;
  }

  .dashboard-bottom {
    top: calc(46vh - 10rpx);
    bottom: 16rpx;
  }
}
