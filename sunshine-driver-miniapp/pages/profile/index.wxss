.driver-profile-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 194, 124, 0.2), transparent 32%),
    linear-gradient(180deg, #fff6ea 0%, #f7f8fc 36%, #f5f7fb 100%);
}

.driver-profile {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 22rpx 24rpx calc(env(safe-area-inset-bottom) + 34rpx);
}

.driver-profile-title {
  padding: 32rpx 0 18rpx;
  text-align: center;
  color: #172033;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.driver-hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx 28rpx 24rpx;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 160, 74, 0.28);
  background:
    linear-gradient(115deg, rgba(255, 213, 160, 0.62) 0%, rgba(255, 251, 246, 0.92) 54%, rgba(255, 231, 203, 0.72) 100%),
    #fff7ef;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.12);
}

.driver-city,
.driver-road,
.driver-taxi {
  pointer-events: none;
}

.driver-city {
  position: absolute;
  right: 56rpx;
  top: 26rpx;
  width: 238rpx;
  height: 130rpx;
  opacity: 0.22;
}

.driver-city__block {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.driver-city__block--1 {
  left: 18rpx;
  height: 66rpx;
}

.driver-city__block--2 {
  left: 70rpx;
  height: 110rpx;
}

.driver-city__block--3 {
  left: 128rpx;
  height: 88rpx;
}

.driver-city__block--4 {
  left: 184rpx;
  height: 56rpx;
}

.driver-road {
  position: absolute;
  right: -34rpx;
  top: 144rpx;
  width: 320rpx;
  height: 78rpx;
  border-top: 8rpx solid rgba(255, 255, 255, 0.76);
  transform: rotate(-11deg);
}

.driver-road::after {
  content: "";
  position: absolute;
  right: 20rpx;
  top: 22rpx;
  width: 190rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.88);
}

.driver-taxi {
  position: absolute;
  right: 104rpx;
  top: 166rpx;
  width: 76rpx;
  height: 40rpx;
  transform: rotate(-4deg);
}

.driver-taxi__body,
.driver-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa232 0%, #ff7a00 100%);
  border: 2rpx solid rgba(156, 72, 0, 0.14);
}

.driver-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 68rpx;
  height: 28rpx;
  border-radius: 12rpx 15rpx 9rpx 9rpx;
}

.driver-taxi__top {
  left: 24rpx;
  bottom: 28rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.driver-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #243041;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.driver-taxi__wheel--left {
  left: 15rpx;
}

.driver-taxi__wheel--right {
  right: 13rpx;
}

.driver-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 132rpx;
}

.driver-avatar-wrap {
  position: relative;
  width: 114rpx;
  height: 114rpx;
  flex-shrink: 0;
  padding: 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 26rpx rgba(210, 104, 18, 0.12);
}

.profile-avatar {
  display: block;
  width: 100rpx;
  height: 100rpx;
  border-radius: 999rpx;
  background: #fff4e8;
}

.driver-avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: -2rpx;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a31 0%, #ff7a00 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.94);
  font-size: 18rpx;
  font-weight: 900;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.12;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-desc {
  margin-top: 14rpx;
  color: #4d5b70;
  font-size: 25rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-metrics {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 28rpx;
  padding: 22rpx 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

.driver-metric {
  min-width: 0;
  text-align: center;
  border-right: 1rpx solid rgba(31, 36, 50, 0.12);
}

.driver-metric:last-child {
  border-right: none;
}

.driver-metric__value {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.driver-metric__value--text {
  font-size: 34rpx;
}

.driver-metric__label {
  margin-top: 10rpx;
  color: #566276;
  font-size: 23rpx;
  line-height: 1.2;
}

.permission-card,
.group-card,
.profile-logout-card {
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 16rpx 40rpx rgba(24, 34, 56, 0.065);
}

.permission-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 116rpx;
  padding: 24rpx 72rpx 24rpx 24rpx;
  border-radius: 30rpx;
}

.permission-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb34d 0%, #ff7a00 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.18);
  font-size: 31rpx;
  font-weight: 900;
}

.permission-copy {
  flex: 1;
  min-width: 0;
}

.permission-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
}

.permission-desc {
  margin-top: 9rpx;
  color: #6f788b;
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-chip,
.menu-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 102rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.1;
}

.status-chip.pending {
  color: #c77614;
  background: rgba(255, 176, 32, 0.16);
}

.status-chip.success {
  color: #118650;
  background: rgba(34, 197, 94, 0.16);
}

.status-chip.danger {
  color: #d14343;
  background: rgba(239, 68, 68, 0.16);
}

.status-chip.neutral,
.status-chip.disabled {
  color: #66788a;
  background: rgba(148, 163, 184, 0.18);
}

.group-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.group-title {
  position: relative;
  padding-left: 18rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.group-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 5rpx;
  width: 7rpx;
  height: 31rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.group-card {
  overflow: hidden;
  padding: 0 26rpx;
  border-radius: 30rpx;
}

.menu-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 118rpx;
  padding: 20rpx 44rpx 20rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  color: #ff7a00;
  background: #fff0df;
  font-size: 24rpx;
  font-weight: 900;
}

.group-block:nth-of-type(3) .menu-icon {
  color: #326fe6;
  background: #edf5ff;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.18;
}

.menu-desc {
  margin-top: 9rpx;
  color: #6f788b;
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-badge {
  color: #ff6f00;
  background: #fff1df;
}

.menu-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid rgba(112, 122, 140, 0.42);
  border-right: 4rpx solid rgba(112, 122, 140, 0.42);
  transform: translateY(-50%) rotate(45deg);
}

.group-card .menu-arrow {
  right: 4rpx;
}

.profile-logout-card {
  min-height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #ff5b57;
  font-size: 28rpx;
  font-weight: 800;
}
