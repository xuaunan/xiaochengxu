.driver-profile-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 194, 124, 0.2), transparent 32%),
    linear-gradient(180deg, #fff6ea 0%, #f7f8fc 36%, #f5f7fb 100%);
}

.driver-profile {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 16rpx 22rpx calc(env(safe-area-inset-bottom) + 32rpx);
}

.driver-hero {
  position: relative;
  overflow: hidden;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 160, 74, 0.28);
  background:
    linear-gradient(115deg, rgba(255, 213, 160, 0.62) 0%, rgba(255, 251, 246, 0.92) 54%, rgba(255, 231, 203, 0.72) 100%),
    #fff7ef;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.12);
}

.driver-city,
.driver-road,
.driver-taxi {
  pointer-events: none;
}

.driver-city {
  position: absolute;
  right: 56rpx;
  top: 26rpx;
  width: 238rpx;
  height: 130rpx;
  opacity: 0.22;
}

.driver-city__block {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.driver-city__block--1 {
  left: 18rpx;
  height: 66rpx;
}

.driver-city__block--2 {
  left: 70rpx;
  height: 110rpx;
}

.driver-city__block--3 {
  left: 128rpx;
  height: 88rpx;
}

.driver-city__block--4 {
  left: 184rpx;
  height: 56rpx;
}

.driver-road {
  position: absolute;
  right: -34rpx;
  top: 144rpx;
  width: 320rpx;
  height: 78rpx;
  border-top: 8rpx solid rgba(255, 255, 255, 0.76);
  transform: rotate(-11deg);
}

.driver-road::after {
  content: "";
  position: absolute;
  right: 20rpx;
  top: 22rpx;
  width: 190rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.88);
}

.driver-taxi {
  position: absolute;
  right: 104rpx;
  top: 166rpx;
  width: 76rpx;
  height: 40rpx;
  transform: rotate(-4deg);
}

.driver-taxi__body,
.driver-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa232 0%, #ff7a00 100%);
  border: 2rpx solid rgba(156, 72, 0, 0.14);
}

.driver-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 68rpx;
  height: 28rpx;
  border-radius: 12rpx 15rpx 9rpx 9rpx;
}

.driver-taxi__top {
  left: 24rpx;
  bottom: 28rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.driver-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #243041;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.driver-taxi__wheel--left {
  left: 15rpx;
}

.driver-taxi__wheel--right {
  right: 13rpx;
}

.driver-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 118rpx;
}

.driver-avatar-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 26rpx rgba(210, 104, 18, 0.12);
}

.profile-avatar {
  display: block;
  width: 76rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: #fff4e8;
}

.driver-avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: -2rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a31 0%, #ff7a00 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 16rpx rgba(255, 122, 0, 0.2);
}

.driver-avatar-badge::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 8rpx;
}

.driver-avatar-badge::after {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 15rpx;
  width: 8rpx;
  height: 4rpx;
  border-left: 3rpx solid #ff7a00;
  border-bottom: 3rpx solid #ff7a00;
  transform: rotate(-45deg);
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  color: #172033;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-desc {
  margin-top: 8rpx;
  color: #4d5b70;
  font-size: 21rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-metrics {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

.driver-metric {
  min-width: 0;
  text-align: center;
  border-right: 1rpx solid rgba(31, 36, 50, 0.12);
}

.driver-metric:last-child {
  border-right: none;
}

.driver-metric__value {
  color: #172033;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.16;
}

.driver-metric__value--text {
  font-size: 24rpx;
}

.driver-metric__label {
  margin-top: 8rpx;
  color: #566276;
  font-size: 21rpx;
  line-height: 1.3;
}

.permission-card,
.group-card,
.profile-logout-card {
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 16rpx 40rpx rgba(24, 34, 56, 0.065);
}

.permission-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 20rpx 66rpx 20rpx 22rpx;
  border-radius: 24rpx;
}

.permission-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ffb34d 0%, #ff7a00 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.18);
}

.permission-icon::before {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 15rpx;
  width: 30rpx;
  height: 30rpx;
  border: 6rpx solid #ffffff;
  border-radius: 12rpx;
}

.permission-icon::after {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 27rpx;
  width: 12rpx;
  height: 7rpx;
  border-left: 4rpx solid #ff7a00;
  border-bottom: 4rpx solid #ff7a00;
  transform: rotate(-45deg);
}

.permission-copy {
  flex: 1;
  min-width: 0;
}

.permission-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.28;
}

.permission-desc {
  margin-top: 7rpx;
  color: #6f788b;
  font-size: 21rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-chip,
.menu-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.1;
}

.status-chip.pending {
  color: #c77614;
  background: rgba(255, 176, 32, 0.16);
}

.status-chip.success {
  color: #118650;
  background: rgba(34, 197, 94, 0.16);
}

.status-chip.danger {
  color: #d14343;
  background: rgba(239, 68, 68, 0.16);
}

.status-chip.neutral,
.status-chip.disabled {
  color: #66788a;
  background: rgba(148, 163, 184, 0.18);
}

.group-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.group-title {
  position: relative;
  padding-left: 18rpx;
  color: #172033;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.3;
}

.group-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 7rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.group-card {
  overflow: hidden;
  padding: 0 22rpx;
  border-radius: 24rpx;
}

.menu-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 18rpx 42rpx 18rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #fff0df;
}

.menu-icon::before,
.menu-icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.menu-icon--vehicle::before {
  left: 13rpx;
  top: 24rpx;
  width: 36rpx;
  height: 20rpx;
  border-radius: 8rpx 10rpx 6rpx 6rpx;
  background: #ff7a00;
}

.menu-icon--vehicle::after {
  left: 18rpx;
  top: 17rpx;
  width: 26rpx;
  height: 18rpx;
  border-radius: 14rpx 14rpx 4rpx 4rpx;
  border: 6rpx solid #ff7a00;
  border-bottom: 0;
  box-shadow: -6rpx 24rpx 0 -2rpx #ffffff, 24rpx 24rpx 0 -2rpx #ffffff;
}

.menu-icon--orders {
  background: #edf5ff;
}

.menu-icon--orders::before {
  left: 17rpx;
  top: 13rpx;
  width: 28rpx;
  height: 36rpx;
  border-radius: 7rpx;
  background: #3b82f6;
}

.menu-icon--orders::after {
  left: 24rpx;
  top: 24rpx;
  width: 16rpx;
  height: 14rpx;
  border-top: 4rpx solid rgba(255, 255, 255, 0.95);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.95);
}

.menu-icon--income::before {
  left: 16rpx;
  top: 17rpx;
  width: 30rpx;
  height: 31rpx;
  border-radius: 8rpx;
  background: #ff7a00;
}

.menu-icon--income::after {
  left: 26rpx;
  top: 21rpx;
  width: 12rpx;
  height: 18rpx;
  border-top: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(90deg);
}

.menu-icon--settings {
  background: #eef0ff;
}

.menu-icon--settings::before {
  left: 18rpx;
  top: 18rpx;
  width: 26rpx;
  height: 26rpx;
  border: 8rpx solid #5b6ff0;
  border-radius: 50%;
}

.menu-icon--settings::after {
  left: 28rpx;
  top: 9rpx;
  width: 6rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #5b6ff0;
  box-shadow: 0 0 0 0 #5b6ff0;
  transform: rotate(45deg);
}

.menu-icon--profile::before {
  left: 22rpx;
  top: 13rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.menu-icon--profile::after {
  left: 14rpx;
  top: 34rpx;
  width: 34rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 9rpx 9rpx;
  background: #ff7a00;
}

.menu-icon--bell {
  background: #edf5ff;
}

.menu-icon--bell::before {
  left: 18rpx;
  top: 16rpx;
  width: 26rpx;
  height: 28rpx;
  border-radius: 16rpx 16rpx 9rpx 9rpx;
  background: #3b82f6;
}

.menu-icon--bell::after {
  left: 28rpx;
  top: 45rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #3b82f6;
  box-shadow: 16rpx -29rpx 0 -1rpx #ff5a1f;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.28;
}

.menu-desc {
  margin-top: 7rpx;
  color: #6f788b;
  font-size: 21rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-badge {
  color: #ff6f00;
  background: #fff1df;
}

.menu-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid rgba(112, 122, 140, 0.42);
  border-right: 4rpx solid rgba(112, 122, 140, 0.42);
  transform: translateY(-50%) rotate(45deg);
}

.group-card .menu-arrow {
  right: 4rpx;
}

.profile-logout-card {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #ff5b57;
  font-size: 24rpx;
  font-weight: 500;
}
