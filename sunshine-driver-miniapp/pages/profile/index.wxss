.driver-profile-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 184, 98, 0.28), transparent 32%),
    radial-gradient(circle at 0% 18%, rgba(47, 114, 219, 0.08), transparent 28%),
    linear-gradient(180deg, #fff5e8 0%, #f7f8fc 36%, #f4f6fb 100%);
}

.driver-profile {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 22rpx 36rpx calc(env(safe-area-inset-bottom) + 38rpx);
}

.driver-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx 26rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 160, 74, 0.28);
  background:
    linear-gradient(115deg, rgba(255, 213, 160, 0.62) 0%, rgba(255, 251, 246, 0.92) 54%, rgba(255, 231, 203, 0.72) 100%),
    #fff7ef;
  box-shadow: 0 12rpx 30rpx rgba(210, 104, 18, 0.11);
}

.driver-city,
.driver-road,
.driver-taxi {
  pointer-events: none;
}

.driver-city {
  position: absolute;
  right: 56rpx;
  top: 26rpx;
  width: 238rpx;
  height: 130rpx;
  opacity: 0.22;
}

.driver-city__block {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.driver-city__block--1 {
  left: 18rpx;
  height: 66rpx;
}

.driver-city__block--2 {
  left: 70rpx;
  height: 110rpx;
}

.driver-city__block--3 {
  left: 128rpx;
  height: 88rpx;
}

.driver-city__block--4 {
  left: 184rpx;
  height: 56rpx;
}

.driver-road {
  position: absolute;
  right: -34rpx;
  top: 144rpx;
  width: 320rpx;
  height: 78rpx;
  border-top: 8rpx solid rgba(255, 255, 255, 0.76);
  transform: rotate(-11deg);
}

.driver-road::after {
  content: "";
  position: absolute;
  right: 20rpx;
  top: 22rpx;
  width: 190rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.88);
}

.driver-taxi {
  position: absolute;
  right: 104rpx;
  top: 166rpx;
  width: 76rpx;
  height: 40rpx;
  transform: rotate(-4deg);
}

.driver-taxi__body,
.driver-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa232 0%, #ff7a00 100%);
  border: 2rpx solid rgba(156, 72, 0, 0.14);
}

.driver-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 68rpx;
  height: 28rpx;
  border-radius: 12rpx 15rpx 9rpx 9rpx;
}

.driver-taxi__top {
  left: 24rpx;
  bottom: 28rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.driver-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #243041;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.driver-taxi__wheel--left {
  left: 15rpx;
}

.driver-taxi__wheel--right {
  right: 13rpx;
}

.driver-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 122rpx;
}

.driver-avatar-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 26rpx rgba(210, 104, 18, 0.12);
}

.profile-avatar {
  display: block;
  width: 76rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: #fff4e8;
}

.driver-avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: -2rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a31 0%, #ff7a00 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 16rpx rgba(255, 122, 0, 0.2);
}

.driver-avatar-badge::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 8rpx;
}

.driver-avatar-badge::after {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 15rpx;
  width: 8rpx;
  height: 4rpx;
  border-left: 3rpx solid #ff7a00;
  border-bottom: 3rpx solid #ff7a00;
  transform: rotate(-45deg);
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  color: #172033;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-desc {
  margin-top: 8rpx;
  color: #4d5b70;
  font-size: 21rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-metrics {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

.driver-metric {
  min-width: 0;
  text-align: center;
  border-right: 1rpx solid rgba(31, 36, 50, 0.12);
}

.driver-metric:last-child {
  border-right: none;
}

.driver-metric__value {
  color: #172033;
  font-size: 29rpx;
  font-weight: 450;
  line-height: 1.16;
}

.driver-metric__value--text {
  font-size: 24rpx;
}

.driver-metric__label {
  margin-top: 8rpx;
  color: #566276;
  font-size: 21rpx;
  line-height: 1.3;
}

.permission-card,
.group-card,
.profile-logout-card {
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 12rpx 30rpx rgba(24, 34, 56, 0.058);
}

.permission-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 110rpx;
  padding: 22rpx 70rpx 22rpx 28rpx;
  border-radius: 26rpx;
}

.permission-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff9b32, #ff7a00);
  opacity: 0.72;
}

.permission-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ffb34d 0%, #ff7a00 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.18);
  box-sizing: border-box;
}

.permission-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 25rpx;
  height: 25rpx;
  border: 4rpx solid #ffffff;
  border-radius: 8rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.permission-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 9rpx;
  height: 15rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  box-sizing: border-box;
  transform: translate(-24%, -58%) rotate(42deg);
  transform-origin: center;
}

.permission-copy {
  flex: 1;
  min-width: 0;
}

.permission-title {
  color: #172033;
  font-size: 24rpx;
  font-weight: 450;
  line-height: 1.28;
}

.permission-desc {
  margin-top: 7rpx;
  color: #6f788b;
  font-size: 20rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-chip,
.menu-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 450;
  line-height: 1.1;
}

.status-chip.pending {
  color: #c77614;
  background: rgba(255, 176, 32, 0.16);
}

.status-chip.success {
  color: #118650;
  background: rgba(34, 197, 94, 0.16);
}

.status-chip.danger {
  color: #d14343;
  background: rgba(239, 68, 68, 0.16);
}

.status-chip.neutral,
.status-chip.disabled {
  color: #66788a;
  background: rgba(148, 163, 184, 0.18);
}

.group-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.group-title {
  position: relative;
  padding-left: 16rpx;
  color: #172033;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
}

.group-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 5rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.group-card {
  overflow: hidden;
  padding: 0 28rpx;
  border-radius: 26rpx;
}

.menu-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 108rpx;
  padding: 20rpx 44rpx 20rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.menu-row::before {
  content: "";
  position: absolute;
  left: -24rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 5rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0);
}

.menu-row:active::before {
  background: rgba(255, 122, 0, 0.38);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fff4e7, #ffe8d1);
  box-sizing: border-box;
}

.menu-icon::before,
.menu-icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.menu-icon--vehicle::before {
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 16rpx;
  border-radius: 7rpx 8rpx 5rpx 5rpx;
  background: #ff7a00;
  transform: translate(-50%, -2%);
}

.menu-icon--vehicle::after {
  left: 50%;
  top: 50%;
  width: 21rpx;
  height: 14rpx;
  border-radius: 14rpx 14rpx 4rpx 4rpx;
  border: 4rpx solid #ff7a00;
  border-bottom: 0;
  box-shadow: -6rpx 21rpx 0 -2rpx #ffffff, 20rpx 21rpx 0 -2rpx #ffffff;
  transform: translate(-50%, -72%);
}

.menu-icon--orders {
  background: linear-gradient(180deg, #edf5ff, #ddeaff);
}

.menu-icon--orders::before {
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 30rpx;
  border-radius: 7rpx;
  background: #3b82f6;
  transform: translate(-50%, -50%);
}

.menu-icon--orders::after {
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 11rpx;
  border-top: 3rpx solid rgba(255, 255, 255, 0.95);
  border-bottom: 3rpx solid rgba(255, 255, 255, 0.95);
  transform: translate(-50%, -34%);
}

.menu-icon--income::before {
  left: 50%;
  top: 50%;
  width: 25rpx;
  height: 26rpx;
  border-radius: 8rpx;
  background: #ff7a00;
  transform: translate(-50%, -50%);
}

.menu-icon--income::after {
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 14rpx;
  border-top: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: translate(-50%, -50%) rotate(90deg);
}

.menu-icon--settings {
  background: linear-gradient(180deg, #eef0ff, #e0e4ff);
}

.menu-icon--settings::before {
  left: 50%;
  top: 50%;
  width: 25rpx;
  height: 25rpx;
  border: 3rpx solid #5b6ff0;
  border-radius: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.menu-icon--settings::after {
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: #5b6ff0;
  box-shadow: 0 0 0 0 #5b6ff0;
  transform: translate(-50%, -50%) rotate(45deg);
}

.menu-icon--profile::before {
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff7a00;
  transform: translate(-50%, -80%);
}

.menu-icon--profile::after {
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 16rpx;
  border-radius: 18rpx 18rpx 9rpx 9rpx;
  background: #ff7a00;
  transform: translate(-50%, 18%);
}

.menu-icon--bell {
  background: linear-gradient(180deg, #edf5ff, #ddeaff);
}

.menu-icon--bell::before {
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 27rpx;
  border-radius: 16rpx 16rpx 9rpx 9rpx;
  background: #3b82f6;
  transform: translate(-50%, -54%);
}

.menu-icon--bell::after {
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #3b82f6;
  box-shadow: 13rpx -27rpx 0 -1rpx #ff5a1f;
  transform: translate(-50%, 122%);
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: #172033;
  font-size: 24rpx;
  font-weight: 450;
  line-height: 1.28;
}

.menu-desc {
  margin-top: 7rpx;
  color: #6f788b;
  font-size: 20rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-badge {
  color: #ff6f00;
  background: #fff1df;
}

.menu-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid rgba(112, 122, 140, 0.42);
  border-right: 4rpx solid rgba(112, 122, 140, 0.42);
  transform: translateY(-50%) rotate(45deg);
}

.group-card .menu-arrow {
  right: 4rpx;
}

.profile-logout-card {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: #ff5b57;
  font-size: 23rpx;
  font-weight: 450;
}

.permission-icon,
.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: none;
}

.permission-icon::before,
.permission-icon::after,
.menu-icon::before,
.menu-icon::after {
  display: none;
}

.permission-icon-image,
.menu-icon-image {
  display: block;
  width: 100%;
  height: 100%;
}

.permission-icon {
  background: #eaf8f1;
}

.menu-icon--vehicle {
  background: #fff4d8;
}

.menu-icon--orders,
.menu-icon--bell,
.menu-icon--support {
  background: #edf5ff;
}

.menu-icon--income {
  background: #fff5df;
}

.menu-icon--settings {
  background: #eef0ff;
}

.menu-icon--profile {
  background: #fff0ec;
}

.permission-icon,
.menu-icon,
.menu-icon--vehicle,
.menu-icon--orders,
.menu-icon--bell,
.menu-icon--support,
.menu-icon--income,
.menu-icon--settings,
.menu-icon--profile {
  background: transparent;
}

.permission-icon,
.menu-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 20rpx;
}
