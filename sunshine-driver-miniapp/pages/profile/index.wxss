.profile-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 36rpx;
}

.profile-name {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2432;
}

.profile-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7385;
}

.permission-card {
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 241, 223, 0.92), rgba(255, 255, 255, 1));
}

.permission-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.status-chip.pending {
  color: #c77614;
  background: rgba(255, 153, 0, 0.16);
}

.status-chip.success {
  color: #1d8f56;
  background: rgba(34, 197, 94, 0.16);
}

.status-chip.danger {
  color: #d14343;
  background: rgba(239, 68, 68, 0.16);
}

.status-chip.neutral,
.status-chip.disabled {
  color: #66788a;
  background: rgba(148, 163, 184, 0.18);
}

.group-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-title {
  padding-left: 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2432;
}

.menu-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(247, 248, 252, 0.92));
}

.menu-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
}

.menu-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ff7a00;
  background: #fff1df;
}

.menu-card--logout {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 126rpx;
  background: #ffffff;
}

.menu-title--logout {
  color: #ff5b57;
  text-align: center;
}

.profile-logout-card {
  margin-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}


