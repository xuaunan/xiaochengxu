:root,
page {
  --brand: #ff7a00;
  --brand-soft: #fff1df;
  --brand-deep: #ff9326;
  --brand-warm: #ffb14a;
  --text-primary: #1f2432;
  --text-secondary: #6b7385;
  --text-muted: #98a1b3;
  --line: rgba(31, 36, 50, 0.08);
  --card: #ffffff;
  --page: #f7f8fc;
  --success: #1ba97a;
  --warning: #ffb020;
  --danger: #ff5b57;
  background: var(--page);
  color: var(--text-primary);
  font-size: 28rpx;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
button,
input,
textarea,
scroll-view,
swiper,
swiper-item,
map {
  box-sizing: border-box;
}

input {
  min-height: 76rpx;
}

.search-input,
.login-input,
.auth-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: rgba(247, 248, 252, 0.92);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  font-size: 28rpx;
  line-height: 76rpx;
  color: var(--text-primary);
}

.search-input::placeholder,
.login-input::placeholder,
.auth-input::placeholder {
  color: var(--text-muted);
}

.page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(255, 177, 74, 0.18), transparent 32%),
    linear-gradient(180deg, #fff7ef 0%, #f7f8fc 34%, #f7f8fc 100%);
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

.page-content {
  padding: 24rpx 24rpx 40rpx;
}

.home-page {
  position: relative;
  min-height: 100vh;
  background: #f7f8fc;
}

.home-map {
  width: 100%;
  height: 100vh;
}

.home-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 10;
}

.hero-card,
.panel-card,
.glass-card {
  background: var(--card);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 50rpx rgba(24, 34, 56, 0.08);
}

.hero-card {
  padding: 28rpx;
}

.panel-card {
  padding: 24rpx;
}

.glass-card {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(14rpx);
  padding: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-center {
  display: flex;
  align-items: center;
}

.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-muted {
  color: var(--text-muted);
}

.brand-text {
  color: var(--brand);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--brand-soft);
  color: var(--brand);
}

.divider {
  height: 1rpx;
  background: var(--line);
}

.primary-button,
.ghost-button,
.warn-button {
  border: none;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  padding: 26rpx 28rpx;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-button::after,
.ghost-button::after,
.warn-button::after {
  border: none;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  box-shadow: 0 14rpx 32rpx rgba(255, 122, 0, 0.22);
}

.ghost-button {
  color: var(--brand);
  background: var(--brand-soft);
}

.warn-button {
  color: #ffffff;
  background: linear-gradient(135deg, #ff7f68 0%, #ff5b57 100%);
}

.primary-button.button-hover,
.ghost-button.button-hover,
.warn-button.button-hover,
.tap-scale:active,
.pressable-hover {
  transform: scale(0.98);
  opacity: 0.96;
}

.field-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  background: rgba(247, 248, 252, 0.9);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  border-radius: 24rpx;
}

.field-icon {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.field-icon.start {
  background: #20bf6b;
  box-shadow: 0 0 0 10rpx rgba(32, 191, 107, 0.12);
}

.field-icon.end {
  background: #ff5b57;
  box-shadow: 0 0 0 10rpx rgba(255, 91, 87, 0.12);
}

.field-body {
  flex: 1;
  min-width: 0;
}

.field-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.field-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.08);
}

.chip-active {
  color: var(--brand);
  background: var(--brand-soft);
  border-color: rgba(255, 122, 0, 0.2);
}

.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.waiting {
  color: #c77700;
  background: rgba(255, 176, 32, 0.14);
}

.status-tag.success {
  color: #13885e;
  background: rgba(27, 169, 122, 0.14);
}

.status-tag.processing {
  color: #2c63ff;
  background: rgba(44, 99, 255, 0.12);
}

.status-tag.danger {
  color: #d13d39;
  background: rgba(255, 91, 87, 0.12);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.metric-item {
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 246, 236, 0.92));
}

.metric-value {
  font-size: 34rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.list-gap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton {
  position: relative;
  overflow: hidden;
  background: #eef1f7;
}

.skeleton::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
  animation: shimmer 1.4s infinite;
}

.floating-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 40;
}

.mask-panel {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.38);
  z-index: 60;
}

.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 30rpx);
  animation: slide-up 0.25s ease;
}

.fade-in {
  animation: fade-in 0.3s ease;
}

.slide-in {
  animation: slide-up 0.28s ease;
}

.badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
}

@keyframes shimmer {
  100% {
    transform: translateX(100%);
  }
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
