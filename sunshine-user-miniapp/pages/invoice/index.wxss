.invoice-shell {
  background:
    linear-gradient(180deg, rgba(255, 246, 237, 0.64) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.invoice-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.invoice-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 8rpx 2rpx;
}

.invoice-title {
  font-size: 34rpx;
}

.invoice-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a94a8;
}

.invoice-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.invoice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.invoice-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.invoice-card__title {
  font-size: 29rpx;
  font-weight: 800;
  color: #1f2432;
}

.invoice-card__time {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7a8396;
}

.invoice-card .brand-text {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.invoice-button {
  width: 100%;
  margin-top: 18rpx;
  min-height: 84rpx;
  border-radius: 22rpx;
}
