.invoice-shell {
  background:
    radial-gradient(circle at 84% 10%, rgba(255, 211, 156, 0.24) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f7f8fc 100%);
}

.invoice-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 16rpx;
}

.invoice-hero {
  position: relative;
  min-height: 162rpx;
  padding: 26rpx 190rpx 24rpx 112rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.16);
  background:
    linear-gradient(112deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.94) 54%, rgba(255, 230, 196, 0.78) 100%);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
  overflow: hidden;
  box-sizing: border-box;
}

.invoice-hero__icon {
  position: absolute;
  left: 30rpx;
  top: 32rpx;
  width: 72rpx;
  height: 86rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.8), rgba(255, 122, 0, 0.78));
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.7), 0 18rpx 34rpx rgba(255, 122, 0, 0.18);
}

.invoice-doc-lines {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 28rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 0 rgba(255, 255, 255, 0.72), 0 36rpx 0 rgba(255, 255, 255, 0.52);
}

.invoice-hero__check {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffae58, #ff7a00);
  border: 4rpx solid #ffffff;
}

.invoice-hero__check::after {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 13rpx;
  width: 20rpx;
  height: 12rpx;
  border-left: 5rpx solid #ffffff;
  border-bottom: 5rpx solid #ffffff;
  transform: rotate(-45deg);
}

.invoice-hero__copy {
  position: relative;
  z-index: 2;
}

.invoice-hero__title {
  font-size: 38rpx;
  font-weight: 700;
  color: #21150e;
  line-height: 1.15;
}

.invoice-hero__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #747d8f;
  line-height: 1.3;
  white-space: nowrap;
}

.invoice-count {
  position: absolute;
  right: 24rpx;
  top: 38rpx;
  z-index: 2;
  min-width: 102rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.84);
  background: rgba(255, 255, 255, 0.64);
  box-shadow: 0 8rpx 20rpx rgba(31, 41, 55, 0.06);
  color: #ff6b00;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
  box-sizing: border-box;
}

.invoice-paper {
  position: absolute;
  right: 46rpx;
  bottom: 12rpx;
  width: 154rpx;
  height: 98rpx;
  opacity: 0.68;
}

.invoice-paper__sheet {
  position: absolute;
  right: 42rpx;
  bottom: 0;
  width: 112rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.74);
  transform: rotate(11deg);
}

.invoice-paper__sheet::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 20rpx;
  top: 24rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 191, 117, 0.46);
  box-shadow: 0 24rpx 0 rgba(255, 191, 117, 0.32), 0 48rpx 0 rgba(255, 191, 117, 0.22);
}

.invoice-paper__leaf {
  position: absolute;
  right: 0;
  bottom: 14rpx;
  width: 28rpx;
  height: 56rpx;
  border-radius: 28rpx 28rpx 0 28rpx;
  background: rgba(255, 195, 130, 0.32);
  transform-origin: bottom left;
}

.invoice-paper__leaf--one {
  transform: rotate(-32deg);
}

.invoice-paper__leaf--two {
  right: 24rpx;
  transform: rotate(18deg);
}

.invoice-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.invoice-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.invoice-card__top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.invoice-service-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 122, 0, 0.18);
  background: rgba(255, 247, 237, 0.98);
}

.invoice-service-icon--carpool {
  border-color: rgba(39, 157, 84, 0.2);
  background: rgba(237, 250, 239, 0.98);
}

.invoice-service-icon--international {
  border-color: rgba(37, 99, 235, 0.2);
  background: rgba(237, 245, 255, 0.98);
}

.invoice-service-icon__shape,
.invoice-service-icon__shape::before,
.invoice-service-icon__shape::after {
  position: absolute;
  content: "";
  box-sizing: border-box;
}

.invoice-service-icon__shape {
  left: 20rpx;
  top: 38rpx;
  width: 48rpx;
  height: 25rpx;
  border-radius: 14rpx 18rpx 10rpx 10rpx;
  background: #ff7a00;
}

.invoice-service-icon__shape::before {
  left: 14rpx;
  top: -18rpx;
  width: 28rpx;
  height: 20rpx;
  border-radius: 16rpx 16rpx 4rpx 4rpx;
  border: 4rpx solid #ff7a00;
  border-bottom: 0;
}

.invoice-service-icon__shape::after {
  left: 8rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 32rpx 0 0 #ffffff;
}

.invoice-service-icon--carpool .invoice-service-icon__shape {
  background: #2f9f58;
}

.invoice-service-icon--carpool .invoice-service-icon__shape::before {
  border-color: #2f9f58;
}

.invoice-service-icon--international .invoice-service-icon__shape {
  left: 26rpx;
  top: 26rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  border: 6rpx solid #3d7cf2;
  background: transparent;
}

.invoice-service-icon--international .invoice-service-icon__shape::before {
  left: 19rpx;
  top: -6rpx;
  width: 8rpx;
  height: 54rpx;
  border: 0;
  border-radius: 999rpx;
  background: #3d7cf2;
  transform: rotate(28deg);
}

.invoice-service-icon--international .invoice-service-icon__shape::after {
  left: 9rpx;
  top: 18rpx;
  width: 38rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #3d7cf2;
  transform: rotate(28deg);
}

.invoice-card__main {
  flex: 1;
  min-width: 0;
}

.invoice-tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  color: #ff6b00;
  background: rgba(255, 122, 0, 0.1);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.invoice-tag--carpool {
  color: #26954f;
  background: rgba(39, 157, 84, 0.12);
}

.invoice-tag--international {
  color: #2563eb;
  background: rgba(37, 99, 235, 0.12);
}

.invoice-card__title {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.22;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.invoice-card__time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  color: #8a94a8;
  font-size: 23rpx;
  line-height: 1.2;
}

.invoice-time-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid #9aa3b2;
  box-sizing: border-box;
}

.invoice-time-icon::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 3rpx;
  width: 4rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: #9aa3b2;
  box-shadow: 5rpx 7rpx 0 -1rpx #9aa3b2;
}

.invoice-amount {
  flex-shrink: 0;
  color: #ef6b20;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  margin-left: 12rpx;
}

.invoice-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 64rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.96), rgba(255, 255, 255, 0.98));
  color: #c6531f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  box-sizing: border-box;
}

.invoice-button::after {
  border: 0;
}

.invoice-button__arrow {
  font-size: 28rpx;
  line-height: 1;
}

.invoice-button--disabled {
  color: #8b94a7;
  border-color: rgba(31, 36, 50, 0.08);
  background: #f5f6f9;
}

.invoice-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  padding: 38rpx 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.invoice-empty__icon {
  position: relative;
  width: 88rpx;
  height: 104rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.8), rgba(255, 122, 0, 0.78));
}

.invoice-empty__icon::after {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 30rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 22rpx 0 rgba(255, 255, 255, 0.62);
}

.invoice-empty__title {
  margin-top: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.invoice-empty__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8b94a7;
}
