.invoice-page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 48% 0%, rgba(255, 198, 128, 0.2), transparent 30%),
    linear-gradient(180deg, #fff6ea 0%, #f7f8fc 38%, #f5f7fb 100%);
}

.invoice-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 22rpx 32rpx;
}

.invoice-hero {
  position: relative;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 160, 74, 0.24);
  background:
    linear-gradient(115deg, rgba(255, 211, 157, 0.5) 0%, rgba(255, 250, 244, 0.92) 52%, rgba(255, 233, 209, 0.68) 100%),
    #fff7ef;
  box-shadow: 0 14rpx 34rpx rgba(210, 104, 18, 0.1);
  box-sizing: border-box;
}

.invoice-hero__icon {
  position: relative;
  width: 58rpx;
  height: 66rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(255, 122, 0, 0.38);
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.12);
}

.invoice-doc-lines {
  position: absolute;
  left: 13rpx;
  right: 13rpx;
  top: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.72);
  box-shadow: 0 14rpx 0 rgba(255, 122, 0, 0.34), 0 28rpx 0 rgba(255, 122, 0, 0.22);
}

.invoice-hero__check {
  position: absolute;
  right: -5rpx;
  bottom: -5rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: #ff7a00;
  border: 3rpx solid #ffffff;
}

.invoice-hero__check::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 11rpx;
  height: 7rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: translate(-50%, -56%) rotate(-45deg);
}

.invoice-hero__copy {
  flex: 1;
  min-width: 0;
}

.invoice-hero__title {
  color: #172033;
  font-size: 30rpx;
  line-height: 1.18;
  font-weight: 550;
}

.invoice-hero__desc {
  margin-top: 8rpx;
  color: #6f788b;
  font-size: 22rpx;
  line-height: 1.36;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invoice-count,
.invoice-soft-pill {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff1df;
  font-size: 22rpx;
  line-height: 1.1;
  font-weight: 500;
}

.invoice-count {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 122, 0, 0.14);
}

.invoice-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.05);
}

.invoice-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  border-radius: 14rpx;
  color: #7a8396;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 400;
}

.invoice-tab--active {
  color: #ff6f00;
  font-weight: 500;
  background: #fff3e6;
  box-shadow: inset 0 0 0 1rpx rgba(255, 122, 0, 0.2);
}

.invoice-section-head,
.invoice-title-wrap {
  display: flex;
  align-items: center;
}

.invoice-section-head {
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 4rpx 0;
}

.invoice-title-wrap {
  gap: 14rpx;
  min-width: 0;
}

.invoice-section-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  border-radius: 13rpx;
  background: #fff0df;
  color: #ff7a00;
  box-sizing: border-box;
}

.invoice-section-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 24rpx;
  border-radius: 6rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.invoice-section-icon--issued {
  color: #2f72db;
  background: #eaf2ff;
}

.invoice-section-title {
  color: #172033;
  font-size: 27rpx;
  line-height: 1.24;
  font-weight: 550;
}

.invoice-list,
.invoice-issued-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.invoice-card,
.invoice-issued-row,
.invoice-empty {
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
}

.invoice-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-height: 150rpx;
  padding: 20rpx;
}

.invoice-service-icon,
.invoice-issued-row__badge {
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border-radius: 15rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.18);
  background: rgba(255, 247, 237, 0.98);
  color: #ff7a00;
}

.invoice-service-icon--carpool,
.invoice-issued-row__badge--carpool {
  border-color: rgba(39, 157, 84, 0.2);
  background: rgba(237, 250, 239, 0.98);
  color: #2f9f58;
}

.invoice-service-icon--international,
.invoice-issued-row__badge--international {
  border-color: rgba(37, 99, 235, 0.2);
  background: rgba(237, 245, 255, 0.98);
  color: #3d7cf2;
}

.invoice-service-icon__image {
  width: 100%;
  height: 100%;
  display: block;
}

.invoice-card__main,
.invoice-issued-row__main {
  flex: 1;
  min-width: 0;
}

.invoice-tag,
.invoice-issued-row__tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 32rpx;
  padding: 0 11rpx;
  border-radius: 9rpx;
  color: #ff6b00;
  background: rgba(255, 122, 0, 0.1);
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
  box-sizing: border-box;
}

.invoice-tag--carpool {
  color: #26954f;
  background: rgba(39, 157, 84, 0.12);
}

.invoice-tag--international {
  color: #2563eb;
  background: rgba(37, 99, 235, 0.12);
}

.invoice-card__title,
.invoice-issued-row__title {
  margin-top: 7rpx;
  color: #172033;
  font-size: 25rpx;
  line-height: 1.26;
  font-weight: 550;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invoice-card__time,
.invoice-issued-row__meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 7rpx;
  color: #8a94a8;
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invoice-time-icon {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #9aa3b2;
  box-sizing: border-box;
}

.invoice-time-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 3rpx;
  width: 3rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #9aa3b2;
  box-shadow: 4rpx 6rpx 0 -1rpx #9aa3b2;
  transform: translateX(-50%);
}

.invoice-card__side {
  flex-shrink: 0;
  max-width: 150rpx;
  padding-top: 38rpx;
  text-align: right;
}

.invoice-amount,
.invoice-issued-row__amount {
  color: #ef6b20;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 550;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invoice-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 260rpx;
  height: 44rpx;
  margin: 14rpx 0 0;
  padding: 0;
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  border-radius: 15rpx;
  background: #fff8ef;
  color: #d85e14;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
  box-sizing: border-box;
}

.invoice-button::after {
  border: 0;
}

.invoice-button__arrow {
  font-size: 25rpx;
  line-height: 1;
}

.invoice-button--disabled {
  color: #8b94a7;
  border-color: rgba(31, 36, 50, 0.08);
  background: #f5f6f9;
}

.invoice-card__reason {
  margin-top: 9rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(255, 241, 242, 0.94);
  color: #e05252;
  font-size: 20rpx;
  line-height: 1.35;
}

.invoice-issued-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 18rpx 18rpx;
}

.invoice-issued-row--active {
  border-color: rgba(255, 122, 0, 0.24);
  background: linear-gradient(135deg, rgba(255, 248, 238, 0.98), rgba(255, 255, 255, 0.98));
}

.invoice-issued-row__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.invoice-issued-row__arrow {
  flex-shrink: 0;
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid rgba(112, 122, 140, 0.42);
  border-right: 4rpx solid rgba(112, 122, 140, 0.42);
  transform: rotate(45deg);
}

.invoice-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  padding: 32rpx 24rpx;
}

.invoice-empty__icon {
  position: relative;
  width: 70rpx;
  height: 82rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.8), rgba(255, 122, 0, 0.78));
}

.invoice-empty__icon::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 25rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 0 rgba(255, 255, 255, 0.62);
}

.invoice-empty__title {
  margin-top: 14rpx;
  color: #172033;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 500;
}

.invoice-empty__desc {
  margin-top: 8rpx;
  color: #737d90;
  font-size: 21rpx;
  line-height: 1.5;
  font-weight: 400;
}

.invoice-viewer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.42);
}

.invoice-viewer {
  width: 100%;
  max-height: 82vh;
  padding: 22rpx 22rpx calc(env(safe-area-inset-bottom) + 22rpx);
  border-radius: 26rpx 26rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -16rpx 42rpx rgba(15, 23, 42, 0.16);
  box-sizing: border-box;
}

.invoice-viewer__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.invoice-viewer__title {
  color: #111827;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 550;
}

.invoice-viewer__sub {
  margin-top: 6rpx;
  color: #8b94a7;
  font-size: 21rpx;
}

.invoice-viewer__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f4f5f8;
  color: #6b7280;
  font-size: 34rpx;
  line-height: 1;
}

.invoice-viewer__scroll {
  width: 100%;
  height: 380rpx;
  max-height: 62vh;
  padding: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fff8ef 0%, #f7f8fc 100%);
  white-space: normal;
  box-sizing: border-box;
}

.invoice-viewer__image {
  display: block;
  width: 100%;
  height: auto;
  max-width: 100%;
  margin: 0 auto;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(37, 43, 58, 0.1);
  box-sizing: border-box;
}

.invoice-viewer__loading {
  height: 380rpx;
  color: #8b94a7;
  font-size: 22rpx;
  line-height: 380rpx;
  text-align: center;
}

.invoice-viewer__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.invoice-viewer__button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  padding: 0;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  background: #fff7ed;
  color: #d85e14;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 500;
  box-sizing: border-box;
}

.invoice-viewer__button::after {
  border: 0;
}

.invoice-viewer__button--primary {
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9d2e 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 0, 0.22);
}
