<view class="page-shell invoice-page-shell safe-bottom">
  <view class="invoice-page page-enter">
    <view class="invoice-hero">
      <view class="invoice-hero__icon">
        <view class="invoice-doc-lines"></view>
        <view class="invoice-hero__check"></view>
      </view>
      <view class="invoice-hero__copy">
        <view class="invoice-hero__title">发票中心</view>
        <view class="invoice-hero__desc">订单开票申请与已开具发票</view>
      </view>
      <view class="invoice-count">{{issuedList.length}} 张</view>
    </view>

    <view class="invoice-tabs">
      <view
        class="invoice-tab {{activeTab === 'apply' ? 'invoice-tab--active' : ''}}"
        data-tab="apply"
        bindtap="switchInvoiceTab"
      >
        可申请
      </view>
      <view
        class="invoice-tab {{activeTab === 'issued' ? 'invoice-tab--active' : ''}}"
        data-tab="issued"
        bindtap="switchInvoiceTab"
      >
        我的发票
      </view>
    </view>

    <block wx:if="{{activeTab === 'apply'}}">
      <view class="invoice-section-head">
        <view class="invoice-title-wrap">
          <view class="invoice-section-icon invoice-section-icon--apply"></view>
          <view class="invoice-section-title">可申请发票</view>
        </view>
        <view class="invoice-soft-pill">{{applyList.length}} 单</view>
      </view>

      <view class="invoice-list" wx:if="{{applyList.length}}">
        <view class="invoice-card tap-scale" wx:for="{{applyList}}" wx:key="id">
          <view class="invoice-service-icon invoice-service-icon--{{item.iconClass}}">
            <image class="invoice-service-icon__image" src="{{item.iconPath}}" mode="aspectFit"></image>
          </view>
          <view class="invoice-card__main">
            <view class="invoice-tag invoice-tag--{{item.iconClass}}">{{item.serviceTag}}</view>
            <view class="invoice-card__title">{{item.title}}</view>
            <view class="invoice-card__time">
              <view class="invoice-time-icon"></view>
              <text>{{item.displayTime}}</text>
            </view>
            <view wx:if="{{item.rejectReason}}" class="invoice-card__reason">驳回原因：{{item.rejectReason}}</view>
            <button
              class="invoice-button {{item.canApply ? '' : 'invoice-button--disabled'}}"
              hover-class="button-hover"
              data-id="{{item.id}}"
              bindtap="applyInvoice"
              loading="{{applyingInvoiceId === '' + item.id}}"
              disabled="{{!item.canApply || applyingInvoiceId === '' + item.id}}"
            >
              <text>{{applyingInvoiceId === '' + item.id ? '申请中...' : item.status}}</text>
              <text class="invoice-button__arrow">›</text>
            </button>
          </view>
          <view class="invoice-card__side">
            <view class="invoice-amount">{{item.amountText}}</view>
          </view>
        </view>
      </view>

      <view class="invoice-empty" wx:else>
        <view class="invoice-empty__icon"></view>
        <view class="invoice-empty__title">暂无可申请发票</view>
        <view class="invoice-empty__desc">完成并支付的订单会自动出现在这里。</view>
      </view>
    </block>

    <block wx:else>
      <view class="invoice-section-head">
        <view class="invoice-title-wrap">
          <view class="invoice-section-icon invoice-section-icon--issued"></view>
          <view class="invoice-section-title">我的发票</view>
        </view>
        <view class="invoice-soft-pill">{{issuedList.length}} 张</view>
      </view>

      <view class="invoice-issued-list" wx:if="{{issuedList.length}}">
        <view
          class="invoice-issued-row tap-scale {{selectedInvoiceId === '' + item.id ? 'invoice-issued-row--active' : ''}}"
          wx:for="{{issuedList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="viewInvoice"
        >
          <view class="invoice-issued-row__badge invoice-issued-row__badge--{{item.iconClass}}">
            <image class="invoice-service-icon__image" src="{{item.iconPath}}" mode="aspectFit"></image>
          </view>
          <view class="invoice-issued-row__main">
            <view class="invoice-issued-row__top">
              <text class="invoice-issued-row__tag">{{item.serviceTag}}</text>
              <text class="invoice-issued-row__amount">{{item.amountText}}</text>
            </view>
            <view class="invoice-issued-row__title">{{item.title}}</view>
            <view class="invoice-issued-row__meta">订单 {{item.orderNo}} · {{item.issueTime || item.displayTime}}</view>
          </view>
          <view class="invoice-issued-row__arrow"></view>
        </view>
      </view>

      <view class="invoice-empty" wx:else>
        <view class="invoice-empty__icon"></view>
        <view class="invoice-empty__title">暂无已开具发票</view>
        <view class="invoice-empty__desc">发票开具后，会出现在我的发票里。</view>
      </view>
    </block>

    <view wx:if="{{invoiceViewerVisible}}" class="invoice-viewer-mask" catchtouchmove="noop">
      <view class="invoice-viewer">
        <view class="invoice-viewer__head">
          <view>
            <view class="invoice-viewer__title">电子发票</view>
            <view class="invoice-viewer__sub">{{viewerInvoice.orderNo}}</view>
          </view>
          <view class="invoice-viewer__close" bindtap="closeInvoiceViewer">×</view>
        </view>
        <scroll-view class="invoice-viewer__scroll" style="{{invoiceScrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
          <view wx:if="{{invoiceImageLoading}}" class="invoice-viewer__loading">发票图片生成中...</view>
          <image
            wx:elif="{{invoiceImagePath}}"
            class="invoice-viewer__image"
            style="{{invoiceImageStyle}}"
            src="{{invoiceImagePath}}"
            mode="aspectFit"
            bindload="handleInvoiceImageLoad"
            bindtap="previewInvoiceImage"
          ></image>
          <view wx:else class="invoice-viewer__loading">发票图片暂不可用</view>
        </scroll-view>
        <view class="invoice-viewer__actions">
          <button class="invoice-viewer__button" bindtap="previewInvoiceImage" disabled="{{!invoiceImagePath}}">查看大图</button>
          <button class="invoice-viewer__button invoice-viewer__button--primary" bindtap="saveInvoiceImage" disabled="{{!invoiceImagePath}}">保存相册</button>
        </view>
      </view>
    </view>
  </view>
</view>
