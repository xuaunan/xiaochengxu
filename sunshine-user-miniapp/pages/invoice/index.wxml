<view class="page-shell safe-bottom">
  <view class="page-content list-gap page-enter">
    <view class="hero-card invoice-hero">
      <view class="section-title">发票中心</view>
      <view class="section-subtitle">可开票订单会实时同步，支持按订单发起电子发票申请。</view>
    </view>
    <view class="panel-card invoice-card" wx:for="{{list}}" wx:key="id">
      <view class="row-between">
        <view>
          <view class="section-title">{{item.title}}</view>
          <view class="section-subtitle">{{item.createdAt}}</view>
        </view>
        <view class="brand-text">{{item.amountText}}</view>
      </view>
      <button class="ghost-button invoice-button" hover-class="button-hover" data-id="{{item.id}}" bindtap="applyInvoice">{{item.status}}</button>
    </view>
  </view>
</view>
