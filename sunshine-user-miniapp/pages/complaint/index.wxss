.complaint-shell {
  background:
    linear-gradient(180deg, rgba(255, 246, 237, 0.64) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.complaint-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.complaint-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 8rpx 2rpx;
}

.complaint-title {
  font-size: 34rpx;
}

.complaint-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a94a8;
}

.complaint-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.complaint-form {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.complaint-form__title {
  font-size: 31rpx;
  font-weight: 800;
  color: #1f2432;
}

.complaint-form__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #6f7b90;
}

.review-textarea {
  width: 100%;
  min-height: 240rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  color: #1f2432;
  line-height: 1.65;
}

.complaint-form .primary-button {
  width: 100%;
  margin-top: 22rpx;
  min-height: 92rpx;
  border-radius: 24rpx;
}

.complaint-history {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.complaint-history__title {
  padding: 0 6rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2432;
}

.complaint-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.complaint-card__title {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2432;
}

.complaint-card__time {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #7a8396;
}

.complaint-empty {
  padding: 48rpx 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
  text-align: center;
}

.complaint-empty__title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2432;
}

.complaint-empty__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #7a8396;
}
