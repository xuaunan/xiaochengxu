.complaint-hero {
  overflow: hidden;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 177, 74, 0.24), transparent 36%),
    linear-gradient(180deg, #ffffff 0%, #fff8ef 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.review-textarea {
  width: 100%;
  min-height: 240rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  color: #1f2432;
  line-height: 1.65;
}

.complaint-hero .primary-button {
  width: 100%;
  margin-top: 22rpx;
  min-height: 92rpx;
  border-radius: 999rpx;
}

.complaint-card {
  border: 1rpx solid rgba(255, 122, 0, 0.07);
}


