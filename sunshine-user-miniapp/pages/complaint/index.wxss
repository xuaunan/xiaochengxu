.complaint-shell {
  background:
    radial-gradient(circle at 92% 0%, rgba(255, 193, 117, 0.12), transparent 34%),
    linear-gradient(180deg, #fff8f2 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.complaint-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.complaint-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 6rpx 0;
}

.complaint-kicker {
  margin-bottom: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #ff7a00;
}

.complaint-title {
  font-size: 36rpx;
}

.complaint-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.1);
  font-size: 21rpx;
  font-weight: 800;
}

.complaint-form {
  padding: 26rpx;
}

.complaint-form__title {
  font-size: 31rpx;
  font-weight: 800;
  color: #1f2432;
}

.complaint-form__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #6f7b90;
}

.review-textarea {
  width: 100%;
  min-height: 240rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #f7f8fc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  color: #1f2432;
  line-height: 1.65;
}

.complaint-form .primary-button {
  width: 100%;
  margin-top: 22rpx;
  min-height: 92rpx;
  border-radius: 26rpx;
}

.complaint-history {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.complaint-history__title {
  padding: 0 6rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2432;
}

.complaint-card {
  padding: 24rpx;
}

.complaint-card__title {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2432;
}

.complaint-card__time {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #7a8396;
}
