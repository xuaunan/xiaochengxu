.complaint-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.22) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.complaint-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
}

.complaint-hero,
.complaint-form,
.complaint-card,
.complaint-empty {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.complaint-hero {
  position: relative;
  min-height: 160rpx;
  padding: 30rpx 170rpx 30rpx 30rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.complaint-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.18;
}

.complaint-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #737c90;
}

.complaint-count {
  position: absolute;
  right: 30rpx;
  top: 32rpx;
  z-index: 2;
  min-width: 92rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
}

.complaint-hero__icon {
  position: absolute;
  right: 52rpx;
  bottom: 20rpx;
  width: 84rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.82), rgba(255, 122, 0, 0.76));
}

.complaint-hero__icon::before,
.complaint-hero__icon::after {
  content: "";
  position: absolute;
  background: #ffffff;
}

.complaint-hero__icon::before {
  left: 22rpx;
  top: 22rpx;
  width: 40rpx;
  height: 8rpx;
  border-radius: 999rpx;
  box-shadow: 0 18rpx 0 rgba(255, 255, 255, 0.78);
}

.complaint-hero__icon::after {
  left: 37rpx;
  bottom: 14rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.complaint-form {
  padding: 28rpx;
}

.complaint-form__title {
  font-size: 32rpx;
  font-weight: 900;
  color: #111827;
}

.complaint-form__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #667085;
}

.review-textarea {
  width: 100%;
  min-height: 240rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  color: #111827;
  font-size: 27rpx;
  line-height: 1.65;
  box-sizing: border-box;
}

.complaint-submit {
  width: 100%;
  height: 92rpx;
  margin-top: 22rpx;
  border-radius: 20rpx;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.complaint-history {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.complaint-history__title {
  padding: 0 6rpx;
  font-size: 31rpx;
  font-weight: 900;
  color: #111827;
}

.complaint-card {
  padding: 24rpx;
}

.complaint-card__title {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 900;
  color: #111827;
}

.complaint-card__time {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #7a8396;
}

.complaint-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
  text-align: center;
}

.complaint-empty__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.82), rgba(255, 122, 0, 0.76));
}

.complaint-empty__title {
  margin-top: 24rpx;
  font-size: 29rpx;
  font-weight: 900;
  color: #111827;
}

.complaint-empty__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #7a8396;
}
