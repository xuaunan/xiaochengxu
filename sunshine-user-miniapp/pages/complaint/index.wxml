<view class="page-shell complaint-shell safe-bottom">
  <view class="page-content complaint-page page-enter">
    <view class="complaint-header">
      <view>
        <view class="section-title complaint-title">投诉与建议</view>
        <view class="complaint-subtitle">订单问题与服务反馈</view>
      </view>
      <view class="complaint-count">{{history.length}} 条</view>
    </view>

    <view class="panel-card complaint-form">
      <view class="complaint-form__title">提交投诉或建议</view>
      <view class="complaint-form__desc">描述订单问题、司机服务反馈或产品建议，平台会记录处理进度。</view>
      <textarea class="review-textarea" placeholder="请输入订单问题、司机服务反馈或产品建议" value="{{content}}" bindinput="updateContent"></textarea>
      <button class="primary-button" hover-class="button-hover" bindtap="submitComplaint">提交反馈</button>
    </view>

    <view class="complaint-history">
      <view class="complaint-history__title">处理记录</view>
      <view wx:if="{{history.length === 0}}" class="complaint-empty">
        <view class="complaint-empty__title">暂无处理记录</view>
        <view class="complaint-empty__desc">提交反馈后，处理进度会显示在这里。</view>
      </view>
      <view class="panel-card complaint-card tap-scale" wx:for="{{history}}" wx:key="id">
        <view class="row-between">
          <view class="complaint-card__title">{{item.title}}</view>
          <view class="status-tag processing">{{item.status}}</view>
        </view>
        <view class="complaint-card__time">{{item.createdAt}}</view>
      </view>
    </view>
  </view>
</view>
