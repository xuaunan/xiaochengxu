.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  background: linear-gradient(180deg, #eef3f8 0%, #f7f8fc 100%);
}

.arrival-nav {
  position: relative;
  z-index: 20;
}

.arrival-direct-back {
  position: absolute;
  left: 24rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  width: 120px;
  color: #6b7385;
  font-size: 26rpx;
}

.arrival-direct-back--hover {
  color: #ff7a00;
  opacity: 0.72;
}

.arrival-map-stage {
  position: relative;
  width: 100%;
  height: 40vh;
  overflow: hidden;
  background: #e7edf3;
}

.arrival-map-stage .arrival-map {
  display: block;
  width: 100%;
  height: 100%;
}

.arrival-content {
  position: relative;
  padding: 26rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
}

.arrival-bottom {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16rpx);
  box-shadow: 0 16rpx 36rpx rgba(31, 36, 50, 0.1);
}

.arrival-map-follow {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  z-index: 5;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  max-height: 64rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 20rpx rgba(31, 36, 50, 0.12);
  color: #4f596d;
}

.arrival-map-follow::after {
  border: none;
}

.arrival-map-follow__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.arrival-map-follow__icon::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.arrival-map-follow.following {
  color: #5d687a;
}

.arrival-map-follow.paused {
  color: #ff7a00;
  border-color: rgba(255, 122, 0, 0.22);
}

.arrival-map-follow--hover {
  transform: scale(0.94);
  opacity: 0.9;
}

.arrival-metrics {
  margin-top: 18rpx;
  gap: 12rpx;
}

.arrival-metrics .metric-item {
  min-width: 0;
  padding: 15rpx 12rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.055);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: none;
}

.arrival-metrics .metric-value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #263044;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.2;
}

.arrival-metrics .metric-label {
  margin-top: 6rpx;
  color: #8791a2;
  font-size: 18rpx;
  line-height: 1.25;
}

.arrival-chip-row {
  display: grid;
  grid-template-columns: 0.88fr 1.12fr;
  align-items: stretch;
  gap: 10rpx;
  margin-top: 16rpx;
}

.arrival-chip-row .chip {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 62rpx;
  box-sizing: border-box;
  padding: 11rpx 13rpx;
  border-radius: 18rpx;
  color: #6f7a8d;
  font-size: 18rpx;
  line-height: 1.45;
}

.arrival-chip-row .chip:first-child {
  color: #536b96;
  background: #f2f6ff;
  border-color: rgba(72, 116, 196, 0.14);
}

.arrival-chip-row .chip:last-child {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  background: #fbfcfe;
}

.arrival-actions {
  display: grid;
  grid-template-columns: 0.86fr 1.24fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.arrival-button,
.arrival-cancel {
  width: 100%;
  margin: 0;
  min-height: 76rpx;
  padding: 22rpx 10rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
}

.arrival-button[disabled],
.arrival-cancel[disabled] {
  opacity: 0.72;
}


