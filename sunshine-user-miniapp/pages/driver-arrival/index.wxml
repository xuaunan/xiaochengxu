<view class="home-page page-enter" wx:if="{{order}}">
  <view class="arrival-nav">
    <sun-nav title="司机已接单" subtitle="司机位置每 3 秒自动刷新"></sun-nav>
    <view class="arrival-direct-back" style="top: {{statusBarHeight}}px; height: {{navHeight}}px;" role="button" aria-label="返回" hover-class="arrival-direct-back--hover" catchtap="handleDirectBack">返回</view>
  </view>

  <view class="arrival-map-stage" style="height: {{mapBodyHeight}}px;">
    <map
      id="arrivalMap"
      class="home-map arrival-map"
      style="height: {{mapBodyHeight}}px;"
      longitude="{{mapCenter.longitude || order.start.longitude}}"
      latitude="{{mapCenter.latitude || order.start.latitude}}"
      scale="12"
      markers="{{markers}}"
      polyline="{{polyline}}"
      bindregionchange="handleMapRegionChange"
      enable-rotate
      enable-overlooking
    ></map>

    <view class="arrival-map-follow {{mapFollowMode ? 'following' : 'paused'}}" role="button" aria-label="回到车辆视角" hover-class="arrival-map-follow--hover" bindtap="restoreVehicleView">
      <view class="arrival-map-follow__icon"></view>
    </view>
  </view>

  <view class="arrival-content">
    <view class="arrival-bottom glass-card">
      <sun-driver-card driver="{{order.driver}}" etaText="{{etaText}}" bindaction="contactDriver"></sun-driver-card>
      <view class="metric-grid arrival-metrics">
        <view class="metric-item">
          <view class="metric-value">{{progressText}}</view>
          <view class="metric-label">接驾进度</view>
        </view>
        <view class="metric-item">
          <view class="metric-value">{{order.carType.name}}</view>
          <view class="metric-label">订单车型</view>
        </view>
        <view class="metric-item">
          <view class="metric-value">{{order.driver.plateNo}}</view>
          <view class="metric-label">车牌号</view>
        </view>
      </view>
      <view class="chip-row arrival-chip-row">
        <view class="chip">{{trafficText}}</view>
        <view class="chip">{{order.cancelRule}}</view>
      </view>
      <view class="arrival-actions">
        <button class="ghost-button arrival-cancel" hover-class="button-hover" loading="{{canceling}}" disabled="{{canceling}}" bindtap="cancelRideOrder">{{canceling ? '取消中' : '取消订单'}}</button>
        <button class="primary-button arrival-button" hover-class="button-hover" disabled="{{canceling}}" bindtap="startTripNow">{{actionButtonText}}</button>
      </view>
    </view>
  </view>
</view>
