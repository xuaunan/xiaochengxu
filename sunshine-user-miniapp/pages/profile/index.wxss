.profile-page-shell {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fffaf4 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.profile-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 20rpx 22rpx 32rpx;
}

.profile-hero {
  position: relative;
  min-height: 178rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: #fff7ef;
  box-shadow: 0 20rpx 44rpx rgba(209, 117, 35, 0.12);
}

.profile-hero-bg,
.profile-hero-tint {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.profile-hero-bg {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-hero-tint {
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.62) 48%, rgba(255, 255, 255, 0.2) 100%),
    linear-gradient(180deg, rgba(255, 247, 239, 0.22) 0%, rgba(255, 190, 109, 0.08) 100%);
}

.profile-avatar-wrap {
  position: relative;
  z-index: 2;
  width: 94rpx;
  height: 94rpx;
  flex-shrink: 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 26rpx rgba(210, 104, 18, 0.14);
}

.profile-avatar {
  width: 82rpx;
  height: 82rpx;
  display: block;
  border-radius: 999rpx;
  background: #fff4e8;
}

.profile-identity {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  padding-right: 78rpx;
}

.profile-name {
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.12;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-subline {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-pill {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.1;
}

.profile-pill--member {
  color: #ff6f00;
  background: rgba(255, 248, 240, 0.92);
  border: 2rpx solid rgba(255, 122, 0, 0.18);
}

.profile-pill--plain {
  color: #657083;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(115, 135, 165, 0.16);
}

.profile-member-badge {
  position: absolute;
  right: 42rpx;
  top: 50%;
  z-index: 2;
  width: 60rpx;
  height: 54rpx;
  display: block;
  opacity: 0.94;
  transform: translateY(-50%);
}

.profile-assets,
.profile-menu-panel {
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 16rpx 38rpx rgba(24, 34, 56, 0.06);
}

.profile-assets {
  padding: 24rpx;
}

.profile-card-head,
.profile-section-head,
.card-title-wrap,
.section-title-wrap {
  display: flex;
  align-items: center;
}

.profile-card-head,
.profile-section-head {
  justify-content: space-between;
  gap: 16rpx;
}

.card-title-wrap,
.section-title-wrap {
  gap: 18rpx;
  min-width: 0;
}

.section-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #ffffff;
  box-sizing: border-box;
}

.section-icon--asset {
  background: linear-gradient(135deg, #ffb456 0%, #ff7a00 100%);
}

.section-icon--asset::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 16rpx;
  border-radius: 5rpx;
  background: #ffffff;
  transform: translate(-50%, -10%);
}

.section-icon--asset::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 11rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  border: 3rpx solid #ffffff;
  border-bottom: none;
  box-sizing: border-box;
  transform: translate(-50%, -74%);
}

.section-icon--service {
  background: linear-gradient(135deg, #ff9838 0%, #ff6f00 100%);
}

.section-icon--service::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 23rpx;
  height: 23rpx;
  border-radius: 7rpx;
  border: 3rpx solid #ffffff;
  box-sizing: border-box;
  transform: translate(-50%, -50%) rotate(45deg);
}

.section-icon--service::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 16rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  box-sizing: border-box;
  transform: translate(-24%, -57%) rotate(42deg);
  transform-origin: center;
}

.profile-card-title,
.profile-section-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 550;
  line-height: 1.24;
}

.profile-card-desc {
  margin-top: 7rpx;
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.42;
}

.sync-pill,
.soft-pill {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff1df;
  font-size: 22rpx;
  font-weight: 500;
}

.profile-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.asset-card {
  min-height: 132rpx;
  padding: 18rpx 15rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, rgba(255, 251, 247, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx solid rgba(255, 162, 74, 0.2);
}

.asset-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.asset-icon--wallet,
.asset-icon--coupon {
  color: #ff7a00;
  background: #fff0df;
}

.asset-icon--invoice {
  color: #2f72db;
  background: #eaf2ff;
}

.asset-icon--wallet::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 25rpx;
  height: 20rpx;
  border-radius: 6rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.asset-icon--wallet::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 9rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(36%, -50%);
}

.asset-icon--invoice::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 21rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.asset-icon--invoice::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 0 #ffffff, 0 14rpx 0 #ffffff;
  transform: translate(-50%, -116%);
}

.asset-icon--coupon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 20rpx;
  border-radius: 6rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.asset-icon--coupon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  height: 20rpx;
  border-left: 2rpx dashed currentColor;
  transform: translate(-50%, -50%);
}

.asset-value {
  margin-top: 14rpx;
  color: #172033;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.asset-label {
  margin-top: 8rpx;
  color: #6f788b;
  font-size: 20rpx;
  line-height: 1.32;
}

.profile-section-head {
  padding: 10rpx 4rpx 4rpx;
}

.profile-menu-panel {
  overflow: hidden;
  padding: 0 22rpx;
}

.menu-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 30rpx;
  min-height: 104rpx;
  padding: 18rpx 36rpx 18rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  color: #ff7a00;
  background: #fff0df;
  box-sizing: border-box;
}

.menu-icon--shield {
  color: #10a566;
  background: #eaf8f1;
}

.menu-icon--message,
.menu-icon--bell {
  color: #2f72db;
  background: #edf5ff;
}

.menu-icon--user::before,
.menu-icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.menu-icon--user::before {
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  transform: translate(-50%, -82%);
}

.menu-icon--user::after {
  left: 50%;
  top: 50%;
  width: 29rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  transform: translate(-50%, 16%);
}

.menu-icon--shield::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 31rpx;
  border-radius: 13rpx 13rpx 18rpx 18rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.menu-icon--shield::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  box-sizing: border-box;
  transform: translate(-25%, -55%) rotate(42deg);
  transform-origin: center;
}

.menu-icon--wallet::before,
.menu-icon--invoice::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 20rpx;
  border-radius: 7rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.menu-icon--wallet::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 9rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(42%, -50%);
}

.menu-icon--star::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 23rpx;
  height: 23rpx;
  border-radius: 7rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%) rotate(45deg);
}

.menu-icon--star::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 16rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-22%, -57%) rotate(42deg);
  transform-origin: center;
}

.menu-icon--message::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 31rpx;
  height: 23rpx;
  border-radius: 8rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.menu-icon--message::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 9rpx 0 0 #ffffff, 18rpx 0 0 #ffffff;
  transform: translate(-188%, -50%);
}

.menu-icon--bell::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 25rpx;
  height: 28rpx;
  border-radius: 16rpx 16rpx 9rpx 9rpx;
  background: currentColor;
  transform: translate(-50%, -54%);
}

.menu-icon--bell::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 13rpx -31rpx 0 -1rpx #ff5b2f;
  transform: translate(-50%, 122%);
}

.menu-icon--help::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 23rpx;
  border-radius: 14rpx 14rpx 5rpx 14rpx;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -58%);
}

.menu-icon--help::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, 110%);
}

.menu-icon--settings::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.menu-icon--settings::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(45deg);
}

.menu-icon--invoice::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 15rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 7rpx 0 currentColor;
  transform: translate(-50%, -26%);
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.28;
}

.menu-desc {
  margin-top: 7rpx;
  color: #737d90;
  font-size: 21rpx;
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  position: absolute;
  right: 4rpx;
  top: 50%;
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid rgba(112, 122, 140, 0.42);
  border-right: 4rpx solid rgba(112, 122, 140, 0.42);
  transform: translateY(-50%) rotate(45deg);
}

.profile-logout {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #ff5b57;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 91, 87, 0.1);
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.045);
}

.asset-icon,
.menu-icon {
  overflow: hidden;
}

.asset-icon::before,
.asset-icon::after,
.menu-icon::before,
.menu-icon::after {
  display: none;
}

.asset-icon-image,
.menu-icon-image {
  display: block;
  width: 100%;
  height: 100%;
}

.asset-icon--wallet {
  background: #fff4d8;
}

.asset-icon--invoice {
  background: #fff2df;
}

.asset-icon--coupon {
  background: #e9fbf6;
}

.menu-icon--user {
  background: #fff0ec;
}

.menu-icon--wallet,
.menu-icon--invoice {
  background: #fff5df;
}

.menu-icon--star {
  background: #f2ecff;
}

.menu-icon--feedback {
  background: #e9fbf6;
}

.menu-icon--service,
.menu-icon--bell {
  background: #edf5ff;
}

.menu-icon--help {
  background: #eafbf4;
}

.menu-icon--settings {
  background: #eef0ff;
}

.asset-icon,
.menu-icon,
.asset-icon--wallet,
.asset-icon--invoice,
.asset-icon--coupon,
.menu-icon--user,
.menu-icon--wallet,
.menu-icon--invoice,
.menu-icon--star,
.menu-icon--feedback,
.menu-icon--service,
.menu-icon--bell,
.menu-icon--help,
.menu-icon--settings {
  background: transparent;
}

.asset-icon {
  width: 46rpx;
  height: 46rpx;
  border-radius: 18rpx;
}

.menu-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 20rpx;
}

.section-icon {
  overflow: visible;
  background: transparent;
}

.section-icon::before,
.section-icon::after {
  display: none;
}

.section-icon-image {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.section-icon--asset {
  width: 52rpx;
  height: 52rpx;
}

.section-icon--service {
  width: 52rpx;
  height: 52rpx;
}

.section-icon--asset .section-icon-image,
.section-icon--service .section-icon-image {
  width: 58rpx;
  height: 58rpx;
}

.asset-icon,
.menu-icon {
  overflow: visible;
}
