.profile-hero {
  text-align: center;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 0, rgba(255, 255, 255, 0.2), transparent 36%),
    linear-gradient(135deg, #ff7a00 0%, #ff9a31 62%, #ffbd63 100%);
  color: #ffffff;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.68);
  box-shadow: 0 18rpx 34rpx rgba(108, 52, 0, 0.2);
}

.profile-name {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
}

.profile-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.profile-metrics {
  margin-top: 24rpx;
}

.profile-metrics .metric-item {
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.profile-metrics .metric-value,
.profile-metrics .metric-label {
  color: #ffffff;
}

.menu-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 24rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.08);
}

.menu-card::after {
  content: "";
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid rgba(255, 122, 0, 0.36);
  border-right: 3rpx solid rgba(255, 122, 0, 0.36);
  transform: translateY(-50%) rotate(45deg);
}

.menu-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
}

.menu-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7a8396;
}

.menu-card--logout {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 126rpx;
  background: #ffffff;
}

.menu-card--logout::after {
  display: none;
}

.menu-title--logout {
  color: #ff5b57;
  text-align: center;
}


