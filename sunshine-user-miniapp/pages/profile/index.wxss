.profile-page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 48% 0%, rgba(255, 198, 128, 0.2), transparent 30%),
    linear-gradient(180deg, #fff6ea 0%, #f7f8fc 38%, #f5f7fb 100%);
}

.profile-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 22rpx 24rpx 34rpx;
}

.profile-title {
  padding: 32rpx 0 18rpx;
  text-align: center;
  color: #1d2433;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-hero {
  position: relative;
  min-height: 170rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 34rpx 28rpx;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 160, 74, 0.28);
  background:
    linear-gradient(115deg, rgba(255, 211, 157, 0.58) 0%, rgba(255, 250, 244, 0.9) 48%, rgba(255, 233, 209, 0.7) 100%),
    #fff7ef;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.12);
}

.hero-cloud,
.hero-city,
.hero-road,
.hero-taxi {
  pointer-events: none;
}

.hero-cloud {
  position: absolute;
  left: 168rpx;
  top: 30rpx;
  width: 96rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  opacity: 0.8;
}

.hero-cloud::before,
.hero-cloud::after {
  content: "";
  position: absolute;
  bottom: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
}

.hero-cloud::before {
  left: 30rpx;
  width: 34rpx;
  height: 34rpx;
}

.hero-cloud::after {
  left: 56rpx;
  width: 46rpx;
  height: 46rpx;
}

.hero-city {
  position: absolute;
  right: 48rpx;
  top: 28rpx;
  width: 220rpx;
  height: 118rpx;
  opacity: 0.24;
}

.city-block {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.city-block--1 {
  left: 20rpx;
  height: 72rpx;
}

.city-block--2 {
  left: 66rpx;
  height: 104rpx;
}

.city-block--3 {
  left: 118rpx;
  height: 86rpx;
}

.city-block--4 {
  left: 166rpx;
  height: 54rpx;
}

.hero-road {
  position: absolute;
  right: -38rpx;
  bottom: 12rpx;
  width: 312rpx;
  height: 72rpx;
  border-top: 8rpx solid rgba(255, 255, 255, 0.74);
  transform: rotate(-12deg);
}

.hero-road::after {
  content: "";
  position: absolute;
  right: 20rpx;
  top: 22rpx;
  width: 180rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.86);
}

.hero-taxi {
  position: absolute;
  right: 96rpx;
  bottom: 50rpx;
  width: 76rpx;
  height: 40rpx;
  transform: rotate(-4deg);
}

.hero-taxi__body,
.hero-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa232 0%, #ff7a00 100%);
  border: 2rpx solid rgba(156, 72, 0, 0.14);
}

.hero-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 68rpx;
  height: 28rpx;
  border-radius: 12rpx 15rpx 9rpx 9rpx;
}

.hero-taxi__top {
  left: 24rpx;
  bottom: 28rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.hero-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #243041;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.hero-taxi__wheel--left {
  left: 15rpx;
}

.hero-taxi__wheel--right {
  right: 13rpx;
}

.profile-avatar-wrap {
  position: relative;
  z-index: 2;
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  padding: 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 26rpx rgba(210, 104, 18, 0.12);
}

.profile-avatar {
  width: 102rpx;
  height: 102rpx;
  display: block;
  border-radius: 999rpx;
  background: #fff4e8;
}

.profile-identity {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.profile-name {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.12;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-subline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.profile-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.1;
}

.profile-pill--member {
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(255, 122, 0, 0.28);
}

.profile-pill--plain {
  color: #657083;
  background: rgba(239, 244, 251, 0.8);
  border: 2rpx solid rgba(115, 135, 165, 0.2);
}

.profile-edit {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(255, 122, 0, 0.24);
  font-size: 24rpx;
  font-weight: 800;
}

.profile-edit__icon {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  transform: rotate(-8deg);
}

.profile-assets,
.profile-menu-panel {
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 18rpx 44rpx rgba(24, 34, 56, 0.075);
}

.profile-assets {
  padding: 28rpx;
}

.profile-card-head,
.profile-section-head,
.card-title-wrap,
.section-title-wrap {
  display: flex;
  align-items: center;
}

.profile-card-head,
.profile-section-head {
  justify-content: space-between;
  gap: 20rpx;
}

.card-title-wrap,
.section-title-wrap {
  gap: 16rpx;
  min-width: 0;
}

.section-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #ffffff;
}

.section-icon--asset {
  background: linear-gradient(135deg, #ffb456 0%, #ff7a00 100%);
}

.section-icon--asset::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 17rpx;
  width: 22rpx;
  height: 17rpx;
  border-radius: 5rpx;
  background: #ffffff;
}

.section-icon--asset::after {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 11rpx;
  width: 14rpx;
  height: 12rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  border: 4rpx solid #ffffff;
  border-bottom: none;
}

.section-icon--service {
  background: linear-gradient(135deg, #ff9838 0%, #ff6f00 100%);
}

.section-icon--service::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 7rpx;
  border: 5rpx solid #ffffff;
  transform: rotate(45deg);
}

.section-icon--service::after {
  content: "";
  position: absolute;
  left: 21rpx;
  top: 13rpx;
  width: 8rpx;
  height: 18rpx;
  border-right: 5rpx solid #ffffff;
  border-bottom: 5rpx solid #ffffff;
  transform: rotate(42deg);
}

.profile-card-title,
.profile-section-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
}

.profile-card-desc {
  margin-top: 8rpx;
  color: #7a8396;
  font-size: 24rpx;
  line-height: 1.35;
}

.sync-pill,
.soft-pill {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff1df;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.asset-card {
  min-height: 154rpx;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(255, 251, 247, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx solid rgba(255, 162, 74, 0.2);
}

.asset-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.asset-icon--wallet,
.asset-icon--coupon {
  color: #ff7a00;
  background: #fff0df;
}

.asset-icon--invoice {
  color: #2f72db;
  background: #eaf2ff;
}

.asset-icon--wallet::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 27rpx;
  height: 22rpx;
  border-radius: 6rpx;
  border: 4rpx solid currentColor;
}

.asset-icon--wallet::after {
  content: "";
  position: absolute;
  right: 8rpx;
  top: 21rpx;
  width: 11rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.asset-icon--invoice::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 10rpx;
  width: 22rpx;
  height: 29rpx;
  border-radius: 6rpx;
  background: currentColor;
}

.asset-icon--invoice::after {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 17rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 0 #ffffff, 0 16rpx 0 #ffffff;
}

.asset-icon--coupon::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 14rpx;
  width: 28rpx;
  height: 21rpx;
  border-radius: 6rpx;
  border: 4rpx solid currentColor;
}

.asset-icon--coupon::after {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 14rpx;
  height: 21rpx;
  border-left: 3rpx dashed currentColor;
}

.asset-value {
  margin-top: 20rpx;
  color: #172033;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.asset-label {
  margin-top: 12rpx;
  color: #6f788b;
  font-size: 22rpx;
  line-height: 1.25;
}

.profile-section-head {
  padding: 4rpx 4rpx 0;
}

.profile-menu-panel {
  overflow: hidden;
  padding: 0 26rpx;
}

.menu-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 118rpx;
  padding: 20rpx 36rpx 20rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #ff7a00;
  background: #fff0df;
}

.menu-icon--shield {
  color: #10a566;
  background: #eaf8f1;
}

.menu-icon--message,
.menu-icon--bell {
  color: #2f72db;
  background: #edf5ff;
}

.menu-icon--user::before,
.menu-icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.menu-icon--user::before {
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
}

.menu-icon--user::after {
  left: 14rpx;
  bottom: 11rpx;
  width: 30rpx;
  height: 19rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
}

.menu-icon--shield::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 10rpx;
  width: 30rpx;
  height: 34rpx;
  border-radius: 13rpx 13rpx 18rpx 18rpx;
  background: currentColor;
}

.menu-icon--shield::after {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 18rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 5rpx solid #ffffff;
  border-bottom: 5rpx solid #ffffff;
  transform: rotate(42deg);
}

.menu-icon--wallet::before,
.menu-icon--invoice::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 18rpx;
  width: 30rpx;
  height: 22rpx;
  border-radius: 7rpx;
  border: 4rpx solid currentColor;
}

.menu-icon--wallet::after {
  content: "";
  position: absolute;
  right: 11rpx;
  top: 26rpx;
  width: 10rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.menu-icon--star::before {
  content: "★";
  position: absolute;
  left: 12rpx;
  top: 6rpx;
  color: currentColor;
  font-size: 37rpx;
  line-height: 1;
}

.menu-icon--message::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 15rpx;
  width: 34rpx;
  height: 25rpx;
  border-radius: 8rpx;
  background: currentColor;
}

.menu-icon--message::after {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 26rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 9rpx 0 0 #ffffff, 18rpx 0 0 #ffffff;
}

.menu-icon--bell::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 12rpx;
  width: 28rpx;
  height: 30rpx;
  border-radius: 16rpx 16rpx 9rpx 9rpx;
  background: currentColor;
}

.menu-icon--bell::after {
  content: "";
  position: absolute;
  left: 25rpx;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 14rpx -34rpx 0 0 #ff5b2f;
}

.menu-icon--help::before {
  content: "?";
  position: absolute;
  left: 18rpx;
  top: 7rpx;
  color: currentColor;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.menu-icon--settings::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 8rpx solid currentColor;
}

.menu-icon--settings::after {
  content: "";
  position: absolute;
  left: 25rpx;
  top: 4rpx;
  width: 8rpx;
  height: 50rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(45deg);
}

.menu-icon--invoice::after {
  content: "";
  position: absolute;
  left: 21rpx;
  top: 24rpx;
  width: 15rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 8rpx 0 currentColor;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.18;
}

.menu-desc {
  margin-top: 9rpx;
  color: #737d90;
  font-size: 23rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  position: absolute;
  right: 4rpx;
  top: 50%;
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid rgba(112, 122, 140, 0.42);
  border-right: 4rpx solid rgba(112, 122, 140, 0.42);
  transform: translateY(-50%) rotate(45deg);
}

.profile-logout {
  min-height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #ff5b57;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 91, 87, 0.1);
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.045);
}
