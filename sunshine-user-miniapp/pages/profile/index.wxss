.profile-page-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.64) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.profile-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.06);
}

.profile-avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  padding: 5rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #fff7ef, #ffffff);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(31, 36, 50, 0.06);
}

.profile-avatar {
  width: 102rpx;
  height: 102rpx;
  display: block;
  border-radius: 25rpx;
  background: #fff4e8;
}

.profile-identity {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #1f2432;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-subline {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-pill {
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #ff7a00;
  background: #fff1df;
}

.profile-pill--plain {
  color: #6b7385;
  background: #eef1f7;
}

.profile-edit {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 24rpx;
  font-weight: 700;
}

.profile-assets {
  padding: 26rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.055);
}

.profile-assets__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.profile-assets__title {
  font-size: 32rpx;
}

.profile-assets__desc {
  margin-top: 8rpx;
}

.profile-assets__tag {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 700;
}

.profile-metrics {
  margin-top: 24rpx;
  gap: 14rpx;
}

.profile-metrics .metric-item {
  min-height: 124rpx;
  padding: 22rpx 12rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  box-shadow: none;
}

.profile-metrics .metric-value {
  color: #1f2432;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
}

.profile-metrics .metric-label {
  color: #7a8396;
  font-size: 22rpx;
}

.profile-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 6rpx 0;
}

.profile-section-title {
  font-size: 32rpx;
}

.profile-menu-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.menu-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 20rpx 58rpx 20rpx 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(31, 36, 50, 0.045);
}

.menu-card::after {
  content: "";
  position: absolute;
  right: 26rpx;
  top: 50%;
  width: 13rpx;
  height: 13rpx;
  border-top: 3rpx solid rgba(122, 131, 150, 0.38);
  border-right: 3rpx solid rgba(122, 131, 150, 0.38);
  transform: translateY(-50%) rotate(45deg);
}

.menu-index {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 22rpx;
  font-weight: 800;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2432;
}

.menu-desc {
  margin-top: 7rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #7a8396;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card--logout {
  min-height: 104rpx;
  justify-content: center;
  padding-right: 22rpx;
  background: #ffffff;
}

.menu-card--logout::after {
  display: none;
}

.menu-title--logout {
  color: #ff5b57;
  text-align: center;
}
