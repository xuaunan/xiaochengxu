.profile-page-shell {
  background:
    radial-gradient(circle at 88% 0, rgba(255, 122, 0, 0.12), transparent 26%),
    linear-gradient(180deg, #ffffff 0%, #f6f7fb 34%, #f7f8fc 100%);
}

.profile-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  color: #ffffff;
  background:
    linear-gradient(145deg, #151924 0%, #202635 52%, #ff7a00 150%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 28rpx 64rpx rgba(21, 25, 36, 0.2);
}

.profile-hero__glow,
.profile-hero__shine {
  position: absolute;
  pointer-events: none;
}

.profile-hero__glow {
  width: 360rpx;
  height: 360rpx;
  right: -120rpx;
  top: -130rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 145, 37, 0.64), rgba(255, 145, 37, 0) 66%);
  animation: profile-glow 5.8s ease-in-out infinite;
}

.profile-hero__shine {
  left: -35%;
  top: 0;
  width: 34%;
  height: 100%;
  transform: skewX(-16deg);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.16), transparent);
  animation: profile-shine 4.8s ease-in-out infinite;
}

.profile-hero__top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-avatar-wrap {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  padding: 6rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(255, 177, 74, 0.38));
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.18);
}

.profile-avatar {
  width: 116rpx;
  height: 116rpx;
  display: block;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
}

.profile-identity {
  flex: 1;
  min-width: 0;
}

.profile-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: rgba(255, 205, 151, 0.92);
}

.profile-name {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.14;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.profile-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #3b2208;
  background: linear-gradient(135deg, #ffe2b8 0%, #ffb14a 100%);
}

.profile-badge--light {
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.profile-level {
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 900;
}

.profile-metrics {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  gap: 16rpx;
}

.profile-metrics .metric-item {
  min-height: 132rpx;
  padding: 24rpx 14rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.11);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(18rpx);
}

.profile-metrics .metric-value {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.1;
}

.profile-metrics .metric-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.profile-quick-row {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.profile-quick {
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.profile-quick__label {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.profile-quick__desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
}

.profile-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 6rpx 0;
}

.profile-section-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #ff7a00;
}

.profile-section-title {
  margin-top: 6rpx;
  font-size: 34rpx;
}

.profile-menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 118rpx;
  padding: 22rpx 62rpx 22rpx 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  background:
    radial-gradient(circle at 100% 0, rgba(255, 122, 0, 0.06), transparent 34%),
    rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 34rpx rgba(31, 36, 50, 0.06);
}

.menu-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff7a00, #ffb14a);
  opacity: 0.72;
}

.menu-card::after {
  content: "";
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid rgba(255, 122, 0, 0.38);
  border-right: 3rpx solid rgba(255, 122, 0, 0.38);
  transform: translateY(-50%) rotate(45deg);
}

.menu-index {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #ff7a00;
  background: #fff1df;
  font-size: 24rpx;
  font-weight: 900;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 29rpx;
  font-weight: 900;
  color: #1f2432;
}

.menu-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #7a8396;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card--logout {
  min-height: 106rpx;
  justify-content: center;
  padding-right: 22rpx;
  background: rgba(255, 255, 255, 0.9);
}

.menu-card--logout::before,
.menu-card--logout::after {
  display: none;
}

.menu-title--logout {
  color: #ff5b57;
  text-align: center;
}

@keyframes profile-glow {
  0%,
  100% {
    opacity: 0.72;
    transform: translate3d(0, 0, 0) scale(1);
  }
  50% {
    opacity: 0.92;
    transform: translate3d(-18rpx, 20rpx, 0) scale(1.08);
  }
}

@keyframes profile-shine {
  0%,
  45% {
    transform: translateX(0) skewX(-16deg);
    opacity: 0;
  }
  58% {
    opacity: 1;
  }
  78%,
  100% {
    transform: translateX(430%) skewX(-16deg);
    opacity: 0;
  }
}
