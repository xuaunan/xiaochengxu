<view class="page-shell profile-page-shell safe-bottom">
  <view class="profile-page page-enter">
    <view class="profile-hero">
      <image class="profile-hero-bg" src="/images/profile-hero-bg.png" mode="aspectFill"></image>
      <view class="profile-hero-tint"></view>

      <view class="profile-avatar-wrap">
        <image class="profile-avatar" src="{{profile.avatar}}" mode="aspectFill"></image>
      </view>
      <view class="profile-identity">
        <view class="profile-name">{{profile.name}}</view>
        <view class="profile-subline">
          <view class="profile-pill profile-pill--member">{{profile.memberLevel}}</view>
          <view class="profile-pill profile-pill--plain">{{verifiedText}}</view>
        </view>
      </view>
      <image class="profile-member-badge" src="{{memberBadgeSrc}}" mode="aspectFit"></image>
    </view>

    <view class="profile-assets">
      <view class="profile-card-head">
        <view class="card-title-wrap">
          <view class="section-icon section-icon--asset"></view>
          <view>
            <view class="profile-card-title">账户资产</view>
            <view class="profile-card-desc">余额、发票和优惠券集中管理</view>
          </view>
        </view>
        <view class="sync-pill">已更新</view>
      </view>
      <view class="profile-metrics">
        <view class="asset-card tap-scale" bindtap="openOrders">
          <view class="asset-icon asset-icon--wallet"></view>
          <view class="asset-value">{{wallet.balance}}</view>
          <view class="asset-label">钱包余额（元）</view>
        </view>
        <view class="asset-card tap-scale" bindtap="openOrders">
          <view class="asset-icon asset-icon--invoice"></view>
          <view class="asset-value">{{wallet.invoices}}</view>
          <view class="asset-label">可开发票（张）</view>
        </view>
        <view class="asset-card tap-scale" bindtap="openCoupons">
          <view class="asset-icon asset-icon--coupon"></view>
          <view class="asset-value">{{wallet.couponBalance}}</view>
          <view class="asset-label">优惠总额（元）</view>
        </view>
      </view>
    </view>

    <view class="profile-section-head">
      <view class="section-title-wrap">
        <view class="section-icon section-icon--service"></view>
        <view class="profile-section-title">账户服务</view>
      </view>
      <view class="soft-pill">{{menus.length}} 项服务</view>
    </view>

    <view class="profile-menu-panel">
      <view class="menu-row tap-scale" wx:for="{{menus}}" wx:key="title" data-url="{{item.url}}" bindtap="openMenu">
        <view class="menu-icon menu-icon--{{item.iconClass}}"></view>
        <view class="menu-copy">
          <view class="menu-title">{{item.title}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
        <view class="menu-arrow"></view>
      </view>
    </view>

    <view class="profile-logout tap-scale" bindtap="handleLogout">{{logoutText}}</view>
  </view>
</view>
