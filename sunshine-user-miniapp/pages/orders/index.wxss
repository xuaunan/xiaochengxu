.orders-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.orders-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 24rpx;
}

.orders-hero {
  position: relative;
  min-height: 150rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.26);
  background:
    linear-gradient(110deg, rgba(255, 250, 244, 0.98) 0%, rgba(255, 247, 238, 0.92) 52%, rgba(255, 226, 190, 0.52) 100%),
    #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.09);
}

.orders-hero__icon {
  position: relative;
  z-index: 2;
  width: 86rpx;
  height: 86rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #ff9d32 0%, #ff6f00 100%);
  box-shadow: inset 0 0 0 10rpx rgba(255, 255, 255, 0.7), 0 14rpx 26rpx rgba(255, 111, 0, 0.18);
}

.orders-hero__icon::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 22rpx;
  width: 38rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.orders-hero__icon::after {
  content: "";
  position: absolute;
  left: 30rpx;
  top: 16rpx;
  width: 10rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 18rpx 0 0 #ff7a00;
}

.orders-hero__icon-line {
  position: absolute;
  left: 32rpx;
  top: 38rpx;
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 0 12rpx 0 #ff7a00;
  z-index: 2;
}

.orders-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.orders-title {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.orders-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  font-weight: 600;
}

.orders-hero__count {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  min-width: 92rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 122, 0, 0.42);
  text-align: center;
  font-size: 27rpx;
  font-weight: 900;
}

.orders-city,
.orders-road,
.orders-taxi {
  pointer-events: none;
}

.orders-city {
  position: absolute;
  right: 84rpx;
  bottom: 20rpx;
  width: 230rpx;
  height: 112rpx;
  opacity: 0.2;
}

.orders-building {
  position: absolute;
  bottom: 0;
  width: 34rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.orders-building--1 {
  left: 14rpx;
  height: 58rpx;
}

.orders-building--2 {
  left: 62rpx;
  height: 92rpx;
}

.orders-building--3 {
  left: 116rpx;
  height: 76rpx;
}

.orders-building--4 {
  left: 168rpx;
  height: 50rpx;
}

.orders-road {
  position: absolute;
  right: -28rpx;
  bottom: 18rpx;
  width: 320rpx;
  height: 70rpx;
  border-top: 7rpx solid rgba(255, 255, 255, 0.84);
  transform: rotate(-12deg);
}

.orders-road::after {
  content: "";
  position: absolute;
  right: 22rpx;
  top: 21rpx;
  width: 170rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.92);
}

.orders-taxi {
  position: absolute;
  right: 122rpx;
  bottom: 36rpx;
  width: 82rpx;
  height: 44rpx;
  transform: rotate(-5deg);
}

.orders-taxi__body,
.orders-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa33d 0%, #ff7a00 100%);
  border: 2rpx solid rgba(134, 68, 0, 0.16);
}

.orders-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 74rpx;
  height: 30rpx;
  border-radius: 13rpx 16rpx 9rpx 9rpx;
}

.orders-taxi__top {
  left: 28rpx;
  bottom: 30rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.orders-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #1f2432;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.orders-taxi__wheel--left {
  left: 16rpx;
}

.orders-taxi__wheel--right {
  right: 14rpx;
}

.filter-card {
  padding: 20rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 16rpx 36rpx rgba(24, 34, 56, 0.06);
}

.tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.tabs-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 4rpx;
}

.filter-divider {
  height: 1rpx;
  margin: 20rpx 6rpx;
  background: rgba(31, 36, 50, 0.08);
}

.filter-chip {
  min-width: 120rpx;
  height: 58rpx;
  padding: 0 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #667085;
  background: #fbfcfe;
  border: 2rpx solid rgba(31, 36, 50, 0.08);
  font-size: 26rpx;
  font-weight: 800;
  transition: transform 0.18s ease, color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.filter-chip--type {
  min-width: 128rpx;
  height: 66rpx;
}

.filter-chip--active {
  color: #ff6f00;
  background: #fff3e7;
  border-color: rgba(255, 122, 0, 0.52);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: 28rpx;
}

.order-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.065);
}

.order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 210rpx;
  height: 90rpx;
  background: radial-gradient(circle at 0% 0%, rgba(255, 122, 0, 0.09), transparent 70%);
}

.order-card__top,
.order-card__bottom,
.order-type,
.order-meta__item {
  display: flex;
  align-items: center;
}

.order-card__top,
.order-card__bottom {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 18rpx;
}

.order-type {
  gap: 14rpx;
  min-width: 0;
}

.order-type__icon {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  border-radius: 17rpx;
  color: #ff6f00;
  background: #fff1df;
}

.order-type__icon--taxi::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 20rpx;
  width: 34rpx;
  height: 18rpx;
  border-radius: 9rpx 10rpx 5rpx 5rpx;
  border: 4rpx solid currentColor;
}

.order-type__icon--taxi::after {
  content: "";
  position: absolute;
  left: 16rpx;
  bottom: 10rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 17rpx 0 0 currentColor, 6rpx -21rpx 0 -1rpx currentColor;
}

.order-type__icon--carpool::before,
.order-type__icon--carpool::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.order-type__icon--carpool::before {
  left: 13rpx;
  top: 12rpx;
  width: 11rpx;
  height: 11rpx;
  box-shadow: 18rpx 0 0 currentColor;
}

.order-type__icon--carpool::after {
  left: 8rpx;
  bottom: 12rpx;
  width: 18rpx;
  height: 14rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  box-shadow: 20rpx 0 0 currentColor;
}

.order-type__icon--international::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  width: 34rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(-28deg);
}

.order-type__icon--international::after {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 14rpx;
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(-28deg);
}

.order-type__text {
  color: #ff6f00;
  font-size: 27rpx;
  font-weight: 900;
}

.order-status {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff1df;
  font-size: 25rpx;
  font-weight: 900;
}

.order-status--success {
  color: #12845c;
  background: #e8f8ef;
}

.order-status--danger {
  color: #df3d38;
  background: #ffeded;
}

.order-status--processing {
  color: #2f72db;
  background: #edf5ff;
}

.order-status--waiting {
  color: #d88300;
  background: #fff4df;
}

.order-route {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.45;
}

.order-card__bottom {
  margin-top: 24rpx;
}

.order-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx 20rpx;
  color: #7a8396;
  font-size: 23rpx;
}

.order-meta__item {
  min-width: 0;
  gap: 9rpx;
  max-width: 100%;
}

.order-meta__item text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta__icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  color: #8b94a7;
}

.order-meta__icon--time {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.order-meta__icon--time::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 3rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.order-meta__icon--time::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 11rpx;
  width: 8rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.order-meta__icon--no::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 2rpx;
  width: 18rpx;
  height: 22rpx;
  border-radius: 5rpx;
  border: 3rpx solid currentColor;
}

.order-meta__icon--no::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 9rpx;
  width: 8rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 7rpx 0 currentColor;
}

.order-price {
  flex-shrink: 0;
  color: #ff6f00;
  font-size: 41rpx;
  font-weight: 900;
  line-height: 1;
}

.empty-panel {
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 16rpx 34rpx rgba(24, 34, 56, 0.06);
}

.pressable-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
