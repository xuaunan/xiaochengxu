.orders-hero {
  overflow: hidden;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 255, 255, 0.2), transparent 34%),
    linear-gradient(135deg, #ff7a00 0%, #ff9a31 62%, #ffbd63 100%);
  color: #ffffff;
}

.orders-hero .section-title,
.orders-hero .section-subtitle {
  color: #ffffff;
}

.orders-hero .section-subtitle {
  color: rgba(255, 255, 255, 0.84);
}

.tabs-scroll {
  margin-top: 18rpx;
  width: 100%;
  white-space: nowrap;
}

.tabs-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 10rpx;
}

.orders-hero .chip {
  color: rgba(255, 255, 255, 0.86);
  background: rgba(255, 255, 255, 0.16);
  border-color: rgba(255, 255, 255, 0.2);
}

.orders-hero .chip-active {
  color: #ff7a00;
  background: #ffffff;
  border-color: #ffffff;
}

.order-list {
  margin-top: 24rpx;
}

.order-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  background:
    radial-gradient(circle at 100% 0, rgba(255, 177, 74, 0.12), transparent 34%),
    rgba(255, 255, 255, 0.96);
}

.order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff7a00, #ffb14a);
}

.order-title {
  font-size: 30rpx;
}

.order-route {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
  line-height: 1.55;
}

.order-meta {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #7a8396;
}

.order-meta .brand-text {
  font-size: 30rpx;
  font-weight: 800;
}

.order-no {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #98a1b3;
}


