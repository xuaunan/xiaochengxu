.orders-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.orders-hero {
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 244, 232, 0.98) 0%, rgba(255, 255, 255, 0.98) 58%),
    #ffffff;
  color: #1f2432;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.055);
}

.orders-hero__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.orders-hero__count {
  flex-shrink: 0;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.orders-hero .section-title,
.orders-hero .section-subtitle {
  color: #1f2432;
}

.orders-hero .section-subtitle {
  color: #6b7385;
}

.tabs-scroll {
  margin-top: 20rpx;
  width: 100%;
  white-space: nowrap;
}

.tabs-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 10rpx;
}

.orders-hero .chip {
  color: #6b7385;
  background: #f8fafc;
  border-color: rgba(31, 36, 50, 0.07);
  box-shadow: none;
}

.orders-hero .chip-active {
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.1);
  border-color: rgba(255, 122, 0, 0.18);
}

.order-list {
  margin-top: 24rpx;
}

.order-card {
  position: relative;
  overflow: hidden;
  border-radius: 26rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.order-title {
  font-size: 29rpx;
}

.order-route {
  margin-top: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2432;
  line-height: 1.55;
}

.order-meta {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #7a8396;
}

.order-meta .brand-text {
  font-size: 29rpx;
  font-weight: 800;
}

.order-no {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #98a1b3;
}


