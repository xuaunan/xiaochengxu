.orders-hero {
  overflow: hidden;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 122, 0, 0.08), transparent 34%),
    rgba(255, 255, 255, 0.97);
  color: #1f2432;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.08);
}

.orders-hero .section-title,
.orders-hero .section-subtitle {
  color: #1f2432;
}

.orders-hero .section-subtitle {
  color: #6b7385;
}

.tabs-scroll {
  margin-top: 18rpx;
  width: 100%;
  white-space: nowrap;
}

.tabs-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 10rpx;
}

.orders-hero .chip {
  color: #6b7385;
  background: #ffffff;
  border-color: rgba(31, 36, 50, 0.07);
  box-shadow: 0 8rpx 20rpx rgba(24, 34, 56, 0.04);
}

.orders-hero .chip-active {
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.1);
  border-color: rgba(255, 122, 0, 0.18);
}

.order-list {
  margin-top: 24rpx;
}

.order-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.06);
}

.order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  opacity: 0.72;
}

.order-title {
  font-size: 30rpx;
}

.order-route {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
  line-height: 1.55;
}

.order-meta {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #7a8396;
}

.order-meta .brand-text {
  font-size: 30rpx;
  font-weight: 800;
}

.order-no {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #98a1b3;
}


