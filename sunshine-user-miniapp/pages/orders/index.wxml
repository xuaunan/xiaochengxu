<view class="page-shell orders-shell safe-bottom">
  <view class="page-content orders-page">
    <view class="orders-hero page-enter">
      <view class="orders-hero__icon">
        <view class="orders-hero__icon-line"></view>
      </view>
      <view class="orders-hero__copy">
        <view class="orders-title">订单中心</view>
        <view class="orders-desc">按业务和状态查看行程记录</view>
      </view>
      <view class="orders-hero__count">{{list.length}} 单</view>
      <view class="orders-city">
        <view class="orders-building orders-building--1"></view>
        <view class="orders-building orders-building--2"></view>
        <view class="orders-building orders-building--3"></view>
        <view class="orders-building orders-building--4"></view>
      </view>
      <view class="orders-road"></view>
      <view class="orders-taxi">
        <view class="orders-taxi__body"></view>
        <view class="orders-taxi__top"></view>
        <view class="orders-taxi__wheel orders-taxi__wheel--left"></view>
        <view class="orders-taxi__wheel orders-taxi__wheel--right"></view>
      </view>
    </view>

    <view class="filter-card">
      <scroll-view scroll-x enable-flex show-scrollbar="{{false}}" class="tabs-scroll">
        <view class="tabs-row tabs-row--type">
          <view
            class="filter-chip filter-chip--type {{activeType === item.key ? 'filter-chip--active' : ''}}"
            wx:for="{{typeTabs}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="chooseType"
            hover-class="pressable-hover"
            hover-stay-time="60"
          >
            {{item.label}}
          </view>
        </view>
      </scroll-view>
      <view class="filter-divider"></view>
      <scroll-view scroll-x enable-flex show-scrollbar="{{false}}" class="tabs-scroll">
        <view class="tabs-row">
          <view
            class="filter-chip {{activeStatus === item.key ? 'filter-chip--active' : ''}}"
            wx:for="{{statusTabs}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="chooseStatus"
            hover-class="pressable-hover"
            hover-stay-time="60"
          >
            {{item.label}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="order-list" wx:if="{{list.length}}">
      <view
        class="order-card tap-scale"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openDetail"
        hover-class="pressable-hover"
        hover-stay-time="60"
      >
        <view class="order-card__top">
          <view class="order-type">
            <view class="order-type__icon order-type__icon--{{item.type}}"></view>
            <view class="order-type__text">{{item.typeText}}</view>
          </view>
          <view class="order-status order-status--{{item.statusTag}}">{{item.statusText}}</view>
        </view>
        <view class="order-route">{{item.startName}} → {{item.endName}}</view>
        <view class="order-card__bottom">
          <view class="order-meta">
            <view class="order-meta__item">
              <view class="order-meta__icon order-meta__icon--time"></view>
              <text>{{item.createdAtText}}</text>
            </view>
            <view class="order-meta__item">
              <view class="order-meta__icon order-meta__icon--no"></view>
              <text>订单号：{{item.orderNo}}</text>
            </view>
          </view>
          <view class="order-price">{{item.amountText}}</view>
        </view>
      </view>
    </view>

    <view class="empty-panel" wx:else>
      <sun-empty
        title="暂无符合条件的订单"
        description="你可以返回首页下单，或切换筛选条件查看其他订单。"
        buttonText="返回首页"
        bindaction="goHome"
      ></sun-empty>
    </view>
  </view>
</view>
