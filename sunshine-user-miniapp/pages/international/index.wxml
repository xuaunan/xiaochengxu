<view class="page-shell intl-shell safe-bottom">
  <view class="page-content list-gap page-enter">
    <view class="intl-hero">
      <view class="intl-hero-head">
        <view class="intl-hero-copy">
          <view class="intl-kicker">Global Travel Desk</view>
          <view class="intl-title">{{pageTitle}}</view>
          <view class="intl-subtitle">{{pageSubtitle}}</view>
        </view>
        <view class="intl-globe">
          <view class="intl-globe-ring"></view>
          <view class="intl-globe-line intl-globe-line--one"></view>
          <view class="intl-globe-line intl-globe-line--two"></view>
        </view>
      </view>
      <view class="intl-airline-strip">
        <view wx:for="{{routeCodes}}" wx:key="code">
          <text>{{item.code}}</text>
          <view>{{item.label}}</view>
        </view>
      </view>
      <view class="intl-exchange">{{exchangeRate}}</view>
      <view class="intl-metrics">
        <view class="intl-metric" wx:for="{{metrics}}" wx:key="label">
          <view>{{item.value}}</view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="list-gap">
      <view class="intl-card tap-scale" wx:for="{{options}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder">
        <view class="intl-card-head">
          <view class="intl-route-badge">{{item.routeCode}}</view>
          <view class="intl-country">{{item.countryText}}</view>
        </view>
        <view class="row-between intl-card-title-row">
          <view class="intl-card-copy">
            <view class="intl-route-title">{{item.titleZh}}</view>
            <view class="intl-route-en">{{item.titleEn}}</view>
          </view>
          <view class="intl-price">
            <text>{{item.currency}}</text>
            <view>{{item.basePrice}}</view>
          </view>
        </view>
        <view class="intl-route-line">
          <text>{{item.startName}}</text>
          <view>→</view>
          <text>{{item.endName}}</text>
        </view>
        <view class="intl-meta-row">
          <view>{{item.badge}}</view>
          <view>{{item.vehicle}}</view>
          <view>{{item.durationText}}</view>
        </view>
        <view class="intl-service-row">
          <text wx:for="{{item.inclusions}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="intl-doc-row">{{item.documents[0]}} · {{item.documents[1]}}</view>
        <view class="intl-notice">{{item.notice}}</view>
      </view>
    </view>
  </view>
  <view class="floating-bar">
    <button class="ghost-button" hover-class="button-hover" bindtap="openList">查看我的国际行程</button>
  </view>
</view>
