.intl-shell {
  background:
    linear-gradient(180deg, #eef5fb 0%, #f7f8fc 42%, #fff8ef 100%);
}

.intl-hero {
  display: grid;
  gap: 22rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(135deg, #10243f 0%, #1d4e89 62%, #d96f18 100%);
  background-size: 46rpx 46rpx, 46rpx 46rpx, auto;
  box-shadow: 0 18rpx 38rpx rgba(16, 36, 63, 0.18);
}

.intl-hero-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.intl-hero-copy {
  flex: 1;
  min-width: 0;
}

.intl-globe {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.12);
}

.intl-globe::before,
.intl-globe::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 10rpx;
  bottom: 10rpx;
  width: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.58);
  border-top: none;
  border-bottom: none;
  border-radius: 50%;
  transform: translateX(-50%);
}

.intl-globe::after {
  width: 68rpx;
  opacity: 0.52;
}

.intl-globe-ring,
.intl-globe-line {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
}

.intl-globe-ring {
  left: 16rpx;
  right: 16rpx;
  top: 50%;
  height: 2rpx;
  transform: translateY(-50%);
}

.intl-globe-line--one {
  left: 22rpx;
  right: 22rpx;
  top: 33rpx;
  height: 2rpx;
}

.intl-globe-line--two {
  left: 22rpx;
  right: 22rpx;
  bottom: 33rpx;
  height: 2rpx;
}

.intl-kicker {
  font-size: 22rpx;
  opacity: 0.76;
  letter-spacing: 0;
  line-height: 1.3;
}

.intl-title {
  margin-top: 10rpx;
  font-size: 43rpx;
  font-weight: 700;
  line-height: 1.18;
}

.intl-subtitle {
  margin-top: 14rpx;
  max-width: 620rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.82);
}

.intl-airline-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.intl-airline-strip > view {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.intl-airline-strip text {
  display: block;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.15;
}

.intl-airline-strip view view {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
  line-height: 1.2;
}

.intl-exchange {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  width: fit-content;
  padding: 13rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  background: rgba(255, 255, 255, 0.16);
}

.intl-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.intl-metric {
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.14);
}

.intl-metric view {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.intl-metric text {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.72);
}

.intl-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.07);
  border: 1rpx solid rgba(29, 78, 137, 0.08);
}

.intl-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.intl-route-badge,
.intl-country {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 42rpx;
}

.intl-route-badge {
  color: #ffffff;
  background: #1d4e89;
}

.intl-country {
  color: #d96f18;
  background: #fff1df;
}

.intl-card-title-row {
  gap: 18rpx;
  align-items: flex-start;
}

.intl-card-copy {
  min-width: 0;
}

.intl-route-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2432;
  line-height: 1.25;
}

.intl-route-en {
  margin-top: 6rpx;
  color: #8a94a8;
  font-size: 22rpx;
}

.intl-price {
  flex-shrink: 0;
  text-align: right;
  color: #d96f18;
}

.intl-price text {
  font-size: 20rpx;
}

.intl-price view {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.12;
}

.intl-route-line {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 44rpx minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
  margin-top: 20rpx;
  color: #4b5565;
  font-size: 25rpx;
  line-height: 1.5;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7f9fd;
}

.intl-route-line text {
  min-width: 0;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.35;
}

.intl-route-line view {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #1d4e89;
  background: #eaf2fb;
  font-size: 24rpx;
  line-height: 44rpx;
}

.intl-meta-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.intl-meta-row view {
  min-width: 0;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  text-align: center;
  color: #3b4658;
  font-size: 22rpx;
  background: #f6f8fc;
}

.intl-service-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.intl-service-row text {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #125f4c;
  font-size: 21rpx;
  background: rgba(31, 139, 113, 0.1);
}

.intl-doc-row {
  margin-top: 18rpx;
  color: #1d4e89;
  font-size: 22rpx;
  line-height: 1.45;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #eef5fb;
}

.intl-notice {
  margin-top: 18rpx;
  color: #7a8396;
  font-size: 24rpx;
  line-height: 1.55;
}


