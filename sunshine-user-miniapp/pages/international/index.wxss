.intl-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.intl-hero {
  display: grid;
  gap: 26rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  color: #1f2432;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.intl-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.15;
}

.intl-subtitle {
  margin-top: 14rpx;
  max-width: 620rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #6b7385;
}

.intl-exchange {
  display: inline-flex;
  width: fit-content;
  padding: 13rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
}

.intl-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.intl-metric {
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.intl-metric view {
  font-size: 28rpx;
  font-weight: 800;
}

.intl-metric text {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8a94a8;
}

.intl-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
}

.intl-route-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2432;
}

.intl-route-en {
  margin-top: 6rpx;
  color: #8a94a8;
  font-size: 22rpx;
}

.intl-price {
  text-align: right;
  color: #ff7a00;
}

.intl-price text {
  font-size: 20rpx;
}

.intl-price view {
  font-size: 38rpx;
  font-weight: 800;
}

.intl-route-line {
  margin-top: 20rpx;
  color: #4b5565;
  font-size: 25rpx;
  line-height: 1.5;
}

.intl-meta-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.intl-meta-row view {
  min-width: 0;
  padding: 14rpx 12rpx;
  border-radius: 18rpx;
  text-align: center;
  color: #3b4658;
  font-size: 22rpx;
  background: #f6f8fc;
}

.intl-service-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.intl-service-row text {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #13885e;
  font-size: 21rpx;
  background: rgba(22, 163, 74, 0.1);
}

.intl-notice {
  margin-top: 18rpx;
  color: #7a8396;
  font-size: 24rpx;
  line-height: 1.55;
}


