<view class="welcome-page page-enter">
  <image class="welcome-bg-image" src="/images/auth/passenger-welcome-hero.png" mode="aspectFill"></image>
  <view class="welcome-bg-mask"></view>

  <view class="welcome-hero">
    <view class="brand-block">
      <view class="brand-title">阳光出行</view>
      <view class="brand-subtitle">智慧出行服务平台</view>
    </view>

    <view class="gift-pill">
      <view class="gift-icon">
        <image class="gift-icon-img" src="/images/profile-menu-icons/coupon.png" mode="aspectFit"></image>
      </view>
      <text>新人礼包已备好</text>
    </view>

    <view class="hero-copy">
      <view class="hero-title">出行，从这里开始</view>
      <view class="hero-desc">打车、顺风车、国际出行与优惠券服务集中管理。</view>
    </view>
  </view>

  <view class="welcome-content">
    <view class="coupon-card">
      <view class="coupon-topline">
        <view class="coupon-badge">新人专享</view>
        <view class="coupon-rule">注册即领 · 首单可用</view>
      </view>
      <view class="coupon-body">
        <view class="coupon-amount"><text>18</text><text class="coupon-unit">元</text></view>
        <view class="coupon-divider"></view>
        <view class="coupon-copy">
          <view class="coupon-title">打车立减券</view>
          <view class="coupon-desc">首页下单时自动展示，可与活动叠加。</view>
        </view>
        <view class="coupon-action">领取</view>
      </view>
      <view class="coupon-watermark">%</view>
    </view>

    <view class="feature-card">
      <view class="feature-head">
        <view>
          <view class="feature-kicker">服务能力</view>
          <view class="feature-heading">常用出行一站搞定</view>
        </view>
        <view class="feature-count">{{couponCount}} 项</view>
      </view>

      <view class="feature-row">
        <view class="feature-icon feature-icon--route">
          <image class="feature-icon-img" src="/images/profile-menu-icons/route.png" mode="aspectFit"></image>
        </view>
        <view class="feature-copy">
          <view class="feature-title">地图路线可视化</view>
          <view class="feature-desc">定位、选点、路线和费用预估集中呈现。</view>
        </view>
        <view class="feature-arrow"></view>
      </view>
      <view class="feature-divider"></view>

      <view class="feature-row">
        <view class="feature-icon feature-icon--wallet">
          <image class="feature-icon-img" src="/images/profile-menu-icons/wallet.png" mode="aspectFit"></image>
        </view>
        <view class="feature-copy">
          <view class="feature-title">订单支付闭环</view>
          <view class="feature-desc">订单、优惠、支付和评价保持同一套流程。</view>
        </view>
        <view class="feature-arrow"></view>
      </view>
      <view class="feature-divider"></view>

      <view class="feature-row">
        <view class="feature-icon feature-icon--shield">
          <image class="feature-icon-img" src="/images/profile-menu-icons/shield.png" mode="aspectFit"></image>
        </view>
        <view class="feature-copy">
          <view class="feature-title">统一服务体验</view>
          <view class="feature-desc">界面、状态和操作反馈保持一致。</view>
        </view>
        <view class="feature-arrow"></view>
      </view>
    </view>

    <view class="bottom-action">
      <button class="claim-button" hover-class="button-hover" bindtap="claimWelcomePack" loading="{{claiming}}" disabled="{{claiming}}">
        <block wx:if="{{claiming}}">进入中...</block>
        <block wx:else>领取 {{couponCount}} 张新人券并进入</block>
      </button>
      <view class="safe-note">
        <view class="safe-note__icon"></view>
        <text>安全出行 · 阳光相伴</text>
      </view>
    </view>
  </view>
</view>
