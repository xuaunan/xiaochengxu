.welcome-page {
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.hero {
  padding: 42rpx 30rpx 12rpx;
}

.hero__badge {
  display: inline-flex;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.14);
  font-size: 22rpx;
}

.hero__title {
  margin-top: 26rpx;
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 800;
  color: #1f2432;
}

.hero__subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #6b7385;
}

.coupon-stack {
  position: relative;
  margin: 28rpx 24rpx 0;
  height: 238rpx;
}

.coupon-card {
  position: absolute;
  left: 0;
  right: 0;
  border-radius: 30rpx;
  padding: 28rpx;
  color: #1f2432;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.06);
}

.coupon-card--main {
  top: 0;
  z-index: 2;
  background: #ffffff;
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.coupon-card--sub {
  top: 104rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 1;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
}

.coupon-card__amount {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #ff7a00;
}

.coupon-card__name {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.coupon-card__desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.feature-list {
  margin: 42rpx 24rpx 0;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.feature-item {
  display: flex;
  gap: 18rpx;
}

.feature-item + .feature-item {
  margin-top: 26rpx;
}

.feature-item__index {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  text-align: center;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff7a00;
  background: #fff1df;
  flex-shrink: 0;
}

.feature-item__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
}

.feature-item__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7385;
}
