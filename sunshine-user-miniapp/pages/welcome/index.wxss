page {
  background: #fff4e8;
}

.welcome-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 116rpx 42rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: #fff4e8;
}

.welcome-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.welcome-bg-mask {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(255, 247, 235, 0.8) 0%, rgba(255, 247, 235, 0.42) 42%, rgba(255, 247, 235, 0.02) 78%),
    linear-gradient(180deg, rgba(255, 242, 220, 0.06) 0%, rgba(255, 248, 240, 0.1) 42%, rgba(246, 248, 252, 0.84) 100%);
}

.welcome-hero {
  position: relative;
  z-index: 2;
  min-height: 260rpx;
}

.brand-title {
  color: #2c211b;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.08;
}

.brand-subtitle {
  margin-top: 8rpx;
  color: #7a716c;
  font-size: 21rpx;
}

.gift-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 44rpx;
  margin-top: 30rpx;
  padding: 0 16rpx 0 14rpx;
  border-radius: 999rpx;
  color: #ff7300;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  box-shadow: 0 10rpx 22rpx rgba(196, 104, 22, 0.08);
  font-size: 20rpx;
  font-weight: 500;
}

.gift-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.gift-icon::before {
  display: none;
}

.gift-icon::after {
  display: none;
}

.gift-icon-img {
  display: block;
  width: 100%;
  height: 100%;
}

.hero-copy {
  width: 560rpx;
  margin-top: 24rpx;
}

.hero-title {
  color: #3b220c;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  white-space: nowrap;
}

.hero-desc {
  width: 430rpx;
  margin-top: 12rpx;
  color: #655f63;
  font-size: 21rpx;
  line-height: 1.45;
}

.welcome-content {
  position: relative;
  z-index: 3;
}

.coupon-card,
.feature-card,
.bottom-action {
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  box-shadow: 0 18rpx 38rpx rgba(48, 37, 28, 0.08);
  backdrop-filter: blur(14rpx);
}

.coupon-card {
  position: relative;
  overflow: hidden;
  padding: 18rpx 22rpx 20rpx;
  border-radius: 26rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.74) 0%, rgba(255, 250, 244, 0.62) 100%);
}

.coupon-card::before,
.coupon-card::after {
  content: "";
  position: absolute;
  top: 50%;
  z-index: 2;
  width: 34rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: rgba(247, 247, 246, 0.96);
  transform: translateY(-50%);
}

.coupon-card::before {
  left: -18rpx;
}

.coupon-card::after {
  right: -18rpx;
}

.coupon-topline {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.coupon-badge {
  height: 34rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff8b1a, #ff6f00);
  font-size: 19rpx;
  font-weight: 600;
}

.coupon-rule {
  color: #9a765f;
  font-size: 19rpx;
}

.coupon-body {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}

.coupon-amount {
  width: 126rpx;
  display: flex;
  align-items: baseline;
  color: #ff6f00;
  font-weight: 750;
  line-height: 1;
}

.coupon-amount text:first-child {
  font-size: 66rpx;
}

.coupon-unit {
  margin-left: 7rpx;
  font-size: 22rpx;
}

.coupon-divider {
  width: 1rpx;
  height: 58rpx;
  background: linear-gradient(180deg, transparent, rgba(255, 122, 0, 0.28), transparent);
}

.coupon-copy {
  flex: 1;
  min-width: 0;
}

.coupon-title {
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.24;
}

.coupon-desc {
  margin-top: 7rpx;
  color: #687386;
  font-size: 19rpx;
  line-height: 1.42;
}

.coupon-action {
  width: 88rpx;
  height: 46rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff3e5;
  border: 1rpx solid rgba(255, 122, 0, 0.28);
  font-size: 20rpx;
  font-weight: 600;
}

.coupon-watermark {
  position: absolute;
  right: 24rpx;
  bottom: -20rpx;
  color: rgba(255, 122, 0, 0.1);
  font-size: 94rpx;
  font-weight: 800;
  transform: rotate(-12deg);
}

.feature-card {
  margin-top: 16rpx;
  padding: 18rpx 22rpx 8rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.72);
}

.feature-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 6rpx;
}

.feature-kicker {
  color: #ff7300;
  font-size: 19rpx;
  font-weight: 600;
}

.feature-heading {
  margin-top: 5rpx;
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 650;
}

.feature-count {
  height: 40rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  color: #6b7280;
  background: #f5f7fb;
  font-size: 19rpx;
  font-weight: 500;
}

.feature-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.feature-icon {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: transparent;
  box-shadow: none;
}

.feature-icon::before,
.feature-icon::after {
  display: none;
}

.feature-icon-img {
  display: block;
  width: 100%;
  height: 100%;
}

.feature-copy {
  flex: 1;
  min-width: 0;
}

.feature-title {
  color: #1f2937;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.22;
}

.feature-desc {
  margin-top: 5rpx;
  color: #727b8c;
  font-size: 19rpx;
  line-height: 1.42;
}

.feature-arrow {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  border-top: 4rpx solid rgba(120, 116, 116, 0.3);
  border-right: 4rpx solid rgba(120, 116, 116, 0.3);
  transform: rotate(45deg);
}

.feature-divider {
  height: 1rpx;
  margin-left: 72rpx;
  background: linear-gradient(90deg, rgba(228, 180, 131, 0.42), rgba(228, 180, 131, 0));
}

.bottom-action {
  margin-top: 16rpx;
  padding: 12rpx 16rpx 14rpx;
  border-radius: 24rpx;
  border-color: rgba(255, 255, 255, 0.42);
  background: rgba(255, 255, 255, 0.42);
}

.claim-button {
  width: 100%;
  min-height: 68rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 18rpx;
  color: #fff;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.16), transparent 42%),
    linear-gradient(135deg, #ff8c1a 0%, #ff6f00 100%);
  box-shadow: 0 14rpx 26rpx rgba(255, 111, 0, 0.26);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.2;
}

.claim-button::after {
  border: none;
}

.claim-button[disabled] {
  opacity: 0.62;
  box-shadow: none;
}

.safe-note {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #8d8a86;
  font-size: 19rpx;
}

.safe-note__icon {
  position: relative;
  width: 23rpx;
  height: 27rpx;
  border: 3rpx solid currentColor;
  border-radius: 10rpx 10rpx 14rpx 14rpx;
  box-sizing: border-box;
}

.safe-note__icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 5rpx;
  width: 7rpx;
  height: 12rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: translateX(-50%) rotate(42deg);
}

.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
