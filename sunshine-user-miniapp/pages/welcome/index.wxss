}

.building--f4 {
  right: 168rpx;
  width: 94rpx;
  height: 190rpx;
}

.building--f5 {
  right: 52rpx;
  width: 86rpx;
  height: 142rpx;
}

.tree {
  position: absolute;
  width: 42rpx;
  height: 72rpx;
  border-radius: 22rpx 22rpx 16rpx 16rpx;
  background: linear-gradient(180deg, #b5c483 0%, #7ea35f 100%);
  box-shadow: 0 15rpx 24rpx rgba(126, 163, 95, 0.16);
}

.tree::before,
.tree::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: inherit;
}

.tree::before {
  left: -20rpx;
  top: 20rpx;
  width: 42rpx;
  height: 42rpx;
}

.tree::after {
  right: -20rpx;
  top: 22rpx;
  width: 40rpx;
  height: 40rpx;
}

.tree--1 {
  left: 126rpx;
  top: 604rpx;
}

.tree--2 {
  left: 426rpx;
  top: 574rpx;
  transform: scale(1.18);
}

.tree--3 {
  right: 224rpx;
  top: 606rpx;
  transform: scale(0.86);
}

.tree--4 {
  right: 72rpx;
  top: 622rpx;
  transform: scale(0.72);
}

.road-scene {
  position: absolute;
  left: -36rpx;
  right: -110rpx;
  top: 690rpx;
  height: 272rpx;
  background:
    linear-gradient(166deg, transparent 0 22%, rgba(255, 255, 255, 0.66) 23% 25%, transparent 26% 100%),
    linear-gradient(166deg, transparent 0 46%, rgba(255, 255, 255, 0.8) 47% 49%, transparent 50% 100%),
    linear-gradient(166deg, transparent 0 70%, rgba(255, 255, 255, 0.65) 71% 73%, transparent 74% 100%),
    linear-gradient(180deg, rgba(255, 196, 119, 0.22), rgba(255, 159, 74, 0.16));
  transform: skewY(-5deg);
}

.road-line {
  position: absolute;
  height: 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  transform: rotate(-11deg);
}

.road-line--one {
  left: 110rpx;
  top: 66rpx;
  width: 280rpx;
}

.road-line--two {
  right: 118rpx;
  top: 118rpx;
  width: 220rpx;
}

.road-line--three {
  right: 52rpx;
  top: 196rpx;
  width: 170rpx;
}

.hero-car {
  position: absolute;
  right: 126rpx;
  top: 644rpx;
  width: 246rpx;
  height: 142rpx;
  filter: drop-shadow(0 18rpx 24rpx rgba(151, 78, 15, 0.2));
}

.hero-car__body {
  position: absolute;
  left: 14rpx;
  bottom: 30rpx;
  width: 216rpx;
  height: 78rpx;
  border-radius: 36rpx 46rpx 28rpx 28rpx;
  background: linear-gradient(180deg, #ffb03f 0%, #ff7a00 78%);
  border: 3rpx solid rgba(119, 65, 13, 0.18);
}

.hero-car__top {
  position: absolute;
  left: 74rpx;
  top: 24rpx;
  width: 92rpx;
  height: 60rpx;
  border-radius: 36rpx 36rpx 8rpx 8rpx;
  background: linear-gradient(180deg, #fff5e7 0%, #ff9d32 74%);
  border: 3rpx solid rgba(119, 65, 13, 0.16);
}

.hero-car__window {
  position: absolute;
  top: 36rpx;
  width: 32rpx;
  height: 30rpx;
  border-radius: 13rpx 13rpx 4rpx 4rpx;
  background: #e9f4ff;
}

.hero-car__window--left {
  left: 84rpx;
}

.hero-car__window--right {
  left: 122rpx;
}

.hero-car__light {
  position: absolute;
  bottom: 58rpx;
  width: 18rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #fff4cd;
}

.hero-car__light--left {
  left: 24rpx;
}

.hero-car__light--right {
  right: 28rpx;
}

.hero-car__plate {
  position: absolute;
  left: 100rpx;
  bottom: 48rpx;
  width: 48rpx;
  height: 18rpx;
  border-radius: 5rpx;
  background: #2bbf7d;
}

.hero-car__wheel {
  position: absolute;
  bottom: 16rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #2e3035;
  box-shadow: inset 0 0 0 11rpx #ffffff, inset 0 0 0 16rpx #88909c;
}

.hero-car__wheel--left {
  left: 48rpx;
}

.hero-car__wheel--right {
  right: 44rpx;
}

.hero-car__sign {
  position: absolute;
  left: 94rpx;
  top: 0;
  padding: 5rpx 15rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  color: #ffffff;
  background: #ff7a00;
  font-size: 17rpx;
  font-weight: 900;
}

.welcome-content {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  padding: 138rpx 44rpx calc(env(safe-area-inset-bottom) + 36rpx);
}

.brand-block {
  margin-top: 8rpx;
}

.brand-title {
  color: #333238;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: 1rpx;
}

.brand-subtitle {
  margin-top: 12rpx;
  color: #7a7170;
  font-size: 24rpx;
  font-weight: 600;
}

.gift-pill {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  height: 58rpx;
  margin-top: 64rpx;
  padding: 0 28rpx 0 22rpx;
  border-radius: 20rpx;
  color: #ff6f00;
  background: rgba(255, 214, 170, 0.72);
  font-size: 24rpx;
  font-weight: 800;
}

.gift-icon {
  position: relative;
  width: 34rpx;
  height: 32rpx;
}

.gift-icon::before {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 11rpx;
  width: 30rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.gift-icon::after {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 6rpx;
  width: 4rpx;
  height: 25rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.gift-icon__bow {
  position: absolute;
  left: 5rpx;
  top: 0;
  width: 24rpx;
  height: 14rpx;
}

.gift-icon__bow::before,
.gift-icon__bow::after {
  content: "";
  position: absolute;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50% 50% 50% 0;
  border: 4rpx solid currentColor;
}

.gift-icon__bow::before {
  left: 0;
  transform: rotate(-35deg);
}

.gift-icon__bow::after {
  right: 0;
  transform: rotate(135deg);
}

.hero-copy {
  margin-top: 44rpx;
}

.hero-title {
  color: #3b220c;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 1rpx;
}

.hero-desc {
  margin-top: 24rpx;
  color: #716d73;
  font-size: 27rpx;
  line-height: 1.45;
}

.coupon-card {
  position: relative;
  width: 392rpx;
  min-height: 276rpx;
  margin-top: 118rpx;
  padding: 40rpx 44rpx 34rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 22rpx 44rpx rgba(153, 86, 25, 0.12);
  backdrop-filter: blur(10rpx);
}

.coupon-card::after {
  content: "";
  position: absolute;
  right: -2rpx;
  top: 50%;
  width: 42rpx;
  height: 68rpx;
  border-radius: 42rpx 0 0 42rpx;
  background: #ffe3bf;
  transform: translateY(-50%);
}

.coupon-amount {
  display: flex;
  align-items: baseline;
  color: #ff6f00;
  font-weight: 900;
  line-height: 1;
}

.coupon-amount text:first-child {
  font-size: 104rpx;
  letter-spacing: 1rpx;
}

.coupon-unit {
  margin-left: 14rpx;
  font-size: 32rpx;
}

.coupon-title {
  margin-top: 24rpx;
  color: #191715;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.coupon-desc {
  margin-top: 20rpx;
  color: #5f5960;
  font-size: 24rpx;
  line-height: 1.45;
}

.coupon-corner {
  position: absolute;
  left: 18rpx;
  right: -350rpx;
  bottom: -16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 185, 103, 0.46);
  filter: blur(1rpx);
}

.coupon-ticket {
  position: absolute;
  right: -94rpx;
  bottom: -18rpx;
  width: 138rpx;
  height: 82rpx;
  border-radius: 13rpx;
  color: rgba(255, 255, 255, 0.76);
  background: linear-gradient(135deg, rgba(255, 181, 101, 0.82), rgba(255, 130, 18, 0.52));
  transform: rotate(-14deg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 900;
}

.feature-card {
  margin-top: 64rpx;
  padding: 28rpx 34rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(135, 83, 39, 0.08);
}

.feature-row {
  min-height: 142rpx;
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.feature-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ff6f00;
  background:
    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.86), rgba(255, 241, 223, 0.98));
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.08);
}

.feature-icon--pin::before {
  content: "";
  position: absolute;
  left: 28rpx;
  top: 18rpx;
  width: 32rpx;
  height: 42rpx;
  border-radius: 50% 50% 50% 0;
  background: currentColor;
  transform: rotate(-45deg);
}

.feature-icon--pin::after {
  content: "";
  position: absolute;
  left: 38rpx;
  top: 28rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 32rpx 0 -2rpx currentColor;
}

.feature-icon--wallet::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 30rpx;
  width: 42rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: currentColor;
}

.feature-icon--wallet::after {
  content: "";
  position: absolute;
  right: 20rpx;
  top: 40rpx;
  width: 14rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.feature-icon--shield::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 18rpx;
  width: 40rpx;
  height: 48rpx;
  border-radius: 18rpx 18rpx 24rpx 24rpx;
  background: currentColor;
}

.feature-icon--shield::after {
  content: "";
  position: absolute;
  left: 37rpx;
  top: 29rpx;
  width: 12rpx;
  height: 24rpx;
  border-right: 7rpx solid #ffffff;
  border-bottom: 7rpx solid #ffffff;
  transform: rotate(42deg);
}

.feature-index {
  width: 52rpx;
  flex-shrink: 0;
  color: #ff6f00;
  font-size: 29rpx;
  font-weight: 900;
}

.feature-copy {
  flex: 1;
  min-width: 0;
}

.feature-title {
  color: #16130f;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.22;
}

.feature-desc {
  margin-top: 16rpx;
  color: #6f6b74;
  font-size: 24rpx;
  line-height: 1.45;
}

.feature-arrow {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
  border-top: 4rpx solid rgba(120, 116, 116, 0.36);
  border-right: 4rpx solid rgba(120, 116, 116, 0.36);
  transform: rotate(45deg);
}

.feature-divider {
  height: 1rpx;
  margin-left: 116rpx;
  background: rgba(228, 180, 131, 0.42);
}

.bottom-action {
  margin-top: 40rpx;
}

.claim-button {
  width: 100%;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb450 0%, #ff7a00 52%, #ff6500 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 111, 0, 0.28);
  font-size: 33rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.claim-button::after {
  border: none;
}

.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}

.safe-note {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #a49b96;
  font-size: 24rpx;
}

.safe-note__icon {
  position: relative;
  width: 26rpx;
  height: 30rpx;
  border-radius: 10rpx 10rpx 14rpx 14rpx;
  border: 3rpx solid currentColor;
}

.safe-note__icon::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 5rpx;
  width: 7rpx;
  height: 14rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(42deg);
}
