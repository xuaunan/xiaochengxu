page {
  background: #fff4e7;
}

.welcome-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 56% 28%, rgba(255, 255, 255, 0.78), transparent 20%),
    linear-gradient(180deg, #fff1df 0%, #fff9f1 52%, #fff0de 100%);
}

.welcome-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.welcome-bg::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 85% 12%, rgba(255, 183, 100, 0.16), transparent 26%),
    radial-gradient(circle at 18% 54%, rgba(255, 205, 139, 0.18), transparent 20%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 244, 228, 0.4));
}

.sky-card {
  position: absolute;
  width: 88rpx;
  height: 58rpx;
  border-radius: 10rpx;
  background: rgba(255, 188, 112, 0.28);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.34);
}

.sky-card::before,
.sky-card::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
}

.sky-card::before {
  top: 20rpx;
}

.sky-card::after {
  top: 31rpx;
}

.sky-card--one {
  top: 250rpx;
  left: 480rpx;
}

.sky-card--two {
  top: 220rpx;
  right: 178rpx;
}

.sky-card--three {
  top: 182rpx;
  right: 356rpx;
}

.city {
  position: absolute;
  right: 0;
  left: 0;
}

.city--back {
  top: 252rpx;
  height: 470rpx;
  opacity: 0.28;
}

.city--front {
  top: 424rpx;
  height: 300rpx;
  opacity: 0.4;
}

.building {
  position: absolute;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255, 205, 151, 0.82), rgba(255, 160, 74, 0.52));
  border-radius: 14rpx 14rpx 0 0;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.35);
}

.building::before {
  content: "";
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 26rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
  box-shadow: 0 34rpx 0 rgba(255, 255, 255, 0.34), 0 68rpx 0 rgba(255, 255, 255, 0.3), 0 102rpx 0 rgba(255, 255, 255, 0.26);
}

.building--b1 {
  left: 382rpx;
  width: 78rpx;
  height: 170rpx;
}

.building--b2 {
  left: 512rpx;
  width: 86rpx;
  height: 246rpx;
}

.building--b3 {
  right: 300rpx;
  width: 78rpx;
  height: 312rpx;
}

.building--b4 {
  right: 198rpx;
  width: 86rpx;
  height: 398rpx;
  border-radius: 48rpx 48rpx 0 0;
}

.building--b5 {
  right: 104rpx;
  width: 82rpx;
  height: 256rpx;
}

.building--b6 {
  right: 18rpx;
  width: 72rpx;
  height: 214rpx;
}

.building--f1 {
  left: 286rpx;
  width: 68rpx;
  height: 136rpx;
}

.building--f2 {
  left: 424rpx;
  width: 74rpx;
  height: 220rpx;
}

.building--f3 {
  right: 270rpx;
  width: 70rpx;
