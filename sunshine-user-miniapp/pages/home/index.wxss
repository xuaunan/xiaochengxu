.home-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #f7f8fc;
}

.home-map-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(255, 247, 235, 0.32), rgba(247, 248, 252, 0.08)),
    #e9edf2;
}

.home-map {
  width: 100%;
}

.home-map-wrap::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 160rpx;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), #ffffff 90%);
  z-index: 2;
}

.map-brand {
  position: absolute;
  left: 42rpx;
  width: 330rpx;
  height: 142rpx;
  z-index: 6;
  pointer-events: none;
}

.brand-mark {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark__shield {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx 14rpx 20rpx 20rpx;
  background: linear-gradient(135deg, #ff9a2d 0%, #ff6f00 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 111, 0, 0.2);
}

.brand-mark__shield::after {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 10rpx;
  width: 14rpx;
  height: 22rpx;
  border-right: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  transform: rotate(42deg);
}

.brand-title {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.05;
  color: #ff6f00;
  letter-spacing: 2rpx;
}

.brand-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #697386;
  letter-spacing: 8rpx;
}

.brand-road {
  position: absolute;
  left: -46rpx;
  bottom: 4rpx;
  width: 336rpx;
  height: 70rpx;
  border-top: 6rpx solid rgba(255, 255, 255, 0.9);
  transform: rotate(-12deg);
  opacity: 0.78;
}

.brand-road::after {
  content: "";
  position: absolute;
  left: 70rpx;
  top: 20rpx;
  width: 170rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.9);
}

.brand-taxi,
.map-driver-car {
  position: absolute;
  pointer-events: none;
}

.brand-taxi {
  left: 190rpx;
  bottom: 26rpx;
  width: 78rpx;
  height: 42rpx;
  z-index: 2;
  transform: rotate(-5deg);
}

.brand-taxi__body,
.brand-taxi__top,
.map-driver-car__body,
.map-driver-car__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa33d 0%, #ff7a00 100%);
  border: 2rpx solid rgba(134, 68, 0, 0.16);
}

.brand-taxi__body {
  left: 4rpx;
  bottom: 8rpx;
  width: 70rpx;
  height: 28rpx;
  border-radius: 13rpx 16rpx 9rpx 9rpx;
}

.brand-taxi__top {
  left: 26rpx;
  bottom: 28rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.brand-taxi__wheel,
.map-driver-car__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #1f2432;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.brand-taxi__wheel--left {
  left: 15rpx;
}

.brand-taxi__wheel--right {
  right: 13rpx;
}

.map-center-pin {
  position: absolute;
  left: 50%;
  top: 48%;
  width: 68rpx;
  height: 68rpx;
  transform: translate(-50%, -50%);
  z-index: 5;
  pointer-events: none;
}

.map-center-pin__ring {
  position: absolute;
  inset: 4rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(34, 103, 204, 0.18);
}

.map-center-pin__dot {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #1f8dff;
  border: 6rpx solid #ffffff;
}

.map-driver-car {
  right: 154rpx;
  top: 46%;
  width: 54rpx;
  height: 70rpx;
  z-index: 5;
  transform: rotate(9deg);
}

.map-driver-car__body {
  left: 10rpx;
  top: 16rpx;
  width: 34rpx;
  height: 44rpx;
  border-radius: 12rpx;
}

.map-driver-car__top {
  left: 15rpx;
  top: 4rpx;
  width: 24rpx;
  height: 20rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.map-driver-car__wheel {
  width: 10rpx;
  height: 10rpx;
  box-shadow: none;
}

.map-driver-car__wheel--left {
  left: 6rpx;
  top: 24rpx;
}

.map-driver-car__wheel--right {
  right: 6rpx;
  top: 24rpx;
}

.safety-pill {
  position: absolute;
  left: 44rpx;
  bottom: 52rpx;
  z-index: 6;
  height: 74rpx;
  padding: 0 24rpx 0 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 999rpx;
  color: #1f2432;
  font-size: 27rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  box-shadow: 0 14rpx 34rpx rgba(24, 34, 56, 0.12);
}

.safety-icon {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx 14rpx 18rpx 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  background: linear-gradient(135deg, #7f8799 0%, #4f5869 100%);
}

.safety-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid rgba(31, 36, 50, 0.48);
  border-right: 3rpx solid rgba(31, 36, 50, 0.48);
  transform: rotate(45deg);
}

.home-panel {
  position: relative;
  z-index: 10;
  margin-top: -42rpx;
  border-radius: 38rpx 38rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -14rpx 40rpx rgba(24, 34, 56, 0.1);
}

.home-panel::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -140rpx;
  height: 140rpx;
  background: #ffffff;
}

.home-panel__content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  padding: 24rpx 28rpx 20rpx;
}

.service-tabs {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  min-height: 88rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(245, 247, 251, 0.94);
  box-shadow: inset 0 0 0 1rpx rgba(31, 36, 50, 0.04);
}

.service-tab {
  position: relative;
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-radius: 999rpx;
  color: #7a8396;
  font-size: 31rpx;
  font-weight: 800;
  transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.service-tab--active {
  color: #ffffff;
  background: linear-gradient(135deg, #ff6f00 0%, #ff982c 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 111, 0, 0.22);
}

.service-tab--active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -9rpx;
  width: 28rpx;
  height: 12rpx;
  border-radius: 0 0 20rpx 20rpx;
  background: #ff7a00;
  transform: translateX(-50%);
}

.service-tab__icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  color: currentColor;
}

.service-tab__icon--taxi::before {
  content: "";
  position: absolute;
  left: 3rpx;
  top: 11rpx;
  width: 30rpx;
  height: 17rpx;
  border-radius: 8rpx 9rpx 5rpx 5rpx;
  border: 4rpx solid currentColor;
}

.service-tab__icon--taxi::after {
  content: "";
  position: absolute;
  left: 9rpx;
  bottom: 1rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 16rpx 0 0 currentColor, 5rpx -19rpx 0 -1rpx currentColor;
}

.service-tab__icon--people::before,
.service-tab__icon--people::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.service-tab__icon--people::before {
  left: 4rpx;
  top: 5rpx;
  width: 11rpx;
  height: 11rpx;
  box-shadow: 18rpx 0 0 currentColor;
}

.service-tab__icon--people::after {
  left: 0;
  bottom: 4rpx;
  width: 17rpx;
  height: 13rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  box-shadow: 19rpx 0 0 currentColor;
}

.service-tab__icon--plane::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 15rpx;
  width: 30rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(-28deg);
}

.service-tab__icon--plane::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 8rpx;
  width: 8rpx;
  height: 23rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(-28deg);
}

.current-ride-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff8ef 0%, #fff2e2 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 0, 0.08);
}

.current-ride-card__head,
.current-ride-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.current-ride-card__eyebrow {
  color: #ff7a00;
  font-size: 22rpx;
  font-weight: 800;
}

.current-ride-card__title {
  margin-top: 10rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.current-ride-card__status {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 122, 0, 0.12);
  font-size: 22rpx;
  font-weight: 800;
}

.current-ride-card__foot {
  margin-top: 18rpx;
}

.current-ride-card__price {
  color: #ff6f00;
  font-size: 34rpx;
  font-weight: 900;
}

.current-ride-card__action {
  color: #172033;
  font-size: 24rpx;
  font-weight: 800;
}

.address-card {
  position: relative;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.055);
  box-shadow: 0 18rpx 40rpx rgba(24, 34, 56, 0.08);
}

.address-row {
  position: relative;
  min-height: 128rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 48rpx 22rpx 28rpx;
}

.address-pin {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.address-pin::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 13rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ffffff;
}

.address-pin--start {
  background: #30c878;
  box-shadow: 0 0 0 12rpx rgba(48, 200, 120, 0.12);
}

.address-pin--end {
  background: #ff5b57;
  box-shadow: 0 0 0 12rpx rgba(255, 91, 87, 0.12);
}

.address-copy {
  flex: 1;
  min-width: 0;
}

.address-label {
  color: #8d96a8;
  font-size: 24rpx;
  font-weight: 600;
}

.address-value {
  margin-top: 9rpx;
  color: #161d2d;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.15;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid rgba(31, 36, 50, 0.36);
  border-right: 4rpx solid rgba(31, 36, 50, 0.36);
  transform: translateY(-50%) rotate(45deg);
}

.address-divider {
  height: 1rpx;
  margin: 0 28rpx 0 86rpx;
  background: rgba(31, 36, 50, 0.08);
}

.address-switch {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ff6f00;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.14);
  font-size: 38rpx;
  font-weight: 900;
  transform: translate(-50%, -50%);
}

.estimate-block {
  margin-top: 28rpx;
  padding: 24rpx 20rpx 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fffaf3 0%, #fff7ee 100%);
}

.estimate-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.estimate-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.estimate-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ff6f00;
  background: rgba(255, 122, 0, 0.1);
  font-size: 22rpx;
}

.estimate-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
}

.estimate-tip {
  flex-shrink: 0;
  color: #ff6f00;
  font-size: 24rpx;
  font-weight: 800;
}

.estimate-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.estimate-card {
  min-height: 110rpx;
  padding: 18rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 153, 59, 0.12);
}

.estimate-card__value {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: center;
}

.estimate-card__label {
  margin-top: 10rpx;
  color: #70798b;
  font-size: 23rpx;
  font-weight: 600;
}

.car-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
  padding-bottom: 26rpx;
}

.car-card {
  position: relative;
  min-height: 176rpx;
  overflow: hidden;
  padding: 20rpx 18rpx 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fffaf5 100%);
  border: 2rpx solid rgba(255, 153, 59, 0.18);
  transition: transform 0.22s ease, opacity 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
}

.car-card--active {
  border-color: #ff6f00;
  box-shadow: 0 16rpx 32rpx rgba(255, 111, 0, 0.14);
}

.car-card--pulse {
  animation: car-pulse 0.3s ease;
}

.car-card__check {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 2;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6f00 0%, #ff962e 100%);
  font-size: 24rpx;
  font-weight: 900;
}

.car-card__name {
  position: relative;
  z-index: 2;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.car-card__desc {
  position: relative;
  z-index: 2;
  margin-top: 6rpx;
  min-height: 34rpx;
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.car-card__image {
  position: absolute;
  right: 8rpx;
  top: 56rpx;
  width: 126rpx;
  height: 76rpx;
  z-index: 1;
}

.car-card__action {
  position: relative;
  z-index: 2;
  margin-top: 54rpx;
  color: #ff6f00;
  font-size: 24rpx;
  font-weight: 800;
}

.car-card__action--price {
  margin-top: 52rpx;
}

.car-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-height: 34rpx;
}

.car-card__price-label {
  color: #8a92a4;
  font-size: 21rpx;
  font-weight: 600;
}

.car-card__price-original {
  color: #ff7a00;
  font-size: 25rpx;
  font-weight: 800;
}

.car-card__price-original--discounted {
  color: #aab2c1;
  font-size: 19rpx;
  text-decoration: line-through;
}

.car-card__price-payable,
.car-card__price-single {
  color: #ff6f00;
  font-weight: 900;
  line-height: 1;
}

.car-card__price-payable {
  font-size: 30rpx;
}

.car-card__price-single {
  font-size: 29rpx;
}

.home-panel__footer {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 22rpx 28rpx 18rpx;
  background: #ffffff;
  box-shadow: 0 -12rpx 28rpx rgba(31, 36, 50, 0.06);
}

.confirm-button {
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 1rpx;
  background: linear-gradient(135deg, #ff6f00 0%, #ff9d32 100%);
  box-shadow: 0 16rpx 32rpx rgba(255, 111, 0, 0.22);
}

.pressable-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.985);
  opacity: 0.96;
}

@keyframes car-pulse {
  0% {
    transform: scale(0.97);
  }
  60% {
    transform: scale(1.018);
  }
  100% {
    transform: scale(1);
  }
}
