.home-page {
  height: 100vh;
  overflow: hidden;
  background: #f5f5f5;
}

.home-map-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #e7ecf3;
}

.home-map {
  width: 100%;
}

.home-brand {
  position: absolute;
  left: 28rpx;
  z-index: 6;
}

.home-brand__title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.05;
  color: #1f2432;
}

.home-brand__subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9da6b8;
}

.home-panel {
  position: relative;
  margin-top: -24rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 28rpx rgba(24, 34, 56, 0.08);
}

.home-panel::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -128rpx;
  height: 128rpx;
  background: #ffffff;
  z-index: 0;
}

.home-notice-ticker {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  height: 52rpx;
  margin: 0 24rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 122, 0, 0.16);
  border-bottom: 0;
  border-radius: 28rpx 28rpx 0 0;
  background: linear-gradient(90deg, rgba(255, 247, 238, 0.98), rgba(255, 255, 255, 0.96));
}

.home-notice-ticker__label {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.12);
  color: #ff7a00;
  font-size: 20rpx;
  font-weight: 700;
}

.home-notice-ticker__track {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.home-notice-ticker__text {
  display: inline-block;
  padding-left: 100%;
  color: #566277;
  font-size: 20rpx;
  line-height: 52rpx;
  white-space: nowrap;
  animation: home-notice-marquee 18s linear infinite;
}

.home-panel__content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  padding: 22rpx 24rpx 24rpx;
  box-sizing: border-box;
}

@keyframes home-notice-marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-100%);
  }
}

.service-tabs {
  display: flex;
  gap: 12rpx;
}

.current-ride-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff7ef 0%, #fff1e2 100%);
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 0, 0.08);
}

.current-ride-card__head,
.current-ride-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.current-ride-card__eyebrow {
  font-size: 20rpx;
  color: #ff8a1f;
  font-weight: 700;
}

.current-ride-card__title {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 750;
  color: #1f2432;
  line-height: 1.32;
}

.current-ride-card__status {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.12);
  color: #ff7a00;
  font-size: 20rpx;
  font-weight: 700;
}

.current-ride-card__foot {
  margin-top: 18rpx;
}

.current-ride-card__price {
  font-size: 28rpx;
  font-weight: 750;
  color: #ff7a00;
}

.current-ride-card__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  font-size: 21rpx;
  font-weight: 700;
  color: #ff7a00;
  white-space: nowrap;
}

.service-tab {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #f5f6fa;
  color: #6d7688;
  font-size: 23rpx;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.service-tab__icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.service-tab--active {
  background: linear-gradient(135deg, #ff8a1f 0%, #ff7a00 100%);
  color: #ffffff;
}

.address-block {
  position: relative;
  margin-top: 18rpx;
}

.address-card {
  min-height: 110rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f7f8fc;
  border: 1rpx solid rgba(31, 36, 50, 0.04);
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.address-card + .address-card {
  margin-top: 18rpx;
}

.address-card__dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.address-card__dot--start {
  background: #22c36a;
  box-shadow: 0 0 0 10rpx rgba(34, 195, 106, 0.12);
}

.address-card__dot--end {
  background: #ffb8b4;
  box-shadow: 0 0 0 10rpx rgba(255, 184, 180, 0.14);
}

.address-card__body {
  flex: 1;
  min-width: 0;
}

.address-card__label {
  font-size: 20rpx;
  color: #a2aabc;
}

.address-card__value {
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 650;
  color: #1f2432;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-switch {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: rgba(255, 122, 0, 0.1);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.08);
  color: #ff7a00;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.estimate-block {
  margin-top: 18rpx;
}

.estimate-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.estimate-title {
  font-size: 30rpx;
  font-weight: 750;
  color: #1f2432;
}

.estimate-subtitle {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #7f8799;
}

.estimate-tip {
  flex-shrink: 0;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: #fff3e3;
  color: #ff8a1f;
  font-size: 20rpx;
  font-weight: 600;
}

.estimate-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.estimate-card {
  min-height: 112rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #fffaf4 0%, #fff5ea 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.estimate-card__value {
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 750;
  color: #1f2432;
  word-break: break-word;
}

.estimate-card__label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8f97a8;
}

.car-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
  padding-bottom: 24rpx;
}

.car-card {
  min-height: 236rpx;
  padding: 18rpx 14rpx 16rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(31, 36, 50, 0.06);
  background: #ffffff;
  transition: transform 0.22s ease, opacity 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
}

.car-card--active {
  border-color: rgba(255, 122, 0, 0.32);
  background: linear-gradient(180deg, #fffdfa 0%, #fff7ef 100%);
  box-shadow: 0 14rpx 28rpx rgba(255, 122, 0, 0.1);
}

.car-card--pulse {
  animation: car-pulse 0.3s ease;
}

.car-card__icon-box {
  height: 74rpx;
  border-radius: 18rpx;
  background: #fff4e7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.car-card__image {
  width: 96rpx;
  height: 64rpx;
}

.car-card__name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.car-card__desc {
  margin-top: 10rpx;
  min-height: 64rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8a92a4;
  overflow: hidden;
}

.car-card__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
  max-width: 100%;
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  font-size: 24rpx;
  font-weight: 700;
  color: #ff7a00;
  overflow: hidden;
}

.car-card__action--price {
  font-size: 28rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.11);
}

.car-card__price-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  min-height: 36rpx;
}

.car-card__price-original {
  color: #ff7a00;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.15;
}

.car-card__price-original--discounted {
  color: #b4bccb;
  font-size: 20rpx;
  font-weight: 600;
  text-decoration: line-through;
  line-height: 1.3;
}

.car-card__price-payable,
.car-card__price-single {
  color: #ff7a00;
  font-weight: 800;
  line-height: 1.1;
}

.car-card__price-payable {
  font-size: 30rpx;
}

.car-card__price-single {
  font-size: 28rpx;
}

.home-panel__footer {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 34rpx 24rpx 18rpx;
  background: #ffffff;
  box-shadow: 0 -12rpx 28rpx rgba(31, 36, 50, 0.06);
}

.confirm-button {
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.14);
  background: rgba(255, 122, 0, 0.11);
  color: #ff7a00;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.08);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.15;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-button[disabled] {
  background: rgba(148, 163, 184, 0.12);
  border-color: rgba(148, 163, 184, 0.14);
  color: #98a2b3;
  box-shadow: none;
}

.pressable-hover,
.tap-scale:active {
  transform: scale(0.97);
  opacity: 0.92;
}

@keyframes car-pulse {
  0% {
    transform: scale(0.96);
  }
  60% {
    transform: scale(1.02);
  }
  100% {
    transform: scale(1);
  }
}
