<view class="page-shell safe-bottom">
  <view class="profile-edit-page">
    <view class="edit-hero">
      <view>
        <view class="edit-kicker">{{copy.account}}</view>
        <view class="edit-title">{{copy.title}}</view>
        <view class="edit-subtitle">{{phoneText}}</view>
      </view>
      <view class="avatar-view" aria-label="{{copy.avatar}}">
        <image class="avatar-image" src="{{form.avatar || '/images/avatar-user.svg'}}" mode="aspectFill"></image>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">{{copy.basic}}</view>
      <view class="form-item">
        <view class="form-label">{{copy.nickname}}</view>
        <input class="form-input" maxlength="20" data-key="nickname" value="{{form.nickname}}" bindinput="updateField" placeholder="{{copy.nicknamePlaceholder}}"></input>
      </view>
      <view class="form-item">
        <view class="form-label">{{copy.realName}}</view>
        <input class="form-input" maxlength="20" data-key="realName" value="{{form.realName}}" bindinput="updateField" placeholder="{{copy.optional}}"></input>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">{{copy.contact}}</view>
      <view class="form-item">
        <view class="form-label">{{copy.emergencyContact}}</view>
        <input class="form-input" maxlength="20" data-key="emergencyContact" value="{{form.emergencyContact}}" bindinput="updateField" placeholder="{{copy.optional}}"></input>
      </view>
      <view class="form-item">
        <view class="form-label">{{copy.emergencyPhone}}</view>
        <input class="form-input" type="number" maxlength="16" data-key="emergencyPhone" value="{{form.emergencyPhone}}" bindinput="updateField" placeholder="8-16位纯数字"></input>
      </view>
    </view>

    <button class="primary-action" disabled="{{saving}}" bindtap="submitForm">{{copy.save}}</button>
  </view>
</view>
