.profile-edit-page {
  display: grid;
  gap: 24rpx;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
}

.edit-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 122, 0, 0.08), transparent 34%),
    rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.08);
}

.edit-kicker {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #f97316;
}

.edit-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1f2432;
}

.edit-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8396;
}

.avatar-view {
  flex: 0 0 136rpx;
  width: 136rpx;
  height: 136rpx;
  padding: 6rpx;
  border-radius: 36rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.07);
}

.avatar-image {
  width: 124rpx;
  height: 124rpx;
  display: block;
  border-radius: 30rpx;
}

.form-section {
  display: grid;
  gap: 2rpx;
  padding: 18rpx 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.06);
}

.section-title {
  padding: 12rpx 0 4rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #475569;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
}

.form-item:last-child {
  border-bottom: 0;
}

.form-label {
  width: 188rpx;
  flex: 0 0 188rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: rgba(247, 248, 252, 0.95);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  font-size: 28rpx;
  line-height: 80rpx;
  color: #1f2432;
  text-align: right;
}

.primary-action {
  width: 100%;
  height: 96rpx;
  border-radius: 26rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.16);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.primary-action::after {
  border: none;
}

.primary-action[disabled] {
  opacity: 0.72;
}

.primary-action.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.97;
}


