.profile-edit-shell {
  background:
    radial-gradient(circle at 12% 0%, rgba(255, 186, 99, 0.22), transparent 32%),
    linear-gradient(180deg, #fff4e8 0%, #f7f8fc 34%, #f4f6fb 100%);
}

.profile-edit-page {
  position: relative;
  display: grid;
  gap: 18rpx;
  padding: 22rpx 44rpx calc(env(safe-area-inset-bottom) + 38rpx);
}

.edit-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 22rpx;
  min-height: 158rpx;
  padding: 28rpx 30rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(118deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 248, 239, 0.96) 58%, rgba(255, 224, 184, 0.62) 100%),
    #ffffff;
  border: 1rpx solid rgba(255, 122, 0, 0.13);
  box-shadow: 0 12rpx 28rpx rgba(210, 104, 18, 0.07);
}

.edit-hero > view:first-child {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.edit-hero::before {
  content: "";
  position: absolute;
  right: 64rpx;
  top: -28rpx;
  width: 138rpx;
  height: 138rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.58);
  transform: rotate(18deg);
}

.edit-hero::after {
  content: "";
  position: absolute;
  right: -46rpx;
  bottom: -54rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(255, 122, 0, 0.1);
}

.edit-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2432;
  line-height: 1.2;
}

.edit-subtitle {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1;
  color: #7b8497;
  background: rgba(255, 255, 255, 0.66);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
}

.avatar-view {
  position: relative;
  z-index: 2;
  align-self: center;
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  padding: 6rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffffff, #fff3e5);
  border: 1rpx solid rgba(255, 122, 0, 0.16);
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.055);
}

.avatar-button {
  margin: 0;
  line-height: 1;
  box-sizing: border-box;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.avatar-button::after {
  border: none;
}

.avatar-button[disabled] {
  opacity: 0.72;
}

.avatar-button--hover {
  transform: translateY(2rpx) scale(0.98);
  opacity: 0.96;
}

.avatar-image {
  width: 100rpx;
  height: 100rpx;
  display: block;
  border-radius: 24rpx;
}

.avatar-action {
  position: absolute;
  right: 0;
  bottom: 0;
  min-width: 58rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 16rpx 0 24rpx 0;
  background: rgba(255, 122, 0, 0.92);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 550;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 10rpx rgba(255, 122, 0, 0.18);
}

.form-section {
  position: relative;
  overflow: hidden;
  display: grid;
  gap: 12rpx;
  padding: 22rpx 28rpx 24rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(255, 253, 250, 0.98)),
    #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(24, 34, 56, 0.06);
}

.form-section::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff9b32, #ff7a00);
  opacity: 0.72;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 0 2rpx 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #ff7a00;
}

.section-title::before {
  content: "";
  width: 18rpx;
  height: 18rpx;
  border-radius: 7rpx;
  background: linear-gradient(135deg, #ff9b32, #ff7a00);
  box-shadow: 0 4rpx 10rpx rgba(255, 122, 0, 0.18);
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 78rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: #f7f9fd;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
}

.form-item:last-child {
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.05);
}

.form-label {
  position: relative;
  width: 150rpx;
  flex: 0 0 150rpx;
  padding-left: 22rpx;
  font-size: 22rpx;
  font-weight: 450;
  color: #6f788b;
}

.form-label::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff9b32;
  transform: translateY(-50%);
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  min-height: 64rpx;
  box-sizing: border-box;
  padding: 0 2rpx 0 16rpx;
  border-radius: 0;
  background: transparent;
  border: 0;
  font-size: 23rpx;
  line-height: 64rpx;
  color: #1f2432;
  text-align: right;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 380rpx;
  height: 76rpx;
  margin: 16rpx auto 0;
  padding: 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9829 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
  box-sizing: border-box;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.16);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.primary-action::after {
  border: none;
}

.primary-action[disabled] {
  opacity: 0.72;
}

.primary-action.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.97;
}


