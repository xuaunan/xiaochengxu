.profile-edit-page {
  display: grid;
  gap: 24rpx;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
}

.edit-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 177, 74, 0.18), transparent 34%),
    linear-gradient(135deg, #fff7ed 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.08);
}

.edit-kicker {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #f97316;
}

.edit-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1f2432;
}

.edit-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8396;
}

.avatar-view {
  flex: 0 0 136rpx;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(249, 115, 22, 0.18);
}

.avatar-image {
  width: 136rpx;
  height: 136rpx;
  display: block;
}

.form-section {
  display: grid;
  gap: 2rpx;
  padding: 18rpx 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 122, 0, 0.06);
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.section-title {
  padding: 12rpx 0 4rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #475569;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
}

.form-item:last-child {
  border-bottom: 0;
}

.form-label {
  width: 188rpx;
  flex: 0 0 188rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(255, 122, 0, 0.06);
  font-size: 28rpx;
  line-height: 80rpx;
  color: #1f2432;
  text-align: right;
}

.primary-action {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9a31 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 34rpx rgba(255, 122, 0, 0.22);
}

.primary-action::after {
  border: none;
}

.primary-action[disabled] {
  opacity: 0.72;
}


