.profile-edit-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.64) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.profile-edit-page {
  display: grid;
  gap: 24rpx;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
}

.edit-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.055);
}

.edit-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2432;
}

.edit-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8396;
}

.avatar-view {
  flex: 0 0 126rpx;
  width: 126rpx;
  height: 126rpx;
  padding: 6rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #fff7ef, #ffffff);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.055);
}

.avatar-image {
  width: 114rpx;
  height: 114rpx;
  display: block;
  border-radius: 28rpx;
}

.form-section {
  display: grid;
  gap: 2rpx;
  padding: 18rpx 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.section-title {
  padding: 12rpx 0 4rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #ff7a00;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
}

.form-item:last-child {
  border-bottom: 0;
}

.form-label {
  width: 188rpx;
  flex: 0 0 188rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  font-size: 28rpx;
  line-height: 80rpx;
  color: #1f2432;
  text-align: right;
}

.primary-action {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.16);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.primary-action::after {
  border: none;
}

.primary-action[disabled] {
  opacity: 0.72;
}

.primary-action.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.97;
}


