.profile-edit-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.64) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.profile-edit-page {
  display: grid;
  gap: 14rpx;
  padding: 18rpx 18rpx calc(env(safe-area-inset-bottom) + 28rpx);
}

.edit-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 7rpx 18rpx rgba(24, 34, 56, 0.035);
}

.edit-title {
  font-size: 27rpx;
  font-weight: 550;
  color: #1f2432;
}

.edit-subtitle {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7a8396;
}

.avatar-view {
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 92rpx;
  padding: 4rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff7ef, #ffffff);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.055);
}

.avatar-image {
  width: 84rpx;
  height: 84rpx;
  display: block;
  border-radius: 20rpx;
}

.form-section {
  display: grid;
  gap: 2rpx;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 7rpx 18rpx rgba(24, 34, 56, 0.035);
}

.section-title {
  padding: 10rpx 0 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #ff7a00;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
}

.form-item:last-child {
  border-bottom: 0;
}

.form-label {
  width: 148rpx;
  flex: 0 0 148rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #1f2432;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  min-height: 58rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  font-size: 22rpx;
  line-height: 58rpx;
  color: #1f2432;
  text-align: right;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 68rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 24rpx;
  font-weight: 550;
  line-height: 1.2;
  box-sizing: border-box;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.16);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.primary-action::after {
  border: none;
}

.primary-action[disabled] {
  opacity: 0.72;
}

.primary-action.button-hover {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.97;
}


