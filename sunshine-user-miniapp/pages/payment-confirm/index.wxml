<view class="page-shell payment-shell safe-bottom fade-in">
  <view class="page-content payment-page page-enter {{loading ? '' : 'payment-page-ready'}}" wx:if="{{order}}">
    <view class="hero-card amount-card">
      <view class="amount-label">订单总金额</view>
      <view class="amount-value">{{order.amountText}}</view>
      <view class="section-subtitle amount-subtitle">
        {{order.payStatus === 'PAID' ? '当前订单已完成支付，可直接返回订单详情。' : '支付成功后会自动更新订单状态。'}}
      </view>
      <view class="route-summary">
        <view class="route-text">{{order.startDisplay}} -> {{order.endDisplay}}</view>
        <view class="route-order">订单号：{{order.orderNo}}</view>
      </view>
    </view>

    <view class="panel-card">
      <view class="section-title">支付方式</view>
      <view class="section-subtitle">选择本次订单的支付渠道</view>
      <view class="method-list">
        <view
          class="method-item {{selectedMethod === item.key ? 'method-item-active' : ''}}"
          wx:for="{{paymentMethods}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="selectMethod"
        >
          <view class="method-main">
            <view class="method-name">{{item.name}}</view>
            <view class="method-desc">{{item.desc}}</view>
          </view>
          <view class="method-check">
            <view class="method-check__inner" wx:if="{{selectedMethod === item.key}}"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="panel-card tip-card">
      <view class="section-title">支付提示</view>
      <view class="tip-list">
        <view class="tip-item">支付完成后，订单详情会自动更新。</view>
        <view class="tip-item">未完成支付时，订单会继续保留为待支付状态。</view>
      </view>
    </view>
  </view>

  <view class="page-content" wx:elif="{{loading}}">
    <view class="hero-card skeleton skeleton-card"></view>
    <view class="panel-card skeleton skeleton-panel"></view>
  </view>

  <view class="payment-footer" wx:if="{{order}}">
    <button class="ghost-button footer-cancel" hover-class="button-hover" bindtap="cancelPay">
      {{order.payStatus === 'PAID' ? '查看订单' : '暂不支付'}}
    </button>
    <button
      class="primary-button footer-confirm"
      hover-class="button-hover"
      bindtap="confirmPay"
      loading="{{processing}}"
      disabled="{{processing || !canPay || order.payStatus === 'PAID'}}"
    >
      {{confirmText}}
    </button>
  </view>

  <view wx:if="{{showSuccessPopup}}">
    <view class="mask-panel"></view>
    <view class="success-popup fade-in">
      <view class="success-icon">✓</view>
      <view class="success-title">支付成功</view>
      <view class="success-desc">{{successHint}}</view>
    </view>
  </view>
</view>
