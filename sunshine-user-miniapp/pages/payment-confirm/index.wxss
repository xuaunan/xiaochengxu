.payment-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.22) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.payment-page {
  padding-bottom: 240rpx;
}

.amount-card {
  position: relative;
  overflow: hidden;
  text-align: center;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  border-radius: 30rpx;
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.amount-label {
  font-size: 26rpx;
  font-weight: 800;
  color: #7d8799;
}

.amount-value {
  margin-top: 16rpx;
  font-size: 76rpx;
  font-weight: 900;
  color: #ff6b00;
  line-height: 1.05;
}

.amount-subtitle {
  margin-top: 12rpx;
}

.route-summary {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.route-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #1f2432;
}

.route-order {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b94a7;
}

.method-list {
  margin-top: 24rpx;
}

.method-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(31, 36, 50, 0.08);
  background: linear-gradient(180deg, #ffffff, #fafbfe);
  transition:
    transform 0.16s var(--motion-press),
    border-color 0.22s var(--motion-smooth),
    box-shadow 0.22s var(--motion-smooth),
    background 0.22s var(--motion-smooth);
}

.method-item:active {
  transform: translateY(2rpx) scale(0.985);
}

.method-item + .method-item {
  margin-top: 18rpx;
}

.method-item-active {
  border-color: rgba(255, 122, 0, 0.3);
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.98), rgba(255, 255, 255, 0.98));
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.06);
  transform: translateY(-1rpx);
}

.method-main {
  flex: 1;
}

.method-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
}

.method-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b94a7;
}

.method-check {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 122, 0, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.method-check__inner {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.tip-card {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  border-radius: 28rpx;
}

.tip-list {
  margin-top: 20rpx;
}

.tip-item {
  position: relative;
  padding-left: 24rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #5b6476;
}

.tip-item + .tip-item {
  margin-top: 12rpx;
}

.tip-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 15rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.skeleton-card {
  height: 320rpx;
  border-radius: 32rpx;
}

.skeleton-panel {
  height: 260rpx;
  margin-top: 20rpx;
  border-radius: 32rpx;
}

.payment-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -12rpx 30rpx rgba(31, 36, 50, 0.08);
}

.footer-cancel {
  width: 220rpx;
  min-height: 96rpx;
  border-radius: 22rpx;
  font-weight: 900;
}

.footer-confirm {
  flex: 1;
  min-height: 96rpx;
  border-radius: 22rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.success-popup {
  position: fixed;
  left: 72rpx;
  right: 72rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 70;
  padding: 48rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 28rpx 50rpx rgba(31, 36, 50, 0.16);
}

.success-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(180deg, #ff9c2f, #ff6b00);
}

.success-title {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2432;
}

.success-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #6b7385;
}


