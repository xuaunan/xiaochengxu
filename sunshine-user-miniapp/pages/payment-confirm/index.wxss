.payment-page {
  padding-bottom: 240rpx;
}

.amount-card {
  text-align: center;
  background:
    radial-gradient(circle at top, rgba(255, 177, 74, 0.26), transparent 40%),
    linear-gradient(180deg, #ffffff 0%, #fff8ef 100%);
}

.amount-label {
  font-size: 26rpx;
  color: #8b94a7;
}

.amount-value {
  margin-top: 16rpx;
  font-size: 82rpx;
  font-weight: 800;
  color: #ff7a00;
}

.amount-subtitle {
  margin-top: 12rpx;
}

.route-summary {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
}

.route-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #1f2432;
}

.route-order {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b94a7;
}

.method-list {
  margin-top: 24rpx;
}

.method-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 22rpx;
  border-radius: 28rpx;
  border: 2rpx solid rgba(31, 36, 50, 0.08);
  background: #ffffff;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.method-item + .method-item {
  margin-top: 18rpx;
}

.method-item-active {
  border-color: rgba(255, 122, 0, 0.3);
  background: linear-gradient(180deg, #fffaf3 0%, #fff4e6 100%);
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 0, 0.1);
  transform: translateY(-2rpx);
}

.method-main {
  flex: 1;
}

.method-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
}

.method-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b94a7;
}

.method-check {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 122, 0, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.method-check__inner {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.tip-card {
  margin-top: 20rpx;
}

.tip-list {
  margin-top: 20rpx;
}

.tip-item {
  position: relative;
  padding-left: 24rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #5b6476;
}

.tip-item + .tip-item {
  margin-top: 12rpx;
}

.tip-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 15rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.skeleton-card {
  height: 320rpx;
  border-radius: 32rpx;
}

.skeleton-panel {
  height: 260rpx;
  margin-top: 20rpx;
  border-radius: 32rpx;
}

.payment-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -12rpx 32rpx rgba(31, 36, 50, 0.08);
}

.footer-cancel {
  width: 220rpx;
  min-height: 96rpx;
  border-radius: 999rpx;
}

.footer-confirm {
  flex: 1;
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
}

.success-popup {
  position: fixed;
  left: 72rpx;
  right: 72rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 70;
  padding: 48rpx 32rpx;
  border-radius: 36rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 28rpx 50rpx rgba(31, 36, 50, 0.16);
}

.success-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ffb14a 100%);
}

.success-title {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2432;
}

.success-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #6b7385;
}


