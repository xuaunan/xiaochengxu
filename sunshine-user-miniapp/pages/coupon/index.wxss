.coupon-page-shell {
  background:
    linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.coupon-hero {
  position: relative;
  padding: 28rpx 28rpx 26rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  border-radius: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.coupon-hero::before {
  display: none;
}

.coupon-hero__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.coupon-hero__count {
  flex-shrink: 0;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.coupon-hero .section-title,
.coupon-hero .section-subtitle {
  color: #1f2432;
}

.coupon-hero .section-subtitle {
  color: #6b7385;
}

.coupon-tabs {
  margin-top: 18rpx;
  gap: 12rpx;
}

.coupon-tabs .chip {
  min-width: 148rpx;
  justify-content: center;
  padding: 12rpx 22rpx;
  font-size: 22rpx;
}

.coupon-hero .chip {
  color: #7a8396;
  background: #f8fafc;
  border-color: rgba(31, 36, 50, 0.08);
}

.coupon-hero .chip-active {
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  border-color: rgba(255, 122, 0, 0.18);
  box-shadow: none;
}

.coupon-section {
  margin-top: 20rpx;
}

.coupon-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.coupon-section__title {
  font-size: 30rpx;
}

.coupon-section__meta {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
}

.coupon-section--list .coupon-list {
  margin-top: 0;
}

.coupon-list {
  gap: 14rpx;
}

.coupon-more {
  width: 260rpx;
  margin: 18rpx auto 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.1);
}

.coupon-empty {
  margin-top: 20rpx;
}

.coupon-center {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.coupon-center__head {
  margin-bottom: 18rpx;
  padding: 0;
}

.coupon-center__empty {
  padding: 34rpx 20rpx;
  border-radius: 24rpx;
  color: #9aa3b5;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
  background: #f8f9fc;
}


