<view class="coupon-page-shell safe-bottom">
  <view class="coupon-page page-enter">
    <view class="coupon-hero">
      <view class="coupon-hero__copy">
        <view class="coupon-hero__title">优惠券中心</view>
        <view class="coupon-hero__subtitle">领券购物更优惠</view>
      </view>
      <view class="coupon-wallet" aria-hidden="true">
        <view class="coupon-wallet__ticket coupon-wallet__ticket--left">%</view>
        <view class="coupon-wallet__ticket coupon-wallet__ticket--right">券</view>
        <view class="coupon-wallet__body">
          <view class="coupon-wallet__button"></view>
        </view>
        <view class="coupon-wallet__coin coupon-wallet__coin--front">¥</view>
        <view class="coupon-wallet__coin coupon-wallet__coin--back">+</view>
      </view>
    </view>

    <view class="coupon-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="coupon-tab {{active === item.key ? 'coupon-tab--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="chooseTab"
      >
        {{item.label}}
      </view>
    </view>

    <view class="coupon-panel coupon-panel--mine">
      <view class="coupon-section__head">
        <view class="coupon-section__title-wrap">
          <view class="coupon-section__icon coupon-section__icon--orange"></view>
          <view class="coupon-section__title">我的券包</view>
        </view>
        <view class="coupon-section__more">{{currentTabCount}} 张{{currentTabMoreText}} <text class="coupon-section__chevron">›</text></view>
      </view>

      <block wx:if="{{list.length}}">
        <view class="coupon-list">
          <sun-coupon-card
            wx:for="{{visibleList}}"
            wx:key="id"
            item="{{item}}"
            theme="orange"
            bindselect="handleSelect"
            bindaction="handleUseCoupon"
          ></sun-coupon-card>
        </view>
        <view wx:if="{{showCouponListToggle}}" class="coupon-more coupon-more--orange" bindtap="toggleCouponList">
          {{couponListToggleText}} <text class="coupon-more__arrow">⌄</text>
        </view>
      </block>

      <view class="coupon-empty" wx:else>
        <view class="coupon-empty__title">暂无对应优惠券</view>
        <view class="coupon-empty__desc">去首页下单或参加活动后，会在这里看到可用券。</view>
        <view class="coupon-empty__button" bindtap="jumpToHome">去首页看看</view>
      </view>
    </view>

    <view class="coupon-panel coupon-panel--center">
      <view class="coupon-section__head">
        <view class="coupon-section__title-wrap">
          <view class="coupon-section__icon coupon-section__icon--purple"></view>
          <view class="coupon-section__title">券中心</view>
          <view class="coupon-section__hint">更多优惠券等你来领</view>
        </view>
        <view class="coupon-section__more">{{centerList.length}} 张可领券 <text class="coupon-section__chevron">›</text></view>
      </view>

      <block wx:if="{{centerList.length}}">
        <view class="coupon-list">
          <sun-coupon-card
            wx:for="{{visibleCenterList}}"
            wx:key="id"
            item="{{item}}"
            theme="purple"
            bindaction="claimCoupon"
          ></sun-coupon-card>
        </view>
        <view wx:if="{{showCenterToggle}}" class="coupon-more coupon-more--purple" bindtap="toggleCenterList">
          {{centerToggleText}} <text class="coupon-more__arrow">⌄</text>
        </view>
      </block>
      <view class="coupon-center__empty" wx:else>
        当前暂无可领取优惠券
      </view>
    </view>

    <view class="member-banner {{membership.active ? 'member-banner--active' : ''}}" bindtap="openMembership">
      <view class="member-banner__icon">
        <image class="member-crown" src="/images/coupon-member-crown.png" mode="aspectFit"></image>
      </view>
      <view class="member-banner__copy">
        <view class="member-banner__title">{{memberTitle}}</view>
        <view class="member-banner__desc">{{memberDesc}}</view>
      </view>
      <view class="member-banner__button" catchtap="openMembership">{{memberButtonText}}</view>
    </view>
  </view>
</view>
