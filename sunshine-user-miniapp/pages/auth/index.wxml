<view class="page-shell auth-shell safe-bottom">
  <view class="page-content auth-page page-enter">
    <view class="auth-hero">
      <view class="auth-hero__copy">
        <view class="auth-title">实名认证信息</view>
        <view class="auth-desc">提交后进入审核流程，结果会同步到个人资料。</view>
      </view>
      <view class="auth-hero__icon"></view>
    </view>

    <view class="auth-status-card">
      <view class="fee-row">
        <view class="fee-label">真实姓名</view>
        <view class="fee-value">{{auth.realName || '未填写'}}</view>
      </view>
      <view class="fee-row">
        <view class="fee-label">身份证号</view>
        <view class="fee-value">{{auth.idNo || '未填写'}}</view>
      </view>
      <view class="fee-row">
        <view class="fee-label">审核状态</view>
        <view class="fee-value brand-text">{{auth.status}}</view>
      </view>
    </view>

    <view class="auth-form">
      <view class="form-title">提交认证</view>
      <view class="auth-field">
        <view class="auth-field__icon auth-field__icon--user"></view>
        <input class="auth-input" data-key="realName" value="{{form.realName}}" bindinput="updateField" placeholder="请输入真实姓名" />
      </view>
      <view class="auth-field">
        <view class="auth-field__icon auth-field__icon--card"></view>
        <input class="auth-input" data-key="idCard" value="{{form.idCard}}" bindinput="updateField" placeholder="请输入身份证号" />
      </view>
      <button class="primary-button auth-submit" hover-class="button-hover" bindtap="submitRealName">提交实名认证</button>
    </view>
  </view>
</view>
