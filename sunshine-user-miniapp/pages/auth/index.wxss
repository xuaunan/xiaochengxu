.auth-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.auth-hero,
.auth-form {
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.auth-card {
  margin-top: 18rpx;
}

.auth-status-card {
  margin-top: 22rpx;
  padding: 4rpx 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.08);
}

.fee-row:last-child {
  border-bottom: none;
}

.auth-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  font-size: 28rpx;
  line-height: 76rpx;
  color: #1f2432;
}


