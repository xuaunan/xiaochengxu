.auth-card {
  margin-top: 18rpx;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.08);
}

.fee-row:last-child {
  border-bottom: none;
}

.auth-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f7f8fc;
  font-size: 28rpx;
  line-height: 76rpx;
  color: #1f2432;
}


