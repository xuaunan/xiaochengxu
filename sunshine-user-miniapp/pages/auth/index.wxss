.auth-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.22) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.auth-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
}

.auth-hero,
.auth-status-card,
.auth-form {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.auth-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 158rpx;
  padding: 30rpx 150rpx 30rpx 30rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.auth-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.18;
}

.auth-desc {
  margin-top: 10rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  color: #737c90;
  line-height: 1.4;
}

.auth-hero__icon {
  position: absolute;
  right: 42rpx;
  top: 42rpx;
  width: 82rpx;
  height: 82rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.9), rgba(255, 122, 0, 0.86));
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.18);
}

.auth-hero__icon::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 17rpx;
  width: 34rpx;
  height: 42rpx;
  border-radius: 18rpx 18rpx 10rpx 10rpx;
  background: #ffffff;
}

.auth-hero__icon::after {
  content: "";
  position: absolute;
  left: 34rpx;
  top: 26rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow: 0 22rpx 0 6rpx #ff7a00;
}

.auth-status-card {
  padding: 4rpx 24rpx;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.08);
}

.fee-row:last-child {
  border-bottom: 0;
}

.fee-label {
  color: #7b8497;
}

.fee-value {
  min-width: 0;
  font-weight: 900;
  color: #111827;
  text-align: right;
  word-break: break-all;
}

.auth-form {
  padding: 26rpx;
}

.form-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #111827;
}

.auth-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  border: 1rpx solid rgba(31, 36, 50, 0.08);
}

.auth-field + .auth-field {
  margin-top: 16rpx;
}

.auth-field__icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.auth-field__icon::before,
.auth-field__icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.auth-field__icon--user::before {
  left: 12rpx;
  top: 3rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.auth-field__icon--user::after {
  left: 4rpx;
  bottom: 3rpx;
  width: 30rpx;
  height: 18rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  border: 4rpx solid #ff7a00;
  border-top-width: 6rpx;
}

.auth-field__icon--card::before {
  left: 2rpx;
  top: 7rpx;
  width: 34rpx;
  height: 24rpx;
  border-radius: 6rpx;
  border: 4rpx solid #ff7a00;
}

.auth-field__icon--card::after {
  left: 9rpx;
  top: 17rpx;
  width: 20rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.auth-input {
  flex: 1;
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 28rpx;
  line-height: 84rpx;
  color: #111827;
}

.auth-submit {
  width: 100%;
  height: 92rpx;
  margin-top: 22rpx;
  border-radius: 20rpx;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 92rpx;
}
