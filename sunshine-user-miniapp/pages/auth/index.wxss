.auth-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.22) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.auth-page {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 12rpx;
}

.auth-hero,
.auth-status-card,
.auth-form {
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 7rpx 18rpx rgba(37, 43, 58, 0.035);
}

.auth-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 102rpx;
  padding: 17rpx 116rpx 17rpx 18rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.auth-title {
  font-size: 27rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.18;
}

.auth-desc {
  margin-top: 6rpx;
  max-width: 520rpx;
  font-size: 20rpx;
  color: #737c90;
  line-height: 1.4;
}

.auth-hero__icon {
  position: absolute;
  right: 26rpx;
  top: 26rpx;
  width: 64rpx;
  height: 64rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.9), rgba(255, 122, 0, 0.86));
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.14);
}

.auth-hero__icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 13rpx;
  width: 28rpx;
  height: 34rpx;
  border-radius: 18rpx 18rpx 10rpx 10rpx;
  background: #ffffff;
  transform: translateX(-50%);
}

.auth-hero__icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 20rpx;
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow: 0 17rpx 0 5rpx #ff7a00;
  transform: translateX(-50%);
}

.auth-status-card {
  padding: 0 18rpx;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 0;
  font-size: 21rpx;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.08);
}

.fee-row:last-child {
  border-bottom: 0;
}

.fee-label {
  color: #7b8497;
}

.fee-value {
  min-width: 0;
  font-weight: 550;
  color: #111827;
  text-align: right;
  word-break: break-all;
}

.auth-form {
  padding: 16rpx;
}

.form-title {
  margin-bottom: 16rpx;
  font-size: 25rpx;
  font-weight: 550;
  color: #111827;
}

.auth-field {
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 62rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  border: 1rpx solid rgba(31, 36, 50, 0.08);
}

.auth-field + .auth-field {
  margin-top: 12rpx;
}

.auth-field__icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.auth-field__icon::before,
.auth-field__icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.auth-field__icon--user::before {
  left: 50%;
  top: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #ff7a00;
  transform: translateX(-50%);
}

.auth-field__icon--user::after {
  left: 50%;
  bottom: 3rpx;
  width: 26rpx;
  height: 16rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  border: 3rpx solid #ff7a00;
  transform: translateX(-50%);
}

.auth-field__icon--card::before {
  left: 50%;
  top: 50%;
  width: 29rpx;
  height: 21rpx;
  border-radius: 6rpx;
  border: 3rpx solid #ff7a00;
  transform: translate(-50%, -50%);
}

.auth-field__icon--card::after {
  left: 50%;
  top: 50%;
  width: 17rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  transform: translate(-50%, -50%);
}

.auth-input {
  flex: 1;
  width: 100%;
  height: 60rpx;
  min-height: 60rpx;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 22rpx;
  line-height: 60rpx;
  color: #111827;
}

.auth-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 66rpx;
  margin-top: 16rpx;
  padding: 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 550;
  line-height: 1.2;
  box-sizing: border-box;
}
