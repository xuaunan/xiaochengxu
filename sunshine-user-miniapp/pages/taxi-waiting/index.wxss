.waiting-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.waiting-banner {
  text-align: center;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(24, 34, 56, 0.04);
}

.waiting-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 550;
  color: #1f2432;
}

.waiting-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7385;
}

.waiting-circle {
  width: 132rpx;
  height: 132rpx;
  margin: 26rpx auto 0;
  border-radius: 50%;
  line-height: 132rpx;
  font-size: 32rpx;
  font-weight: 550;
  color: #ff7a00;
  background: radial-gradient(circle, rgba(255, 122, 0, 0.12), rgba(255, 122, 0, 0.02));
}

.waiting-metrics {
  margin-top: 22rpx;
}

.waiting-metric,
.waiting-rule {
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}


