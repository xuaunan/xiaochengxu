.carpool-publish-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.24) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 32%, #f5f7fb 100%);
}

.publish-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 16rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 126rpx;
}

.publish-hero,
.publish-panel {
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 12rpx 28rpx rgba(37, 43, 58, 0.045);
}

.publish-hero {
  position: relative;
  min-height: 132rpx;
  padding: 24rpx 188rpx 24rpx 26rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.publish-hero__title {
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.18;
}

.publish-hero__desc {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #737c90;
  line-height: 1.35;
}

.publish-hero__scene {
  position: absolute;
  right: 20rpx;
  bottom: 12rpx;
  width: 150rpx;
  height: 76rpx;
  border-radius: 70% 30% 0 0;
  border-top: 8rpx solid rgba(255, 255, 255, 0.9);
  background: linear-gradient(90deg, rgba(255, 181, 95, 0), rgba(255, 181, 95, 0.18));
  transform: skewX(-18deg);
}

.publish-hero__scene::after {
  content: "";
  position: absolute;
  right: 42rpx;
  bottom: 22rpx;
  width: 82rpx;
  height: 32rpx;
  border-radius: 16rpx 22rpx 10rpx 10rpx;
  background: linear-gradient(180deg, #ffad3a, #ff7a00);
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.22);
}

.publish-panel {
  padding: 22rpx;
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  font-size: 27rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.3;
}

.panel-title__mark {
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff8d1a, #ff6b00);
}

.route-inputs {
  position: relative;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.72);
}

.route-input {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 88rpx;
  padding: 14rpx 18rpx;
  background: linear-gradient(180deg, #fafbfe 0%, #ffffff 100%);
}

.route-input + .route-input {
  border-top: 1rpx solid rgba(17, 24, 39, 0.08);
}

.route-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.route-input--start .route-dot {
  background: #23c66b;
  box-shadow: 0 0 0 14rpx rgba(35, 198, 107, 0.13);
}

.route-input--end .route-dot {
  background: #ff7373;
  box-shadow: 0 0 0 14rpx rgba(255, 115, 115, 0.13);
}

.publish-input {
  flex: 1;
  width: 100%;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 64rpx;
  color: #111827;
}

.publish-input::placeholder {
  color: #a0a8b8;
  font-weight: 400;
}

.publish-input--full {
  height: 70rpx;
  min-height: 70rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  box-sizing: border-box;
}

.publish-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.publish-grid + .publish-grid {
  margin-top: 14rpx;
}

.publish-field,
.number-field {
  position: relative;
  min-height: 108rpx;
  padding: 18rpx 16rpx 16rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  box-shadow: none;
}

.number-field {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.field-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  margin-bottom: 10rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.field-icon::before {
  content: "";
  position: absolute;
  inset: 1rpx;
  border-radius: 8rpx;
  border: 3rpx solid #ff7a00;
  box-sizing: border-box;
}

.field-icon--time::before {
  border-radius: 50%;
}

.field-icon--seat::before {
  border-radius: 50%;
  width: 14rpx;
  height: 14rpx;
  left: 50%;
  top: 2rpx;
  inset: auto;
  background: #ff7a00;
  transform: translateX(-50%);
}

.field-icon--seat::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 26rpx;
  height: 16rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  border: 3rpx solid #ff7a00;
  box-sizing: border-box;
  transform: translateX(-50%);
}

.field-icon--price::before {
  border-radius: 50%;
}

.field-icon--price::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  transform: translate(-50%, -50%);
}

.field-label {
  font-size: 20rpx;
  color: #7d8799;
}

.field-value {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 550;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.publish-textarea {
  width: 100%;
  min-height: 170rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  font-size: 24rpx;
  line-height: 1.5;
  color: #111827;
  box-sizing: border-box;
}

.publish-floating-bar {
  left: 24rpx;
  right: 24rpx;
}

.publish-submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  padding: 0;
  line-height: 1.2;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 550;
  box-shadow: 0 12rpx 26rpx rgba(255, 107, 0, 0.18);
  box-sizing: border-box;
}
