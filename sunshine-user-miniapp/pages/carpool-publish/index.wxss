.search-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
  background: rgba(247, 248, 252, 0.9);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  font-size: 28rpx;
  line-height: 76rpx;
  color: #1f2432;
}

.publish-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.publish-textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(247, 248, 252, 0.92);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  font-size: 28rpx;
  line-height: 1.6;
}


