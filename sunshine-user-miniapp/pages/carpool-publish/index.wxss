.carpool-publish-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.publish-hero,
.publish-form {
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.search-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  font-size: 28rpx;
  line-height: 76rpx;
  color: #1f2432;
}

.publish-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.publish-textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  font-size: 28rpx;
  line-height: 1.6;
}


