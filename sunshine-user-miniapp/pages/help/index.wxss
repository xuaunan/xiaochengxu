.help-shell {
  background:
    linear-gradient(180deg, rgba(255, 246, 237, 0.72) 0%, #f7f8fc 26%, #f5f7fb 100%);
}

.help-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.help-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 8rpx 2rpx;
}

.help-title {
  font-size: 34rpx;
}

.help-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a94a8;
}

.help-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.help-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.help-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
}

.help-card__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
  border-radius: 18rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 22rpx;
  font-weight: 800;
}

.help-card__body {
  flex: 1;
  min-width: 0;
}

.help-card__title {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.36;
  color: #1f2432;
}

.help-card__content {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #6f7b90;
}

.help-card__arrow {
  flex-shrink: 0;
  margin-top: 2rpx;
  color: #c0c7d4;
  font-size: 40rpx;
  line-height: 1;
}
