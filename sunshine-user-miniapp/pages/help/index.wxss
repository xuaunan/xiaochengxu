.help-shell {
  background:
    radial-gradient(circle at 92% 0%, rgba(255, 193, 117, 0.12), transparent 34%),
    linear-gradient(180deg, #fff8f2 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.help-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.help-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 6rpx 0;
}

.help-kicker {
  margin-bottom: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #ff7a00;
}

.help-title {
  font-size: 36rpx;
}

.help-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.1);
  font-size: 21rpx;
  font-weight: 800;
}

.help-intro {
  padding: 22rpx 24rpx;
}

.help-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.help-card {
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.06);
}

.help-card__mark {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  margin-top: 9rpx;
  border-radius: 50%;
  background: #ff5b57;
  box-shadow: 0 0 0 10rpx rgba(255, 91, 87, 0.1);
}

.help-card__body {
  flex: 1;
  min-width: 0;
}

.help-card__title {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.36;
  color: #1f2432;
}

.help-card__content {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #6f7b90;
}
