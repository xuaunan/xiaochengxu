.help-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 184, 98, 0.24) 0, rgba(255, 211, 156, 0) 270rpx),
    linear-gradient(180deg, #fff5e9 0%, #f7f8fc 34%, #f4f6fb 100%);
}

.help-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 18rpx 36rpx 44rpx;
}

.help-hero {
  position: relative;
  min-height: 112rpx;
  padding: 24rpx 130rpx 24rpx 26rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 10rpx 24rpx rgba(37, 43, 58, 0.045);
}

.help-hero::after {
  content: "";
  position: absolute;
  right: -44rpx;
  bottom: -58rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 122, 0, 0.08);
}

.help-title {
  font-size: 29rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.18;
}

.help-subtitle {
  margin-top: 7rpx;
  font-size: 21rpx;
  color: #737c90;
}

.help-count {
  position: absolute;
  right: 20rpx;
  top: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
}

.help-hero__icon {
  position: absolute;
  right: 38rpx;
  bottom: 16rpx;
  width: 64rpx;
  height: 58rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.82), rgba(255, 122, 0, 0.76));
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.14);
}

.help-hero__icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 13rpx;
  width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  border-radius: 18rpx 18rpx 4rpx 4rpx;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  transform: translateX(-50%);
}

.help-hero__icon::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffffff;
  transform: translateX(-50%);
}

.help-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.help-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(37, 43, 58, 0.045);
}

.help-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 5rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.38);
}

.help-card__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  color: #ff6b00;
  background: linear-gradient(180deg, #fff4e7, #ffe8d1);
  font-size: 21rpx;
  font-weight: 500;
}

.help-card__body {
  flex: 1;
  min-width: 0;
}

.help-card__title {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.36;
  color: #111827;
}

.help-card__content {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #667085;
}

.help-card__arrow {
  flex-shrink: 0;
  margin-top: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #a5adbb;
  border-right: 3rpx solid #a5adbb;
  transform: rotate(45deg);
}
