.help-hero {
  overflow: hidden;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 177, 74, 0.24), transparent 36%),
    linear-gradient(180deg, #ffffff 0%, #fff8ef 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.help-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 122, 0, 0.07);
}

.help-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff7a00, #ffb14a);
}


