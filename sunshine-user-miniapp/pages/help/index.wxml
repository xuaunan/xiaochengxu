<view class="page-shell help-shell safe-bottom">
  <view class="page-content help-page page-enter">
    <view class="help-header">
      <view>
        <view class="help-kicker">服务支持</view>
        <view class="section-title help-title">帮助中心</view>
      </view>
      <view class="help-count">{{list.length}} 项</view>
    </view>

    <view class="panel-card help-intro">
      <view class="section-subtitle">常见问题、订单处理和平台服务说明都汇总在这里，方便快速定位。</view>
    </view>

    <view class="help-list">
      <view class="help-card tap-scale" wx:for="{{list}}" wx:key="id">
        <view class="help-card__mark"></view>
        <view class="help-card__body">
          <view class="help-card__title">{{item.title}}</view>
          <view class="help-card__content">{{item.content}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
