<view class="page-shell safe-bottom">
  <view class="page-content list-gap page-enter">
    <view class="hero-card review-card">
      <view class="section-title">本次行程服务如何？</view>
      <view class="section-subtitle">你的评价会影响司机服务分与派单优先级</view>
      <view class="star-row">
        <text class="star {{score >= item ? 'star--active' : ''}}" wx:for="{{scoreOptions}}" wx:key="*this" data-score="{{item}}" bindtap="chooseScore">★</text>
      </view>
    </view>

    <view class="panel-card">
      <view class="section-title">评价标签</view>
      <view class="chip-row review-tags">
        <view class="chip {{item.active ? 'chip-active' : ''}}" wx:for="{{tags}}" wx:key="label" data-tag="{{item.label}}" bindtap="toggleTag">{{item.label}}</view>
      </view>
      <textarea class="review-textarea" placeholder="补充你的出行体验，帮助平台持续优化服务" maxlength="120" bindinput="updateContent"></textarea>
      <view class="row-between review-switch">
        <text>匿名评价</text>
        <switch color="#ff7a00" checked="{{anonymous}}" bindchange="toggleAnonymous"></switch>
      </view>
    </view>
  </view>

  <view class="floating-bar">
    <button class="primary-button" hover-class="button-hover" bindtap="submitReview">提交评价</button>
  </view>
</view>
