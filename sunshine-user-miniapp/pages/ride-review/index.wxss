.ride-review-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.review-card {
  text-align: center;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.055);
}

.star-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.star {
  font-size: 58rpx;
  color: #d9dde8;
  transition: transform 0.18s ease, color 0.18s ease;
}

.star--active {
  color: #ffb020;
  transform: translateY(-3rpx) scale(1.04);
}

.review-tags {
  margin-top: 22rpx;
}

.review-textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  color: #1f2432;
  line-height: 1.65;
}

.review-switch {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #1f2432;
}


