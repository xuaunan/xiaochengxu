.review-card {
  text-align: center;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 0, rgba(255, 177, 74, 0.28), transparent 42%),
    linear-gradient(180deg, #ffffff 0%, #fff8ef 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.star-row {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-top: 32rpx;
}

.star {
  font-size: 58rpx;
  color: #d9dde8;
  transition: transform 0.18s ease, color 0.18s ease;
}

.star--active {
  color: #ffb020;
  transform: translateY(-3rpx) scale(1.04);
}

.review-tags {
  margin-top: 22rpx;
}

.review-textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f7f8fc;
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  color: #1f2432;
  line-height: 1.65;
}

.review-switch {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #1f2432;
}


