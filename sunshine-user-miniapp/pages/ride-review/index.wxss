.ride-review-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.review-card {
  text-align: center;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(24, 34, 56, 0.04);
}

.star-row {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.star {
  font-size: 38rpx;
  color: #d9dde8;
  transition: transform 0.18s ease, color 0.18s ease;
}

.star--active {
  color: #ffb020;
  transform: translateY(-3rpx) scale(1.04);
}

.review-tags {
  margin-top: 18rpx;
}

.review-textarea {
  width: 100%;
  min-height: 156rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  color: #1f2432;
  line-height: 1.65;
}

.review-switch {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #1f2432;
}

.review-state-card {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  box-shadow: 0 8rpx 22rpx rgba(24, 34, 56, 0.04);
  text-align: center;
}

.review-state-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 550;
}

.review-state-desc {
  margin-top: 10rpx;
  color: #7a8396;
  font-size: 22rpx;
  line-height: 1.5;
}

.review-state-button {
  min-width: 200rpx;
  height: 58rpx;
  min-height: 58rpx;
  margin-top: 22rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.floating-bar .primary-button[disabled] {
  opacity: 0.58;
  box-shadow: none;
}


