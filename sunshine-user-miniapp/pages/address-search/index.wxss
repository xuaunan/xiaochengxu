.address-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(255, 193, 117, 0.18), transparent 35%),
    linear-gradient(180deg, #fff7ef 0%, #f7f8fc 30%, #f5f7fb 100%);
  opacity: 0;
}

.address-page--enter {
  animation: address-enter 0.28s ease forwards;
}

.address-page--leave {
  animation: address-leave 0.18s ease forwards;
}

.address-top {
  padding: 0 20rpx 14rpx;
}

.address-searchbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.address-back {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.08);
}

.address-back__icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid #1f2432;
  border-top: 3rpx solid #1f2432;
  transform: rotate(-45deg);
}

.address-input-wrap {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 122, 0, 0.14);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  position: relative;
  z-index: 5;
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.08);
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.address-input-wrap--focus {
  border-color: #ff7a00;
  box-shadow: 0 18rpx 36rpx rgba(255, 122, 0, 0.18);
  background: #ffffff;
}

.address-input__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #20bf6b;
  flex-shrink: 0;
  box-shadow: 0 0 0 7rpx rgba(32, 191, 107, 0.12);
}

.address-input__dot--end {
  background: #ff5b57;
  box-shadow: 0 0 0 7rpx rgba(255, 91, 87, 0.12);
}

.address-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  margin-left: 14rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  color: #1f2432;
}

.address-input__placeholder {
  color: #9aa3b6;
}

.candidate-panel {
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 40rpx rgba(24, 34, 56, 0.12);
  overflow: hidden;
}

.candidate-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 20rpx 8rpx;
}

.candidate-panel__title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2432;
}

.candidate-panel__count {
  font-size: 20rpx;
  color: #98a1b3;
}

.candidate-panel__item {
  min-height: 96rpx;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.candidate-panel__marker {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #20bf6b;
  box-shadow: 0 0 0 7rpx rgba(32, 191, 107, 0.12);
  flex-shrink: 0;
}

.candidate-panel__marker--end {
  background: #ff5b57;
  box-shadow: 0 0 0 7rpx rgba(255, 91, 87, 0.12);
}

.candidate-panel__empty {
  padding: 24rpx 20rpx 28rpx;
  text-align: center;
}

.candidate-panel__empty-text {
  font-size: 21rpx;
  line-height: 1.6;
  color: #7a8396;
}

.quick-actions {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.quick-action {
  padding: 14rpx 10rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  text-align: center;
  box-shadow: 0 12rpx 26rpx rgba(24, 34, 56, 0.08);
}

.quick-action__icon {
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.quick-action__icon--location {
  background: transparent;
}

.quick-action__icon--favorite {
  background: transparent;
}

.quick-action__icon--map {
  background: transparent;
}

.quick-action__image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.quick-action__text {
  margin-top: 9rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #1f2432;
}

.favorite-panel {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 26rpx rgba(24, 34, 56, 0.08);
}

.fade-in {
  animation: fade-in 0.22s ease;
}

.favorite-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.favorite-panel__title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2432;
}

.favorite-panel__count {
  font-size: 20rpx;
  color: #98a1b3;
}

.favorite-panel__item {
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.favorite-panel__item:first-of-type {
  margin-top: 14rpx;
}

.address-scroll {
  flex: 1;
  min-height: 0;
}

.address-scroll__inner {
  min-height: 100%;
  padding: 0 20rpx calc(env(safe-area-inset-bottom) + 32rpx);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.address-scroll__inner--animating {
  opacity: 0.76;
  transform: translateY(8rpx);
}

.address-section {
  margin-top: 8rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 26rpx rgba(24, 34, 56, 0.08);
  overflow: hidden;
}

.address-section__head {
  padding: 20rpx 20rpx 6rpx;
}

.address-section__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.address-section__desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #98a1b3;
}

.address-loading,
.address-empty {
  padding: 38rpx 26rpx;
  text-align: center;
}

.address-loading__spinner {
  width: 34rpx;
  height: 34rpx;
  margin: 0 auto;
  border: 3rpx solid rgba(255, 122, 0, 0.14);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: rotate 0.8s linear infinite;
}

.address-loading__text {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #7a8396;
}

.swipe-row {
  position: relative;
  overflow: hidden;
}

.swipe-row--deleting {
  animation: row-fade-out 0.18s ease forwards;
}

.swipe-row__delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 138rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ff6b6b 0%, #ff4d4f 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.swipe-row__content {
  position: relative;
  z-index: 2;
  background: #ffffff;
  transition: transform 0.24s ease;
}

.address-item,
.pressable-row {
  min-height: 110rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
}

.address-item {
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.address-item__marker {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #20bf6b;
  border-radius: 50%;
  flex-shrink: 0;
}

.address-item__marker--end {
  border-color: #ff5b57;
}

.address-content {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.address-content__main {
  flex: 1;
  min-width: 0;
}

.address-content__name {
  font-size: 25rpx;
  font-weight: 700;
  color: #1f2432;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-content__detail {
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.42;
  color: #7a8396;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-content__meta {
  width: 94rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.address-content__distance {
  font-size: 21rpx;
  color: #98a1b3;
}

.favorite-toggle {
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6fa;
  color: #9aa3b6;
  font-size: 28rpx;
  line-height: 1;
  transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.favorite-toggle--active {
  background: rgba(255, 191, 64, 0.18);
  color: #ffb400;
}

.favorite-toggle--bounce {
  animation: star-bounce 0.26s ease;
}

.history-footer {
  padding: 18rpx 0 0;
}

.history-footer__button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  width: 320rpx;
  height: 72rpx;
  line-height: 1.2;
  padding: 0;
  border: none;
  border-radius: 20rpx;
  color: #ff5b57;
  background: rgba(255, 91, 87, 0.1);
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.history-footer__button::after,
.address-empty__button::after {
  border: none;
}

.address-empty__title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2432;
}

.address-empty__desc {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #7a8396;
}

.address-empty__button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 1.2;
  padding: 0;
  border: none;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9430 100%);
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes address-enter {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes address-leave {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes row-fade-out {
  from {
    opacity: 1;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(0.96);
  }
}

@keyframes star-bounce {
  0% {
    transform: scale(0.84);
  }
  65% {
    transform: scale(1.14);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
