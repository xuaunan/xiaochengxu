.message-shell {
  background:
    radial-gradient(circle at 92% 0%, rgba(255, 193, 117, 0.12), transparent 34%),
    linear-gradient(180deg, #fff8f2 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.message-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 6rpx 0;
}

.message-kicker {
  margin-bottom: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #ff7a00;
}

.message-title {
  font-size: 36rpx;
}

.message-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.1);
  font-size: 21rpx;
  font-weight: 800;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.message-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx 24rpx 24rpx 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.06);
}

.message-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  opacity: 0.72;
}

.message-card__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.message-card__title {
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1f2432;
}

.message-card__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff5b57;
}

.message-card__content {
  margin-top: 9rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6f7b90;
}

.message-card__time {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #a0a8b8;
}

.message-empty {
  padding: 84rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.06);
  text-align: center;
  color: #8a94a8;
}

.message-empty__title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2432;
}

.message-empty__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
}
