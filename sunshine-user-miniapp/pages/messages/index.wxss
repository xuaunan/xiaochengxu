.message-shell {
  background:
    linear-gradient(180deg, rgba(255, 246, 237, 0.72) 0%, #f7f8fc 26%, #f5f7fb 100%);
}

.message-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 8rpx 2rpx;
}

.message-title {
  font-size: 34rpx;
}

.message-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a94a8;
}

.message-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.message-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
}

.message-card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.message-card__badge {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow: 0 0 0 8rpx rgba(255, 122, 0, 0.08);
}

.message-card__title {
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1f2432;
}

.message-card__dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #ff5b57;
}

.message-card__content {
  margin-top: 9rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6f7b90;
}

.message-card__time {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #a0a8b8;
}

.message-empty {
  padding: 78rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
  text-align: center;
  color: #8a94a8;
}

.message-empty__mark {
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 20rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(135deg, rgba(255, 122, 0, 0.14), rgba(255, 176, 74, 0.08));
  border: 1rpx solid rgba(255, 122, 0, 0.12);
}

.message-empty__title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2432;
}

.message-empty__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
}
