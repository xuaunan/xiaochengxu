.message-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 32%, #f5f7fb 100%);
}

.message-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 24rpx;
}

.message-hero {
  position: relative;
  min-height: 166rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 32rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 250, 244, 0.96) 58%, rgba(255, 233, 209, 0.66) 100%),
    #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(210, 104, 18, 0.08);
}

.message-hero__copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.message-hero__title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.1;
}

.message-hero__desc {
  margin-top: 22rpx;
  color: #5f6676;
  font-size: 27rpx;
  line-height: 1.35;
}

.message-bell {
  position: absolute;
  right: 222rpx;
  top: 40rpx;
  width: 124rpx;
  height: 118rpx;
  transform: rotate(-12deg);
  opacity: 0.96;
}

.message-bell__body {
  position: absolute;
  left: 22rpx;
  top: 16rpx;
  width: 76rpx;
  height: 78rpx;
  border-radius: 42rpx 42rpx 24rpx 24rpx;
  background: linear-gradient(145deg, #ffd9b5 0%, #ff8a16 100%);
  box-shadow: 0 16rpx 28rpx rgba(255, 122, 0, 0.16);
}

.message-bell__body::before {
  content: "";
  position: absolute;
  left: 28rpx;
  top: -12rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #ff9b32;
}

.message-bell__body::after {
  content: "";
  position: absolute;
  left: -12rpx;
  right: -12rpx;
  bottom: -7rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffc796 0%, #ff7900 100%);
}

.message-bell__clapper {
  position: absolute;
  left: 54rpx;
  bottom: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.message-count {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  min-width: 112rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 250, 244, 0.8);
  border: 2rpx solid rgba(255, 122, 0, 0.18);
  text-align: center;
  font-size: 30rpx;
  font-weight: 900;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.message-card {
  position: relative;
  min-height: 140rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 68rpx 28rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.065);
}

.message-icon {
  position: relative;
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ff7900;
  background: #fff1df;
}

.message-icon--cancel::before,
.message-icon--cancel::after {
  content: "";
  position: absolute;
  left: 21rpx;
  top: 30rpx;
  width: 25rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.message-icon--cancel::before {
  transform: rotate(45deg);
}

.message-icon--cancel::after {
  transform: rotate(-45deg);
}

.message-icon--order::before {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 15rpx;
  width: 27rpx;
  height: 36rpx;
  border-radius: 7rpx;
  background: currentColor;
}

.message-icon--order::after {
  content: "";
  position: absolute;
  left: 28rpx;
  top: 25rpx;
  width: 13rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 0 #ffffff;
}

.message-icon--paid::before,
.message-icon--finish::before {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 14rpx;
  width: 22rpx;
  height: 34rpx;
  border-right: 8rpx solid currentColor;
  border-bottom: 8rpx solid currentColor;
  transform: rotate(42deg);
}

.message-icon--finish::before {
  left: 22rpx;
  top: 15rpx;
  width: 18rpx;
  height: 30rpx;
}

.message-icon--start::before {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 18rpx;
  border-left: 24rpx solid currentColor;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
}

.message-icon--car::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 28rpx;
  width: 38rpx;
  height: 20rpx;
  border-radius: 10rpx 12rpx 6rpx 6rpx;
  border: 5rpx solid currentColor;
}

.message-icon--car::after {
  content: "";
  position: absolute;
  left: 22rpx;
  bottom: 14rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 20rpx 0 0 currentColor, 7rpx -25rpx 0 -1rpx currentColor;
}

.message-icon--driver::before,
.message-icon--driver::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.message-icon--driver::before {
  left: 24rpx;
  top: 14rpx;
  width: 18rpx;
  height: 18rpx;
}

.message-icon--driver::after {
  left: 17rpx;
  bottom: 14rpx;
  width: 32rpx;
  height: 20rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
}

.message-icon--notice::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 17rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 6rpx solid currentColor;
}

.message-icon--notice::after {
  content: "";
  position: absolute;
  left: 31rpx;
  top: 28rpx;
  width: 6rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.message-card__main {
  flex: 1;
  min-width: 0;
}

.message-card__title {
  color: #111827;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-card__content {
  margin-top: 14rpx;
  color: #222733;
  font-size: 26rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-card__time {
  margin-top: 14rpx;
  color: #8b94a7;
  font-size: 25rpx;
}

.message-card__dot {
  position: absolute;
  left: 75rpx;
  top: 25rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff5b57;
  box-shadow: 0 0 0 5rpx #ffffff;
}

.message-arrow {
  position: absolute;
  right: 34rpx;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid rgba(31, 36, 50, 0.46);
  border-right: 4rpx solid rgba(31, 36, 50, 0.46);
  transform: translateY(-50%) rotate(45deg);
}

.message-empty {
  min-height: 360rpx;
  padding: 78rpx 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.065);
  text-align: center;
  color: #8a94a8;
}

.message-empty__mark {
  margin: 0 auto 20rpx;
}

.message-empty__title {
  color: #1f2432;
  font-size: 30rpx;
  font-weight: 900;
}

.message-empty__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
