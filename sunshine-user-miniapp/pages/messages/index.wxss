.message-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.message-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx 24rpx 24rpx 30rpx;
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 177, 74, 0.1), transparent 34%),
    #ffffff;
  border: 1rpx solid rgba(255, 122, 0, 0.07);
  box-shadow: 0 14rpx 32rpx rgba(31, 36, 50, 0.06);
}

.message-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff7a00, #ffb14a);
}

.message-card__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.message-card__title {
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1f2432;
}

.message-card__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.message-card__content {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #6f7b90;
}

.message-card__time {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a0a8b8;
}

.message-empty {
  padding: 80rpx 28rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 50% 0, rgba(255, 177, 74, 0.14), transparent 38%),
    rgba(255, 255, 255, 0.78);
  text-align: center;
  color: #8a94a8;
}

.message-empty__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.message-empty__desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.55;
}


