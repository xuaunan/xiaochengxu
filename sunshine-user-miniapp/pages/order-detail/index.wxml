<view class="page-shell detail-shell safe-bottom">
  <view class="page-content detail-page {{showPayBar ? 'has-pay-bar' : ''}}" wx:if="{{detail}}">
    <view class="detail-hero page-enter">
      <view class="detail-hero__head">
        <view class="detail-hero__copy">
          <view class="detail-route">{{detail.startDisplay}} -> {{detail.endDisplay}}</view>
          <view class="detail-order-no">订单号 {{detail.orderNo}} <text wx:if="{{detail.carpoolMeta}}">｜乘客 {{detail.carpoolMeta.passengerCountText}}</text></view>
          <view class="detail-tags">
            <view class="detail-tag detail-tag--type">{{detail.serviceTypeText}}</view>
            <view class="detail-tag detail-tag--price">{{detail.showDiscountPrice ? displayedPayableAmountText : detail.originalAmountText}}</view>
          </view>
        </view>
        <view class="status-tag detail-status {{showPayBar ? 'waiting' : detail.uiStatus.tagType}}">
          {{detail.uiStatus.label}}
        </view>
      </view>

      <view class="detail-city">
        <view class="detail-building detail-building--1"></view>
        <view class="detail-building detail-building--2"></view>
        <view class="detail-building detail-building--3"></view>
        <view class="detail-building detail-building--4"></view>
      </view>
      <view class="detail-road"></view>
      <view class="detail-taxi">
        <view class="detail-taxi__body"></view>
        <view class="detail-taxi__top"></view>
        <view class="detail-taxi__wheel detail-taxi__wheel--left"></view>
        <view class="detail-taxi__wheel detail-taxi__wheel--right"></view>
      </view>

      <view class="detail-metrics">
        <view class="detail-metric" wx:for="{{detailMetrics}}" wx:key="key">
          <view class="detail-metric__icon detail-metric__icon--{{item.icon}}"></view>
          <view>
            <view class="detail-metric__value">{{item.value}}</view>
            <view class="detail-metric__label">{{item.label}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-card service-panel" wx:if="{{showServiceFlow}}">
      <view class="detail-section-head">
        <view class="detail-section-title-wrap">
          <view class="detail-section-icon detail-section-icon--flow"></view>
          <view class="detail-section-title">服务流程</view>
        </view>
      </view>
      <view class="service-steps">
        <view class="service-step service-step--{{item.state}}" wx:for="{{timelineSteps}}" wx:key="key">
          <view class="service-dot">{{item.state === 'upcoming' ? '' : '✓'}}</view>
          <view class="service-line" wx:if="{{index !== timelineSteps.length - 1}}"></view>
          <view class="service-label">{{item.title}}</view>
        </view>
      </view>
    </view>

    <view class="detail-card drive-panel drive-panel--{{driveStatus.state}}">
      <view class="drive-head">
        <view class="detail-section-title-wrap">
          <view class="detail-section-icon detail-section-icon--car"></view>
          <view class="detail-section-title">{{driveStatus.sectionTitle}}</view>
        </view>
        <view class="drive-badge">{{driveStatus.badge}}</view>
      </view>

      <block wx:if="{{driveStatus.visualType === 'dispatch'}}">
        <view class="status-stage status-stage--dispatch">
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{driveStatus.subtitle}}</view>
            <view class="drive-description">{{driveStatus.description}}</view>
          </view>
          <view class="dispatch-board">
            <view class="dispatch-board__row dispatch-board__row--active">
              <text>系统派单</text>
              <text>筛选中</text>
            </view>
            <view class="dispatch-board__row">
              <text>附近司机</text>
              <text>等待响应</text>
            </view>
            <view class="dispatch-board__row">
              <text>接驾距离</text>
              <text>同步中</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:elif="{{driveStatus.visualType === 'approach'}}">
        <view class="status-stage status-stage--approach">
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{driveStatus.subtitle}}</view>
            <view class="drive-description">{{driveStatus.description}}</view>
          </view>
          <view class="arrival-board">
            <view class="arrival-node arrival-node--driver">司机</view>
            <view class="arrival-path">
              <view class="arrival-car"></view>
            </view>
            <view class="arrival-node arrival-node--pickup">上车点</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{driveStatus.visualType === 'trip'}}">
        <view class="status-stage status-stage--trip">
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{driveStatus.subtitle}}</view>
            <view class="drive-description">{{driveStatus.description}}</view>
          </view>
          <view class="nav-board">
            <view class="nav-board__top">
              <text>{{driveStatus.visualTitle}}</text>
              <text>{{driveStatus.progress}}%</text>
            </view>
            <view class="nav-board__bar">
              <view class="nav-board__fill" style="width: {{driveStatus.progress}}%;"></view>
            </view>
            <view class="nav-board__hint">{{driveStatus.visualHint}}</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{driveStatus.visualType === 'finished'}}">
        <view class="status-stage status-stage--finished">
          <view class="result-mark result-mark--done">✓</view>
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{driveStatus.visualTitle}}</view>
            <view class="drive-description">{{driveStatus.visualHint}}</view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="status-stage status-stage--cancelled">
          <view class="result-mark result-mark--closed">×</view>
          <view class="status-stage__copy">
            <view class="drive-subtitle">{{driveStatus.visualTitle}}</view>
            <view class="drive-description">{{driveStatus.description}}</view>
          </view>
        </view>
      </block>

      <view class="drive-facts">
        <view class="drive-fact drive-fact--{{item.tone || 'normal'}}" wx:for="{{driveStatus.facts}}" wx:key="label">
          <view class="drive-fact__label">{{item.label}}</view>
          <view class="drive-fact__value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="detail-card aftersale-panel">
      <view class="detail-section-title">售后服务</view>
      <view class="action-grid">
        <view class="action-card tap-scale" bindtap="applyRefund">申请退款</view>
        <view class="action-card tap-scale" bindtap="gotoComplaint">投诉反馈</view>
        <view class="action-card tap-scale" bindtap="gotoInvoice">申请发票</view>
      </view>
    </view>

    <view class="detail-card info-panel">
      <view class="detail-section-title">订单信息</view>
      <view class="info-list">
        <view class="info-row">
          <text class="info-label">业务类型</text>
          <text class="info-value">{{detail.serviceTypeText}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">支付状态</text>
          <text class="info-value">{{detail.payStatusText}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.carpoolMeta}}">
          <text class="info-label">出发时段</text>
          <text class="info-value">{{detail.carpoolMeta.timeText}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.carpoolMeta}}">
          <text class="info-label">同行人数</text>
          <text class="info-value">{{detail.carpoolMeta.passengerCountText}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.carpoolMeta}}">
          <text class="info-label">行李情况</text>
          <text class="info-value">{{detail.carpoolMeta.luggageText}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.carpoolMeta}}">
          <text class="info-label">高速费</text>
          <text class="info-value">{{detail.carpoolMeta.tollModeText}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.showPaidCouponInfo}}">
          <text class="info-label">使用优惠券</text>
          <text class="info-value">{{detail.appliedCouponName}}</text>
        </view>
        <view class="info-row" wx:if="{{detail.showPaidCouponInfo}}">
          <text class="info-label">优惠抵扣</text>
          <text class="info-value info-value--brand">-{{detail.appliedCouponDiscountText}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">创建时间</text>
          <text class="info-value">{{detail.createdAt}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">司机信息</text>
          <text class="info-value">{{detail.driver.name}} {{detail.driver.plateNo}}</text>
        </view>
        <view class="info-row info-row--remark" wx:if="{{detail.remarkText}}">
          <text class="info-label">订单备注</text>
          <text class="info-value info-value--remark">{{detail.remarkText}}</text>
        </view>
      </view>
    </view>

    <view class="detail-complete" wx:if="{{!showPayBar}}">状态已完成</view>
  </view>

  <view class="page-content" wx:elif="{{loading}}">
    <view class="detail-hero skeleton skeleton-card"></view>
    <view class="detail-card skeleton skeleton-panel"></view>
  </view>

  <view class="payment-bar" wx:if="{{showPayBar}}">
    <view class="payment-bar__inner">
      <view class="coupon-entry {{couponActionDisabled ? 'coupon-entry--disabled' : 'tap-scale'}}" wx:if="{{allowCoupon}}" bindtap="openCouponPicker" hover-class="pressable-hover" hover-stay-time="60">
        <view class="coupon-entry__main">
          <view class="coupon-entry__icon">券</view>
          <view class="coupon-entry__label">优惠券</view>
        </view>
        <view class="coupon-entry__summary {{couponActionDisabled ? '' : 'coupon-entry__summary--active'}}">{{couponSummaryText}}</view>
        <view class="coupon-entry__action {{couponActionDisabled ? 'coupon-entry__action--disabled' : ''}}">去选择 ></view>
      </view>

      <view class="payment-bar__row">
        <view class="payment-meta">
          <view class="payment-label">当前需支付</view>
          <view class="payment-amount">{{displayedPayableAmountText}}</view>
        </view>
        <button class="primary-button pay-button" hover-class="button-hover" bindtap="goToPay">{{payButtonText}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{couponModalVisible}}">
    <view class="mask-panel coupon-picker-mask" bindtap="closeCouponPicker"></view>
    <view class="coupon-picker slide-in">
      <view class="coupon-picker__header">
        <view class="coupon-picker__title">选择优惠券</view>
        <view class="coupon-picker__close tap-scale" bindtap="closeCouponPicker">×</view>
      </view>

      <view class="coupon-tabs">
        <view
          class="coupon-tab {{activeCouponTab === 'available' ? 'coupon-tab--active' : ''}}"
          data-tab="available"
          bindtap="switchCouponTab"
        >
          可用优惠券
        </view>
        <view
          class="coupon-tab {{activeCouponTab === 'unavailable' ? 'coupon-tab--active' : ''}}"
          data-tab="unavailable"
          bindtap="switchCouponTab"
        >
          不可用优惠券
        </view>
      </view>

      <scroll-view class="coupon-picker__content" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="coupon-list" wx:if="{{activeCouponTab === 'available' && availableCoupons.length}}">
          <view
            class="coupon-card tap-scale {{selectedCouponId === item.userCouponIdText ? 'coupon-card--selected' : ''}}"
            wx:for="{{availableCoupons}}"
            wx:key="userCouponIdText"
            data-id="{{item.userCouponIdText}}"
            bindtap="chooseCoupon"
            hover-class="pressable-hover"
            hover-stay-time="60"
          >
            <view class="coupon-card__value">
              <view class="coupon-card__amount">{{item.discountAmountText}}</view>
              <view class="coupon-card__caption">本单最高可减</view>
            </view>
            <view class="coupon-card__body">
              <view class="coupon-card__name">{{item.name}}</view>
              <view class="coupon-card__rule">{{item.ruleText}}</view>
              <view class="coupon-card__valid">{{item.validText}}</view>
            </view>
            <view class="coupon-card__radio">
              <view class="coupon-card__radio-inner" wx:if="{{selectedCouponId === item.userCouponIdText}}"></view>
            </view>
          </view>
        </view>

        <view class="coupon-empty detail-card" wx:elif="{{activeCouponTab === 'available'}}">
          当前订单暂无可用优惠券
        </view>

        <view class="coupon-list" wx:if="{{activeCouponTab === 'unavailable' && unavailableCoupons.length}}">
          <view class="coupon-card coupon-card--disabled" wx:for="{{unavailableCoupons}}" wx:key="userCouponIdText">
            <view class="coupon-card__value coupon-card__value--disabled">
              <view class="coupon-card__amount">{{item.discountAmountText}}</view>
              <view class="coupon-card__caption">暂不可抵扣</view>
            </view>
            <view class="coupon-card__body">
              <view class="coupon-card__name">{{item.name}}</view>
              <view class="coupon-card__rule">{{item.ruleText}}</view>
              <view class="coupon-card__valid">{{item.validText}}</view>
            </view>
            <view class="coupon-card__reason">{{item.unavailableReason}}</view>
          </view>
        </view>

        <view class="coupon-empty detail-card" wx:elif="{{activeCouponTab === 'unavailable'}}">
          暂无不可用优惠券
        </view>
      </scroll-view>

      <view class="coupon-picker__footer">
        <button class="ghost-button coupon-picker__clear" hover-class="button-hover" bindtap="clearCouponSelection">不使用优惠券</button>
      </view>
    </view>
  </view>
</view>
