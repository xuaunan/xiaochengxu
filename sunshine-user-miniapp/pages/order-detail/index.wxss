.has-pay-bar {
  padding-bottom: 356rpx;
}

.order-hero {
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(255, 177, 74, 0.3), transparent 36%),
    radial-gradient(circle at bottom left, rgba(255, 122, 0, 0.08), transparent 34%),
    linear-gradient(180deg, #ffffff 0%, #fff9f1 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.hero-head {
  align-items: flex-start;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.hero-route {
  line-height: 1.4;
}

.hero-status {
  flex-shrink: 0;
}

.hero-status-accent {
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ff9b2f 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 0, 0.2);
}

.amount-caption {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #8b94a7;
}

.detail-amount-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 10rpx;
}

.detail-amount {
  font-size: 68rpx;
  font-weight: 800;
  color: #ff7a00;
  line-height: 1.1;
  letter-spacing: 0;
}

.detail-amount--original {
  color: #bcc4d2;
  font-size: 40rpx;
  line-height: 1.35;
  text-decoration: line-through;
}

.detail-amount--payable {
  font-size: 72rpx;
}

.amount-discount-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ff7a00;
}

.address-card {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 10rpx 24rpx rgba(31, 36, 50, 0.04);
}

.address-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.address-row + .address-row {
  margin-top: 20rpx;
}

.address-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}

.address-badge.start {
  background: #20bf6b;
}

.address-badge.end {
  background: #ff7a00;
}

.address-text {
  flex: 1;
  font-size: 28rpx;
  color: #1f2432;
  line-height: 1.6;
}

.timeline-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.timeline-toggle {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  color: #ff7a00;
  font-size: 22rpx;
  font-weight: 700;
}

.timeline-summary {
  position: relative;
  display: flex;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #f8f9fc;
  border: 1rpx solid rgba(31, 36, 50, 0.04);
}

.timeline-summary-main {
  flex: 1;
  min-width: 0;
}

.timeline-list {
  margin-top: 22rpx;
}

.timeline-item {
  position: relative;
  padding-left: 54rpx;
  min-height: 104rpx;
}

.timeline-tail {
  position: absolute;
  left: 20rpx;
  top: 34rpx;
  bottom: -24rpx;
  width: 4rpx;
  background: rgba(31, 36, 50, 0.08);
}

.timeline-dot {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #d0d6e2;
  border: 6rpx solid #f0f3f9;
}

.timeline-body {
  padding-bottom: 22rpx;
}

.timeline-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.timeline-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #9aa2b4;
}

.timeline-time {
  flex-shrink: 0;
  max-width: 250rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #a5adbd;
  text-align: right;
}

.timeline-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9aa2b4;
}

.timeline-list .timeline-title {
  font-size: 26rpx;
  font-weight: 700;
}

.timeline-list .timeline-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.timeline-list .timeline-time {
  font-size: 20rpx;
}

.timeline-completed .timeline-dot,
.timeline-completed .timeline-tail {
  background: #ffb14a;
}

.timeline-completed .timeline-dot {
  border-color: rgba(255, 177, 74, 0.18);
}

.timeline-completed .timeline-title,
.timeline-completed .timeline-desc,
.timeline-completed .timeline-time {
  color: #5b6476;
}

.timeline-completed-muted .timeline-dot,
.timeline-completed-muted .timeline-tail {
  background: #c8cfdb;
}

.timeline-completed-muted .timeline-dot {
  border-color: #edf1f7;
}

.timeline-completed-muted .timeline-title,
.timeline-completed-muted .timeline-desc,
.timeline-completed-muted .timeline-time {
  color: #8b94a7;
}

.timeline-current .timeline-dot,
.timeline-current .timeline-tail {
  background: #ff7a00;
}

.timeline-current .timeline-dot {
  border-color: rgba(255, 122, 0, 0.16);
}

.timeline-current .timeline-title {
  color: #ff7a00;
}

.timeline-current .timeline-desc,
.timeline-current .timeline-time {
  color: #d98013;
}

.timeline-summary.timeline-completed,
.timeline-summary.timeline-completed-muted {
  background: linear-gradient(180deg, #fffaf3 0%, #fff7ec 100%);
}

.timeline-summary.timeline-current {
  background: rgba(255, 122, 0, 0.08);
}

.timeline-dot-pulse {
  animation: pay-pulse 1.8s ease-in-out infinite;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-card {
  padding: 30rpx 14rpx;
  border-radius: 26rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff7a00;
  background: linear-gradient(180deg, #fff6ea 0%, #fff1df 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.08);
}

.info-list {
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 24rpx;
  color: #8b94a7;
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #1f2432;
  line-height: 1.6;
}

.info-value--brand {
  color: #ff7a00;
  font-weight: 700;
}

.skeleton-card {
  height: 320rpx;
  border-radius: 32rpx;
}

.skeleton-panel {
  height: 360rpx;
  margin-top: 20rpx;
  border-radius: 32rpx;
}

.payment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -16rpx 38rpx rgba(31, 36, 50, 0.1);
}

.payment-bar__inner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-scene-tip {
  padding: 16rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 122, 0, 0.1);
  color: #ff7a00;
  font-size: 24rpx;
  font-weight: 700;
}

.cancel-fee-note {
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #fffaf3 0%, #fff4e6 100%);
  color: #7a8396;
  font-size: 24rpx;
  line-height: 1.5;
}

.payment-bar__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.coupon-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fffaf3 0%, #fff4e6 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.08);
}

.coupon-entry--disabled {
  opacity: 0.72;
}

.coupon-entry__main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.coupon-entry__icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ffb14a 100%);
}

.coupon-entry__label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2432;
}

.coupon-entry__summary {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8b94a7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-entry__summary--active {
  color: #ff7a00;
  font-weight: 600;
}

.coupon-entry__action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff7a00;
}

.coupon-entry__action--disabled {
  color: #b8c0cf;
}

.payment-meta {
  min-width: 180rpx;
}

.payment-label {
  font-size: 22rpx;
  color: #8b94a7;
}

.payment-amount {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #ff7a00;
}

.pay-button {
  flex: 1;
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
}

.coupon-picker-mask {
  z-index: 59;
}

.coupon-picker {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 90% 2%, rgba(255, 177, 74, 0.16), transparent 28%),
    #f7f8fc;
}

.coupon-picker__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 26rpx) 24rpx 18rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 8rpx 24rpx rgba(31, 36, 50, 0.04);
}

.coupon-picker__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2432;
}

.coupon-picker__close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8b94a7;
  background: #ffffff;
}

.coupon-tabs {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx 0;
  background: #ffffff;
}

.coupon-tab {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8b94a7;
  background: #f5f6fa;
}

.coupon-tab--active {
  color: #ff7a00;
  background: #fff1df;
}

.coupon-picker__content {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 24rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 122, 0, 0.08);
  box-shadow: 0 16rpx 30rpx rgba(31, 36, 50, 0.06);
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.coupon-card--selected {
  border-color: rgba(255, 122, 0, 0.28);
  background: linear-gradient(180deg, #fffaf3 0%, #fff5ea 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.1);
}

.coupon-card--disabled {
  opacity: 0.7;
  background: #f8f9fc;
  border-color: rgba(31, 36, 50, 0.06);
  box-shadow: none;
}

.coupon-card__value {
  width: 188rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff4e6 0%, #fff0de 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-card__value--disabled {
  background: #eef1f7;
}

.coupon-card__amount {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff7a00;
  line-height: 1.1;
}

.coupon-card__caption {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b94a7;
}

.coupon-card__body {
  flex: 1;
  min-width: 0;
}

.coupon-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
  line-height: 1.4;
}

.coupon-card__rule,
.coupon-card__valid {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b94a7;
}

.coupon-card__radio {
  width: 40rpx;
  height: 40rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 122, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex-shrink: 0;
}

.coupon-card__radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.coupon-card__reason {
  flex-shrink: 0;
  align-self: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #8b94a7;
  background: #eef1f7;
}

.coupon-empty {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8b94a7;
}

.coupon-picker__footer {
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 28rpx rgba(31, 36, 50, 0.06);
}

.coupon-picker__clear {
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}

@keyframes pay-pulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255, 122, 0, 0.2);
  }
  50% {
    transform: scale(1.08);
    box-shadow: 0 0 0 14rpx rgba(255, 122, 0, 0);
  }
}


