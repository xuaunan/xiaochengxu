.detail-shell {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 198, 128, 0.18), transparent 30%),
    linear-gradient(180deg, #fff7ed 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.detail-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 24rpx;
}

.has-pay-bar {
  padding-bottom: 250rpx;
}

.detail-hero,
.detail-card {
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 18rpx 42rpx rgba(24, 34, 56, 0.065);
}

.detail-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx 28rpx;
  border-color: rgba(255, 122, 0, 0.18);
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 250, 244, 0.96) 56%, rgba(255, 233, 209, 0.64) 100%),
    #ffffff;
}

.detail-hero__head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-hero__copy {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.detail-route {
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.35;
}

.detail-order-no {
  margin-top: 16rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.4;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.detail-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.detail-tag--type {
  color: #12845c;
  background: #e8f8ef;
}

.detail-tag--price {
  color: #ff6f00;
  background: #fff1df;
}

.detail-status {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.detail-city {
  position: absolute;
  right: 78rpx;
  top: 128rpx;
  width: 250rpx;
  height: 150rpx;
  opacity: 0.18;
  pointer-events: none;
}

.detail-building {
  position: absolute;
  bottom: 0;
  width: 38rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.detail-building--1 {
  left: 18rpx;
  height: 84rpx;
}

.detail-building--2 {
  left: 78rpx;
  height: 126rpx;
}

.detail-building--3 {
  left: 140rpx;
  height: 98rpx;
}

.detail-building--4 {
  left: 198rpx;
  height: 68rpx;
}

.detail-road {
  position: absolute;
  right: -32rpx;
  top: 210rpx;
  width: 360rpx;
  height: 86rpx;
  border-top: 8rpx solid rgba(255, 255, 255, 0.88);
  transform: rotate(-12deg);
  pointer-events: none;
}

.detail-road::after {
  content: "";
  position: absolute;
  right: 38rpx;
  top: 25rpx;
  width: 190rpx;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.92);
}

.detail-taxi {
  position: absolute;
  right: 154rpx;
  top: 220rpx;
  width: 96rpx;
  height: 52rpx;
  transform: rotate(-5deg);
  pointer-events: none;
}

.detail-taxi__body,
.detail-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa33d 0%, #ff7a00 100%);
  border: 2rpx solid rgba(134, 68, 0, 0.16);
}

.detail-taxi__body {
  left: 4rpx;
  bottom: 9rpx;
  width: 86rpx;
  height: 34rpx;
  border-radius: 15rpx 18rpx 10rpx 10rpx;
}

.detail-taxi__top {
  left: 34rpx;
  bottom: 40rpx;
  width: 30rpx;
  height: 19rpx;
  border-radius: 13rpx 13rpx 4rpx 4rpx;
}

.detail-taxi__wheel {
  position: absolute;
  bottom: 3rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: #1f2432;
  box-shadow: inset 0 0 0 5rpx #ffffff;
}

.detail-taxi__wheel--left {
  left: 18rpx;
}

.detail-taxi__wheel--right {
  right: 17rpx;
}

.detail-metrics {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 76rpx;
}

.detail-metric {
  min-height: 116rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 153, 59, 0.16);
}

.detail-metric__icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ff6f00;
  background: #fff1df;
}

.detail-metric__icon--route::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 9rpx;
  width: 20rpx;
  height: 27rpx;
  border-radius: 50% 50% 50% 0;
  border: 5rpx solid currentColor;
  transform: rotate(-45deg);
}

.detail-metric__icon--route::after {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 17rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
}

.detail-metric__icon--clock::before {
  content: "";
  position: absolute;
  inset: 9rpx;
  border-radius: 50%;
  border: 5rpx solid currentColor;
}

.detail-metric__icon--clock::after {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 15rpx;
  width: 5rpx;
  height: 15rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 7rpx 12rpx 0 -1rpx currentColor;
}

.detail-metric__icon--progress::before {
  content: "";
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  border: 5rpx solid currentColor;
  opacity: 0.82;
}

.detail-metric__icon--progress::after {
  content: "100";
  position: absolute;
  left: 8rpx;
  top: 17rpx;
  color: currentColor;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.detail-metric__value {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.1;
  white-space: nowrap;
}

.detail-metric__label {
  margin-top: 8rpx;
  color: #697386;
  font-size: 22rpx;
  line-height: 1.2;
}

.detail-card {
  padding: 28rpx;
}

.detail-section-head,
.detail-section-title-wrap {
  display: flex;
  align-items: center;
}

.detail-section-head {
  justify-content: space-between;
  gap: 18rpx;
}

.detail-section-title-wrap {
  gap: 16rpx;
  min-width: 0;
}

.detail-section-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  color: #ff6f00;
  background: #fff1df;
}

.detail-section-icon--flow::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 24rpx;
  height: 18rpx;
  border-radius: 5rpx;
  border: 4rpx solid currentColor;
}

.detail-section-icon--flow::after {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 21rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 9rpx 0 currentColor;
}

.detail-section-icon--car::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 20rpx;
  width: 32rpx;
  height: 18rpx;
  border-radius: 9rpx 10rpx 5rpx 5rpx;
  border: 4rpx solid currentColor;
}

.detail-section-icon--car::after {
  content: "";
  position: absolute;
  left: 14rpx;
  bottom: 9rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 17rpx 0 0 currentColor, 6rpx -21rpx 0 -1rpx currentColor;
}

.detail-section-icon--driver::before,
.detail-section-icon--driver::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.detail-section-icon--driver::before {
  left: 16rpx;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
}

.detail-section-icon--driver::after {
  left: 11rpx;
  bottom: 10rpx;
  width: 26rpx;
  height: 17rpx;
  border-radius: 15rpx 15rpx 6rpx 6rpx;
}

.detail-section-title {
  color: #172033;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.18;
}

.service-steps {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 0 12rpx;
}

.service-step {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.service-dot {
  position: relative;
  z-index: 2;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #d4dae5;
  font-size: 22rpx;
  font-weight: 900;
}

.service-line {
  position: absolute;
  left: calc(50% + 18rpx);
  right: calc(-50% + 18rpx);
  top: 16rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #d4dae5;
}

.service-step--completed .service-dot,
.service-step--completed-muted .service-dot,
.service-step--current .service-dot {
  background: #ff6f00;
}

.service-step--completed .service-line,
.service-step--completed-muted .service-line,
.service-step--current .service-line {
  background: linear-gradient(90deg, #ff6f00 0%, #ffad4e 100%);
}

.service-step--current .service-dot {
  box-shadow: 0 0 0 12rpx rgba(255, 122, 0, 0.12);
}

.service-label {
  margin-top: 18rpx;
  color: #172033;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.service-step--upcoming .service-label {
  color: #8b94a7;
}

.drive-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 290rpx;
  gap: 18rpx;
  align-items: center;
}

.drive-subtitle {
  margin: 24rpx 0 22rpx 64rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.35;
}

.drive-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 58rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  color: #172033;
  background: linear-gradient(90deg, #eef9f2 0%, #fff6ed 100%);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.drive-pin {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  border-radius: 50% 50% 50% 0;
  background: #25b66f;
  transform: rotate(-45deg);
}

.drive-pin::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
}

.mini-map {
  position: relative;
  height: 148rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #f2f4f8;
}

.mini-map__grid {
  position: absolute;
  inset: -20rpx;
  background:
    linear-gradient(25deg, transparent 0 40%, rgba(255, 255, 255, 0.96) 41% 45%, transparent 46% 100%),
    linear-gradient(-25deg, transparent 0 46%, rgba(255, 255, 255, 0.88) 47% 51%, transparent 52% 100%),
    linear-gradient(90deg, transparent 0 48%, rgba(255, 255, 255, 0.86) 49% 51%, transparent 52% 100%),
    #eef2f7;
}

.mini-map__route {
  position: absolute;
  left: 50rpx;
  right: 56rpx;
  top: 78rpx;
  height: 42rpx;
  border-top: 6rpx dashed #ff6f00;
  border-radius: 50%;
  transform: rotate(-8deg);
}

.mini-map__point {
  position: absolute;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 8rpx solid #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(24, 34, 56, 0.1);
}

.mini-map__point--start {
  left: 44rpx;
  bottom: 32rpx;
  background: #43c66f;
}

.mini-map__point--end {
  right: 38rpx;
  top: 34rpx;
  background: #ff6f00;
}

.action-desc {
  margin: 18rpx 0 24rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.5;
}

.driver-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffaf5 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 153, 59, 0.16);
}

.driver-action {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.driver-action__icon {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ff6f00;
  background: #fff1df;
}

.driver-action__icon--wheel::before {
  content: "";
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  border: 6rpx solid currentColor;
}

.driver-action__icon--wheel::after {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 13rpx;
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(45deg);
}

.driver-action__icon--user::before,
.driver-action__icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.driver-action__icon--user::before {
  top: 12rpx;
  left: 19rpx;
  width: 16rpx;
  height: 16rpx;
}

.driver-action__icon--user::after {
  left: 14rpx;
  bottom: 12rpx;
  width: 26rpx;
  height: 17rpx;
  border-radius: 15rpx 15rpx 6rpx 6rpx;
}

.driver-action__icon--check::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 12rpx;
  width: 15rpx;
  height: 26rpx;
  border-right: 7rpx solid currentColor;
  border-bottom: 7rpx solid currentColor;
  transform: rotate(42deg);
}

.driver-action__copy {
  min-width: 0;
}

.driver-action__title {
  color: #172033;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
}

.driver-action__desc {
  margin-top: 6rpx;
  color: #7a8396;
  font-size: 19rpx;
  line-height: 1.25;
}

.driver-action__state {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #12845c;
  background: #e8f8ef;
  font-size: 19rpx;
  font-weight: 900;
}

.driver-action--pending .driver-action__state {
  color: #8b94a7;
  background: #eef1f7;
}

.driver-action__arrow {
  position: absolute;
  right: -9rpx;
  top: 24rpx;
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid rgba(112, 122, 140, 0.3);
  border-right: 4rpx solid rgba(112, 122, 140, 0.3);
  transform: rotate(45deg);
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-card {
  padding: 28rpx 14rpx;
  border-radius: 22rpx;
  color: #ff6f00;
  background: rgba(255, 122, 0, 0.07);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
}

.info-list {
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  color: #8b94a7;
  font-size: 24rpx;
}

.info-value {
  flex: 1;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: right;
}

.info-value--brand {
  color: #ff6f00;
  font-weight: 900;
}

.detail-complete {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #d8791f;
  background: linear-gradient(135deg, #ffd1a8 0%, #ffe1bf 100%);
  font-size: 31rpx;
  font-weight: 900;
}

.skeleton-card {
  height: 430rpx;
  border-radius: 32rpx;
}

.skeleton-panel {
  height: 300rpx;
  margin-top: 20rpx;
  border-radius: 32rpx;
}

.payment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -12rpx 30rpx rgba(31, 36, 50, 0.08);
}

.payment-bar__inner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-bar__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.coupon-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.045);
}

.coupon-entry--disabled {
  opacity: 0.72;
}

.coupon-entry__main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.coupon-entry__icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #ff7a00;
  font-size: 22rpx;
  font-weight: 900;
}

.coupon-entry__label {
  color: #1f2432;
  font-size: 28rpx;
  font-weight: 900;
}

.coupon-entry__summary {
  flex: 1;
  min-width: 0;
  color: #8b94a7;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-entry__summary--active,
.coupon-entry__action {
  color: #ff7a00;
  font-weight: 800;
}

.coupon-entry__action {
  flex-shrink: 0;
  font-size: 24rpx;
}

.coupon-entry__action--disabled {
  color: #b8c0cf;
}

.payment-meta {
  min-width: 180rpx;
}

.payment-label {
  color: #8b94a7;
  font-size: 22rpx;
}

.payment-amount {
  margin-top: 8rpx;
  color: #ff7a00;
  font-size: 38rpx;
  font-weight: 900;
}

.pay-button {
  flex: 1;
  min-height: 96rpx;
  border-radius: 26rpx;
  font-size: 32rpx;
}

.coupon-picker-mask {
  z-index: 59;
}

.coupon-picker {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 90% 2%, rgba(255, 177, 74, 0.16), transparent 28%),
    #f7f8fc;
}

.coupon-picker__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 26rpx) 24rpx 18rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 8rpx 24rpx rgba(31, 36, 50, 0.04);
}

.coupon-picker__title {
  color: #1f2432;
  font-size: 34rpx;
  font-weight: 900;
}

.coupon-picker__close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b94a7;
  background: #ffffff;
  font-size: 40rpx;
}

.coupon-tabs {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx 0;
  background: #ffffff;
}

.coupon-tab {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  color: #8b94a7;
  background: #f5f6fa;
  font-size: 26rpx;
  font-weight: 800;
}

.coupon-tab--active {
  color: #ff7a00;
  background: #fff1df;
}

.coupon-picker__content {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 24rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 122, 0, 0.08);
  box-shadow: 0 16rpx 30rpx rgba(31, 36, 50, 0.06);
}

.coupon-card--selected {
  border-color: rgba(255, 122, 0, 0.28);
  background: linear-gradient(180deg, #fffaf3 0%, #fff5ea 100%);
}

.coupon-card--disabled {
  opacity: 0.7;
  background: #f8f9fc;
  border-color: rgba(31, 36, 50, 0.06);
  box-shadow: none;
}

.coupon-card__value {
  width: 188rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff4e6 0%, #fff0de 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-card__value--disabled {
  background: #eef1f7;
}

.coupon-card__amount {
  color: #ff7a00;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.1;
}

.coupon-card__caption,
.coupon-card__rule,
.coupon-card__valid {
  color: #8b94a7;
}

.coupon-card__caption {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.coupon-card__body {
  flex: 1;
  min-width: 0;
}

.coupon-card__name {
  color: #1f2432;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.coupon-card__rule,
.coupon-card__valid {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.coupon-card__radio {
  width: 40rpx;
  height: 40rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 122, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex-shrink: 0;
}

.coupon-card__radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.coupon-card__reason {
  flex-shrink: 0;
  align-self: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8b94a7;
  background: #eef1f7;
  font-size: 22rpx;
  font-weight: 800;
}

.coupon-empty {
  margin-top: 12rpx;
  text-align: center;
  color: #8b94a7;
  font-size: 26rpx;
}

.coupon-picker__footer {
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 28rpx rgba(31, 36, 50, 0.06);
}

.coupon-picker__clear {
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.pressable-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
