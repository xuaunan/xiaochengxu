.wallet-hero {
  overflow: hidden;
  color: #ffffff;
  background:
    radial-gradient(circle at 90% 0, rgba(255, 255, 255, 0.2), transparent 34%),
    linear-gradient(135deg, #ff7a00 0%, #ff9a31 58%, #ffbd63 100%);
}

.wallet-hero .section-title,
.wallet-hero .section-subtitle {
  color: #ffffff;
}

.wallet-hero .section-subtitle {
  color: rgba(255, 255, 255, 0.82);
}

.wallet-balance {
  margin-top: 18rpx;
  font-size: 76rpx;
  line-height: 1.08;
  font-weight: 800;
  letter-spacing: 0;
}

.wallet-actions {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
}

.wallet-action {
  flex: 1;
  min-height: 92rpx;
  border-radius: 999rpx;
}


