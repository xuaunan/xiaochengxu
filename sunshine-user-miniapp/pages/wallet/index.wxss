.wallet-page-shell {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff7ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.wallet-page {
  display: flex;
  flex-direction: column;
  gap: 13rpx;
  padding: 18rpx 22rpx 30rpx;
}

.wallet-balance-card,
.wallet-ledger-panel {
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(31, 36, 50, 0.045);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.05);
}

.wallet-balance-card {
  padding: 20rpx 22rpx 22rpx;
}

.wallet-balance-head,
.wallet-section-head,
.wallet-title-wrap {
  display: flex;
  align-items: center;
}

.wallet-balance-head,
.wallet-section-head {
  justify-content: space-between;
  gap: 16rpx;
}

.wallet-title-wrap {
  gap: 14rpx;
  min-width: 0;
}

.wallet-balance-title,
.wallet-section-title {
  color: #172033;
  font-size: 26rpx;
  line-height: 1.28;
  font-weight: 500;
}

.wallet-balance-desc {
  margin-top: 6rpx;
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 400;
}

.wallet-soft-pill {
  flex-shrink: 0;
  padding: 6rpx 13rpx;
  border-radius: 999rpx;
  background: #fff1df;
  color: #ff6f00;
  font-size: 20rpx;
  line-height: 1.1;
  font-weight: 500;
}

.wallet-amount-line {
  display: flex;
  align-items: baseline;
  min-width: 0;
  margin-top: 14rpx;
  color: #172033;
  font-variant-numeric: tabular-nums;
}

.wallet-amount-symbol {
  flex-shrink: 0;
  margin-right: 6rpx;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 500;
}

.wallet-amount {
  min-width: 0;
  max-width: 520rpx;
  font-size: 40rpx;
  line-height: 1.06;
  font-weight: 500;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wallet-section-head {
  padding: 8rpx 4rpx 2rpx;
}

.wallet-section-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #fff0df;
  color: #ff7a00;
}

.wallet-section-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.wallet-ledger-panel {
  overflow: hidden;
  padding: 0 18rpx;
}

.wallet-record-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.07);
}

.wallet-record-row:last-child {
  border-bottom: none;
}

.wallet-record-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 13rpx;
  color: #ff7a00;
  background: #fff0df;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
}

.wallet-record__marker--refund {
  color: #10a566;
  background: #eaf8f1;
}

.wallet-record-copy {
  flex: 1;
  min-width: 0;
}

.wallet-record-title {
  color: #172033;
  font-size: 23rpx;
  line-height: 1.32;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wallet-record-desc {
  margin-top: 6rpx;
  color: #737d90;
  font-size: 20rpx;
  line-height: 1.36;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wallet-record-side {
  flex-shrink: 0;
  max-width: 170rpx;
  text-align: right;
}

.wallet-record-amount {
  color: #172033;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 500;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wallet-record__amount--refund {
  color: #10a566;
}

.wallet-record-time {
  margin-top: 6rpx;
  color: #9aa2b3;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

.wallet-empty {
  padding: 34rpx 20rpx;
  text-align: center;
}

.wallet-empty__title {
  color: #172033;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 500;
}

.wallet-empty__desc {
  margin-top: 8rpx;
  color: #737d90;
  font-size: 20rpx;
  line-height: 1.5;
  font-weight: 400;
}
