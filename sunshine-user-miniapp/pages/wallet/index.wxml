<view class="page-shell wallet-page-shell safe-bottom">
  <view class="wallet-page page-enter">
    <view class="wallet-balance-card">
      <view class="wallet-balance-head">
        <view>
          <view class="wallet-balance-title">钱包余额</view>
          <view class="wallet-balance-desc">账户当前可用余额</view>
        </view>
      </view>
      <view class="wallet-amount-line">
        <text class="wallet-amount-symbol">¥</text>
        <text class="wallet-amount">{{wallet.balanceText}}</text>
      </view>
    </view>

    <view class="wallet-section-head">
      <view class="wallet-title-wrap">
        <view class="wallet-section-icon"></view>
        <view class="wallet-section-title">流水明细</view>
      </view>
      <view class="wallet-soft-pill">{{records.length}} 条</view>
    </view>

    <view class="wallet-ledger-panel">
      <block wx:if="{{hasRecords}}">
        <view
          class="wallet-record-row tap-scale"
          wx:for="{{records}}"
          wx:key="key"
          data-type="{{item.type}}"
          data-id="{{item.orderId}}"
          bindtap="openRecord"
        >
          <view class="wallet-record-mark {{item.markerClass}}">{{item.marker}}</view>
          <view class="wallet-record-copy">
            <view class="wallet-record-title">{{item.title}}</view>
            <view class="wallet-record-desc">{{item.desc}}</view>
          </view>
          <view class="wallet-record-side">
            <view class="wallet-record-amount {{item.amountClass}}">{{item.amountText}}</view>
            <view class="wallet-record-time">{{item.time}}</view>
          </view>
        </view>
      </block>
      <view wx:else class="wallet-empty">
        <view class="wallet-empty__title">暂无流水</view>
        <view class="wallet-empty__desc">完成支付或退款后，这里会显示明细。</view>
      </view>
    </view>
  </view>
</view>
