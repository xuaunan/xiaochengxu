<view class="page-shell wallet-page-shell safe-bottom">
  <view class="wallet-page page-enter">
    <view class="wallet-hero">
      <image class="wallet-hero-bg" src="/images/wallet-security-bg.png" mode="aspectFill"></image>
      <view class="wallet-hero-top">
        <view>
          <view class="wallet-kicker">账户资产</view>
          <view class="wallet-balance-title">
            <text>钱包余额</text>
            <view class="wallet-eye {{balanceVisible ? '' : 'is-hidden'}}" catchtap="toggleBalanceVisible"></view>
          </view>
        </view>
        <view class="wallet-status-pill">
          <view class="wallet-status-shield"></view>
          <text>安全保障</text>
        </view>
      </view>

      <view class="wallet-amount-line">
        <text class="wallet-amount-symbol" wx:if="{{balanceVisible}}">¥</text>
        <text class="wallet-amount">{{balanceVisible ? wallet.balanceText : '****'}}</text>
      </view>

      <view class="wallet-balance-desc">{{summary.syncText}}</view>

      <view class="wallet-summary-grid">
        <view class="wallet-summary-item">
          <view class="wallet-summary-label">近期支出</view>
          <view class="wallet-summary-value">{{balanceVisible ? summary.spendText : '****'}}</view>
        </view>
        <view class="wallet-summary-divider"></view>
        <view class="wallet-summary-item">
          <view class="wallet-summary-label">退款入账</view>
          <view class="wallet-summary-value wallet-summary-value--refund">{{balanceVisible ? summary.refundText : '****'}}</view>
        </view>
        <view class="wallet-summary-divider"></view>
        <view class="wallet-summary-item">
          <view class="wallet-summary-label">交易笔数</view>
          <view class="wallet-summary-value">{{balanceVisible ? summary.countText : '****'}}</view>
        </view>
      </view>
    </view>

    <view class="wallet-section-head">
      <view class="wallet-title-wrap">
        <view class="wallet-section-icon"></view>
        <view>
          <view class="wallet-section-title">流水明细</view>
          <view class="wallet-section-desc">按最近支付时间排序</view>
        </view>
      </view>
      <view class="wallet-section-actions">
        <view class="wallet-filter-pill">
          <text>{{summary.filterLabel}}</text>
          <view class="wallet-filter-caret"></view>
        </view>
        <view class="wallet-soft-count">{{records.length}}条</view>
      </view>
    </view>

    <view class="wallet-ledger-panel">
      <block wx:if="{{hasRecords}}">
        <view
          class="wallet-record-row tap-scale"
          wx:for="{{records}}"
          wx:key="key"
          data-type="{{item.type}}"
          data-id="{{item.orderId}}"
          bindtap="openRecord"
        >
          <view class="wallet-record-mark {{item.markerClass}}">
            <text>{{item.marker}}</text>
          </view>
          <view class="wallet-record-copy">
            <view class="wallet-record-title-line">
              <view class="wallet-record-title">{{item.title}}</view>
              <view class="wallet-record-status {{item.statusClass}}">{{item.statusText}}</view>
            </view>
            <view class="wallet-record-desc">
              <text>{{item.serviceLabel}}</text>
              <text class="wallet-record-dot">·</text>
              <text>{{item.desc}}</text>
            </view>
          </view>
          <view class="wallet-record-side">
            <view class="wallet-record-time">
              <text>{{item.date}}</text>
              <text>{{item.clock}}</text>
            </view>
            <view class="wallet-record-amount {{item.amountClass}}">{{balanceVisible ? item.amountText : '****'}}</view>
          </view>
          <view class="wallet-record-chevron"></view>
        </view>
      </block>
      <view wx:elif="{{loading}}" class="wallet-state-card">
        <view class="wallet-state-title">流水同步中...</view>
        <view class="wallet-state-desc">正在加载最近交易明细</view>
      </view>
      <view wx:elif="{{errorText}}" class="wallet-state-card wallet-state-card--error">
        <view class="wallet-state-title">钱包加载失败</view>
        <view class="wallet-state-desc">{{errorText}}</view>
        <button class="wallet-state-button" hover-class="button-hover" bindtap="retryRefresh">重新加载</button>
      </view>
      <view wx:else class="wallet-empty">
        <view class="wallet-empty__icon"></view>
        <view class="wallet-empty__title">暂无流水</view>
        <view class="wallet-empty__desc">完成支付或退款后，这里会显示明细。</view>
      </view>
    </view>
  </view>
</view>
