.carpool-trips-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.trips-hero,
.trip-record,
.empty-card {
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.trip-summary {
  margin-top: 22rpx;
}

.trip-record {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
}

.record-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.4;
}

.record-meta,
.record-hint {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.record-action {
  margin-top: 14rpx;
}

.empty-card {
  text-align: center;
  padding: 40rpx 24rpx;
}

.empty-title {
  font-size: 30rpx;
}


