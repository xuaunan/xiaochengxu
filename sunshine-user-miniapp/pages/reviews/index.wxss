.reviews-shell {
  background:
    radial-gradient(circle at 92% 0%, rgba(255, 193, 117, 0.12), transparent 34%),
    linear-gradient(180deg, #fff8f2 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.reviews-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reviews-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 6rpx 0;
}

.reviews-kicker {
  margin-bottom: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #ff7a00;
}

.reviews-title {
  font-size: 36rpx;
}

.reviews-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.1);
  font-size: 21rpx;
  font-weight: 800;
}

.reviews-intro {
  padding: 22rpx 24rpx;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.review-card {
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.06);
}

.review-card .brand-text {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.1);
  font-size: 24rpx;
  font-weight: 800;
}

.review-card__title {
  font-size: 29rpx;
  font-weight: 800;
  color: #1f2432;
}

.review-card__meta,
.review-card__time {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7a8396;
}

.review-content {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f7f8fc;
  font-size: 24rpx;
  line-height: 1.56;
  color: #4f5b70;
}
