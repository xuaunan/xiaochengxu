.reviews-hero {
  overflow: hidden;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 177, 74, 0.24), transparent 36%),
    linear-gradient(180deg, #ffffff 0%, #fff8ef 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.review-card {
  border: 1rpx solid rgba(255, 122, 0, 0.07);
}

.review-card .brand-text {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: #fff1df;
  font-size: 24rpx;
  font-weight: 800;
}

.review-content {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f8f9fc;
}


