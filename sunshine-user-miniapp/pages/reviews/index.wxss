.reviews-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.22) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.reviews-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
}

.reviews-hero,
.review-card,
.reviews-empty {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.reviews-hero {
  position: relative;
  min-height: 160rpx;
  padding: 30rpx 170rpx 30rpx 30rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.reviews-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.18;
}

.reviews-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #737c90;
}

.reviews-count {
  position: absolute;
  right: 30rpx;
  top: 32rpx;
  z-index: 2;
  min-width: 92rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
}

.reviews-hero__icon {
  position: absolute;
  right: 52rpx;
  bottom: 22rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.82), rgba(255, 122, 0, 0.76));
}

.reviews-hero__icon::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 23rpx;
  width: 36rpx;
  height: 26rpx;
  border-left: 7rpx solid #ffffff;
  border-bottom: 7rpx solid #ffffff;
  border-radius: 2rpx;
  background: transparent;
  transform: rotate(-45deg);
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.review-card {
  padding: 26rpx;
}

.review-card__top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.review-icon {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(255, 122, 0, 0.1);
}

.review-icon::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 19rpx;
  width: 26rpx;
  height: 18rpx;
  border-left: 5rpx solid #ff7a00;
  border-bottom: 5rpx solid #ff7a00;
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

.review-card__main {
  flex: 1;
  min-width: 0;
}

.review-score {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 24rpx;
  font-weight: 900;
}

.review-card__title {
  font-size: 29rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.34;
}

.review-card__meta,
.review-card__time {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7a8396;
}

.review-content {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  font-size: 24rpx;
  line-height: 1.6;
  color: #4f5b70;
}

.reviews-empty {
  padding: 24rpx;
}
