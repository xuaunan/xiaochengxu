.reviews-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.22) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.reviews-page {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 12rpx;
}

.reviews-hero,
.review-card,
.reviews-empty {
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 7rpx 18rpx rgba(37, 43, 58, 0.035);
}

.reviews-hero {
  position: relative;
  min-height: 102rpx;
  padding: 17rpx 116rpx 17rpx 18rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.reviews-title {
  font-size: 27rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.18;
}

.reviews-subtitle {
  margin-top: 7rpx;
  font-size: 20rpx;
  color: #737c90;
}

.reviews-count {
  position: absolute;
  right: 20rpx;
  top: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  font-weight: 550;
  line-height: 1;
  box-sizing: border-box;
}

.reviews-hero__icon {
  position: absolute;
  right: 38rpx;
  bottom: 16rpx;
  width: 64rpx;
  height: 64rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.82), rgba(255, 122, 0, 0.76));
}

.reviews-hero__icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 27rpx;
  height: 18rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  border-radius: 2rpx;
  background: transparent;
  transform: translate(-50%, -56%) rotate(-45deg);
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.review-card {
  padding: 16rpx;
}

.review-card__top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.review-icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 122, 0, 0.1);
}

.review-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 21rpx;
  height: 14rpx;
  border-left: 3rpx solid #ff7a00;
  border-bottom: 3rpx solid #ff7a00;
  border-radius: 2rpx;
  transform: translate(-50%, -56%) rotate(-45deg);
}

.review-card__main {
  flex: 1;
  min-width: 0;
}

.review-score {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 20rpx;
  font-weight: 550;
}

.review-card__title {
  font-size: 23rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.34;
}

.review-card__meta,
.review-card__time {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #7a8396;
}

.review-content {
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  font-size: 20rpx;
  line-height: 1.5;
  color: #4f5b70;
}

.reviews-empty {
  padding: 20rpx;
}
