.reviews-shell {
  background:
    linear-gradient(180deg, rgba(255, 246, 237, 0.64) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.reviews-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reviews-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 8rpx 2rpx;
}

.reviews-title {
  font-size: 34rpx;
}

.reviews-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a94a8;
}

.reviews-count {
  flex-shrink: 0;
  margin-bottom: 4rpx;
  padding: 9rpx 17rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 21rpx;
  font-weight: 800;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.review-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.review-card .brand-text {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 24rpx;
  font-weight: 800;
}

.review-card__title {
  font-size: 29rpx;
  font-weight: 800;
  color: #1f2432;
}

.review-card__meta,
.review-card__time {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7a8396;
}

.review-content {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  font-size: 24rpx;
  line-height: 1.56;
  color: #4f5b70;
}
