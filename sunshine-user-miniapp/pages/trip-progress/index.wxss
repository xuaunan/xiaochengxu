page {
  height: 100%;
  overflow: hidden;
}

.home-page {
  position: relative;
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef3f8 0%, #f7f8fc 100%);
}

.trip-nav {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.34);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(18rpx);
  box-shadow: none;
}

.trip-direct-back {
  position: absolute;
  left: 24rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  width: 120px;
  color: #6b7385;
  font-size: 26rpx;
}

.trip-direct-back--hover {
  color: #ff7a00;
  opacity: 0.72;
}

.trip-map-stage {
  flex: 0 0 auto;
  position: relative;
  width: 100%;
  height: 40vh;
  overflow: hidden;
  background: #e7edf3;
}

.trip-map-stage .trip-map {
  display: block;
  width: 100%;
  height: 100%;
}

.trip-content {
  flex: 1 1 auto;
  position: relative;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: linear-gradient(180deg, #f4f7fb 0%, #f8f9fc 100%);
}

.trip-card {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 34rpx rgba(31, 36, 50, 0.09);
}

.passenger-detail-hero,
.passenger-detail-card {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(24, 34, 56, 0.055);
}

.passenger-detail-hero {
  overflow: hidden;
  padding: 20rpx 20rpx 16rpx;
  border-color: rgba(255, 122, 0, 0.16);
  background:
    linear-gradient(110deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 249, 242, 0.97) 58%, rgba(255, 235, 214, 0.86) 100%),
    #ffffff;
}

.passenger-detail-city {
  position: absolute;
  right: 34rpx;
  top: 64rpx;
  width: 178rpx;
  height: 92rpx;
  opacity: 0.18;
  pointer-events: none;
}

.passenger-detail-building {
  position: absolute;
  bottom: 0;
  width: 30rpx;
  border-radius: 7rpx 7rpx 0 0;
  background: #ff9b3d;
}

.passenger-detail-building--1 { left: 8rpx; height: 58rpx; }
.passenger-detail-building--2 { left: 54rpx; height: 92rpx; }
.passenger-detail-building--3 { left: 102rpx; height: 72rpx; }
.passenger-detail-building--4 { left: 148rpx; height: 48rpx; }

.passenger-detail-road {
  position: absolute;
  right: -12rpx;
  top: 128rpx;
  width: 280rpx;
  border-top: 7rpx solid rgba(255, 255, 255, 0.9);
  transform: rotate(-10deg);
  pointer-events: none;
}

.passenger-detail-road::after {
  content: '';
  position: absolute;
  right: 28rpx;
  top: 15rpx;
  width: 150rpx;
  border-top: 3rpx dashed rgba(255, 255, 255, 0.94);
}

.passenger-detail-taxi {
  position: absolute;
  right: 118rpx;
  top: 126rpx;
  width: 72rpx;
  height: 42rpx;
  z-index: 1;
  transform: rotate(-4deg);
  pointer-events: none;
}

.passenger-detail-taxi__body,
.passenger-detail-taxi__top {
  position: absolute;
  background: linear-gradient(180deg, #ffa33d 0%, #ff7a00 100%);
  border: 2rpx solid rgba(134, 68, 0, 0.13);
}

.passenger-detail-taxi__body {
  left: 2rpx;
  bottom: 8rpx;
  width: 70rpx;
  height: 28rpx;
  border-radius: 13rpx 16rpx 8rpx 8rpx;
}

.passenger-detail-taxi__top {
  left: 25rpx;
  bottom: 31rpx;
  width: 28rpx;
  height: 17rpx;
  border-radius: 12rpx 12rpx 3rpx 3rpx;
}

.passenger-detail-taxi__wheel {
  position: absolute;
  bottom: 2rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #263044;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.passenger-detail-taxi__wheel--left { left: 13rpx; }
.passenger-detail-taxi__wheel--right { right: 10rpx; }

.passenger-detail-hero__head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.passenger-detail-hero__copy {
  flex: 1;
  min-width: 0;
}

.passenger-detail-route {
  color: #172033;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.3;
}

.passenger-detail-order {
  margin-top: 8rpx;
  color: #7b8799;
  font-size: 19rpx;
  line-height: 1.3;
}

.passenger-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.passenger-detail-tag {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1;
}

.passenger-detail-tag--service {
  color: #12845c;
  background: #e8f8ef;
}

.passenger-detail-tag--price {
  color: #f06f0a;
  background: #fff0df;
}

.passenger-detail-status {
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #2c63ff;
  background: #e9efff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.passenger-detail-metrics {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
}

.passenger-detail-metric {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
  padding: 12rpx 10rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.78);
}

.passenger-detail-metric__icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  border: 3rpx solid #ff9a3d;
  border-radius: 50%;
}

.passenger-detail-metric__icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #ff9a3d;
  transform: translate(-50%, -50%);
}

.passenger-detail-metric__icon--route {
  border-radius: 50% 50% 50% 4rpx;
  transform: rotate(-45deg);
}

.passenger-detail-metric__icon--route::after {
  transform: translate(-50%, -50%) rotate(45deg);
}

.passenger-detail-metric__icon--time::after {
  width: 3rpx;
  height: 11rpx;
  border-radius: 999rpx;
  transform: translate(-50%, -82%);
}

.passenger-detail-metric__value {
  overflow: hidden;
  color: #263044;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.passenger-detail-metric__label {
  margin-top: 5rpx;
  overflow: hidden;
  color: #8b95a6;
  font-size: 17rpx;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.passenger-detail-card {
  padding: 16rpx 18rpx;
}

.passenger-flow-card {
  padding-bottom: 14rpx;
}

.passenger-drive-card {
  padding-bottom: 16rpx;
}

.passenger-drive-card .trip-section-head--status {
  margin: 0;
  padding: 0;
  border-top: 0;
}

.passenger-drive-stage {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f2fbf5 0%, #eaf7ef 100%);
}

.passenger-drive-stage__title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.2;
}

.passenger-drive-stage__subtitle {
  margin-top: 5rpx;
  color: #6c7789;
  font-size: 19rpx;
  line-height: 1.3;
}

.passenger-drive-stage__route {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
  color: #253044;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
}

.passenger-drive-stage__route text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.passenger-drive-stage__route text:last-child {
  flex-shrink: 0;
}

.passenger-drive-stage__track {
  height: 10rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(27, 169, 122, 0.14);
}

.passenger-drive-stage__fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: inherit;
  background: linear-gradient(90deg, #36b777 0%, #ff9a3d 100%);
}

.passenger-drive-stage__hint {
  margin-top: 8rpx;
  color: #718093;
  font-size: 18rpx;
  line-height: 1.2;
}

.passenger-drive-facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 10rpx;
}

.passenger-drive-fact {
  min-width: 0;
  padding: 10rpx;
  border-radius: 13rpx;
  background: #f7f8fb;
}

.passenger-drive-fact__label {
  color: #929bad;
  font-size: 17rpx;
  line-height: 1.1;
}

.passenger-drive-fact__value {
  margin-top: 5rpx;
  overflow: hidden;
  color: #263044;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.passenger-drive-fact__value--strong {
  color: #ff6f00;
}

.trip-card__eyebrow {
  color: #ff7a00;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
}

.trip-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.trip-section-head--status {
  margin-top: 2rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.trip-section-head__title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.trip-section-title {
  color: #1f2432;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.25;
}

.trip-section-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  border-radius: 12rpx;
  background: #fff1df;
  color: #ff7a00;
}

.trip-section-icon--flow::before,
.trip-section-icon--flow::after {
  content: '';
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.trip-section-icon--flow::before {
  top: 11rpx;
  box-shadow: 0 8rpx 0 currentColor;
}

.trip-section-icon--flow::after {
  top: 27rpx;
  right: 16rpx;
}

.trip-section-icon--car {
  background: #eaf8ef;
  color: #1ba97a;
}

.trip-section-icon--car::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 15rpx;
  width: 22rpx;
  height: 12rpx;
  border-radius: 8rpx 9rpx 5rpx 5rpx;
  background: currentColor;
}

.trip-section-icon--car::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 10rpx;
  width: 14rpx;
  height: 9rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: currentColor;
  box-shadow: -2rpx 18rpx 0 -1rpx #ffffff, 14rpx 18rpx 0 -1rpx #ffffff;
}

.trip-flow {
  display: flex;
  align-items: flex-start;
  margin: 2rpx -4rpx 0;
}

.trip-flow__step {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.trip-flow__dot {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #d6dce7;
  font-size: 20rpx;
  font-weight: 700;
}

.trip-flow__step--done .trip-flow__dot,
.trip-flow__step--current .trip-flow__dot {
  background: #ff7a00;
}

.trip-flow__step--current .trip-flow__dot {
  box-shadow: 0 0 0 9rpx rgba(255, 122, 0, 0.12);
}

.trip-flow__line {
  position: absolute;
  left: calc(50% + 17rpx);
  right: calc(-50% + 17rpx);
  top: 15rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #d6dce7;
}

.trip-flow__step--done .trip-flow__line {
  background: #ff7a00;
}

.trip-flow__label {
  margin-top: 10rpx;
  color: #8b95a6;
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
}

.trip-flow__step--done .trip-flow__label,
.trip-flow__step--current .trip-flow__label {
  color: #31394a;
  font-weight: 550;
}

.trip-phase-badge {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 10rpx;
  color: #12845c;
  background: #e8f8ef;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.trip-phase-badge--dispatch {
  color: #c56b12;
  background: #fff1df;
}

.trip-phase-badge--approach {
  color: #2c63a8;
  background: #eaf3ff;
}

.trip-phase-badge--complete {
  color: #6b7385;
  background: #eef1f5;
}

.map-follow-control {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  z-index: 5;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  max-height: 64rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 20rpx rgba(31, 36, 50, 0.12);
  color: #4f596d;
}

.map-follow-control::after,
.safety-option::after {
  border: none;
}

.map-follow-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.map-follow-icon::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.map-follow-control.following {
  color: #5d687a;
}

.map-follow-control.paused {
  color: #ff7a00;
  border-color: rgba(255, 122, 0, 0.22);
}

.map-follow-control--hover {
  transform: scale(0.94);
  opacity: 0.9;
}

.trip-head {
  align-items: flex-start;
  gap: 20rpx;
}

.trip-summary {
  flex: 1;
  min-width: 0;
}

.trip-route {
  max-width: 520rpx;
  font-size: 31rpx;
  line-height: 1.35;
}

.trip-status {
  flex-shrink: 0;
  margin-top: 8rpx;
}

.arrival-metrics {
  margin-top: 0;
  gap: 12rpx;
}

.arrival-metrics .metric-item {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  border: 1rpx solid rgba(31, 36, 50, 0.045);
}

.arrival-metrics .metric-value {
  font-size: 29rpx;
}

.arrival-metrics .metric-label {
  margin-top: 5rpx;
  font-size: 20rpx;
}

.trip-progress-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.trip-progress-line__track {
  flex: 1;
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0f5;
}

.trip-progress-line__fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: inherit;
  background: #ff9a3d;
}

.trip-progress-line__label {
  flex: 0 0 auto;
  color: #8b95a6;
  font-size: 20rpx;
}

.trip-actions {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 2rpx;
}

.trip-action {
  flex: 1;
  min-width: 0;
}

.trip-alert {
  font-size: 22rpx;
  line-height: 1.7;
  color: #7a8396;
}

.safety-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  background: rgba(18, 24, 36, 0.4);
}

.safety-sheet {
  width: 100%;
  max-height: 86vh;
  box-sizing: border-box;
  overflow-y: auto;
  padding: 14rpx 24rpx calc(env(safe-area-inset-bottom) + 30rpx);
  border-radius: 30rpx 30rpx 0 0;
  background: #f8f9fb;
  box-shadow: 0 -18rpx 54rpx rgba(18, 24, 36, 0.16);
}

.safety-sheet__handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d8dce5;
}

.safety-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 2rpx 22rpx;
}

.safety-sheet__title {
  color: #1f2432;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.safety-sheet__subtitle {
  margin-top: 6rpx;
  color: #8a93a5;
  font-size: 22rpx;
  line-height: 1.4;
}

.safety-sheet__close {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  min-width: 54rpx;
  max-width: 54rpx;
  height: 54rpx;
  min-height: 54rpx;
  max-height: 54rpx;
  flex: 0 0 54rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #eef1f5;
}

.safety-sheet__close-line {
  position: absolute;
  left: 16rpx;
  top: 25rpx;
  width: 22rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #727c8f;
}

.safety-sheet__close-line--left {
  transform: rotate(45deg);
}

.safety-sheet__close-line--right {
  transform: rotate(-45deg);
}

.safety-sheet__close--hover {
  background: #e3e7ed;
}

.safety-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.safety-option {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-height: 108rpx;
  margin: 0;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(31, 36, 50, 0.065);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(31, 36, 50, 0.045);
  text-align: left;
  line-height: 1;
}

.safety-option--hover {
  background: #f5f7fa;
  transform: scale(0.992);
}

.safety-option__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
}

.safety-option__icon image {
  width: 38rpx;
  height: 38rpx;
}

.safety-option__icon--warning {
  background: #fff3e5;
}

.safety-option__icon--support {
  background: #eaf3ff;
}

.safety-option__icon--emergency {
  background: #ffeded;
}

.safety-option__content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.safety-option__title {
  color: #242a38;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.25;
}

.safety-option__desc {
  color: #8992a4;
  font-size: 21rpx;
  line-height: 1.45;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.safety-option__end {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.safety-option__state {
  color: #9aa3b2;
  font-size: 21rpx;
  font-weight: 500;
}

.safety-option__arrow {
  flex-shrink: 0;
  color: #b6bdca;
  font-size: 36rpx;
  font-weight: 300;
}

.safety-option--emergency {
  border-color: rgba(220, 63, 69, 0.13);
  background: #fffdfd;
}

.safety-option--emergency.is-disabled {
  opacity: 0.72;
}

.safety-option__badge {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #fff0f0;
  color: #dc3f45;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.safety-option__arrow--danger {
  color: #d86a70;
}

.safety-sheet__tip {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #e36a6f;
  border-radius: 8rpx;
  background: rgba(255, 237, 237, 0.72);
  color: #8f5b63;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: left;
}

/* Keep the passenger detail stack readable with a clear gap below the map. */
.trip-content {
  gap: 24rpx;
  padding-top: 28rpx;
}

.passenger-detail-route {
  color: #111827;
  font-size: 29rpx;
  font-weight: 550;
  line-height: 1.35;
}

.passenger-detail-order {
  margin-top: 10rpx;
  font-size: 17rpx;
  line-height: 1.45;
}

.passenger-detail-tags {
  margin-top: 8rpx;
  gap: 12rpx;
}

.passenger-detail-tag {
  padding: 6rpx 10rpx;
  font-size: 17rpx;
}

.passenger-detail-status {
  padding: 7rpx 11rpx;
  font-size: 18rpx;
}

.passenger-detail-metrics {
  gap: 7rpx;
  margin-top: 22rpx;
}

.passenger-detail-metric {
  gap: 8rpx;
  padding: 14rpx 10rpx;
}

.passenger-detail-metric__icon {
  width: 27rpx;
  height: 27rpx;
  flex-basis: 27rpx;
  border-width: 2rpx;
}

.passenger-detail-metric__value {
  font-size: 20rpx;
  line-height: 1.25;
}

.passenger-detail-metric__label {
  margin-top: 7rpx;
  font-size: 15rpx;
  line-height: 1.3;
}

.passenger-detail-card {
  padding: 20rpx 18rpx;
}

.passenger-flow-card {
  padding-bottom: 22rpx;
}

.passenger-drive-card {
  padding-bottom: 20rpx;
}

.trip-section-title {
  font-size: 24rpx;
}

.trip-section-head__title {
  gap: 16rpx;
}

.trip-section-icon {
  width: 34rpx;
  height: 34rpx;
  flex-basis: 34rpx;
  border-radius: 10rpx;
}

.trip-flow__dot {
  width: 30rpx;
  height: 30rpx;
  font-size: 17rpx;
}

.trip-flow__line {
  left: calc(50% + 15rpx);
  right: calc(-50% + 15rpx);
  top: 13rpx;
  height: 3rpx;
}

.trip-flow__label {
  margin-top: 14rpx;
  font-size: 18rpx;
  line-height: 1.35;
}

.trip-flow {
  margin-top: 18rpx;
}

.trip-phase-badge {
  padding: 6rpx 11rpx;
  font-size: 18rpx;
}

.passenger-drive-stage {
  margin-top: 18rpx;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
}

.passenger-drive-stage__title {
  font-size: 24rpx;
}

.passenger-drive-stage__subtitle {
  margin-top: 8rpx;
  font-size: 17rpx;
  line-height: 1.4;
}

.passenger-drive-stage__route {
  margin-top: 18rpx;
  font-size: 19rpx;
  line-height: 1.35;
}

.passenger-drive-stage__track {
  height: 8rpx;
  margin-top: 14rpx;
}

.passenger-drive-stage__hint {
  margin-top: 10rpx;
  font-size: 16rpx;
  line-height: 1.35;
}

.trip-actions {
  gap: 12rpx;
  margin-top: 20rpx;
}

.trip-actions .trip-action {
  padding: 24rpx 18rpx;
  font-size: 24rpx;
}

.trip-alert {
  margin-top: 12rpx;
  font-size: 18rpx;
  line-height: 1.45;
}


