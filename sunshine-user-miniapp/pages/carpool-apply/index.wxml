<view class="page-shell carpool-apply-shell safe-bottom">
  <view class="page-content apply-page page-enter" wx:if="{{loading}}">
    <view class="apply-state-card">
      <view class="apply-state-title">行程加载中...</view>
      <view class="apply-state-desc">正在同步顺风车行程信息</view>
    </view>
  </view>

  <view class="page-content apply-page page-enter" wx:elif="{{loadError}}">
    <view class="apply-state-card apply-state-card--error">
      <view class="apply-state-title">行程加载失败</view>
      <view class="apply-state-desc">{{loadError}}</view>
      <button class="primary-button apply-state-button" hover-class="button-hover" bindtap="loadTrip">重新加载</button>
    </view>
  </view>

  <block wx:elif="{{trip}}">
  <view class="page-content apply-page page-enter">
    <view class="apply-hero">
      <view class="apply-hero__title">{{trip.routeText}}</view>
      <view class="apply-hero__desc">{{trip.departTimeText}} · {{trip.priceText}} / 人</view>
      <view class="apply-hero__badge">申请搭乘</view>
    </view>

    <view class="apply-panel">
      <view class="panel-title">
        <view class="panel-title__icon panel-title__icon--people"></view>
        <view>同行人数</view>
      </view>
      <view class="panel-desc">请确认本次搭乘总人数，包含你自己。</view>

      <view class="counter-row">
        <button class="counter-button counter-button--minus" hover-class="button-hover" bindtap="decreaseCompanions" disabled="{{submitting}}"></button>
        <view class="counter-value">
          <view class="counter-value__number">{{companions}}</view>
          <view class="counter-value__label">人</view>
        </view>
        <button class="counter-button counter-button--plus" hover-class="button-hover" bindtap="increaseCompanions" disabled="{{submitting}}"></button>
      </view>

      <view class="apply-summary">
        <view class="apply-summary__label">预估分摊</view>
        <view class="apply-summary__value">{{trip.priceText}} × {{companions}} = {{totalPriceText}}</view>
      </view>
    </view>

    <view class="apply-panel">
      <view class="panel-title">
        <view class="panel-title__icon panel-title__icon--note"></view>
        <view>备注说明</view>
      </view>
      <view class="panel-desc">可补充行李件数、是否携带儿童等信息，方便车主更快确认。</view>
      <textarea class="apply-textarea" placeholder="例如：1 个 20 寸行李箱，准点到上车点" maxlength="80" bindinput="updateNote"></textarea>
    </view>
  </view>

  <view class="floating-bar apply-floating-bar">
    <button class="primary-button apply-submit-button" hover-class="button-hover" bindtap="submitApply" loading="{{submitting}}" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交搭乘申请'}}
    </button>
  </view>
  </block>
</view>
