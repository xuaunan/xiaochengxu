.carpool-apply-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.24) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 32%, #f5f7fb 100%);
}

.apply-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 142rpx;
}

.apply-hero,
.apply-panel {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.apply-hero {
  position: relative;
  min-height: 168rpx;
  padding: 30rpx 160rpx 30rpx 30rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.apply-hero::after {
  content: "";
  position: absolute;
  right: 22rpx;
  bottom: 14rpx;
  width: 150rpx;
  height: 54rpx;
  border-radius: 70% 30% 0 0;
  border-top: 8rpx solid rgba(255, 255, 255, 0.9);
  background: linear-gradient(90deg, rgba(255, 181, 95, 0), rgba(255, 181, 95, 0.18));
  transform: skewX(-18deg);
}

.apply-hero__title {
  position: relative;
  z-index: 1;
  font-size: 38rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.32;
}

.apply-hero__desc {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #6f7787;
  line-height: 1.35;
}

.apply-hero__badge {
  position: absolute;
  right: 28rpx;
  top: 30rpx;
  z-index: 1;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 122, 0, 0.09);
  font-size: 24rpx;
  font-weight: 900;
}

.apply-panel {
  padding: 26rpx;
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.3;
}

.panel-title__icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: rgba(255, 122, 0, 0.1);
}

.panel-title__icon::before,
.panel-title__icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.panel-title__icon--people::before {
  left: 18rpx;
  top: 9rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.panel-title__icon--people::after {
  left: 11rpx;
  bottom: 9rpx;
  width: 28rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  border: 4rpx solid #ff7a00;
  border-top-width: 6rpx;
}

.panel-title__icon--note::before {
  left: 12rpx;
  top: 12rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 3rpx;
  border: 4rpx solid #ff7a00;
  transform: rotate(-45deg);
}

.panel-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6f7787;
  line-height: 1.55;
}

.counter-row {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr) 96rpx;
  align-items: center;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.counter-button {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  border: 0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(31, 41, 55, 0.08);
}

.counter-button::after {
  border: 0;
}

.counter-button::before,
.counter-button--plus::after {
  content: "";
  position: absolute;
  left: 29rpx;
  top: 45rpx;
  width: 38rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #ff6b00;
}

.counter-button--plus::after {
  transform: rotate(90deg);
}

.counter-value {
  min-width: 0;
  text-align: center;
}

.counter-value__number {
  font-size: 50rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #111827;
}

.counter-value__label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #7d8799;
}

.apply-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 122, 0, 0.08);
}

.apply-summary__label {
  color: #7d8799;
  font-size: 24rpx;
}

.apply-summary__value {
  min-width: 0;
  color: #ff6b00;
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.apply-textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  font-size: 28rpx;
  line-height: 1.6;
  color: #111827;
  box-sizing: border-box;
}

.apply-floating-bar {
  left: 28rpx;
  right: 28rpx;
}

.apply-submit-button {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 34rpx rgba(255, 107, 0, 0.22);
}
