.carpool-apply-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.apply-hero,
.apply-panel {
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.counter-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 24rpx;
}

.counter-button {
  width: 92rpx;
  min-width: 92rpx;
  height: 92rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 24rpx;
}

.counter-value {
  min-width: 120rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.apply-summary {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.apply-textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.06);
  font-size: 28rpx;
  line-height: 1.6;
}


