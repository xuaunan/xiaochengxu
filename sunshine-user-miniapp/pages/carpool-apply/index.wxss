.counter-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 24rpx;
}

.counter-button {
  width: 92rpx;
  min-width: 92rpx;
  height: 92rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.counter-value {
  min-width: 120rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.apply-summary {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.apply-textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(247, 248, 252, 0.92);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  font-size: 28rpx;
  line-height: 1.6;
}


