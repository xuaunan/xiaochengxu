.carpool-apply-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.24) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 32%, #f5f7fb 100%);
}

.apply-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 16rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 126rpx;
}

.apply-hero,
.apply-panel {
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 12rpx 28rpx rgba(37, 43, 58, 0.045);
}

.apply-hero {
  position: relative;
  min-height: 136rpx;
  padding: 24rpx 144rpx 24rpx 26rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.apply-hero::after {
  content: "";
  position: absolute;
  right: 22rpx;
  bottom: 14rpx;
  width: 150rpx;
  height: 54rpx;
  border-radius: 70% 30% 0 0;
  border-top: 8rpx solid rgba(255, 255, 255, 0.9);
  background: linear-gradient(90deg, rgba(255, 181, 95, 0), rgba(255, 181, 95, 0.18));
  transform: skewX(-18deg);
}

.apply-hero__title {
  position: relative;
  z-index: 1;
  font-size: 31rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.32;
}

.apply-hero__desc {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f7787;
  line-height: 1.35;
}

.apply-hero__badge {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 122, 0, 0.09);
  font-size: 21rpx;
  font-weight: 550;
}

.apply-panel {
  padding: 22rpx;
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 18rpx;
  font-size: 27rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.3;
}

.panel-title__icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 122, 0, 0.1);
}

.panel-title__icon::before,
.panel-title__icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.panel-title__icon--people::before {
  left: 50%;
  top: 9rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff7a00;
  transform: translateX(-50%);
}

.panel-title__icon--people::after {
  left: 50%;
  bottom: 9rpx;
  width: 27rpx;
  height: 16rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  border: 3rpx solid #ff7a00;
  transform: translateX(-50%);
}

.panel-title__icon--note::before {
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  border-radius: 3rpx;
  border: 3rpx solid #ff7a00;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.panel-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6f7787;
  line-height: 1.55;
}

.counter-row {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) 76rpx;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.counter-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(31, 41, 55, 0.08);
}

.counter-button::after {
  border: 0;
}

.counter-button::before,
.counter-button--plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #ff6b00;
  transform: translate(-50%, -50%);
}

.counter-button--plus::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.counter-value {
  min-width: 0;
  text-align: center;
}

.counter-value__number {
  font-size: 38rpx;
  line-height: 1.1;
  font-weight: 550;
  color: #111827;
}

.counter-value__label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #7d8799;
}

.apply-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 122, 0, 0.08);
}

.apply-summary__label {
  color: #7d8799;
  font-size: 21rpx;
}

.apply-summary__value {
  min-width: 0;
  color: #ff6b00;
  font-size: 23rpx;
  font-weight: 550;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.apply-textarea {
  width: 100%;
  min-height: 170rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  border: 1rpx solid rgba(31, 36, 50, 0.08);
  font-size: 24rpx;
  line-height: 1.5;
  color: #111827;
  box-sizing: border-box;
}

.apply-floating-bar {
  left: 24rpx;
  right: 24rpx;
}

.apply-submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  padding: 0;
  line-height: 1.2;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 550;
  box-shadow: 0 12rpx 26rpx rgba(255, 107, 0, 0.18);
  box-sizing: border-box;
}
