.international-list-hero,
.intl-order-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.07);
}

.international-list-hero {
  background:
    linear-gradient(135deg, rgba(29, 78, 137, 0.1), rgba(255, 122, 0, 0.08)),
    #ffffff;
}

.intl-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.intl-route-badge,
.intl-sync-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 40rpx;
}

.intl-route-badge {
  color: #ffffff;
  background: #1d4e89;
}

.intl-sync-tag {
  color: #125f4c;
  background: rgba(31, 139, 113, 0.1);
}

.intl-card-title-wrap {
  min-width: 0;
}

.intl-card-title {
  max-width: 440rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2432;
  line-height: 1.25;
}

.intl-card-en {
  margin-top: 6rpx;
  color: #8a94a8;
  font-size: 21rpx;
  line-height: 1.25;
}

.intl-card-route {
  margin-top: 16rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.intl-info-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.intl-info-grid > view {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
}

.intl-info-grid text {
  color: #8a94a8;
  font-size: 20rpx;
}

.intl-info-grid view view {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1f2432;
  font-size: 23rpx;
  font-weight: 600;
}

.intl-detail-grid {
  display: grid;
  gap: 10rpx;
  margin-top: 18rpx;
}

.intl-detail-grid view,
.intl-doc-text {
  min-width: 0;
  padding: 13rpx 16rpx;
  border-radius: 16rpx;
  color: #344054;
  background: #f7f9fd;
  font-size: 22rpx;
  line-height: 1.45;
}

.intl-doc-text {
  margin-top: 10rpx;
  color: #1d4e89;
  background: #eef5fb;
}

.intl-service-text {
  margin-top: 18rpx;
  color: #125f4c;
  font-size: 23rpx;
  line-height: 1.55;
}


