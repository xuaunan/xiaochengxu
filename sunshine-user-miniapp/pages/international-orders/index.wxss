.intl-orders-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.international-list-hero,
.intl-order-card {
  padding: 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.international-list-hero {
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
}

.intl-card-title {
  max-width: 440rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2432;
}

.intl-card-route {
  margin-top: 16rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.intl-info-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.intl-info-grid > view {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 20rpx;
  background: #f7f8fc;
}

.intl-info-grid text {
  color: #8a94a8;
  font-size: 20rpx;
}

.intl-info-grid view view {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1f2432;
  font-size: 23rpx;
  font-weight: 700;
}

.intl-service-text {
  margin-top: 18rpx;
  color: #166534;
  font-size: 23rpx;
  line-height: 1.55;
}


