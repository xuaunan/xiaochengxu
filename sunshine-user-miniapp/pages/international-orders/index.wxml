<view class="page-shell intl-orders-shell safe-bottom">
  <view class="page-content list-gap">
    <view class="international-list-hero">
      <view class="section-title">我的国际行程</view>
      <view class="section-subtitle">国际出行订单和预约信息</view>
    </view>
    <block wx:if="{{list.length}}">
      <view class="intl-order-card" wx:for="{{list}}" wx:key="id">
        <view class="row-between">
          <view class="intl-card-title">{{item.internationalMeta.productName || '国际出行'}}</view>
          <view class="status-tag {{item.statusTag}}">{{item.statusText}}</view>
        </view>
        <view class="intl-card-route">{{item.startName}} → {{item.endName}}</view>
        <view class="intl-info-grid">
          <view>
            <text>预约</text>
            <view>{{item.internationalMeta.appointmentTime || item.createdAtText}}</view>
          </view>
          <view>
            <text>联系人</text>
            <view>{{item.internationalMeta.contactName || '待同步'}}</view>
          </view>
          <view>
            <text>费用</text>
            <view>{{item.amountText}}</view>
          </view>
        </view>
        <view class="intl-service-text">{{item.internationalMeta.serviceItemsText}}</view>
      </view>
    </block>
    <view class="panel-card empty-panel" wx:else>
      <sun-empty title="还没有国际出行订单" description="先去国际出行页面选线路下单，订单会自动同步到这里。"></sun-empty>
      <button class="primary-button" hover-class="button-hover" bindtap="goInternational">去下国际出行订单</button>
    </view>
  </view>
</view>
