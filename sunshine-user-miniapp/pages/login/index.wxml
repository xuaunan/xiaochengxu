<view class="page-shell safe-bottom">
  <view class="page-content">
    <view class="login-hero">
      <view class="pill">安全出行 · 原生小程序演示版</view>
      <view class="login-title">欢迎回到阳光出行</view>
      <view class="login-desc">当前已切换为真实账号体系，乘客端登录、注册、鉴权和实名认证都已与后端完整联调。</view>
    </view>

    <view class="hero-card">
      <view class="chip-row login-switch">
        <view class="chip {{mode === 'login' ? 'chip-active' : ''}}" data-mode="login" bindtap="chooseMode">账号登录</view>
        <view class="chip {{mode === 'register' ? 'chip-active' : ''}}" data-mode="register" bindtap="chooseMode">注册新账号</view>
      </view>
      <view class="login-card__title">{{mode === 'login' ? '乘客登录' : '乘客注册'}}</view>
      <view class="login-field">
        <text class="login-field__label">手机号</text>
        <input class="login-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="updatePhone" />
      </view>
      <view class="login-field">
        <text class="login-field__label">密码</text>
        <input class="login-input" password maxlength="20" placeholder="请输入密码，默认 123456" value="{{password}}" bindinput="updatePassword" />
      </view>
      <view class="login-field" wx:if="{{mode === 'register'}}">
        <text class="login-field__label">昵称</text>
        <input class="login-input" maxlength="20" placeholder="请输入昵称" value="{{nickname}}" bindinput="updateNickname" />
      </view>
      <button class="primary-button login-button" hover-class="button-hover" bindtap="submit">{{mode === 'login' ? '登录并进入首页' : '注册并自动登录'}}</button>
    </view>

    <view class="hero-card">
      <view class="login-card__title">演示账号</view>
      <view class="login-tip">{{loginTip}}</view>
      <button class="ghost-button login-button" hover-class="button-hover" bindtap="fillDemoAccount">填入默认账号</button>
    </view>

    <view class="agreement" bindtap="toggleAgree">
      <view class="agreement-check {{agreed ? 'agreement-check--active' : ''}}">{{agreed ? '√' : ''}}</view>
      <view class="agreement-text">我已阅读并同意《用户服务协议》《隐私政策》，且知晓本项目为课程大作业演示版本。</view>
    </view>
  </view>
</view>
