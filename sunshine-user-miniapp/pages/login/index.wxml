<view class="login-page page-enter">
  <view class="login-nav">
    <view class="nav-title">阳光出行</view>
  </view>

  <view class="login-hero">
    <image class="hero-image" src="/images/auth/passenger-login-hero.png" mode="aspectFill"></image>
    <view class="hero-shade"></view>
    <view class="safe-pill">
      <view class="safe-pill__icon"></view>
      <text>安全出行 · 便捷生活</text>
    </view>
    <view class="hero-copy">
      <view class="hero-title">欢迎回到阳光出行</view>
      <view class="hero-desc">登录后查看订单、钱包、优惠券和实名认证状态。</view>
    </view>
  </view>

  <view class="login-card">
    <view class="login-switch">
      <view class="switch-item {{mode === 'login' ? 'switch-item--active' : ''}}" data-mode="login" bindtap="chooseMode">
        <view class="switch-icon switch-icon--user"></view>
        <text>账号登录</text>
      </view>
      <view class="switch-item {{mode === 'register' ? 'switch-item--active' : ''}}" data-mode="register" bindtap="chooseMode">
        <view class="switch-icon switch-icon--plus"></view>
        <text>注册新账号</text>
      </view>
    </view>

    <view class="form-title-row">
      <view class="form-title">{{mode === 'login' ? '乘客账号' : '乘客注册'}}</view>
      <view class="form-subtitle">{{mode === 'login' ? '手机号登录更便捷' : '创建账号后自动登录'}}</view>
    </view>

    <view class="login-field">
      <view class="field-label">手机号</view>
      <view class="input-wrap">
        <view class="input-icon">
          <image class="input-icon-img" src="/images/profile-menu-icons/account-service.png" mode="aspectFit"></image>
        </view>
        <input class="login-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="updatePhone" />
        <view class="input-clear tap-scale" bindtap="clearPhone" wx:if="{{phone}}">×</view>
      </view>
    </view>

    <view class="login-field">
      <view class="field-label">密码</view>
      <view class="input-wrap">
        <view class="input-icon">
          <image class="input-icon-img" src="/images/profile-menu-icons/shield.png" mode="aspectFit"></image>
        </view>
        <input class="login-input" password="{{!showPassword}}" maxlength="20" placeholder="请输入密码，默认 123456" value="{{password}}" bindinput="updatePassword" />
        <view class="input-eye {{showPassword ? 'input-eye--open' : ''}} tap-scale" bindtap="togglePasswordVisible">
          <image class="input-action-img" src="/images/profile-menu-icons/preview.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <view class="login-field" wx:if="{{mode === 'register'}}">
      <view class="field-label">昵称</view>
      <view class="input-wrap">
        <view class="input-icon">
          <image class="input-icon-img" src="/images/profile-menu-icons/user.png" mode="aspectFit"></image>
        </view>
        <input class="login-input" maxlength="20" placeholder="请输入昵称" value="{{nickname}}" bindinput="updateNickname" />
      </view>
    </view>

    <view class="form-options">
      <view class="remember tap-scale" bindtap="toggleAgree">
        <view class="remember-check {{agreed ? 'remember-check--active' : ''}}">✓</view>
        <text>记住账号</text>
      </view>
      <view class="forgot tap-scale" bindtap="handleForgotPassword">忘记密码?</view>
    </view>

    <button class="login-button" hover-class="button-hover" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">
      {{mode === 'login' ? '登录并进入首页' : '注册并自动登录'}}
    </button>
  </view>

  <view class="demo-card">
    <view class="demo-icon">
      <image class="demo-icon-img" src="/images/profile-menu-icons/account-service.png" mode="aspectFit"></image>
    </view>
    <view class="demo-copy">
      <view class="demo-title">快速账号登录</view>
      <view class="demo-desc">{{loginTip}}</view>
    </view>
    <view class="demo-button tap-scale" bindtap="fillDemoAccount" hover-class="button-hover" hover-stay-time="60">一键登录</view>
  </view>

  <view class="agreement" bindtap="toggleAgree">
    <view class="agreement-check {{agreed ? 'agreement-check--active' : ''}}">✓</view>
    <view class="agreement-text">我已阅读并同意 <text>《用户服务协议》</text> 和 <text>《隐私政策》</text></view>
  </view>
</view>
