page {
  background: #f5f7fb;
}

.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(env(safe-area-inset-bottom) + 28rpx);
  background:
    radial-gradient(circle at 85% 4%, rgba(255, 185, 98, 0.22), transparent 26%),
    linear-gradient(180deg, #fff4e5 0%, #f8fafc 42%, #f2f5fa 100%);
}

.login-nav {
  position: relative;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.nav-home {
  position: absolute;
  left: 0;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(35, 42, 56, 0.08);
  box-shadow: 0 10rpx 24rpx rgba(29, 38, 55, 0.08);
}

.nav-home__roof {
  position: absolute;
  left: 50%;
  top: 15rpx;
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #172033;
  border-top: 4rpx solid #172033;
  border-radius: 5rpx;
  transform: translateX(-50%) rotate(45deg);
}

.nav-home__body {
  position: absolute;
  left: 50%;
  top: 29rpx;
  width: 25rpx;
  height: 19rpx;
  border: 4rpx solid #172033;
  border-top: none;
  border-radius: 4rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.nav-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 500;
}

.login-hero {
  position: relative;
  height: 330rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #fff1df;
  box-shadow: 0 16rpx 38rpx rgba(199, 116, 35, 0.12);
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(255, 249, 239, 0.96) 0%, rgba(255, 249, 239, 0.72) 39%, rgba(255, 249, 239, 0.08) 72%);
}

.safe-pill,
.hero-copy {
  position: relative;
  z-index: 2;
  margin-left: 26rpx;
}

.safe-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 42rpx;
  margin-top: 28rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #ff7300;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(255, 122, 0, 0.22);
  font-size: 21rpx;
  font-weight: 500;
}

.safe-pill__icon {
  position: relative;
  width: 26rpx;
  height: 28rpx;
  border-radius: 10rpx 10rpx 14rpx 14rpx;
  background: linear-gradient(135deg, #ff9d32, #ff7300);
}

.safe-pill__icon::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 6rpx;
  width: 7rpx;
  height: 14rpx;
  border-right: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(42deg);
}

.hero-copy {
  width: 386rpx;
  margin-top: 24rpx;
}

.hero-title {
  color: #172033;
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.12;
}

.hero-desc {
  margin-top: 12rpx;
  color: #687386;
  font-size: 22rpx;
  line-height: 1.48;
}

.login-card,
.demo-card {
  position: relative;
  z-index: 2;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 18rpx 42rpx rgba(23, 32, 51, 0.075);
}

.login-card {
  margin-top: 20rpx;
  padding: 24rpx 26rpx 28rpx;
}

.login-switch {
  height: 62rpx;
  padding: 5rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-radius: 999rpx;
  background: #f1f4f8;
  box-sizing: border-box;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 500;
}

.switch-item--active {
  color: #ff7300;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 0, 0.1);
}

.switch-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.switch-icon--user::before,
.switch-icon--user::after {
  content: "";
  position: absolute;
  left: 50%;
  background: currentColor;
  transform: translateX(-50%);
}

.switch-icon--user::before {
  top: 4rpx;
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
}

.switch-icon--user::after {
  bottom: 3rpx;
  width: 21rpx;
  height: 11rpx;
  border-radius: 13rpx 13rpx 5rpx 5rpx;
}

.switch-icon--plus::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.switch-icon--plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 13rpx;
  height: 13rpx;
  background:
    linear-gradient(currentColor, currentColor) center / 13rpx 3rpx no-repeat,
    linear-gradient(currentColor, currentColor) center / 3rpx 13rpx no-repeat;
  transform: translate(-50%, -50%);
}

.form-title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 24rpx;
}

.form-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 600;
}

.form-subtitle {
  color: #98a2b3;
  font-size: 21rpx;
}

.login-field {
  margin-top: 18rpx;
}

.field-label {
  color: #243044;
  font-size: 23rpx;
  font-weight: 500;
}

.input-wrap {
  position: relative;
  min-height: 74rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(31, 36, 50, 0.07);
  box-sizing: border-box;
}

.input-icon {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  color: #ff7a00;
}

.input-icon--phone::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 21rpx;
  height: 36rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.input-icon--phone::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 16rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translateX(-50%);
}

.input-icon--lock::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 36rpx;
  width: 28rpx;
  height: 24rpx;
  border-radius: 7rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.input-icon--lock::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 19rpx;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 12rpx 12rpx 2rpx 2rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.input-icon--user::before,
.input-icon--user::after {
  content: "";
  position: absolute;
  left: 50%;
  background: currentColor;
  transform: translateX(-50%);
}

.input-icon--user::before {
  top: 21rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.input-icon--user::after {
  bottom: 18rpx;
  width: 34rpx;
  height: 20rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
}

.login-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx 0 0;
  color: #172033;
  background: transparent;
  border: none;
  font-size: 24rpx;
  line-height: 72rpx;
}

.input-clear {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #b8c0cc;
  font-size: 24rpx;
  line-height: 1;
}

.input-eye {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  color: #8b95a6;
}

.input-eye::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.input-eye::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.input-eye--open::after {
  display: none;
}

.form-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 20rpx;
}

.remember {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #687386;
  font-size: 22rpx;
}

.remember-check,
.agreement-check {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #fff;
  background: #ff7a00;
  font-size: 19rpx;
  font-weight: 600;
}

.remember-check:not(.remember-check--active),
.agreement-check:not(.agreement-check--active) {
  color: transparent;
  background: #e6ebf2;
}

.forgot {
  color: #687386;
  font-size: 22rpx;
}

.login-button {
  width: 372rpx;
  min-height: 76rpx;
  margin: 26rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff7300 0%, #ff952e 100%);
  box-shadow: 0 16rpx 30rpx rgba(255, 111, 0, 0.24);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.2;
}

.login-button::after {
  border: none;
}

.login-button[disabled] {
  opacity: 0.58;
  box-shadow: none;
}

.demo-card {
  min-height: 98rpx;
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.demo-icon {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  color: #ff7a00;
  background: #fff1df;
}

.demo-icon::before,
.demo-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  background: currentColor;
  transform: translateX(-50%);
}

.demo-icon::before {
  top: 16rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.demo-icon::after {
  bottom: 14rpx;
  width: 34rpx;
  height: 20rpx;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
}

.demo-copy {
  flex: 1;
  min-width: 0;
}

.demo-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 600;
}

.demo-desc {
  margin-top: 7rpx;
  color: #747d8f;
  font-size: 20rpx;
  line-height: 1.4;
}

.demo-button {
  width: 128rpx;
  height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #ff7300;
  background: #fff8f0;
  border: 2rpx solid rgba(255, 122, 0, 0.38);
  font-size: 22rpx;
  font-weight: 500;
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
}

.agreement-text {
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.5;
}

.agreement-text text {
  color: #ff7300;
}

.button-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}

.login-card {
  overflow: hidden;
  padding: 24rpx 26rpx 30rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.92)),
    #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  box-shadow: 0 18rpx 44rpx rgba(25, 35, 55, 0.08);
}

.login-card::before {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  top: 0;
  height: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 122, 0, 0.48), transparent);
}

.login-switch {
  height: 66rpx;
  padding: 6rpx;
  background: linear-gradient(180deg, #f4f7fb, #edf1f7);
  border: 1rpx solid rgba(31, 36, 50, 0.04);
}

.switch-item {
  gap: 8rpx;
  color: #7b8494;
  font-size: 22rpx;
}

.switch-item--active {
  color: #ff7300;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 251, 247, 0.96));
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 0, 0.12);
}

.form-title-row {
  align-items: center;
  margin-top: 24rpx;
}

.form-title {
  position: relative;
  padding-left: 16rpx;
  font-size: 29rpx;
}

.form-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 26rpx;
  border-radius: 999rpx;
  background: #ff7300;
  transform: translateY(-50%);
}

.form-subtitle {
  color: #9aa3b2;
}

.input-wrap {
  min-height: 78rpx;
  margin-top: 10rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(180deg, #ffffff, #f9fbfe);
  border: 1rpx solid rgba(31, 36, 50, 0.07);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.7), 0 8rpx 20rpx rgba(23, 32, 51, 0.035);
}

.input-icon {
  width: 58rpx;
  height: 58rpx;
  margin-left: 10rpx;
  margin-right: 6rpx;
  border-radius: 18rpx;
  color: #ff7300;
  background: linear-gradient(180deg, #fff6ed, #ffe6cc);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
}

.input-icon--phone::before {
  width: 18rpx;
  height: 32rpx;
}

.input-icon--phone::after {
  bottom: 14rpx;
}

.input-icon--lock::before {
  top: 32rpx;
  width: 26rpx;
  height: 22rpx;
}

.input-icon--lock::after {
  top: 16rpx;
}

.login-input {
  height: 76rpx;
  min-height: 76rpx;
  font-size: 24rpx;
  line-height: 76rpx;
}

.form-options {
  margin-top: 18rpx;
}

.remember-check,
.agreement-check {
  border-radius: 9rpx;
  box-shadow: 0 6rpx 12rpx rgba(255, 122, 0, 0.18);
}

.login-button {
  width: 344rpx;
  min-height: 72rpx;
  margin-top: 24rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.14), transparent 42%),
    linear-gradient(135deg, #ff7a00 0%, #ff9a2f 100%);
  box-shadow: 0 16rpx 30rpx rgba(255, 111, 0, 0.26);
  font-size: 26rpx;
  font-weight: 650;
}

.demo-card {
  min-height: 92rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 26rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 250, 244, 0.94));
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.07);
}

.demo-icon {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  background: transparent;
  border-radius: 20rpx;
}

.demo-icon::before,
.demo-icon::after {
  display: none;
}

.demo-icon-img {
  display: block;
  width: 100%;
  height: 100%;
}

.demo-title {
  font-size: 25rpx;
  font-weight: 650;
}

.demo-desc {
  color: #7b8494;
  font-size: 19rpx;
}

.demo-button {
  width: 122rpx;
  height: 50rpx;
  border-radius: 18rpx;
  background: #fff7ef;
  border: 1rpx solid rgba(255, 122, 0, 0.34);
  font-size: 21rpx;
  font-weight: 600;
}

.agreement {
  margin-top: 14rpx;
  padding: 0 14rpx;
}

.login-card .input-wrap {
  min-height: 76rpx;
  padding: 0 10rpx 0 14rpx;
  gap: 10rpx;
  border-radius: 22rpx;
  background: #fbfcff;
  border: 1rpx solid rgba(34, 45, 66, 0.07);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.login-card .input-icon {
  width: 44rpx;
  height: 44rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.login-card .input-icon::before,
.login-card .input-icon::after,
.login-card .input-icon--phone::before,
.login-card .input-icon--phone::after,
.login-card .input-icon--lock::before,
.login-card .input-icon--lock::after,
.login-card .input-icon--user::before,
.login-card .input-icon--user::after {
  display: none;
}

.input-icon-img {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.login-card .login-input {
  height: 74rpx;
  min-height: 74rpx;
  padding: 0;
  line-height: 74rpx;
}

.login-card .input-clear,
.login-card .input-eye {
  width: 44rpx;
  height: 44rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  color: #98a2b3;
  background: rgba(241, 245, 249, 0.9);
  font-size: 24rpx;
  font-weight: 500;
}

.login-card .input-eye::before,
.login-card .input-eye::after {
  display: none;
}

.input-action-img {
  display: block;
  width: 34rpx;
  height: 34rpx;
  opacity: 0.76;
}
