page {
  background: #f7f8fc;
}

.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 80rpx 28rpx calc(env(safe-area-inset-bottom) + 30rpx);
  background:
    radial-gradient(circle at 84% 14%, rgba(255, 182, 96, 0.22), transparent 24%),
    linear-gradient(180deg, #fff7ed 0%, #f8fafc 44%, #f5f7fb 100%);
}

.login-nav {
  position: absolute;
  left: 38rpx;
  right: 38rpx;
  top: 32rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-home {
  position: absolute;
  left: 0;
  top: 0;
  width: 66rpx;
  height: 66rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(31, 36, 50, 0.12);
  box-shadow: 0 10rpx 22rpx rgba(24, 34, 56, 0.06);
}

.nav-home__roof {
  position: absolute;
  left: 50%;
  top: 17rpx;
  width: 27rpx;
  height: 27rpx;
  border-left: 4rpx solid #101418;
  border-top: 4rpx solid #101418;
  border-radius: 4rpx;
  transform: translateX(-50%) rotate(45deg);
}

.nav-home__body {
  position: absolute;
  left: 50%;
  top: 31rpx;
  width: 28rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 4rpx solid #101418;
  border-top: none;
  border-radius: 3rpx;
  transform: translateX(-50%);
}

.nav-title {
  color: #17191f;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.login-hero {
  position: relative;
  min-height: 276rpx;
  padding-top: 66rpx;
}

.safe-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.64);
  border: 2rpx solid rgba(255, 122, 0, 0.38);
  font-size: 21rpx;
  font-weight: 500;
}

.safe-pill__icon {
  position: relative;
  width: 28rpx;
  height: 30rpx;
  border-radius: 10rpx 10rpx 15rpx 15rpx;
  background: #ff7a00;
}

.safe-pill__icon::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 6rpx;
  width: 7rpx;
  height: 14rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(42deg);
}

.hero-copy {
  position: relative;
  z-index: 2;
  margin-top: 32rpx;
}

.hero-title {
  max-width: 530rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 550;
  line-height: 1.18;
  letter-spacing: 0;
}

.hero-desc {
  max-width: 640rpx;
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 21rpx;
  line-height: 1.42;
}

.hero-visual {
  position: absolute;
  right: -8rpx;
  top: 78rpx;
  width: 270rpx;
  height: 216rpx;
}

.hero-city {
  position: absolute;
  right: -12rpx;
  bottom: 18rpx;
  width: 230rpx;
  height: 132rpx;
  opacity: 0.18;
}

.hero-building {
  position: absolute;
  bottom: 0;
  width: 38rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.hero-building--1 {
  left: 18rpx;
  height: 74rpx;
}

.hero-building--2 {
  left: 82rpx;
  height: 116rpx;
}

.hero-building--3 {
  right: 26rpx;
  height: 88rpx;
}

.hero-shield {
  position: absolute;
  right: 76rpx;
  top: 0;
  width: 96rpx;
  height: 108rpx;
  border-radius: 34rpx 34rpx 48rpx 48rpx;
  background: linear-gradient(145deg, #ffd6ad 0%, #ff9b3d 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.16);
  z-index: 2;
}

.hero-shield::after {
  content: "";
  position: absolute;
  left: 34rpx;
  top: 24rpx;
  width: 26rpx;
  height: 48rpx;
  border-right: 12rpx solid #ffffff;
  border-bottom: 12rpx solid #ffffff;
  transform: rotate(42deg);
  border-radius: 5rpx;
}

.hero-car {
  position: absolute;
  right: 28rpx;
  bottom: 18rpx;
  width: 118rpx;
  height: 66rpx;
  z-index: 3;
  filter: drop-shadow(0 12rpx 16rpx rgba(151, 78, 15, 0.16));
}

.hero-car__body {
  position: absolute;
  left: 4rpx;
  bottom: 13rpx;
  width: 108rpx;
  height: 38rpx;
  border-radius: 18rpx 22rpx 12rpx 12rpx;
  background: linear-gradient(180deg, #fff8ef 0%, #ff9a2d 35%, #ff7a00 100%);
  border: 2rpx solid rgba(124, 70, 19, 0.14);
}

.hero-car__top {
  position: absolute;
  left: 43rpx;
  top: 8rpx;
  width: 40rpx;
  height: 28rpx;
  border-radius: 16rpx 16rpx 4rpx 4rpx;
  background: #fff5e7;
  border: 2rpx solid rgba(124, 70, 19, 0.12);
}

.hero-car__wheel {
  position: absolute;
  bottom: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2e3035;
  box-shadow: inset 0 0 0 6rpx #ffffff;
}

.hero-car__wheel--left {
  left: 24rpx;
}

.hero-car__wheel--right {
  right: 22rpx;
}

.login-card,
.demo-card {
  position: relative;
  z-index: 3;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 36, 50, 0.04);
  box-shadow: 0 10rpx 28rpx rgba(24, 34, 56, 0.055);
}

.login-card {
  margin-top: 14rpx;
  padding: 22rpx 22rpx 24rpx;
}

.login-switch {
  width: 392rpx;
  height: 58rpx;
  padding: 6rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-radius: 999rpx;
  background: linear-gradient(90deg, #fff1df 0%, #f7f8fb 100%);
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  color: #6f7685;
  font-size: 22rpx;
  font-weight: 500;
}

.switch-item--active {
  color: #ff6f00;
  background: linear-gradient(135deg, #fff6ee 0%, #ffe8cf 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.08);
}

.switch-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.switch-icon--user::before,
.switch-icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.switch-icon--user::before {
  left: 50%;
  top: 4rpx;
  width: 11rpx;
  height: 11rpx;
  transform: translateX(-50%);
}

.switch-icon--user::after {
  left: 50%;
  bottom: 3rpx;
  width: 20rpx;
  height: 11rpx;
  border-radius: 13rpx 13rpx 5rpx 5rpx;
  transform: translateX(-50%);
}

.switch-icon--plus::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  transform: translate(-50%, -50%);
}

.switch-icon--plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 13rpx;
  height: 13rpx;
  transform: translate(-50%, -50%);
  background:
    linear-gradient(currentColor, currentColor) center / 13rpx 3rpx no-repeat,
    linear-gradient(currentColor, currentColor) center / 3rpx 13rpx no-repeat;
}

.form-title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 30rpx;
}

.form-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 600;
}

.form-subtitle {
  color: #9aa2b4;
  font-size: 21rpx;
}

.login-field {
  margin-top: 20rpx;
}

.field-label {
  color: #172033;
  font-size: 23rpx;
  font-weight: 500;
}

.input-wrap {
  position: relative;
  min-height: 68rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  border-radius: 15rpx;
  background: #ffffff;
  border: 2rpx solid rgba(31, 36, 50, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
}

.input-icon {
  position: relative;
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  color: #ff6f00;
  box-sizing: border-box;
}

.input-icon--phone::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 21rpx;
  height: 36rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 7rpx;
  transform: translate(-50%, -50%);
}

.input-icon--phone::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 16rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translateX(-50%);
}

.input-icon--lock::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 36rpx;
  width: 28rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.input-icon--lock::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 19rpx;
  width: 20rpx;
  height: 20rpx;
  box-sizing: border-box;
  border-radius: 11rpx 11rpx 2rpx 2rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  transform: translateX(-50%);
}

.input-icon--user::before,
.input-icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.input-icon--user::before {
  left: 50%;
  top: 21rpx;
  width: 18rpx;
  height: 18rpx;
  transform: translateX(-50%);
}

.input-icon--user::after {
  left: 50%;
  bottom: 18rpx;
  width: 34rpx;
  height: 20rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
  transform: translateX(-50%);
}

.login-input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  min-height: 66rpx;
  padding: 0 20rpx 0 0;
  color: #172033;
  background: transparent;
  border: none;
  font-size: 25rpx;
  line-height: 66rpx;
}

.input-clear {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #c9ced7;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
}

.input-eye {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  color: #9aa2ad;
  box-sizing: border-box;
}

.input-eye::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.input-eye::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.input-eye--open::after {
  display: none;
}

.form-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 22rpx;
}

.remember {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #6f7685;
  font-size: 22rpx;
}

.remember-check,
.agreement-check {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #ffffff;
  background: #ff7a00;
  font-size: 19rpx;
  font-weight: 600;
}

.remember-check:not(.remember-check--active),
.agreement-check:not(.agreement-check--active) {
  color: transparent;
  background: #e9edf5;
}

.forgot {
  color: #6f7685;
  font-size: 22rpx;
}

.login-button {
  width: 100%;
  min-height: 76rpx;
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 14rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7300 0%, #ff8f22 100%);
  box-shadow: 0 16rpx 28rpx rgba(255, 111, 0, 0.24);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.2;
}

.login-button::after {
  border: none;
}

.login-button[disabled] {
  opacity: 0.58;
  box-shadow: none;
}

.demo-card {
  min-height: 104rpx;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.demo-icon {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border-radius: 16rpx;
  color: #ff6f00;
  background: #fff1df;
}

.demo-icon::before,
.demo-icon::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.demo-icon::before {
  left: 50%;
  top: 16rpx;
  width: 18rpx;
  height: 18rpx;
  transform: translateX(-50%);
}

.demo-icon::after {
  left: 50%;
  bottom: 14rpx;
  width: 34rpx;
  height: 20rpx;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
  transform: translateX(-50%);
}

.demo-copy {
  flex: 1;
  min-width: 0;
}

.demo-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 600;
}

.demo-desc {
  margin-top: 7rpx;
  color: #747d8f;
  font-size: 20rpx;
  line-height: 1.4;
}

.demo-button {
  width: 128rpx;
  height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff8f0;
  border: 2rpx solid rgba(255, 122, 0, 0.44);
  font-size: 22rpx;
  font-weight: 500;
}

.agreement {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 0 12rpx;
}

.agreement-text {
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.5;
}

.agreement-text text {
  color: #ff6f00;
}

.button-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
