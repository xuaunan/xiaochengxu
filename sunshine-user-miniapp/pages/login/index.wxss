page {
  background: #f7f8fc;
}

.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 96rpx 38rpx calc(env(safe-area-inset-bottom) + 40rpx);
  background:
    radial-gradient(circle at 84% 14%, rgba(255, 182, 96, 0.22), transparent 24%),
    linear-gradient(180deg, #fff7ed 0%, #f8fafc 44%, #f5f7fb 100%);
}

.login-nav {
  position: absolute;
  left: 38rpx;
  right: 38rpx;
  top: 32rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-home {
  position: absolute;
  left: 0;
  top: 0;
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(31, 36, 50, 0.12);
  box-shadow: 0 10rpx 22rpx rgba(24, 34, 56, 0.06);
}

.nav-home__roof {
  position: absolute;
  left: 17rpx;
  top: 14rpx;
  width: 30rpx;
  height: 30rpx;
  border-left: 7rpx solid #101418;
  border-top: 7rpx solid #101418;
  transform: rotate(45deg);
  border-radius: 4rpx;
}

.nav-home__body {
  position: absolute;
  left: 19rpx;
  top: 31rpx;
  width: 28rpx;
  height: 22rpx;
  border: 7rpx solid #101418;
  border-top: none;
  border-radius: 3rpx;
}

.nav-title {
  color: #17191f;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.login-hero {
  position: relative;
  min-height: 306rpx;
  padding-top: 76rpx;
}

.safe-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #ff6f00;
  background: rgba(255, 255, 255, 0.64);
  border: 2rpx solid rgba(255, 122, 0, 0.38);
  font-size: 24rpx;
  font-weight: 800;
}

.safe-pill__icon {
  position: relative;
  width: 28rpx;
  height: 30rpx;
  border-radius: 10rpx 10rpx 15rpx 15rpx;
  background: #ff7a00;
}

.safe-pill__icon::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 6rpx;
  width: 7rpx;
  height: 14rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(42deg);
}

.hero-copy {
  position: relative;
  z-index: 2;
  margin-top: 54rpx;
}

.hero-title {
  max-width: 530rpx;
  color: #111827;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
}

.hero-desc {
  max-width: 640rpx;
  margin-top: 20rpx;
  color: #6b7280;
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-visual {
  position: absolute;
  right: -8rpx;
  top: 78rpx;
  width: 270rpx;
  height: 216rpx;
}

.hero-city {
  position: absolute;
  right: -12rpx;
  bottom: 18rpx;
  width: 230rpx;
  height: 132rpx;
  opacity: 0.18;
}

.hero-building {
  position: absolute;
  bottom: 0;
  width: 38rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #ff9b3d;
}

.hero-building--1 {
  left: 18rpx;
  height: 74rpx;
}

.hero-building--2 {
  left: 82rpx;
  height: 116rpx;
}

.hero-building--3 {
  right: 26rpx;
  height: 88rpx;
}

.hero-shield {
  position: absolute;
  right: 76rpx;
  top: 0;
  width: 96rpx;
  height: 108rpx;
  border-radius: 34rpx 34rpx 48rpx 48rpx;
  background: linear-gradient(145deg, #ffd6ad 0%, #ff9b3d 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.16);
  z-index: 2;
}

.hero-shield::after {
  content: "";
  position: absolute;
  left: 34rpx;
  top: 24rpx;
  width: 26rpx;
  height: 48rpx;
  border-right: 12rpx solid #ffffff;
  border-bottom: 12rpx solid #ffffff;
  transform: rotate(42deg);
  border-radius: 5rpx;
}

.hero-car {
  position: absolute;
  right: 28rpx;
  bottom: 18rpx;
  width: 118rpx;
  height: 66rpx;
  z-index: 3;
  filter: drop-shadow(0 12rpx 16rpx rgba(151, 78, 15, 0.16));
}

.hero-car__body {
  position: absolute;
  left: 4rpx;
  bottom: 13rpx;
  width: 108rpx;
  height: 38rpx;
  border-radius: 18rpx 22rpx 12rpx 12rpx;
  background: linear-gradient(180deg, #fff8ef 0%, #ff9a2d 35%, #ff7a00 100%);
  border: 2rpx solid rgba(124, 70, 19, 0.14);
}

.hero-car__top {
  position: absolute;
  left: 43rpx;
  top: 8rpx;
  width: 40rpx;
  height: 28rpx;
  border-radius: 16rpx 16rpx 4rpx 4rpx;
  background: #fff5e7;
  border: 2rpx solid rgba(124, 70, 19, 0.12);
}

.hero-car__wheel {
  position: absolute;
  bottom: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2e3035;
  box-shadow: inset 0 0 0 6rpx #ffffff;
}

.hero-car__wheel--left {
  left: 24rpx;
}

.hero-car__wheel--right {
  right: 22rpx;
}

.login-card,
.demo-card {
  position: relative;
  z-index: 3;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 36, 50, 0.04);
  box-shadow: 0 18rpx 46rpx rgba(24, 34, 56, 0.07);
}

.login-card {
  margin-top: 18rpx;
  padding: 30rpx 28rpx 30rpx;
}

.login-switch {
  width: 448rpx;
  height: 72rpx;
  padding: 6rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-radius: 999rpx;
  background: linear-gradient(90deg, #fff1df 0%, #f7f8fb 100%);
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  color: #6f7685;
  font-size: 25rpx;
  font-weight: 800;
}

.switch-item--active {
  color: #ff6f00;
  background: linear-gradient(135deg, #fff6ee 0%, #ffe8cf 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.08);
}

.switch-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.switch-icon--user::before,
.switch-icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.switch-icon--user::before {
  left: 8rpx;
  top: 2rpx;
  width: 12rpx;
  height: 12rpx;
}

.switch-icon--user::after {
  left: 4rpx;
  bottom: 3rpx;
  width: 20rpx;
  height: 12rpx;
  border-radius: 13rpx 13rpx 5rpx 5rpx;
}

.switch-icon--plus::before {
  content: "";
  position: absolute;
  inset: 3rpx;
  border-radius: 50%;
  border: 4rpx solid currentColor;
}

.switch-icon--plus::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  width: 13rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 4rpx -4rpx 0 -1rpx currentColor;
  transform: rotate(90deg);
}

.form-title-row {
  display: flex;
  align-items: baseline;
  gap: 22rpx;
  margin-top: 46rpx;
}

.form-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
}

.form-subtitle {
  color: #9aa2b4;
  font-size: 23rpx;
}

.login-field {
  margin-top: 30rpx;
}

.field-label {
  color: #172033;
  font-size: 27rpx;
  font-weight: 900;
}

.input-wrap {
  position: relative;
  min-height: 80rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  border-radius: 18rpx;
  background: #ffffff;
  border: 2rpx solid rgba(31, 36, 50, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
}

.input-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  color: #ff6f00;
}

.input-icon--phone::before {
  content: "";
  position: absolute;
  left: 31rpx;
  top: 20rpx;
  width: 20rpx;
  height: 38rpx;
  border: 5rpx solid currentColor;
  border-radius: 6rpx;
}

.input-icon--phone::after {
  content: "";
  position: absolute;
  left: 39rpx;
  bottom: 17rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
}

.input-icon--lock::before {
  content: "";
  position: absolute;
  left: 27rpx;
  top: 36rpx;
  width: 28rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: currentColor;
}

.input-icon--lock::after {
  content: "";
  position: absolute;
  left: 32rpx;
  top: 20rpx;
  width: 18rpx;
  height: 20rpx;
  border-radius: 11rpx 11rpx 2rpx 2rpx;
  border: 5rpx solid currentColor;
  border-bottom: none;
}

.input-icon--user::before,
.input-icon--user::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.input-icon--user::before {
  left: 32rpx;
  top: 21rpx;
  width: 18rpx;
  height: 18rpx;
}

.input-icon--user::after {
  left: 24rpx;
  bottom: 18rpx;
  width: 34rpx;
  height: 20rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
}

.login-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 20rpx 0 0;
  color: #172033;
  background: transparent;
  border: none;
  font-size: 31rpx;
  line-height: 80rpx;
}

.input-clear {
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #c9ced7;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.input-eye {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  color: #9aa2ad;
}

.input-eye::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 17rpx;
  width: 34rpx;
  height: 22rpx;
  border: 5rpx solid currentColor;
  border-radius: 50%;
}

.input-eye::after {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 8rpx;
  width: 5rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(-45deg);
}

.input-eye--open::after {
  display: none;
}

.form-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 32rpx;
}

.remember {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #6f7685;
  font-size: 25rpx;
}

.remember-check,
.agreement-check {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #ffffff;
  background: #ff7a00;
  font-size: 22rpx;
  font-weight: 900;
}

.remember-check:not(.remember-check--active),
.agreement-check:not(.agreement-check--active) {
  color: transparent;
  background: #e9edf5;
}

.forgot {
  color: #6f7685;
  font-size: 25rpx;
}

.login-button {
  width: 100%;
  min-height: 96rpx;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 14rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7300 0%, #ff8f22 100%);
  box-shadow: 0 16rpx 28rpx rgba(255, 111, 0, 0.24);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.login-button::after {
  border: none;
}

.demo-card {
  min-height: 128rpx;
  margin-top: 30rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.demo-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  color: #ff6f00;
  background: #fff1df;
}

.demo-icon::before,
.demo-icon::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.demo-icon::before {
  left: 26rpx;
  top: 16rpx;
  width: 20rpx;
  height: 20rpx;
}

.demo-icon::after {
  left: 18rpx;
  bottom: 14rpx;
  width: 36rpx;
  height: 22rpx;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
}

.demo-copy {
  flex: 1;
  min-width: 0;
}

.demo-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
}

.demo-desc {
  margin-top: 12rpx;
  color: #747d8f;
  font-size: 23rpx;
  line-height: 1.4;
}

.demo-button {
  width: 150rpx;
  height: 62rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #ff6f00;
  background: #fff8f0;
  border: 2rpx solid rgba(255, 122, 0, 0.44);
  font-size: 25rpx;
  font-weight: 900;
}

.agreement {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 34rpx;
  padding: 0 12rpx;
}

.agreement-text {
  color: #7a8396;
  font-size: 24rpx;
  line-height: 1.7;
}

.agreement-text text {
  color: #ff6f00;
}

.button-hover,
.tap-scale:active {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.96;
}
