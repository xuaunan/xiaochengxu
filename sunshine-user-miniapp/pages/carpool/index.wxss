.carpool-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.carpool-hero,
.form-panel,
.action-panel,
.trip-summary-module .panel-card {
  border-radius: 32rpx;
}

.hero-header,
.module-heading,
.group-head {
  display: flex;
  align-items: center;
}

.hero-header,
.module-heading,
.group-head {
  justify-content: space-between;
}

.carpool-hero {
  padding: 30rpx 28rpx;
  background:
    linear-gradient(135deg, rgba(255, 244, 232, 0.98) 0%, rgba(255, 255, 255, 0.98) 58%),
    #ffffff;
}

.hero-header {
  align-items: flex-start;
  gap: 20rpx;
}

.hero-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff9829 0%, #ff7a00 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 16rpx 28rpx rgba(255, 122, 0, 0.2);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.form-panel,
.action-panel {
  padding: 28rpx;
}

.module-heading {
  align-items: flex-start;
  gap: 16rpx;
  flex-wrap: wrap;
}

.group-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.group-head {
  align-items: center;
  gap: 16rpx;
}

.group-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.group-tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff3e4;
  color: #ff7a00;
  font-size: 20rpx;
  line-height: 1.2;
}

.group-divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: rgba(31, 36, 50, 0.08);
}

.group-divider--compact {
  margin: 26rpx 0 24rpx;
}

.address-stack {
  position: relative;
}

.address-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-height: 110rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f7f8fc;
  border: 1rpx solid rgba(31, 36, 50, 0.04);
}

.address-row + .address-row {
  margin-top: 18rpx;
}

.address-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.address-dot--start {
  background: #22c36a;
  box-shadow: 0 0 0 10rpx rgba(34, 195, 106, 0.12);
}

.address-dot--end {
  background: #ffb8b4;
  box-shadow: 0 0 0 10rpx rgba(255, 184, 180, 0.14);
}

.address-copy {
  flex: 1;
  min-width: 0;
}

.address-label,
.option-title {
  font-size: 22rpx;
  color: var(--text-muted);
}

.address-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-switch {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.1);
  color: #ff8a1f;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.field-card--date {
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(247, 248, 252, 0.96), rgba(255, 255, 255, 0.98));
}

.field-action {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  color: #ff7a00;
  font-size: 22rpx;
  font-weight: 600;
}

.selection-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.select-field {
  position: relative;
  min-height: 108rpx;
  padding: 20rpx 58rpx 20rpx 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  background: linear-gradient(180deg, rgba(247, 248, 252, 0.96), rgba(255, 255, 255, 0.98));
}

.select-field__title {
  font-size: 22rpx;
  color: var(--text-muted);
}

.select-field__value {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.select-field__arrow {
  position: absolute;
  top: 50%;
  right: 22rpx;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #ff7a00;
}

.option-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option-grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.option-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #f4f6fa;
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.35;
  border: 1rpx solid transparent;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.option-tile--active {
  background: linear-gradient(135deg, #ff8d1a 0%, #ff7a00 100%);
  color: #ffffff;
  border-color: rgba(255, 122, 0, 0.18);
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.14);
}

.remark-textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  background: linear-gradient(180deg, rgba(247, 248, 252, 0.96), rgba(255, 255, 255, 0.98));
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-primary);
  box-sizing: border-box;
}

.remark-textarea::placeholder {
  color: var(--text-muted);
}

.remark-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  background: linear-gradient(180deg, rgba(247, 248, 252, 0.96), rgba(255, 255, 255, 0.98));
}

.remark-entry__main {
  flex: 1;
  min-width: 0;
}

.remark-entry__value {
  font-size: 26rpx;
  font-weight: 600;
  color: #a2aabc;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remark-entry__value--active {
  color: var(--text-primary);
}

.remark-entry__action {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  color: #ff7a00;
  font-size: 22rpx;
  font-weight: 700;
}

.confirm-order-button {
  width: 52%;
  min-height: 68rpx;
  margin: 22rpx auto 0;
  padding: 0 28rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 68rpx;
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 0, 0.18);
}

.note-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(13, 18, 32, 0.42);
}

.note-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 91;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 70rpx rgba(18, 24, 38, 0.22);
}

.note-modal__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.note-modal__title {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 800;
  color: var(--text-primary);
}

.note-modal__subtitle,
.note-modal__count {
  font-size: 22rpx;
  color: var(--text-muted);
}

.note-modal__subtitle {
  margin-top: 6rpx;
}

.note-modal__count {
  flex-shrink: 0;
  padding-top: 6rpx;
}

.note-modal__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.note-modal__button {
  width: 100%;
  box-sizing: border-box;
  min-height: 74rpx;
  padding: 0;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.note-modal__button--ghost {
  background: #f4f6fa;
  color: var(--text-secondary);
}

.note-modal__button--primary {
  background: linear-gradient(135deg, #ff8d1a 0%, #ff7a00 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 26rpx rgba(255, 122, 0, 0.16);
}

.action-heading {
  align-items: center;
}

.price-distance {
  flex-shrink: 0;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  font-size: 24rpx;
  font-weight: 700;
  color: #ff7a00;
}

.coupon-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffaf3 0%, #fff4e6 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
}

.coupon-entry__main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.coupon-entry__icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a00 0%, #ffb14a 100%);
}

.coupon-entry__label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2432;
}

.coupon-entry__summary {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8b94a7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-entry__summary--active {
  color: #ff7a00;
  font-weight: 600;
}

.coupon-entry__action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff7a00;
}

.price-board {
  margin-top: 22rpx;
  display: block;
}

.price-summary {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff8f1 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.08);
}

.price-summary__main {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ff8d1a 0%, #ff7a00 100%);
  box-shadow: 0 16rpx 28rpx rgba(255, 122, 0, 0.18);
}

.price-summary__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.price-summary__value {
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #ffffff;
  word-break: break-all;
}

.price-summary__detail {
  width: 220rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
  padding: 12rpx 6rpx;
}

.price-summary__line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.price-summary__original,
.price-summary__discount {
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.price-summary__original {
  text-decoration: line-through;
  color: #8c96a5;
}

.price-summary__discount {
  color: #ff7a00;
}

.carpool-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  align-items: center;
}

.carpool-action {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.carpool-action--primary {
  grid-column: 1 / -1;
  width: 48%;
  height: 68rpx;
  line-height: 68rpx;
  justify-self: center;
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 0, 0.22);
}

.trip-summary-module {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.summary-heading {
  padding: 0 4rpx;
}

.list-title {
  font-size: 32rpx;
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
}

.summary-route {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto auto minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f7f8fc;
}

.summary-route__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.summary-route__dot--start {
  background: #22c36a;
  box-shadow: 0 0 0 8rpx rgba(34, 195, 106, 0.12);
}

.summary-route__dot--end {
  background: #ffb8b4;
  box-shadow: 0 0 0 8rpx rgba(255, 184, 180, 0.14);
}

.summary-route__text {
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-route__arrow {
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-item {
  min-width: 0;
  padding: 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #fffaf4 0%, #fff5ea 100%);
}

.summary-item--wide {
  grid-column: 1 / -1;
}

.summary-item__label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.summary-item__value {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-picker-mask {
  z-index: 59;
}

.coupon-picker {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background: #f7f8fc;
}

.coupon-picker__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 26rpx) 24rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
}

.coupon-picker__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2432;
}

.coupon-picker__close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8b94a7;
  background: #ffffff;
}

.coupon-tabs {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx 0;
  background: #ffffff;
}

.coupon-tab {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8b94a7;
  background: #f5f6fa;
}

.coupon-tab--active {
  color: #ff7a00;
  background: #fff1df;
}

.coupon-picker__content {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 24rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 122, 0, 0.08);
  box-shadow: 0 16rpx 30rpx rgba(31, 36, 50, 0.06);
}

.coupon-card--selected {
  border-color: rgba(255, 122, 0, 0.28);
  background: linear-gradient(180deg, #fffaf3 0%, #fff5ea 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.1);
}

.coupon-card--disabled {
  opacity: 0.72;
  background: #f8f9fc;
  border-color: rgba(31, 36, 50, 0.06);
  box-shadow: none;
}

.coupon-card__value {
  width: 188rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff4e6 0%, #fff0de 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-card__value--disabled {
  background: #eef1f7;
}

.coupon-card__amount {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff7a00;
  line-height: 1.1;
}

.coupon-card__caption {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b94a7;
}

.coupon-card__body {
  flex: 1;
  min-width: 0;
}

.coupon-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
  line-height: 1.4;
}

.coupon-card__rule,
.coupon-card__valid {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b94a7;
}

.coupon-card__radio {
  width: 40rpx;
  height: 40rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 122, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex-shrink: 0;
}

.coupon-card__radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.coupon-card__reason {
  flex-shrink: 0;
  align-self: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #8b94a7;
  background: #eef1f7;
}

.coupon-empty {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8b94a7;
}

.coupon-picker__footer {
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 28rpx rgba(31, 36, 50, 0.06);
}

.coupon-picker__clear {
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}


