.page-shell {
  background:
    radial-gradient(circle at 88% 8%, rgba(255, 211, 156, 0.28) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f7f8fc 100%);
}

.carpool-page {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 12rpx 18rpx 36rpx;
  padding-top: 12rpx;
}

.carpool-hero {
  position: relative;
  min-height: 174rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 22rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 135, 24, 0.2);
  background:
    radial-gradient(circle at 91% 22%, rgba(255, 160, 48, 0.24) 0, rgba(255, 160, 48, 0) 160rpx),
    radial-gradient(circle at 74% 100%, rgba(255, 203, 132, 0.3) 0, rgba(255, 203, 132, 0) 180rpx),
    linear-gradient(105deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 250, 244, 0.98) 48%, rgba(255, 231, 198, 0.74) 100%),
    #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(210, 104, 18, 0.075);
}

.hero-bg {
  position: absolute;
  inset: -1rpx;
  z-index: 0;
  width: calc(100% + 2rpx);
  height: calc(100% + 2rpx);
  display: block;
  opacity: 1;
  pointer-events: none;
}

.carpool-hero::before {
  content: "";
  position: absolute;
  inset: 2rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  pointer-events: none;
}

.carpool-hero::after {
  content: "";
  position: absolute;
  right: 18rpx;
  bottom: -38rpx;
  width: 210rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 144, 31, 0.08);
  filter: blur(2rpx);
  pointer-events: none;
}

.hero-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-width: 0;
}

.hero-badge {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background:
    radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.9) 0, rgba(255, 255, 255, 0) 25rpx),
    linear-gradient(145deg, #fff7ee 0%, #ffe2c2 100%);
  box-shadow:
    inset 0 0 0 6rpx rgba(255, 255, 255, 0.72),
    0 10rpx 20rpx rgba(255, 111, 0, 0.16);
  box-sizing: border-box;
}

.hero-badge::before {
  content: "";
  position: absolute;
  inset: 7rpx;
  border-radius: 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  pointer-events: none;
}

.hero-badge__icon {
  position: relative;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.hero-copy {
  flex: 0 1 390rpx;
  min-width: 0;
  max-width: 390rpx;
}

.hero-title {
  font-size: 29rpx;
  font-weight: 650;
  color: #172033;
  line-height: 1.18;
}

.hero-subtitle {
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.28;
  color: #667085;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-scene {
  position: absolute;
  right: 16rpx;
  bottom: 2rpx;
  width: 184rpx;
  height: 108rpx;
  opacity: 0.86;
  display: none;
}

.hero-city {
  position: absolute;
  right: 0;
  bottom: 26rpx;
  width: 150rpx;
  height: 78rpx;
  opacity: 0.6;
}

.hero-building {
  position: absolute;
  bottom: 0;
  width: 28rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, rgba(255, 174, 88, 0.46), rgba(255, 174, 88, 0.14));
}

.hero-building--1 {
  right: 92rpx;
  height: 54rpx;
}

.hero-building--2 {
  right: 52rpx;
  height: 78rpx;
}

.hero-building--3 {
  right: 12rpx;
  height: 62rpx;
}

.hero-road {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 16rpx;
  height: 48rpx;
  border-radius: 80% 20% 0 0;
  border-top: 8rpx solid rgba(255, 255, 255, 0.9);
  transform: skewX(-18deg);
  background: linear-gradient(90deg, rgba(255, 181, 95, 0), rgba(255, 181, 95, 0.18));
}

.hero-car {
  position: absolute;
  right: 32rpx;
  bottom: 37rpx;
  width: 98rpx;
  height: 46rpx;
}

.hero-car__body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8rpx;
  height: 28rpx;
  border-radius: 18rpx 24rpx 12rpx 10rpx;
  background: linear-gradient(180deg, #ffad3a, #ff7a00);
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.22);
}

.hero-car__top {
  position: absolute;
  left: 28rpx;
  bottom: 30rpx;
  width: 38rpx;
  height: 18rpx;
  border-radius: 18rpx 18rpx 4rpx 4rpx;
  background: #ffd28b;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.hero-car__wheel {
  position: absolute;
  bottom: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2b3142;
  box-shadow: inset 0 0 0 5rpx #ffffff;
}

.hero-car__wheel--left {
  left: 14rpx;
}

.hero-car__wheel--right {
  right: 16rpx;
}

.hero-pin,
.hero-chat {
  position: absolute;
  top: 18rpx;
  border-radius: 50%;
  background: rgba(255, 122, 0, 0.18);
}

.hero-pin {
  right: 60rpx;
  width: 26rpx;
  height: 26rpx;
}

.hero-pin::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.hero-chat {
  right: 4rpx;
  top: 24rpx;
  width: 24rpx;
  height: 24rpx;
}

.carpool-panel {
  margin: 0 12rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 7rpx 18rpx rgba(37, 43, 58, 0.035);
}

.carpool-panel--compact {
  padding-bottom: 22rpx;
}

.module-heading,
.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.module-heading {
  margin-bottom: 20rpx;
}

.section-title,
.group-title {
  position: relative;
  font-size: 25rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.25;
}

.section-title {
  padding-left: 20rpx;
}

.section-title::before,
.group-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 6rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff8d1a, #ff6b00);
}

.group-title {
  padding-left: 20rpx;
}

.section-subtitle {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #7b8497;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.group-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 34rpx;
  padding: 0 13rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.08);
  color: #ff6b00;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
}

.group-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.address-stack {
  position: relative;
  margin-top: 18rpx;
  padding: 2rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  background: rgba(255, 255, 255, 0.72);
  overflow: hidden;
}

.address-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 18rpx 52rpx 18rpx 22rpx;
  background: linear-gradient(180deg, #fafbfe 0%, #ffffff 100%);
}

.address-row + .address-row {
  border-top: 1rpx solid rgba(17, 24, 39, 0.07);
}

.address-dot {
  width: 17rpx;
  height: 17rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.address-dot--start {
  background: #23c66b;
  box-shadow: 0 0 0 14rpx rgba(35, 198, 107, 0.13);
}

.address-dot--end {
  background: #ff7373;
  box-shadow: 0 0 0 14rpx rgba(255, 115, 115, 0.13);
}

.address-copy {
  flex: 1;
  min-width: 0;
}

.address-label {
  font-size: 20rpx;
  color: #7d8799;
  line-height: 1.2;
}

.address-value {
  margin-top: 7rpx;
  font-size: 24rpx;
  font-weight: 550;
  color: #121826;
  line-height: 1.22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-arrow,
.basic-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #8b94a7;
  border-right: 4rpx solid #8b94a7;
  transform: translateY(-50%) rotate(45deg);
  opacity: 0.9;
}

.address-switch {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 15rpx;
  transform: translate(-50%, -50%);
  background: linear-gradient(180deg, #ffffff 0%, #fff7ed 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.18);
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.14);
  box-sizing: border-box;
}

.address-switch__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  background:
    linear-gradient(#ff7a00, #ff7a00) 8rpx 6rpx / 3rpx 16rpx no-repeat,
    linear-gradient(#ff7a00, #ff7a00) 18rpx 6rpx / 3rpx 16rpx no-repeat;
  box-sizing: border-box;
}

.address-switch__icon::before,
.address-switch__icon::after {
  content: "";
  position: absolute;
  width: 9rpx;
  height: 9rpx;
  border-radius: 2rpx;
  box-sizing: border-box;
}

.address-switch__icon::before {
  left: 4rpx;
  bottom: 3rpx;
  border-right: 3rpx solid #ff7a00;
  border-bottom: 3rpx solid #ff7a00;
  transform: rotate(45deg);
}

.address-switch__icon::after {
  right: 4rpx;
  top: 3rpx;
  border-left: 3rpx solid #ff7a00;
  border-top: 3rpx solid #ff7a00;
  transform: rotate(45deg);
}

.basic-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.basic-card {
  position: relative;
  min-height: 104rpx;
  padding: 16rpx 34rpx 14rpx 16rpx;
  border-radius: 15rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.13);
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-sizing: border-box;
}

.basic-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  box-shadow: 0 5rpx 10rpx rgba(255, 122, 0, 0.08);
  box-sizing: border-box;
}

.preference-icon::before,
.remark-icon::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 8rpx;
  border: 3rpx solid #ff7a00;
  box-sizing: border-box;
}

.basic-icon::before,
.basic-icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.basic-icon--date::before {
  left: 8rpx;
  top: 9rpx;
  width: 18rpx;
  height: 17rpx;
  border: 2rpx solid #ff7a00;
  border-radius: 5rpx;
  background:
    linear-gradient(#ff7a00, #ff7a00) 0 5rpx / 100% 2rpx no-repeat,
    rgba(255, 255, 255, 0.82);
}

.basic-icon--date::after {
  left: 12rpx;
  top: 6rpx;
  width: 3rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 8rpx 0 0 #ff7a00;
}

.basic-icon--time::before {
  left: 7rpx;
  top: 7rpx;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #ff7a00;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
}

.basic-icon--time::after {
  left: 50%;
  top: 11rpx;
  width: 2rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 5rpx 8rpx 0 -1rpx #ff7a00;
  transform: translateX(-50%) rotate(0deg);
  transform-origin: 50% 100%;
}

.basic-icon--people::before {
  left: 7rpx;
  top: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow: 10rpx 4rpx 0 -1rpx rgba(255, 122, 0, 0.7);
}

.basic-icon--people::after {
  left: 6rpx;
  bottom: 6rpx;
  width: 17rpx;
  height: 10rpx;
  border: 2rpx solid #ff7a00;
  border-radius: 12rpx 12rpx 5rpx 5rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 9rpx 2rpx 0 -2rpx rgba(255, 122, 0, 0.45);
}

.basic-label {
  font-size: 19rpx;
  color: #7d8799;
  line-height: 1.2;
}

.basic-value {
  margin-top: 7rpx;
  font-size: 22rpx;
  font-weight: 550;
  color: #111827;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.basic-arrow {
  right: 22rpx;
}

.preference-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.preference-row {
  display: grid;
  grid-template-columns: 136rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
}

.preference-label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #3f4656;
  font-size: 21rpx;
  font-weight: 500;
}

.preference-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 122, 0, 0.18);
  box-shadow: 0 5rpx 10rpx rgba(255, 122, 0, 0.08);
}

.preference-icon::before {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.preference-icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.preference-icon--luggage::before {
  left: 8rpx;
  top: 12rpx;
  width: 18rpx;
  height: 15rpx;
  border: 2rpx solid #ff7a00;
  border-radius: 5rpx;
  background:
    linear-gradient(#ff7a00, #ff7a00) 50% 0 / 2rpx 100% no-repeat,
    rgba(255, 255, 255, 0.86);
}

.preference-icon--luggage::after {
  left: 13rpx;
  top: 7rpx;
  width: 8rpx;
  height: 7rpx;
  border: 2rpx solid #ff7a00;
  border-bottom: 0;
  border-radius: 5rpx 5rpx 0 0;
}

.preference-icon--toll::before {
  left: 10rpx;
  top: 7rpx;
  width: 14rpx;
  height: 21rpx;
  border-left: 3rpx solid #ff7a00;
  border-right: 3rpx solid #ff7a00;
  border-radius: 7rpx 7rpx 4rpx 4rpx;
  transform: perspective(36rpx) rotateX(18deg);
}

.preference-icon--toll::after {
  left: 16rpx;
  top: 10rpx;
  width: 2rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow:
    0 7rpx 0 #ff7a00,
    0 14rpx 0 #ff7a00;
}

.option-grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.option-tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 36rpx 0 14rpx;
  border-radius: 13rpx;
  border: 1rpx solid transparent;
  background: #f6f7fb;
  color: #626b7e;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
}

.option-tile--active {
  color: #ff6b00;
  border-color: rgba(255, 107, 0, 0.72);
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.96), rgba(255, 255, 255, 0.96));
}

.option-check {
  position: absolute;
  right: 12rpx;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #ff9c2f, #ff6b00);
}

.option-check::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: translate(-50%, -56%) rotate(-45deg);
}

.remark-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(31, 41, 55, 0.08);
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  box-sizing: border-box;
}

.remark-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.remark-icon::before {
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  border-width: 3rpx;
  border-color: #9aa3b2;
  border-radius: 2rpx;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.remark-entry__value {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #9aa3b2;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remark-entry__value--active {
  color: #111827;
  font-weight: 500;
}

.remark-counter {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #8b94a7;
}

.confirm-order-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70%;
  height: 72rpx;
  padding: 0;
  line-height: 1.2;
  box-sizing: border-box;
  margin: 4rpx auto 10rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 550;
  letter-spacing: 0;
  box-shadow: 0 12rpx 24rpx rgba(255, 107, 0, 0.18);
}

.confirm-order-button::after {
  border: 0;
}

.note-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(13, 18, 32, 0.42);
}

.note-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 91;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 70rpx rgba(18, 24, 38, 0.22);
}

.note-modal__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.note-modal__title {
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #111827;
}

.note-modal__subtitle,
.note-modal__count {
  font-size: 22rpx;
  color: #8b94a7;
}

.note-modal__subtitle {
  margin-top: 6rpx;
}

.note-modal__count {
  flex-shrink: 0;
  padding-top: 6rpx;
}

.remark-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  font-size: 23rpx;
  line-height: 1.6;
  color: #111827;
  box-sizing: border-box;
}

.remark-textarea::placeholder {
  color: #9aa3b2;
}

.note-modal__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.note-modal__button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  height: 62rpx;
  padding: 0;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.2;
}

.note-modal__button--ghost {
  background: #f4f6fa;
