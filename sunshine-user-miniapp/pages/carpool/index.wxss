.page-shell {
  background:
    radial-gradient(circle at 88% 8%, rgba(255, 211, 156, 0.28) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f7f8fc 100%);
}

.carpool-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
}

.carpool-hero {
  position: relative;
  min-height: 128rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 122, 0, 0.14);
  background:
    linear-gradient(105deg, rgba(255, 245, 233, 0.98) 0%, rgba(255, 255, 255, 0.92) 54%, rgba(255, 231, 194, 0.8) 100%);
  box-shadow: 0 16rpx 34rpx rgba(37, 43, 58, 0.05);
}

.hero-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-right: 210rpx;
}

.hero-badge {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ff9e36 0%, #ff6b00 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 86rpx;
  text-align: center;
  letter-spacing: 0;
  box-shadow: 0 18rpx 30rpx rgba(255, 122, 0, 0.2);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #101828;
  line-height: 1.18;
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #737c90;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-scene {
  position: absolute;
  right: 24rpx;
  bottom: 0;
  width: 232rpx;
  height: 128rpx;
  opacity: 0.95;
}

.hero-city {
  position: absolute;
  right: 0;
  bottom: 28rpx;
  width: 150rpx;
  height: 78rpx;
  opacity: 0.55;
}

.hero-building {
  position: absolute;
  bottom: 0;
  width: 28rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, rgba(255, 174, 88, 0.46), rgba(255, 174, 88, 0.14));
}

.hero-building--1 {
  right: 92rpx;
  height: 54rpx;
}

.hero-building--2 {
  right: 52rpx;
  height: 78rpx;
}

.hero-building--3 {
  right: 12rpx;
  height: 62rpx;
}

.hero-road {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14rpx;
  height: 48rpx;
  border-radius: 80% 20% 0 0;
  border-top: 8rpx solid rgba(255, 255, 255, 0.9);
  transform: skewX(-18deg);
  background: linear-gradient(90deg, rgba(255, 181, 95, 0), rgba(255, 181, 95, 0.18));
}

.hero-car {
  position: absolute;
  right: 30rpx;
  bottom: 35rpx;
  width: 94rpx;
  height: 44rpx;
}

.hero-car__body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8rpx;
  height: 26rpx;
  border-radius: 18rpx 24rpx 12rpx 10rpx;
  background: linear-gradient(180deg, #ffad3a, #ff7a00);
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.22);
}

.hero-car__top {
  position: absolute;
  left: 26rpx;
  bottom: 28rpx;
  width: 36rpx;
  height: 18rpx;
  border-radius: 18rpx 18rpx 4rpx 4rpx;
  background: #ffd28b;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.hero-car__wheel {
  position: absolute;
  bottom: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2b3142;
  box-shadow: inset 0 0 0 5rpx #ffffff;
}

.hero-car__wheel--left {
  left: 14rpx;
}

.hero-car__wheel--right {
  right: 16rpx;
}

.hero-pin,
.hero-chat {
  position: absolute;
  top: 18rpx;
  border-radius: 50%;
  background: rgba(255, 122, 0, 0.18);
}

.hero-pin {
  right: 58rpx;
  width: 26rpx;
  height: 26rpx;
}

.hero-pin::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.hero-chat {
  right: 4rpx;
  top: 24rpx;
  width: 24rpx;
  height: 24rpx;
}

.carpool-panel {
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.carpool-panel--compact {
  padding-bottom: 22rpx;
}

.module-heading,
.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.module-heading {
  margin-bottom: 24rpx;
}

.section-title,
.group-title {
  position: relative;
  font-size: 34rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.25;
}

.section-title {
  padding-left: 20rpx;
}

.section-title::before,
.group-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 9rpx;
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff8d1a, #ff6b00);
}

.group-title {
  padding-left: 20rpx;
}

.section-subtitle {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #7b8497;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.group-tag {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.08);
  color: #ff6b00;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.group-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.address-stack {
  position: relative;
  margin-top: 20rpx;
  padding: 2rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  background: rgba(255, 255, 255, 0.72);
  overflow: hidden;
}

.address-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 116rpx;
  padding: 24rpx 62rpx 24rpx 28rpx;
  background: linear-gradient(180deg, #fafbfe 0%, #ffffff 100%);
}

.address-row + .address-row {
  border-top: 1rpx solid rgba(17, 24, 39, 0.07);
}

.address-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.address-dot--start {
  background: #23c66b;
  box-shadow: 0 0 0 14rpx rgba(35, 198, 107, 0.13);
}

.address-dot--end {
  background: #ff7373;
  box-shadow: 0 0 0 14rpx rgba(255, 115, 115, 0.13);
}

.address-copy {
  flex: 1;
  min-width: 0;
}

.address-label {
  font-size: 24rpx;
  color: #7d8799;
  line-height: 1.2;
}

.address-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #121826;
  line-height: 1.22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-arrow,
.basic-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #8b94a7;
  border-right: 4rpx solid #8b94a7;
  transform: translateY(-50%) rotate(45deg);
  opacity: 0.9;
}

.address-switch {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(31, 38, 52, 0.12);
}

.address-switch__icon {
  position: relative;
  width: 32rpx;
  height: 42rpx;
}

.address-switch__icon::before,
.address-switch__icon::after {
  content: "";
  position: absolute;
  left: 13rpx;
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #ff6b00;
}

.address-switch__icon::before {
  top: 0;
  transform: rotate(180deg);
}

.address-switch__icon::after {
  bottom: 0;
}

.basic-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.basic-card {
  position: relative;
  min-height: 140rpx;
  padding: 22rpx 40rpx 18rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.13);
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-sizing: border-box;
}

.basic-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 12rpx;
}

.basic-icon::before,
.preference-icon::before,
.remark-icon::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 8rpx;
  border: 4rpx solid #ff7a00;
  box-sizing: border-box;
}

.basic-icon--date::after {
  content: "";
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  top: 11rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ff7a00;
}

.basic-icon--time::before {
  border-radius: 50%;
}

.basic-icon--time::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 7rpx;
  width: 4rpx;
  height: 15rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  box-shadow: 6rpx 9rpx 0 -1rpx #ff7a00;
}

.basic-icon--people::before {
  border-radius: 50%;
  width: 15rpx;
  height: 15rpx;
  left: 9rpx;
  top: 1rpx;
  inset: auto;
  background: #ff7a00;
}

.basic-icon--people::after {
  content: "";
  position: absolute;
  left: 2rpx;
  bottom: 2rpx;
  width: 28rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  border: 4rpx solid #ff7a00;
  border-top-width: 6rpx;
  box-sizing: border-box;
}

.basic-label {
  font-size: 22rpx;
  color: #7d8799;
  line-height: 1.2;
}

.basic-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.basic-arrow {
  right: 22rpx;
}

.preference-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.preference-row {
  display: grid;
  grid-template-columns: 176rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
}

.preference-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #3f4656;
  font-size: 26rpx;
  font-weight: 700;
}

.preference-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  background: #fff3e8;
}

.preference-icon::before {
  inset: 10rpx 9rpx 9rpx;
  border-width: 3rpx;
  border-color: rgba(135, 139, 148, 0.5);
}

.preference-icon--toll::before {
  border-radius: 3rpx;
  transform: skewX(-8deg);
}

.option-grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.option-tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 44rpx 0 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
  background: #f6f7fb;
  color: #626b7e;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.2;
  box-sizing: border-box;
}

.option-tile--active {
  color: #ff6b00;
  border-color: rgba(255, 107, 0, 0.72);
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.96), rgba(255, 255, 255, 0.96));
}

.option-check {
  position: absolute;
  right: 16rpx;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #ff9c2f, #ff6b00);
}

.option-check::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 8rpx;
  width: 14rpx;
  height: 8rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(-45deg);
}

.remark-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  min-height: 80rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(31, 41, 55, 0.08);
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  box-sizing: border-box;
}

.remark-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.remark-icon::before {
  inset: 4rpx;
  border-width: 3rpx;
  border-color: #9aa3b2;
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

.remark-entry__value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #9aa3b2;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remark-entry__value--active {
  color: #111827;
  font-weight: 700;
}

.remark-counter {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8b94a7;
}

.confirm-order-button {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin: 2rpx 0 8rpx;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 0;
  box-shadow: 0 18rpx 34rpx rgba(255, 107, 0, 0.22);
}

.note-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(13, 18, 32, 0.42);
}

.note-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 91;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 70rpx rgba(18, 24, 38, 0.22);
}

.note-modal__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.note-modal__title {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 900;
  color: #111827;
}

.note-modal__subtitle,
.note-modal__count {
  font-size: 22rpx;
  color: #8b94a7;
}

.note-modal__subtitle {
  margin-top: 6rpx;
}

.note-modal__count {
  flex-shrink: 0;
  padding-top: 6rpx;
}

.remark-textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  font-size: 26rpx;
  line-height: 1.6;
  color: #111827;
  box-sizing: border-box;
}

.remark-textarea::placeholder {
  color: #9aa3b2;
}

.note-modal__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.note-modal__button {
  width: 100%;
  box-sizing: border-box;
  min-height: 74rpx;
  padding: 0;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 74rpx;
  text-align: center;
}

.note-modal__button--ghost {
  background: #f4f6fa;
  color: #5f687a;
}

.note-modal__button--primary {
  background: linear-gradient(135deg, #ff8d1a 0%, #ff6b00 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 26rpx rgba(255, 122, 0, 0.16);
}
