.intl-order {
  padding-bottom: 170rpx;
}

.intl-order-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  gap: 18rpx;
  align-items: end;
  padding: 32rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #111827 0%, #1d4ed8 56%, #ff7a00 100%);
  box-shadow: 0 24rpx 58rpx rgba(24, 34, 56, 0.16);
}

.intl-kicker {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.7);
}

.intl-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.intl-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.82);
}

.intl-price-card {
  min-width: 0;
  padding: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  text-align: right;
}

.intl-price-card text {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.intl-price-card view {
  margin: 8rpx 0;
  font-size: 36rpx;
  font-weight: 800;
}

.intl-summary-grid,
.form-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.form-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 0;
}

.intl-summary-grid > view {
  padding: 18rpx 14rpx;
  border-radius: 22rpx;
  background: #f6f8fc;
}

.intl-summary-grid text {
  font-size: 21rpx;
  color: #8a94a8;
}

.intl-summary-grid view view {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 800;
  color: #1f2432;
}

.intl-service-row,
.document-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.intl-service-row text,
.document-list view {
  padding: 11rpx 17rpx;
  border-radius: 999rpx;
  color: #166534;
  font-size: 22rpx;
  background: rgba(22, 163, 74, 0.1);
}

.document-list view {
  color: #1d4ed8;
  background: rgba(37, 99, 235, 0.1);
}

.intl-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f7f8fc;
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  color: #1f2432;
  font-size: 28rpx;
  line-height: 1.55;
}


