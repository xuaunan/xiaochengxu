.intl-order {
  padding-bottom: 170rpx;
}

.intl-order-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  gap: 18rpx;
  align-items: end;
  padding: 32rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(135deg, #10243f 0%, #1d4e89 58%, #d96f18 100%);
  background-size: 44rpx 44rpx, 44rpx 44rpx, auto;
  box-shadow: 0 18rpx 38rpx rgba(16, 36, 63, 0.18);
}

.intl-hero-copy {
  min-width: 0;
}

.intl-kicker {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.3;
}

.intl-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.18;
}

.intl-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.82);
}

.intl-route-token {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #f7fbff;
  background: rgba(255, 255, 255, 0.16);
  font-size: 21rpx;
  line-height: 42rpx;
}

.intl-price-card {
  min-width: 0;
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  text-align: right;
}

.intl-price-card text {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.intl-price-card view {
  margin: 8rpx 0;
  font-size: 36rpx;
  font-weight: 700;
}

.intl-summary-grid,
.form-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.form-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 0;
}

.intl-summary-grid > view {
  padding: 18rpx 14rpx;
  border-radius: 18rpx;
  background: #f4f7fb;
}

.intl-summary-grid text {
  font-size: 21rpx;
  color: #8a94a8;
}

.intl-summary-grid view view {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2432;
}

.intl-service-row,
.document-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.intl-service-row text,
.document-list view {
  padding: 11rpx 17rpx;
  border-radius: 999rpx;
  color: #125f4c;
  font-size: 22rpx;
  background: rgba(31, 139, 113, 0.1);
}

.document-list view {
  color: #1d4e89;
  background: rgba(29, 78, 137, 0.1);
}

.intl-route-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 48rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f7f9fd;
  border: 1rpx solid rgba(29, 78, 137, 0.08);
}

.intl-route-panel text {
  display: block;
  font-size: 18rpx;
  color: #7b8ca8;
  line-height: 1.2;
}

.intl-route-panel view view {
  margin-top: 7rpx;
  color: #172033;
  font-size: 22rpx;
  line-height: 1.35;
}

.intl-route-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #d96f18;
  background: #fff1df;
  font-size: 26rpx;
  line-height: 48rpx;
}

.intl-field {
  display: grid;
  gap: 9rpx;
  min-width: 0;
}

.intl-field > text {
  color: #667085;
  font-size: 21rpx;
  line-height: 1.25;
}

.intl-picker-value,
.intl-field-input {
  display: flex;
  align-items: center;
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  color: #172033;
  background: #f7f9fd;
  border: 1rpx solid rgba(29, 78, 137, 0.1);
  font-size: 26rpx;
  line-height: 76rpx;
}

.intl-field-input {
  box-shadow: none;
}

.intl-field-input::placeholder {
  color: #a1abba;
}

.intl-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f7f9fd;
  border: 1rpx solid rgba(29, 78, 137, 0.1);
  color: #172033;
  font-size: 26rpx;
  line-height: 1.55;
}

.primary-button[disabled] {
  opacity: 0.72;
}


