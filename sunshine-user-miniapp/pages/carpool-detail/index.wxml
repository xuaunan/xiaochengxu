<view class="page-shell carpool-detail-shell safe-bottom" wx:if="{{detail}}">
  <view class="page-content list-gap">
    <view class="hero-card detail-hero page-enter">
      <view class="row-between">
        <view class="section-title detail-route">{{detail.trip.routeText}}</view>
        <view class="status-tag {{detail.trip.statusClassName}}">{{detail.trip.statusText}}</view>
      </view>
      <view class="section-subtitle">{{detail.trip.departTimeText}} · {{detail.trip.priceText}} / 人</view>

      <view class="metric-grid detail-metrics">
        <view class="metric-item">
          <view class="metric-value">{{detail.summary.remainSeatCount}}</view>
          <view class="metric-label">剩余座位</view>
        </view>
        <view class="metric-item">
          <view class="metric-value">{{detail.summary.pendingApplicationCount}}</view>
          <view class="metric-label">待处理申请</view>
        </view>
        <view class="metric-item">
          <view class="metric-value">{{detail.summary.confirmedApplicationCount}}</view>
          <view class="metric-label">已确认同行</view>
        </view>
      </view>

      <view class="chip-row" style="margin-top: 18rpx;">
        <view class="chip" wx:if="{{detail.trip.baggageRule}}">{{detail.trip.baggageRule}}</view>
        <view class="chip" wx:if="{{detail.trip.tripRemark}}">{{detail.trip.tripRemark}}</view>
      </view>
    </view>

    <view class="panel-card owner-card">
      <view class="section-title">车主信息</view>
      <view class="section-subtitle">{{detail.owner.subtitle}}</view>
    </view>

    <view class="panel-card application-panel" wx:if="{{detail.myApplication}}">
      <view class="row-between">
        <view class="section-title">我的申请</view>
        <view class="status-tag {{detail.myApplication.statusClassName}}">{{detail.myApplication.statusText}}</view>
      </view>
      <view class="section-subtitle">{{detail.myApplication.seatText}} · {{detail.myApplication.priceText}}</view>
      <view class="detail-note">{{detail.myApplication.noteText}}</view>
      <view class="action-row" wx:if="{{detail.myApplication.canPassengerConfirm || detail.myApplication.canPassengerCancel}}">
        <button wx:if="{{detail.myApplication.canPassengerCancel}}" class="ghost-button action-button" hover-class="button-hover" data-id="{{detail.myApplication.id}}" bindtap="cancelApplication">取消申请</button>
        <button wx:if="{{detail.myApplication.canPassengerConfirm}}" class="primary-button action-button" hover-class="button-hover" bindtap="confirmPassenger">确认同行</button>
      </view>
    </view>

    <view class="panel-card application-panel" wx:if="{{detail.currentUserRole === 'OWNER'}}">
      <view class="row-between">
        <view class="section-title">乘客申请</view>
        <view class="section-subtitle">{{detail.applications.length}} 条</view>
      </view>

      <view wx:if="{{detail.applications.length}}" class="list-gap application-list">
        <view class="application-card" wx:for="{{detail.applications}}" wx:key="id">
          <view class="row-between">
            <view class="application-name">{{item.passengerText}}</view>
            <view class="status-tag {{item.statusClassName}}">{{item.statusText}}</view>
          </view>
          <view class="application-meta">{{item.seatText}} · {{item.priceText}}</view>
          <view class="application-meta">{{item.noteText}}</view>
          <view class="action-row" wx:if="{{item.canOwnerApprove || item.canOwnerReject}}">
            <button class="ghost-button action-button" hover-class="button-hover" data-id="{{item.id}}" data-action="REJECT" bindtap="handleOwnerAction">拒绝</button>
            <button class="primary-button action-button" hover-class="button-hover" data-id="{{item.id}}" data-action="APPROVE" bindtap="handleOwnerAction">确认同行</button>
          </view>
        </view>
      </view>

      <view wx:else class="detail-note">还没有乘客申请这条顺风车行程。</view>
    </view>
  </view>

  <view class="floating-bar" wx:if="{{detail.trip.canApply}}">
    <button class="primary-button" hover-class="button-hover" bindtap="applyRide">申请搭乘</button>
  </view>
</view>
