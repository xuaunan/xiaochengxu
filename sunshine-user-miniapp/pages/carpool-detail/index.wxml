<view class="page-shell carpool-detail-shell safe-bottom" wx:if="{{detail}}">
  <view class="page-content detail-page page-enter">
    <view class="detail-hero">
      <view class="detail-hero__head">
        <view class="detail-route">{{detail.trip.routeText}}</view>
        <view class="status-tag {{detail.trip.statusClassName}}">{{detail.trip.statusText}}</view>
      </view>
      <view class="detail-subtitle">{{detail.trip.departTimeText}} · {{detail.trip.priceText}} / 人</view>
      <view class="detail-hero__scene">
        <view class="detail-hero__car"></view>
      </view>

      <view class="detail-metrics">
        <view class="metric-card metric-card--seat">
          <view class="metric-icon"></view>
          <view class="metric-value">{{detail.summary.remainSeatCount}}</view>
          <view class="metric-label">剩余座位</view>
        </view>
        <view class="metric-card metric-card--pending">
          <view class="metric-icon"></view>
          <view class="metric-value">{{detail.summary.pendingApplicationCount}}</view>
          <view class="metric-label">待处理申请</view>
        </view>
        <view class="metric-card metric-card--done">
          <view class="metric-icon"></view>
          <view class="metric-value">{{detail.summary.confirmedApplicationCount}}</view>
          <view class="metric-label">已确认同行</view>
        </view>
      </view>

      <view class="detail-tags" wx:if="{{detail.trip.baggageRule || detail.trip.tripRemark}}">
        <view class="detail-tag" wx:if="{{detail.trip.baggageRule}}">{{detail.trip.baggageRule}}</view>
        <view class="detail-tag" wx:if="{{detail.trip.tripRemark}}">{{detail.trip.tripRemark}}</view>
      </view>
    </view>

    <view class="detail-panel owner-card">
      <view class="panel-title">
        <view class="panel-title__icon panel-title__icon--owner"></view>
        <view>车主信息</view>
      </view>
      <view class="panel-desc">{{detail.owner.subtitle}}</view>
    </view>

    <view class="detail-panel application-panel" wx:if="{{detail.myApplication}}">
      <view class="panel-title-row">
        <view class="panel-title">
          <view class="panel-title__icon panel-title__icon--application"></view>
          <view>我的申请</view>
        </view>
        <view class="status-tag {{detail.myApplication.statusClassName}}">{{detail.myApplication.statusText}}</view>
      </view>
      <view class="panel-desc">{{detail.myApplication.seatText}} · {{detail.myApplication.priceText}}</view>
      <view class="detail-note">{{detail.myApplication.noteText}}</view>
      <view class="action-row" wx:if="{{detail.myApplication.canPassengerConfirm || detail.myApplication.canPassengerCancel}}">
        <button wx:if="{{detail.myApplication.canPassengerCancel}}" class="ghost-button action-button" hover-class="button-hover" data-id="{{detail.myApplication.id}}" bindtap="cancelApplication">取消申请</button>
        <button wx:if="{{detail.myApplication.canPassengerConfirm}}" class="primary-button action-button" hover-class="button-hover" bindtap="confirmPassenger">确认同行</button>
      </view>
    </view>

    <view class="detail-panel application-panel" wx:if="{{detail.currentUserRole === 'OWNER'}}">
      <view class="panel-title-row">
        <view class="panel-title">
          <view class="panel-title__icon panel-title__icon--passenger"></view>
          <view>乘客申请</view>
        </view>
        <view class="count-pill">{{detail.applications.length}} 条</view>
      </view>

      <view wx:if="{{detail.applications.length}}" class="application-list">
        <view class="application-card" wx:for="{{detail.applications}}" wx:key="id">
          <view class="application-card__head">
            <view class="application-avatar"></view>
            <view class="application-main">
              <view class="application-name">{{item.passengerText}}</view>
              <view class="application-meta">{{item.seatText}} · {{item.priceText}}</view>
            </view>
            <view class="status-tag {{item.statusClassName}}">{{item.statusText}}</view>
          </view>
          <view class="application-note">{{item.noteText}}</view>
          <view class="action-row" wx:if="{{item.canOwnerApprove || item.canOwnerReject}}">
            <button class="ghost-button action-button" hover-class="button-hover" data-id="{{item.id}}" data-action="REJECT" bindtap="handleOwnerAction">拒绝</button>
            <button class="primary-button action-button" hover-class="button-hover" data-id="{{item.id}}" data-action="APPROVE" bindtap="handleOwnerAction">确认同行</button>
          </view>
        </view>
      </view>

      <view wx:else class="detail-note">还没有乘客申请这条顺风车行程。</view>
    </view>
  </view>

  <view class="floating-bar detail-floating-bar" wx:if="{{detail.trip.canApply}}">
    <button class="primary-button detail-apply-button" hover-class="button-hover" bindtap="applyRide">申请搭乘</button>
  </view>
</view>
