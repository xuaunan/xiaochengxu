.carpool-detail-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.24) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 32%, #f5f7fb 100%);
}

.detail-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 142rpx;
}

.detail-hero,
.detail-panel {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.detail-hero {
  position: relative;
  padding: 30rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.detail-hero__head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.detail-route {
  flex: 1;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.28;
}

.detail-subtitle {
  position: relative;
  z-index: 2;
  margin-top: 12rpx;
  padding-right: 190rpx;
  font-size: 26rpx;
  color: #6f7787;
  line-height: 1.35;
}

.detail-hero__scene {
  position: absolute;
  right: 24rpx;
  top: 82rpx;
  width: 200rpx;
  height: 116rpx;
}

.detail-hero__scene::before {
  content: "";
  position: absolute;
  right: 0;
  bottom: 26rpx;
  width: 160rpx;
  height: 70rpx;
  opacity: 0.46;
  background:
    linear-gradient(180deg, rgba(255, 174, 88, 0.42), rgba(255, 174, 88, 0.12)) 8rpx 18rpx / 28rpx 52rpx no-repeat,
    linear-gradient(180deg, rgba(255, 174, 88, 0.42), rgba(255, 174, 88, 0.12)) 50rpx 0 / 32rpx 70rpx no-repeat,
    linear-gradient(180deg, rgba(255, 174, 88, 0.42), rgba(255, 174, 88, 0.12)) 104rpx 24rpx / 28rpx 46rpx no-repeat;
}

.detail-hero__scene::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14rpx;
  height: 46rpx;
  border-radius: 80% 20% 0 0;
  border-top: 8rpx solid rgba(255, 255, 255, 0.9);
  background: linear-gradient(90deg, rgba(255, 181, 95, 0), rgba(255, 181, 95, 0.18));
  transform: skewX(-18deg);
}

.detail-hero__car {
  position: absolute;
  right: 42rpx;
  bottom: 34rpx;
  z-index: 2;
  width: 86rpx;
  height: 32rpx;
  border-radius: 16rpx 22rpx 10rpx 10rpx;
  background: linear-gradient(180deg, #ffad3a, #ff7a00);
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.22);
}

.detail-hero__car::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: -16rpx;
  width: 32rpx;
  height: 18rpx;
  border-radius: 18rpx 18rpx 4rpx 4rpx;
  background: #ffd28b;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.detail-hero__car::after {
  content: "";
  position: absolute;
  left: 12rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #2b3142;
  box-shadow: inset 0 0 0 5rpx #ffffff, 48rpx 0 0 #2b3142;
}

.detail-metrics {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 28rpx;
}

.metric-card {
  min-height: 138rpx;
  padding: 20rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
}

.metric-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 10rpx;
  border-radius: 14rpx;
  background: rgba(255, 122, 0, 0.1);
}

.metric-icon::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 15rpx;
  width: 18rpx;
  height: 12rpx;
  border-radius: 7rpx;
  background: #ff7a00;
}

.metric-value {
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #111827;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #7d8799;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.detail-tag {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.08);
  color: #ff6b00;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-panel {
  padding: 26rpx;
}

.panel-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.3;
}

.panel-title__icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: rgba(255, 122, 0, 0.1);
  flex-shrink: 0;
}

.panel-title__icon::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 10rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow: 0 20rpx 0 -2rpx #ff7a00;
}

.panel-title__icon--application::before,
.panel-title__icon--passenger::before {
  left: 13rpx;
  top: 14rpx;
  width: 22rpx;
  height: 18rpx;
  border-radius: 6rpx;
  background: transparent;
  border: 4rpx solid #ff7a00;
  box-shadow: none;
}

.panel-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6f7787;
  line-height: 1.55;
}

.count-pill {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6b00;
  background: rgba(255, 122, 0, 0.08);
  font-size: 24rpx;
  font-weight: 900;
}

.detail-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(255, 122, 0, 0.08);
  font-size: 24rpx;
  line-height: 1.65;
  color: #6f7787;
}

.application-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.application-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fafbfe 0%, #ffffff 100%);
  border: 1rpx solid rgba(31, 36, 50, 0.06);
}

.application-card__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.application-avatar {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: rgba(255, 122, 0, 0.1);
}

.application-avatar::before {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 11rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow: 0 22rpx 0 4rpx #ff7a00;
}

.application-main {
  flex: 1;
  min-width: 0;
}

.application-name {
  font-size: 29rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.3;
}

.application-meta,
.application-note {
  font-size: 24rpx;
  color: #7b8497;
  line-height: 1.55;
}

.application-meta {
  margin-top: 6rpx;
}

.application-note {
  margin-top: 14rpx;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-button {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.detail-floating-bar {
  left: 28rpx;
  right: 28rpx;
}

.detail-apply-button {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 34rpx rgba(255, 107, 0, 0.22);
}
