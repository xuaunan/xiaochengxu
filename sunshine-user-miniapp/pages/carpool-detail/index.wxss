.detail-route {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}

.detail-metrics {
  margin-top: 22rpx;
}

.detail-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.application-list {
  margin-top: 20rpx;
}

.application-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(247, 248, 252, 0.92);
  border: 1rpx solid rgba(31, 36, 50, 0.06);
}

.application-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.application-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-button {
  flex: 1;
  width: 100%;
}


