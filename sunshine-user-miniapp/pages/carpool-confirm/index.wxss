.carpool-confirm-shell { background: #f6f8fb; }
.confirm-page { display: flex; flex-direction: column; gap: 18rpx; padding: 18rpx 24rpx 36rpx; }
.confirm-hero, .confirm-panel { background: #fff; border: 1rpx solid rgba(31,36,50,.07); border-radius: 20rpx; box-shadow: 0 10rpx 26rpx rgba(24,34,56,.05); }
.confirm-hero { display: flex; gap: 18rpx; align-items: flex-start; padding: 24rpx; background: linear-gradient(135deg,#fff8ee,#fff); }
.confirm-hero__icon { position: relative; width: 66rpx; height: 66rpx; flex: none; display: block; padding: 11rpx; box-sizing: border-box; border-radius: 18rpx; background: linear-gradient(145deg, #fff7ee 0%, #ffe2c2 100%); box-shadow: inset 0 0 0 5rpx rgba(255,255,255,.72), 0 8rpx 18rpx rgba(255,111,0,.14); }
.carpool-status-note { padding: 16rpx 18rpx; border-radius: 14rpx; color: #7b5a38; background: rgba(255,255,255,.72); font-size: 21rpx; line-height: 1.45; }
.confirm-hero__copy { min-width: 0; }
.confirm-hero__eyebrow { color: #ff6b00; font-size: 20rpx; font-weight: 600; }
.confirm-hero__title { margin-top: 7rpx; color: #121826; font-size: 31rpx; font-weight: 650; line-height: 1.2; }
.confirm-hero__desc { margin-top: 10rpx; color: #6f7889; font-size: 21rpx; line-height: 1.5; }
.confirm-panel { padding: 22rpx; }
.section-heading { color: #121826; font-size: 26rpx; font-weight: 650; line-height: 1.3; }
.route-card { margin-top: 16rpx; border: 1rpx solid rgba(255,122,0,.12); border-radius: 16rpx; overflow: hidden; }
.route-point { display: flex; align-items: center; gap: 20rpx; min-height: 82rpx; padding: 16rpx 18rpx; background: #fff; }
.route-divider { position: relative; height: 1rpx; margin: 0 22rpx; background: #edf0f4; }
.route-swap { position: absolute; left: 50%; top: 50%; width: 44rpx; height: 44rpx; border-radius: 50%; background: #fff3e8; transform: translate(-50%,-50%); }
.route-swap::before { content: '↕'; display: block; color: #ff7a00; font-size: 28rpx; line-height: 44rpx; text-align: center; }
.route-dot { width: 18rpx; height: 18rpx; flex: none; border-radius: 50%; }
.route-point--start .route-dot { background: #27bd70; box-shadow: 0 0 0 10rpx rgba(39,189,112,.12); }
.route-point--end .route-dot { background: #f66d67; box-shadow: 0 0 0 10rpx rgba(246,109,103,.12); }
.route-copy { min-width: 0; }
.route-label, .detail-label { color: #8a93a4; font-size: 20rpx; }
.route-value { margin-top: 6rpx; max-width: 560rpx; overflow: hidden; color: #18202e; font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.detail-list { margin-top: 12rpx; }
.detail-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 62rpx; border-bottom: 1rpx solid #f0f2f5; }
.detail-row:last-child { border-bottom: 0; }
.detail-value { color: #222b3a; font-size: 23rpx; font-weight: 550; text-align: right; }
.detail-value--accent { color: #ff6b00; }
.process-panel { padding-bottom: 16rpx; }
.process-step { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 18rpx; }
.process-index { width: 34rpx; height: 34rpx; flex: none; border-radius: 50%; color: #fff; background: #ff7a00; font-size: 20rpx; line-height: 34rpx; text-align: center; }
.process-title { color: #202938; font-size: 23rpx; font-weight: 600; }
.process-desc { margin-top: 5rpx; color: #7d8798; font-size: 20rpx; line-height: 1.45; }
.process-line { width: 2rpx; height: 20rpx; margin: 4rpx 0 0 16rpx; background: #ffd7b1; }
.confirm-notice { padding: 4rpx 6rpx; color: #8a93a4; font-size: 19rpx; line-height: 1.5; }
.publish-button { width: 100%; min-height: 78rpx; border-radius: 18rpx; font-size: 25rpx; font-weight: 650; }
