.carpool-confirm-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.24) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 32%, #f5f7fb 100%);
}

.confirm-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.confirm-hero,
.confirm-panel {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.confirm-hero {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 156rpx;
  padding: 30rpx 28rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 245, 233, 0.98) 0%, rgba(255, 255, 255, 0.92) 58%, rgba(255, 231, 194, 0.74) 100%);
}

.confirm-hero::after {
  content: "";
  position: absolute;
  right: 22rpx;
  bottom: 12rpx;
  width: 210rpx;
  height: 88rpx;
  border-radius: 80% 20% 0 0;
  border-top: 8rpx solid rgba(255, 255, 255, 0.9);
  background: linear-gradient(90deg, rgba(255, 181, 95, 0), rgba(255, 181, 95, 0.18));
  transform: skewX(-18deg);
}

.confirm-hero__icon {
  position: relative;
  z-index: 1;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #ff9e36, #ff6b00);
  box-shadow: 0 18rpx 30rpx rgba(255, 122, 0, 0.2);
}

.confirm-hero__icon::before,
.confirm-hero__icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.confirm-hero__icon::before {
  left: 22rpx;
  top: 20rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
}

.confirm-hero__icon::after {
  left: 38rpx;
  top: 30rpx;
  width: 8rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: rotate(45deg);
  transform-origin: bottom center;
}

.confirm-hero__copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.confirm-hero__title {
  font-size: 42rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.18;
}

.confirm-hero__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #737c90;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.confirm-distance {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  color: #ff6b00;
  font-size: 24rpx;
  font-weight: 900;
}

.confirm-panel {
  padding: 24rpx;
}

.route-card {
  position: relative;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.72);
}

.route-point {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 116rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, #fafbfe 0%, #ffffff 100%);
}

.route-divider {
  position: relative;
  height: 1rpx;
  margin-left: 28rpx;
  margin-right: 28rpx;
  background: rgba(17, 24, 39, 0.08);
}

.route-swap {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(31, 38, 52, 0.12);
}

.route-swap::before,
.route-swap::after {
  content: "";
  position: absolute;
  left: 31rpx;
  width: 7rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #ff6b00;
}

.route-swap::before {
  top: 13rpx;
}

.route-swap::after {
  bottom: 13rpx;
}

.route-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.route-point--start .route-dot {
  background: #23c66b;
  box-shadow: 0 0 0 14rpx rgba(35, 198, 107, 0.13);
}

.route-point--end .route-dot {
  background: #ff7373;
  box-shadow: 0 0 0 14rpx rgba(255, 115, 115, 0.13);
}

.route-copy {
  flex: 1;
  min-width: 0;
}

.route-label {
  font-size: 24rpx;
  color: #7d8799;
  line-height: 1.2;
}

.route-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #121826;
  line-height: 1.22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.summary-item {
  position: relative;
  min-width: 0;
  min-height: 140rpx;
  padding: 22rpx 18rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96), rgba(255, 255, 255, 0.98));
}

.summary-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 12rpx;
}

.summary-icon::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 8rpx;
  border: 4rpx solid #ff7a00;
  box-sizing: border-box;
}

.summary-item--time .summary-icon::before {
  border-radius: 50%;
}

.summary-item--people .summary-icon::before {
  border-radius: 50%;
  width: 15rpx;
  height: 15rpx;
  left: 9rpx;
  top: 1rpx;
  inset: auto;
  background: #ff7a00;
}

.summary-item--people .summary-icon::after {
  content: "";
  position: absolute;
  left: 2rpx;
  bottom: 2rpx;
  width: 28rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  border: 4rpx solid #ff7a00;
  border-top-width: 6rpx;
  box-sizing: border-box;
}

.summary-item__label {
  font-size: 22rpx;
  color: #7d8799;
  line-height: 1.2;
}

.summary-item__value {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preference-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.preference-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.08);
  color: #ff6b00;
  font-size: 24rpx;
  font-weight: 800;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.compact-title {
  position: relative;
  padding-left: 20rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #111827;
}

.compact-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 9rpx;
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff8d1a, #ff6b00);
}

.compact-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8497;
}

.coupon-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fafbfe, #ffffff);
  border: 1rpx solid rgba(255, 122, 0, 0.12);
}

.coupon-entry__icon {
  position: relative;
  width: 46rpx;
  height: 38rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #ff9c2f, #ff6b00);
  flex-shrink: 0;
}

.coupon-entry__icon::before,
.coupon-entry__icon::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.coupon-entry__icon::before {
  top: 12rpx;
}

.coupon-entry__icon::after {
  bottom: 12rpx;
}

.coupon-entry__body {
  flex: 1;
  min-width: 0;
}

.coupon-entry__label {
  font-size: 26rpx;
  font-weight: 900;
  color: #111827;
}

.coupon-entry__summary {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8b94a7;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.coupon-entry__summary--active,
.coupon-entry__action {
  color: #ff6b00;
  font-weight: 800;
}

.coupon-entry__action {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.08);
  font-size: 23rpx;
}

.price-summary {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 249, 241, 0.96), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(255, 122, 0, 0.1);
}

.price-summary__main {
  min-width: 0;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ff7a00, #ff9c2f);
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 0, 0.18);
}

.price-summary__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.price-summary__value {
  margin-top: 10rpx;
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #ffffff;
  word-break: break-all;
}

.price-summary__detail {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
  padding: 10rpx 4rpx;
}

.price-summary__line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 22rpx;
  color: #687386;
}

.price-summary__original,
.price-summary__discount {
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
}

.price-summary__original {
  text-decoration: line-through;
  color: #8c96a5;
}

.price-summary__discount {
  color: #ff6b00;
}

.confirm-actions {
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.publish-button,
.match-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 900;
}

.match-button {
  box-shadow: 0 18rpx 34rpx rgba(255, 107, 0, 0.22);
}

.coupon-picker-mask {
  z-index: 59;
}

.coupon-picker {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 86% 0%, rgba(255, 211, 156, 0.18) 0, rgba(255, 211, 156, 0) 250rpx),
    #f7f8fc;
}

.coupon-picker__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 28rpx) 28rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.04);
}

.coupon-picker__title {
  font-size: 36rpx;
  font-weight: 900;
  color: #111827;
}

.coupon-picker__subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8b94a7;
}

.coupon-picker__close {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(31, 41, 55, 0.08);
}

.coupon-picker__close::before,
.coupon-picker__close::after {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 32rpx;
  width: 26rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #7c8494;
}

.coupon-picker__close::before {
  transform: rotate(45deg);
}

.coupon-picker__close::after {
  transform: rotate(-45deg);
}

.coupon-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  padding: 20rpx 28rpx 0;
}

.coupon-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #6f7787;
  background: #ffffff;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
}

.coupon-tab--active {
  color: #ff6b00;
  background: #fff3e8;
  border-color: rgba(255, 122, 0, 0.22);
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 0, 0.08);
}

.coupon-picker__content {
  flex: 1;
  min-height: 0;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 24rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 122, 0, 0.08);
  box-shadow: 0 14rpx 30rpx rgba(31, 36, 50, 0.05);
}

.coupon-card--selected {
  border-color: rgba(255, 122, 0, 0.36);
  background: linear-gradient(180deg, #fffaf3 0%, #fff5ea 100%);
}

.coupon-card--disabled {
  opacity: 0.72;
  background: #f8f9fc;
  border-color: rgba(31, 36, 50, 0.06);
  box-shadow: none;
}

.coupon-card__value {
  width: 188rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff4e6 0%, #fff0de 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-card__value--disabled {
  background: #eef1f7;
}

.coupon-card__amount {
  font-size: 40rpx;
  font-weight: 900;
  color: #ff6b00;
  line-height: 1.1;
}

.coupon-card__caption {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b94a7;
}

.coupon-card__body {
  flex: 1;
  min-width: 0;
}

.coupon-card__name {
  font-size: 30rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.4;
}

.coupon-card__rule,
.coupon-card__valid {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #7b8497;
}

.coupon-card__radio {
  width: 42rpx;
  height: 42rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 122, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex-shrink: 0;
}

.coupon-card__radio-inner {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #ff6b00;
}

.coupon-card__reason {
  flex-shrink: 0;
  align-self: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #8b94a7;
  background: #eef1f7;
}

.coupon-empty {
  margin-top: 12rpx;
  padding: 46rpx 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  text-align: center;
  font-size: 26rpx;
  color: #8b94a7;
}

.coupon-picker__footer {
  padding: 16rpx 28rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 28rpx rgba(31, 36, 50, 0.06);
}

.coupon-picker__clear {
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 900;
}
