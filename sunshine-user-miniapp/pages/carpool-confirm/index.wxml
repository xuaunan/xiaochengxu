<view class="page-shell carpool-confirm-shell safe-bottom">
  <view class="page-content confirm-page page-enter">
    <view class="confirm-hero">
      <image class="confirm-hero__icon" src="/images/service-icons/carpool.png" mode="aspectFit"></image>
      <view class="confirm-hero__copy">
        <view class="confirm-hero__eyebrow">顺风车 · 乘客预约</view>
        <view class="confirm-hero__title">确认顺风车订单</view>
        <view class="confirm-hero__desc">订单将进入车主大厅，由车主自主接单</view>
      </view>
    </view>
    <view class="confirm-panel">
      <view class="section-heading">你的路线</view>
      <view class="route-card">
        <view class="route-point route-point--start"><view class="route-dot"></view><view class="route-copy"><view class="route-label">出发地</view><view class="route-value">{{context.draft.start.name || '请选择出发地'}}</view></view></view>
        <view class="route-divider"></view>
        <view class="route-point route-point--end"><view class="route-dot"></view><view class="route-copy"><view class="route-label">目的地</view><view class="route-value">{{context.draft.end.name || '请选择目的地'}}</view></view></view>
      </view>
    </view>
    <view class="confirm-panel">
      <view class="section-heading">行程与费用</view>
      <view class="detail-list">
        <view class="detail-row"><view class="detail-label">出发日期</view><view class="detail-value">{{context.departDate}}</view></view>
        <view class="detail-row"><view class="detail-label">期望时段</view><view class="detail-value">{{context.selectedTimeRangeLabel}}</view></view>
        <view class="detail-row"><view class="detail-label">乘车人数</view><view class="detail-value">{{context.selectedPassengerLabel}}</view></view>
        <view class="detail-row"><view class="detail-label">预估分摊价（每人）</view><view class="detail-value detail-value--accent">{{sharedAmountText}}</view></view>
        <view class="detail-row"><view class="detail-label">高速费</view><view class="detail-value">由车主接单后填写，需你确认</view></view>
      </view>
    </view>
    <view class="confirm-notice">车主接单后订单不会自动出发；若产生高速费，你确认后车主才能开始接驾。</view>
    <button class="primary-button publish-button" hover-class="button-hover" bindtap="publishRequest" loading="{{publishing}}" disabled="{{publishing || loading}}">{{publishing ? '提交中...' : '提交顺风车订单'}}</button>
  </view>
</view>
