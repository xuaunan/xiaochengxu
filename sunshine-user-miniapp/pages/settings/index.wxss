.settings-shell {
  background:
    radial-gradient(circle at 92% 0%, rgba(255, 193, 117, 0.12), transparent 34%),
    linear-gradient(180deg, #fff8f2 0%, #f7f8fc 34%, #f5f7fb 100%);
}

.settings-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.settings-hero {
  padding: 28rpx;
}

.settings-kicker {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #ff7a00;
}

.settings-title {
  font-size: 34rpx;
}

.settings-desc {
  max-width: 610rpx;
}

.setting-list {
  padding: 8rpx 24rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 126rpx;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #1f2432;
}

.setting-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #7a8396;
}

.setting-row switch {
  flex-shrink: 0;
}
