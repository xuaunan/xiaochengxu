.settings-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.22) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.settings-page {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 14rpx;
}

.settings-hero,
.setting-list {
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 10rpx 24rpx rgba(37, 43, 58, 0.045);
}

.settings-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 18rpx 112rpx 18rpx 20rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.settings-title {
  font-size: 29rpx;
  line-height: 1.18;
  font-weight: 600;
  color: #111827;
}

.settings-desc {
  margin-top: 6rpx;
  max-width: 520rpx;
  font-size: 20rpx;
  color: #737c90;
  line-height: 1.4;
}

.settings-hero__icon {
  position: absolute;
  right: 26rpx;
  top: 26rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.9), rgba(255, 122, 0, 0.86));
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.14);
  box-sizing: border-box;
}

.settings-hero__icon::before,
.settings-hero__icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.settings-hero__icon::before {
  box-shadow: 0 16rpx 0 rgba(255, 255, 255, 0.78);
  transform: translate(-50%, -160%);
}

.settings-hero__icon::after {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  box-shadow: -22rpx 22rpx 0 #ffffff;
  transform: translate(70%, -142%);
}

.setting-list {
  padding: 4rpx 18rpx 6rpx;
}

.setting-group + .setting-group {
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.setting-group-title {
  padding: 16rpx 0 5rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #ff6b00;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 76rpx;
  padding-bottom: 10rpx;
}

.setting-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  border-radius: 13rpx;
  background: rgba(255, 122, 0, 0.1);
  box-sizing: border-box;
}

.setting-icon::before,
.setting-icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.setting-icon--push::before {
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 28rpx;
  border-radius: 12rpx 12rpx 8rpx 8rpx;
  background: #ff7a00;
  transform: translate(-50%, -54%);
}

.setting-icon--push::after {
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #ff7a00;
  transform: translate(-50%, 128%);
}

.setting-icon--coupon::before {
  left: 50%;
  top: 50%;
  width: 29rpx;
  height: 20rpx;
  border-radius: 8rpx;
  background: #ff7a00;
  transform: translate(-50%, -50%);
}

.setting-icon--coupon::after {
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #111827;
}

.setting-subtitle {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: #7a8396;
}

.setting-row switch {
  flex-shrink: 0;
  transform: scale(0.86);
  transform-origin: right center;
}
