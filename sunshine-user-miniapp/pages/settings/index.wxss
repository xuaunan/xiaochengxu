.settings-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 184, 98, 0.3) 0, rgba(255, 211, 156, 0) 280rpx),
    radial-gradient(circle at 4% 18%, rgba(255, 122, 0, 0.08) 0, rgba(255, 122, 0, 0) 260rpx),
    linear-gradient(180deg, #fff3e6 0%, #f7f8fc 36%, #f3f6fb 100%);
}

.settings-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 22rpx 44rpx 48rpx;
}

.settings-hero,
.setting-list {
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 14rpx 34rpx rgba(24, 34, 56, 0.06);
}

.settings-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 152rpx;
  padding: 28rpx 124rpx 28rpx 30rpx;
  overflow: hidden;
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 247, 237, 0.96) 55%, rgba(255, 220, 181, 0.78) 100%);
}

.settings-hero::before {
  content: "";
  position: absolute;
  right: 64rpx;
  top: -30rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.5);
  transform: rotate(18deg);
}

.settings-hero::after {
  content: "";
  position: absolute;
  right: -50rpx;
  bottom: -62rpx;
  width: 198rpx;
  height: 198rpx;
  border-radius: 50%;
  background: rgba(255, 122, 0, 0.1);
}

.settings-hero__copy {
  position: relative;
  z-index: 2;
  min-width: 0;
}

.settings-title {
  font-size: 32rpx;
  line-height: 1.18;
  font-weight: 500;
  color: #111827;
}

.settings-desc {
  margin-top: 10rpx;
  max-width: 520rpx;
  font-size: 21rpx;
  color: #737c90;
  line-height: 1.45;
}

.settings-hero__icon {
  z-index: 2;
  position: absolute;
  right: 26rpx;
  top: 34rpx;
  width: 84rpx;
  height: 84rpx;
  filter: drop-shadow(0 12rpx 18rpx rgba(255, 122, 0, 0.16));
}

.setting-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(250, 252, 255, 0.98)),
    #ffffff;
}

.setting-group-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 0 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #ff6b00;
}

.setting-group-title::before {
  content: "";
  width: 16rpx;
  height: 16rpx;
  border-radius: 6rpx;
  background: linear-gradient(135deg, #ff9b32, #ff7a00);
  box-shadow: 0 4rpx 10rpx rgba(255, 122, 0, 0.18);
}

.setting-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 18rpx 18rpx 18rpx 16rpx;
  border-radius: 26rpx;
  background: #f7f9fd;
  border: 1rpx solid rgba(31, 36, 50, 0.055);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.setting-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff, #fff3e6);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.08);
  box-sizing: border-box;
}

.setting-icon-image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 25rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.25;
}

.setting-subtitle {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.42;
  color: #7a8396;
}

.setting-row switch {
  flex-shrink: 0;
  transform: scale(0.86);
  transform-origin: right center;
}
