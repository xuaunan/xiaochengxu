.settings-shell {
  background:
    linear-gradient(180deg, rgba(255, 246, 237, 0.72) 0%, #f7f8fc 26%, #f5f7fb 100%);
}

.settings-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.settings-hero {
  padding: 28rpx 28rpx 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
}

.settings-title {
  font-size: 34rpx;
}

.settings-desc {
  max-width: 610rpx;
}

.setting-list {
  padding: 8rpx 24rpx 4rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.055);
}

.setting-group-title {
  padding: 24rpx 0 2rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #ff7a00;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 116rpx;
  border-bottom: 1rpx solid rgba(31, 36, 50, 0.06);
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2432;
}

.setting-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #7a8396;
}

.setting-row switch {
  flex-shrink: 0;
}
