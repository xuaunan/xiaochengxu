.settings-shell {
  background:
    radial-gradient(circle at 88% 4%, rgba(255, 211, 156, 0.22) 0, rgba(255, 211, 156, 0) 260rpx),
    linear-gradient(180deg, #fff8ef 0%, #f7f8fc 30%, #f5f7fb 100%);
}

.settings-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 16rpx;
}

.settings-hero,
.setting-list {
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(255, 122, 0, 0.1);
  box-shadow: 0 16rpx 36rpx rgba(37, 43, 58, 0.05);
}

.settings-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 126rpx;
  padding: 24rpx 126rpx 24rpx 26rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.95) 56%, rgba(255, 231, 194, 0.7) 100%);
}

.settings-title {
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 700;
  color: #111827;
}

.settings-desc {
  margin-top: 8rpx;
  max-width: 520rpx;
  font-size: 22rpx;
  color: #737c90;
  line-height: 1.4;
}

.settings-hero__icon {
  position: absolute;
  right: 32rpx;
  top: 34rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(255, 183, 105, 0.9), rgba(255, 122, 0, 0.86));
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.18);
}

.settings-hero__icon::before,
.settings-hero__icon::after {
  content: "";
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.settings-hero__icon::before {
  top: 27rpx;
  box-shadow: 0 22rpx 0 rgba(255, 255, 255, 0.78);
}

.settings-hero__icon::after {
  top: 21rpx;
  left: 44rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: -22rpx 22rpx 0 #ffffff;
}

.setting-list {
  padding: 6rpx 22rpx 8rpx;
}

.setting-group + .setting-group {
  border-top: 1rpx solid rgba(31, 36, 50, 0.06);
}

.setting-group-title {
  padding: 20rpx 0 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ff6b00;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 92rpx;
  padding-bottom: 14rpx;
}

.setting-icon {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: rgba(255, 122, 0, 0.1);
}

.setting-icon::before,
.setting-icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.setting-icon--push::before {
  left: 19rpx;
  top: 11rpx;
  width: 20rpx;
  height: 30rpx;
  border-radius: 12rpx 12rpx 8rpx 8rpx;
  background: #ff7a00;
}

.setting-icon--push::after {
  left: 25rpx;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.setting-icon--coupon::before {
  left: 13rpx;
  top: 18rpx;
  width: 32rpx;
  height: 22rpx;
  border-radius: 8rpx;
  background: #ff7a00;
}

.setting-icon--coupon::after {
  left: 20rpx;
  top: 27rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.setting-icon--theme::before {
  left: 14rpx;
  top: 14rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 8rpx solid #ff7a00;
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.setting-subtitle {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: #7a8396;
}

.setting-row switch {
  flex-shrink: 0;
  transform: scale(0.86);
  transform-origin: right center;
}
