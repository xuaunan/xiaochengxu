.settlement-shell {
  background: linear-gradient(180deg, rgba(255, 246, 237, 0.62) 0%, #f7f8fc 28%, #f5f7fb 100%);
}

.settlement-hero {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 32rpx rgba(24, 34, 56, 0.055);
}

.payable {
  margin-top: 28rpx;
  font-size: 64rpx;
  font-weight: 800;
  color: #ff7a00;
}

.payable-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7385;
}

.original-payable {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8b94a7;
}

.status-accent {
  color: #ffffff;
  background: #ff7a00;
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 0, 0.16);
}

.status-success {
  color: #ffffff;
  background: #25b36a;
  box-shadow: 0 10rpx 22rpx rgba(37, 179, 106, 0.14);
}

.status-muted {
  color: #5b6476;
  background: #eef2f7;
  box-shadow: none;
}

.fee-row {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #1f2432;
  border-radius: 18rpx;
  background: #f8fafc;
}

.coupon-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(24, 34, 56, 0.05);
}

.coupon-entry:active {
  transform: scale(0.99);
}

.coupon-entry--disabled {
  opacity: 0.72;
  box-shadow: none;
}

.coupon-entry__main {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.coupon-entry__icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
  background: #ff7a00;
}

.coupon-entry__label {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2432;
}

.coupon-entry__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b94a7;
}

.coupon-entry__summary {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8b94a7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-entry__summary--active {
  color: #ff7a00;
  font-weight: 700;
}

.coupon-entry__action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 800;
  color: #ff7a00;
}

.coupon-entry__action--disabled {
  color: #b8c0cf;
}

.tips {
  margin-top: 22rpx;
}

.tip-item {
  position: relative;
  padding-left: 24rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5b6476;
}

.tip-item + .tip-item {
  margin-top: 10rpx;
}

.tip-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 15rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.settlement-bar {
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -12rpx 30rpx rgba(31, 36, 50, 0.08);
}

.settlement-actions {
  display: flex;
  gap: 18rpx;
}

.settlement-secondary {
  width: 220rpx;
  min-height: 96rpx;
  border-radius: 24rpx;
}

.settlement-primary {
  flex: 1;
  min-height: 96rpx;
  border-radius: 24rpx;
}

.coupon-picker-mask {
  z-index: 59;
}

.coupon-picker {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 90% 2%, rgba(255, 177, 74, 0.16), transparent 28%),
    #f7f8fc;
}

.coupon-picker__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 26rpx) 24rpx 18rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 8rpx 24rpx rgba(31, 36, 50, 0.04);
}

.coupon-picker__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2432;
}

.coupon-picker__close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8b94a7;
  background: #ffffff;
}

.coupon-tabs {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx 0;
  background: #ffffff;
}

.coupon-tab {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8b94a7;
  background: #f5f6fa;
}

.coupon-tab--active {
  color: #ff7a00;
  background: #fff1df;
}

.coupon-picker__content {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 24rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 122, 0, 0.08);
  box-shadow: 0 16rpx 30rpx rgba(31, 36, 50, 0.06);
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.coupon-card--selected {
  border-color: rgba(255, 122, 0, 0.28);
  background: linear-gradient(180deg, #fffaf3 0%, #fff5ea 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 0, 0.1);
}

.coupon-card--disabled {
  opacity: 0.7;
  background: #f8f9fc;
  border-color: rgba(31, 36, 50, 0.06);
  box-shadow: none;
}

.coupon-card__value {
  width: 188rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff4e6 0%, #fff0de 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-card__value--disabled {
  background: #eef1f7;
}

.coupon-card__amount {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff7a00;
  line-height: 1.1;
}

.coupon-card__caption {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b94a7;
}

.coupon-card__body {
  flex: 1;
  min-width: 0;
}

.coupon-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2432;
  line-height: 1.4;
}

.coupon-card__rule,
.coupon-card__valid {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b94a7;
}

.coupon-card__radio {
  width: 40rpx;
  height: 40rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 122, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  flex-shrink: 0;
}

.coupon-card__radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff7a00;
}

.coupon-card__reason {
  flex-shrink: 0;
  align-self: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #8b94a7;
  background: #eef1f7;
}

.coupon-empty {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8b94a7;
}

.coupon-picker__footer {
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 28rpx rgba(31, 36, 50, 0.06);
}

.coupon-picker__clear {
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}


