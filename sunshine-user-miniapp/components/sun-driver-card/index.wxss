.driver-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.09);
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 177, 74, 0.18), transparent 34%),
    linear-gradient(180deg, #ffffff, #fff8ef);
  box-shadow: 0 16rpx 38rpx rgba(31, 36, 50, 0.07);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.driver-card:active {
  transform: scale(0.99);
  opacity: 0.96;
}

.driver-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.driver-body {
  flex: 1;
  min-width: 0;
  padding-right: 118rpx;
}

.driver-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.driver-name {
  min-width: 0;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2432;
}

.driver-rate {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #ff7a00;
}

.driver-meta,
.driver-eta {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.3;
  color: #7a8396;
}

.driver-meta,
.driver-eta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}

.driver-tag {
  max-width: 160rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.1);
  color: #7a8396;
  font-size: 21rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-button {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
  color: #ff7a00;
  background: #fff1df;
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.1);
  box-sizing: border-box;
}

.driver-button::after {
  border: none;
}
