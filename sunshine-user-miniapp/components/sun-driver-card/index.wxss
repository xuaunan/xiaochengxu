.driver-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 118rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.12);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 100% 0, rgba(255, 177, 74, 0.14), transparent 36%),
    linear-gradient(135deg, #fffefd 0%, #fff8ef 100%);
  box-shadow: 0 14rpx 30rpx rgba(31, 36, 50, 0.08);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.driver-card:active {
  transform: scale(0.99);
  opacity: 0.96;
}

.driver-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.driver-body {
  flex: 1;
  min-width: 0;
  padding-right: 136rpx;
}

.driver-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.driver-name {
  min-width: 0;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 650;
  color: #1f2432;
}

.driver-rate {
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 650;
  color: #ff7a00;
}

.driver-meta,
.driver-eta {
  margin-top: 7rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: #7a8396;
}

.driver-meta,
.driver-eta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 9rpx;
}

.driver-tag {
  max-width: 160rpx;
  padding: 5rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(93, 118, 160, 0.09);
  border: 1rpx solid rgba(93, 118, 160, 0.08);
  color: #68758a;
  font-size: 19rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-button {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  min-width: 124rpx;
  max-width: 124rpx;
  height: 46rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  font-size: 19rpx;
  font-weight: 650;
  line-height: 1;
  color: #ff7a00;
  background: rgba(255, 122, 0, 0.11);
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.08);
  box-sizing: border-box;
  white-space: nowrap;
}

.driver-button::after {
  border: none;
}
