.coupon-card {
  position: relative;
  height: 110rpx;
  border-radius: 15rpx;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border: 1rpx solid rgba(31, 36, 50, 0.035);
  box-shadow: 0 7rpx 20rpx rgba(37, 45, 62, 0.044);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.coupon-card:active {
  transform: scale(0.992);
  opacity: 0.96;
}

.coupon-card--disabled {
  opacity: 0.58;
}

.coupon-main {
  position: relative;
  flex-shrink: 0;
  width: 132rpx;
  height: 100%;
  padding: 16rpx 14rpx 14rpx 22rpx;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-card--orange .coupon-main {
  background: linear-gradient(90deg, #ff7f34 0%, #ff934a 56%, #ffab6e 100%);
}

.coupon-card--purple .coupon-main {
  background: linear-gradient(90deg, #9d7cff 0%, #b197ff 56%, #cab8ff 100%);
}

.coupon-main::after {
  content: "";
  position: absolute;
  right: -8rpx;
  top: 0;
  width: 16rpx;
  height: 100%;
  background-image: radial-gradient(circle, #ffffff 7rpx, transparent 8rpx);
  background-size: 16rpx 18rpx;
  background-position: 0 2rpx;
}

.coupon-value {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.coupon-value__num {
  max-width: 88rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 0.95;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-value__unit {
  margin-left: 3rpx;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1;
}

.coupon-scope {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  max-width: 92rpx;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.15;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-body {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx 12rpx 28rpx;
}

.coupon-name {
  color: #20283b;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-rule,
.coupon-code {
  margin-top: 6rpx;
  color: #7b8497;
  font-size: 19rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-code {
  margin-top: 5rpx;
  color: #8f98aa;
}

.coupon-side {
  flex-shrink: 0;
  width: 110rpx;
  padding: 0 12rpx 0 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-action,
.coupon-status {
  min-width: 86rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 42rpx;
  text-align: center;
  white-space: nowrap;
}

.coupon-card--orange .coupon-action,
.coupon-card--orange .coupon-status-active {
  color: #ff6f18;
  background: #fff1e7;
  box-shadow: 0 5rpx 12rpx rgba(255, 116, 30, 0.055);
}

.coupon-card--purple .coupon-action,
.coupon-card--purple .coupon-status-active {
  color: #8d6bff;
  background: #f4efff;
  box-shadow: 0 5rpx 12rpx rgba(141, 112, 255, 0.055);
}

.coupon-status {
  min-width: 68rpx;
  color: #7c8596;
  background: #f2f4f8;
  box-shadow: none;
}

.coupon-action--disabled {
  color: #9ba4b5;
  background: #f1f3f7;
  box-shadow: none;
}
